@using MyCostomProjectManagement.Components.Pages
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>پنل مدیریت</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/csharp.svg" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
               ADMIN LAYOUT - با پس‌زمینه #13505b
            ============================================================ */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
               GLASS EFFECT
            ============================================================ */
    .glass {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

        .glass:hover {
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 48px rgba(0, 0, 0, 0.12);
            transform: translateY(-3px);
            border-color: rgba(255, 255, 255, 0.06);
        }

    /* ============================================================
               ANIMATIONS
            ============================================================ */
    @@keyframes rotateBorder {
        0% {
            background-position: 0% 50%;
        }

        100% {
            background-position: 400% 50%;
        }
    }

    /* ============================================================
               NAVBAR
            ============================================================ */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: all 0.4s ease;
        background: rgba(19, 80, 91, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

        .navbar.scrolled {
            background: rgba(19, 80, 91, 0.95);
            box-shadow: 0 4px 40px rgba(0, 0, 0, 0.12);
        }

        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #e8f0f1;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .logo span {
            color: #e8a838;
        }

        .logo i {
            color: #e8a838;
            font-size: 1.3rem;
        }

    /* منوی دسکتاپ */
    .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 500;
        align-items: center;
        flex-wrap: wrap;
    }

        .nav-links a {
            color: rgba(232, 240, 241, 0.6);
            transition: all 0.35s ease;
            position: relative;
            padding: 4px 0;
            white-space: nowrap;
        }

            .nav-links a:hover {
                color: #ffffff;
            }

            .nav-links a::after {
                content: '';
                position: absolute;
                bottom: -2px;
                right: 0;
                width: 0;
                height: 2.5px;
                background: #e8a838;
                transition: 0.35s;
                border-radius: 4px;
                box-shadow: 0 0 12px rgba(232, 168, 56, 0.15);
            }

            .nav-links a:hover::after {
                width: 100%;
            }

            .nav-links a.active {
                color: #ffffff;
            }

                .nav-links a.active::after {
                    width: 100%;
                }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .avatar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(232, 168, 56, 0.2);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8f0f1;
        font-size: 1.1rem;
        transition: all 0.35s ease;
        cursor: pointer;
    }

        .avatar-btn:hover {
            background: rgba(232, 168, 56, 0.04);
            transform: scale(1.05);
            border-color: #e8a838;
        }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
    }

        .hamburger span {
            display: block;
            width: 28px;
            height: 2.5px;
            background: #e8f0f1;
            border-radius: 4px;
            transition: 0.3s;
        }

    /* ============================================================
               OVERLAY MENU (موبایل)
            ============================================================ */
    /* پس‌زمینه تیره برای overlay */
    .menu-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        z-index: 1000;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

        .menu-overlay.open {
            display: block;
            opacity: 1;
        }

    /* منوی کناری */
    .nav-links-mobile {
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        max-width: 80%;
        height: 100%;
        background: rgba(19, 80, 91, 0.98);
        backdrop-filter: blur(16px);
        box-shadow: -4px 0 30px rgba(0, 0, 0, 0.3);
        z-index: 1001;
        padding: 20px 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow-y: auto;
        transition: right 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
        border-radius: 0 20px 20px 0;
    }

        .nav-links-mobile.open {
            right: 0;
        }

        /* دکمه بستن */
        .nav-links-mobile .close-btn {
            align-self: flex-end;
            background: none;
            border: none;
            color: #e8f0f1;
            font-size: 1.8rem;
            padding: 8px 20px;
            cursor: pointer;
            transition: 0.2s;
        }

            .nav-links-mobile .close-btn:hover {
                color: #e8a838;
                transform: rotate(90deg);
            }

        .nav-links-mobile a {
            color: rgba(232, 240, 241, 0.7);
            padding: 12px 24px;
            font-size: 1rem;
            transition: 0.2s;
            border-right: 3px solid transparent;
        }

            .nav-links-mobile a:hover {
                background: rgba(255, 255, 255, 0.05);
                color: #ffffff;
                border-right-color: #e8a838;
            }

            .nav-links-mobile a.active {
                color: #e8a838;
                background: rgba(232, 168, 56, 0.05);
                border-right-color: #e8a838;
            }

        .nav-links-mobile .separator {
            height: 1px;
            background: rgba(255, 255, 255, 0.05);
            margin: 8px 20px;
        }

    /* ============================================================
               PAGE CONTENT
            ============================================================ */
    .page-wrapper {
        padding-top: 90px;
        padding-bottom: 40px;
        min-height: 100vh;
    }

    /* ============================================================
               FOOTER
            ============================================================ */
    .footer {
        position: relative;
        padding: 28px 0 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.02);
        background: rgba(19, 80, 91, 0.2);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1;
        margin-top: 20px;
    }

        .footer .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
        }

    .footer-links {
        display: flex;
        gap: 24px;
        font-size: 0.85rem;
        color: rgba(232, 240, 241, 0.2);
    }

        .footer-links a:hover {
            color: #e8a838;
        }

    .footer-copy {
        color: rgba(232, 240, 241, 0.2);
        font-size: 0.8rem;
    }

        .footer-copy i {
            color: #e8a838;
        }

    /* ============================================================
               RESPONSIVE
            ============================================================ */
    @@media (max-width: 992px) {
        .nav-links {
            gap: 16px;
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 768px) {
        /* مخفی کردن منوی دسکتاپ */
        .nav-links {
            display: none;
        }

        .hamburger {
            display: flex;
        }

        .nav-actions .btn-outline {
            display: none;
        }

        .page-wrapper {
            padding-top: 80px;
        }

        .footer .container {
            flex-direction: column;
            gap: 16px;
            text-align: center;
        }
    }

    @@media (max-width: 480px) {
        .logo {
            font-size: 1.2rem;
        }

        .nav-links-mobile {
            width: 260px;
        }

            .nav-links-mobile a {
                padding: 10px 20px;
                font-size: 0.9rem;
            }
    }

    /* ============================================================
               HOME BUTTON
            ============================================================ */
    .home-btn {
        background: none;
        border: none;
        color: #cbd5e1;
        font-size: 20px;
        cursor: pointer;
        padding: 6px 10px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: 0.2s;
    }

        .home-btn:hover {
            background: #334155;
            color: white;
        }
</style>

<!-- ============================================================
     SPARKLE PARTICLES (optional)
============================================================ -->
<div class="sparkle" style="display:none;"></div>

