        <!-- منوی دسکتاپ -->
        <ul class="nav-links">
            <li><a class="@(IsActive("/Admin") ? "active" : "")" href="/Admin">داشبورد</a></li>
            <li><a class="@(IsActive("/Admin/Projects") ? "active" : "")" href="/Admin/Projects">پروژه‌ها</a></li>
