<!-- ============================================================
     OVERLAY & MENU MOBILE
============================================================ -->
<!-- پس‌زمینه تیره -->
<div class="menu-overlay @(isMenuOpen ? "open" : "")" @onclick="CloseMenu"></div>

<!-- منوی موبایل (کناری) -->
<div class="nav-links-mobile @(isMenuOpen ? "open" : "")">
    <button class="close-btn" @onclick="CloseMenu">
        <i class="fas fa-times"></i>
    </button>

    <a class="@(IsActive("/Admin") ? "active" : "")" href="/Admin" @onclick="CloseMenu">داشبورد</a>
    <a class="@(IsActive("/Admin/Projects") ? "active" : "")" href="/Admin/Projects" @onclick="CloseMenu">پروژه‌ها</a>
    <a class="@(IsActive("/Admin/Users") ? "active" : "")" href="/Admin/Users" @onclick="CloseMenu">کاربران</a>
    <a class="@(IsActive("/Admin/Roles") ? "active" : "")" href="/Admin/Roles" @onclick="CloseMenu">نقش‌ها</a>
    <a class="@(IsActive("/Admin/ApiManagement") ? "active" : "")" href="/Admin/ApiManagement" @onclick="CloseMenu">APIها</a>
    <a class="@(IsActive("/Admin/Packages") ? "active" : "")" href="/Admin/Packages" @onclick="CloseMenu">پکیج‌ها</a>
    <a class="@(IsActive("/Admin/PackageApiAccess") ? "active" : "")" href="/Admin/PackageApiAccess" @onclick="CloseMenu">دسترسی API</a>
    <a class="@(IsActive("/Admin/Projects/Requests") ? "active" : "")" href="/Admin/Projects/Requests" @onclick="CloseMenu">درخواست‌ها</a>
    <a class="@(IsActive("/Admin/Contacts") ? "active" : "")" href="/Admin/Contacts" @onclick="CloseMenu">تماس</a>
    <a class="@(IsActive("/Admin/Skills") ? "active" : "")" href="/Admin/Skills" @onclick="CloseMenu">مهارت‌ها</a>
    <a class="@(IsActive("/Admin/Portfolio") ? "active" : "")" href="/Admin/Portfolio" @onclick="CloseMenu">نمونه کارها</a>
    <a class="@(IsActive("/Admin/FAQ") ? "active" : "")" href="/Admin/FAQ" @onclick="CloseMenu">سوالات متداول</a>
    <a class="@(IsActive("/Admin/PageManagement") ? "active" : "")" href="/Admin/PageManagement" @onclick="CloseMenu">مدیریت صفحات</a>
    <a class="@(IsActive("/Admin/Settings") ? "active" : "")" href="/Admin/Settings" @onclick="CloseMenu">تنظیمات</a>
    <a class="@(IsActive("/Admin/Subscriptions") ? "active" : "")" href="/Admin/Subscriptions" @onclick="CloseMenu">اشتراک‌ها</a>
    <a class="@(IsActive("/Admin/Tutorials") ? "active" : "")"
       href="/Admin/Tutorials" @onclick="CloseMenu">آموزش‌ها</a>
</div>

<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<div class="page-wrapper">
    <div class="container">
        @Body
    </div>
</div>

<!-- ============================================================
     FOOTER
============================================================ -->
<footer class="footer">
    <div class="container">
        <div class="footer-copy">© ۲۰۲۶ محمد پارسا کریمی · <i class="fas fa-heart"></i> پنل مدیریت</div>
        <div class="footer-links">
            <a href="/Admin">داشبورد</a>
            <a href="/Admin/Settings">تنظیمات</a>
            <a href="/">خروج</a>
        </div>
    </div>
</footer>

@code {
    // ---- متغیرهای وضعیت ----
    private bool isMenuOpen = false;

    // ---- متدهای چرخه زندگی ----
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }

    // ---- متدهای JS Interop ----
    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 30);
            });
        ");
    }

    // ---- تشخیص مسیر فعال ----
    private bool IsActive(string path)
    {
        var currentUri = Navigation.Uri;
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        var relativePath = currentUri.Replace(baseUri, "").TrimStart('/');

        if (relativePath.EndsWith("/"))
            relativePath = relativePath[..^1];

        var targetPath = path.TrimStart('/');

        if (targetPath == "admin" && (relativePath == "admin" || relativePath == ""))
            return true;

        return relativePath.Equals(targetPath, StringComparison.OrdinalIgnoreCase);
    }

    // ---- متدهای UI ----
    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
        StateHasChanged();
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
        StateHasChanged();
    }

    private void GoToProfile() => Navigation.NavigateTo("/Admin/Profile", true);
}