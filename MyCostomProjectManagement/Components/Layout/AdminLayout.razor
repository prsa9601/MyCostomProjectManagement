@using MyCostomProjectManagement.Components.Pages
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>پنل مدیریت</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<!-- آپدیت FontAwesome به نسخه پایدار 6.5.1 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<!-- اضافه کردن کتابخانه Devicon برای آیکون‌های تکنولوژی (Docker, Git, AWS, ...) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
<!-- لینک استاندارد و کامل Devicon برای نمایش صحیح آیکون‌های تکنولوژی -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css">

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
        min-height: 100dvh;
    }

        body.menu-open {
            overflow: hidden;
        }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
               NAVBAR
            ============================================================ */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 12px 0;
        background: rgba(19, 80, 91, 0.88);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        transition: background 0.3s ease;
    }

        .navbar.scrolled {
            background: rgba(19, 80, 91, 0.96);
            box-shadow: 0 4px 40px rgba(0, 0, 0, 0.12);
        }

        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: nowrap;
            gap: 16px;
            min-height: 44px;
        }

    .logo {
        font-size: 1.4rem;
        font-weight: 800;
        color: #e8f0f1;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

        .logo span {
            color: #e8a838;
        }

        .logo i {
            color: #e8a838;
            font-size: 1.2rem;
        }

    /* ============================================================
               DESKTOP NAV
            ============================================================ */
    .nav-links {
        display: flex;
        gap: 20px;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 500;
        align-items: center;
        flex-wrap: wrap;
        min-width: 0;
    }

        .nav-links > li > a,
        .nav-links > li > .nav-link {
            color: rgba(232, 240, 241, 0.65);
            transition: color 0.3s ease;
            position: relative;
            padding: 6px 0;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            background: none;
            border: none;
            font: inherit;
        }

            .nav-links > li > a:hover,
            .nav-links > li > .nav-link:hover {
                color: #fff;
            }

            .nav-links > li > a::after,
            .nav-links > li > .nav-link::after {
                content: '';
                position: absolute;
                bottom: -2px;
                right: 0;
                width: 0;
                height: 2.5px;
                background: #e8a838;
                transition: width 0.35s;
                border-radius: 4px;
            }

            .nav-links > li > a:hover::after,
            .nav-links > li > a.active::after,
            .nav-links > li.active-group > .nav-link::after {
                width: 100%;
            }

            .nav-links > li > a.active {
                color: #fff;
            }

        .nav-links > li.active-group > .nav-link {
            color: #e8a838;
        }

    .nav-item {
        position: relative;
    }

    .dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        min-width: 220px;
        padding: 8px;
        margin-top: 10px;
        background: rgba(15, 62, 72, 0.98);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 14px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
        z-index: 1000;
    }

    .nav-item:hover .dropdown,
    .nav-item:focus-within .dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .dropdown a {
        display: block;
        padding: 9px 14px;
        border-radius: 10px;
        color: rgba(232, 240, 241, 0.72);
        font-size: 0.85rem;
        transition: 0.2s;
        white-space: nowrap;
    }

        .dropdown a:hover {
            background: rgba(232, 168, 56, 0.10);
            color: #fff;
        }

        .dropdown a.active {
            color: #e8a838;
            background: rgba(232, 168, 56, 0.08);
        }

    /* ============================================================
               NAV ACTIONS
            ============================================================ */
    .nav-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .avatar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(232, 168, 56, 0.2);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8f0f1;
        font-size: 1rem;
        transition: all 0.3s;
        cursor: pointer;
    }

        .avatar-btn:hover {
            background: rgba(232, 168, 56, 0.08);
            border-color: #e8a838;
        }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
        padding: 8px;
        border-radius: 8px;
        transition: background 0.2s;
    }

        .hamburger:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .hamburger span {
            display: block;
            width: 24px;
            height: 2.5px;
            background: #e8f0f1;
            border-radius: 4px;
            transition: transform 0.3s, opacity 0.3s;
        }

        .hamburger.active span:nth-child(1) {
            transform: translateY(7.5px) rotate(45deg);
        }

        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger.active span:nth-child(3) {
            transform: translateY(-7.5px) rotate(-45deg);
        }

    /* ============================================================
               MOBILE MENU
            ============================================================ */
    .menu-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        z-index: 1000;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

        .menu-overlay.open {
            display: block;
            opacity: 1;
        }

    .nav-links-mobile {
        position: fixed;
        top: 0;
        right: -100%;
        width: 320px;
        max-width: 88vw;
        height: 100vh;
        height: 100dvh;
        background: rgba(19, 80, 91, 0.99);
        backdrop-filter: blur(16px);
        box-shadow: -4px 0 30px rgba(0, 0, 0, 0.3);
        z-index: 1001;
        display: flex;
        flex-direction: column;
        transition: right 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
        border-radius: 0 0 0 20px;
        overflow: hidden;
    }

        .nav-links-mobile.open {
            right: 0;
        }

    .mobile-menu-header {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        background: rgba(19, 80, 91, 0.99);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
        z-index: 2;
    }

        .mobile-menu-header .logo {
            font-size: 1.15rem;
        }

    .close-btn {
        background: none;
        border: none;
        color: #e8f0f1;
        font-size: 1.4rem;
        padding: 6px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s;
    }

        .close-btn:hover {
            color: #e8a838;
            background: rgba(255, 255, 255, 0.05);
        }

    .mobile-menu-content {
        flex: 1;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
        padding: 8px 0 32px;
    }

        .mobile-menu-content a {
            display: block;
            color: rgba(232, 240, 241, 0.78);
            padding: 11px 24px;
            font-size: 0.95rem;
            border-right: 3px solid transparent;
            transition: background 0.15s, color 0.15s, border-color 0.15s;
        }

            .mobile-menu-content a:hover {
                background: rgba(255, 255, 255, 0.05);
                color: #fff;
            }

            .mobile-menu-content a.active {
                color: #e8a838;
                background: rgba(232, 168, 56, 0.06);
                border-right-color: #e8a838;
            }

    .mobile-group-title {
        padding: 14px 24px 4px;
        font-size: 0.72rem;
        color: rgba(232, 168, 56, 0.9);
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    .mobile-menu-content a.mobile-sub {
        padding-right: 38px;
        font-size: 0.9rem;
    }

    .mobile-menu-content .separator {
        height: 1px;
        background: rgba(255, 255, 255, 0.06);
        margin: 8px 20px;
    }

    /* ============================================================
               PAGE / FOOTER
            ============================================================ */
    .page-wrapper {
        padding-top: 78px;
        padding-bottom: 40px;
        min-height: 100vh;
    }

    .footer {
        position: relative;
        padding: 28px 0 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.02);
        background: rgba(19, 80, 91, 0.2);
        backdrop-filter: blur(8px);
        margin-top: 20px;
    }

        .footer .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

    .footer-links {
        display: flex;
        gap: 24px;
        font-size: 0.85rem;
        color: rgba(232, 240, 241, 0.4);
        flex-wrap: wrap;
    }

        .footer-links a:hover {
            color: #e8a838;
        }

    .footer-copy {
        color: rgba(232, 240, 241, 0.4);
        font-size: 0.8rem;
    }

        .footer-copy i {
            color: #e8a838;
        }

    /* ============================================================
               BREAKPOINTS
            ============================================================ */
    @@media (max-width: 1024px) {
        .nav-links {
            display: none;
        }

        .hamburger {
            display: flex;
        }

        .home-btn {
            display: none;
        }

        .page-wrapper {
            padding-top: 70px;
        }

        .footer .container {
            flex-direction: column;
            text-align: center;
        }
    }

    @@media (max-width: 480px) {
        .container {
            padding: 0 16px;
        }

        .logo {
            font-size: 1.15rem;
        }

            .logo i {
                font-size: 1rem;
            }

        .avatar-btn {
            width: 34px;
            height: 34px;
            font-size: 0.9rem;
        }

        .hamburger span {
            width: 22px;
        }

        .nav-links-mobile {
            width: 280px;
        }
    }
</style>

<!-- ============================================================
     NAVBAR
============================================================ -->
<header class="navbar" id="navbar">
    <div class="container">
        <a href="/Admin" class="logo">
            <i class="fas fa-crown"></i>
            Admin<span>Panel</span>
        </a>

        <ul class="nav-links">
            <li>
                <a class="@(IsActive("/Admin") ? "active" : "")" href="/Admin">داشبورد</a>
            </li>

            @foreach (var group in MenuGroups)
            {
                if (group.Items.Count == 1)
                {
                    var item = group.Items[0];
                    <li>
                        <a class="@(IsActive(item.Path) ? "active" : "")" href="@item.Path">@item.Label</a>
                    </li>
                }
                else
                {
                    <li class="nav-item @(IsGroupActive(group) ? "active-group" : "")">
                        <button class="nav-link" type="button" aria-haspopup="true">
                            @group.Title
                            <i class="fas fa-chevron-down" style="font-size:0.6rem; opacity:0.7;"></i>
                        </button>
                        <ul class="dropdown">
                            @foreach (var item in group.Items)
                            {
                                <li>
                                    <a class="@(IsActive(item.Path) ? "active" : "")" href="@item.Path">@item.Label</a>
                                </li>
                            }
                        </ul>
                    </li>
                }
            }
        </ul>

        <div class="nav-actions">
            <div class="avatar-btn" @onclick="GoToProfile" role="button" aria-label="پروفایل">
                <i class="fas fa-user-cog"></i>
            </div>
            <button class="hamburger @(isMenuOpen ? "active" : "")"
                    @onclick="ToggleMenu"
                    aria-label="منو"
                    aria-expanded="@(isMenuOpen.ToString().ToLower())">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<!-- ============================================================
     MOBILE MENU
============================================================ -->
<div class="menu-overlay @(isMenuOpen ? "open" : "")" @onclick="CloseMenu"></div>

<aside class="nav-links-mobile @(isMenuOpen ? "open" : "")" aria-hidden="@((!isMenuOpen).ToString().ToLower())">
    <div class="mobile-menu-header">
        <a href="/Admin" class="logo" @onclick="CloseMenu">
            <i class="fas fa-crown"></i>
            Admin<span>Panel</span>
        </a>
        <button class="close-btn" @onclick="CloseMenu" aria-label="بستن">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <nav class="mobile-menu-content">
        <a class="@(IsActive("/Admin") ? "active" : "")" href="/Admin" @onclick="CloseMenu">داشبورد</a>

        @foreach (var group in MenuGroups)
        {
            if (group.Items.Count == 1)
            {
                var item = group.Items[0];
                <a class="@(IsActive(item.Path) ? "active" : "")" href="@item.Path" @onclick="CloseMenu">@item.Label</a>
            }
            else
            {
                <div class="mobile-group-title">@group.Title</div>
                @foreach (var item in group.Items)
                {
                    <a class="mobile-sub @(IsActive(item.Path) ? "active" : "")"
                       href="@item.Path"
                       @onclick="CloseMenu">@item.Label</a>
                }
            }
        }

        <div class="separator"></div>
        <a href="/" @onclick="CloseMenu"><i class="fas fa-home" style="margin-left:8px;"></i>صفحه اصلی</a>
        <a href="/Admin/Profile" @onclick="CloseMenu"><i class="fas fa-user-cog" style="margin-left:8px;"></i>پروفایل</a>
    </nav>
</aside>

<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<div class="page-wrapper">
    <div class="container">
        @Body
    </div>
</div>

<!-- ============================================================
     FOOTER
============================================================ -->
<footer class="footer">
    <div class="container">
        <div class="footer-copy">© ۲۰۲۶ محمد پارسا کریمی · <i class="fas fa-heart"></i> پنل مدیریت</div>
        <div class="footer-links">
            <a href="/Admin">داشبورد</a>
            <a href="/Admin/Settings">تنظیمات</a>
            <a href="/">خروج</a>
        </div>
    </div>
</footer>

@code {
    // ============================================================
    //  مدل منو
    // ============================================================
    private sealed record MenuItem(string Path, string Label);
    private sealed record MenuGroup(string Title, List<MenuItem> Items);

    // ============================================================
    //  تعریف منو — با گروه‌های جدید
    // ============================================================
    private static readonly List<MenuGroup> MenuGroups = new()
    {
        new("پروژه‌ها", new()
        {
            new("/Admin/Projects",          "لیست پروژه‌ها"),
            new("/Admin/Projects/Requests", "درخواست‌ها"),
            new("/Admin/Portfolio",         "نمونه کارها"),
        }),
        new("کاربران و دسترسی", new()
        {
            new("/Admin/Users",         "کاربران"),
            new("/Admin/Roles",         "نقش‌ها"),
            new("/Admin/Subscriptions", "اشتراک‌ها"),
        }),
        new("API و پکیج", new()
        {
            new("/Admin/ApiManagement",    "APIها"),
            new("/Admin/Packages",         "پکیج‌ها"),
            new("/Admin/PackageApiAccess", "دسترسی API"),
        }),
        new("محتوا", new()
        {
            new("/Admin/Blogs",           "بلاگ‌ها"),
            new("/Admin/Tutorials",       "آموزش‌ها"),
            new("/Admin/FAQ",             "سوالات متداول"),
            new("/Admin/PageManagement",  "مدیریت صفحات"),
            new("/Admin/Comments",        "نظرات کاربران"), // ← جدید
        }),
        new("تخصص‌ها و خدمات", new()
        {
            new("/Admin/Skills",                    "مهارت‌ها"),
            new("/Admin/ProgrammingServices",       "خدمات برنامه‌نویسی"),
            new("/Admin/SpecializedTechnologies",   "تکنولوژی‌های تخصصی"),
            new("/Admin/SpecializedQualifications", "مدارک تخصصی"),   // ← جدید
        }),
        new("سیستم", new()
        {
            new("/Admin/Contacts", "پیام‌های تماس"),
            new("/Admin/Settings", "تنظیمات"),
        }),
    };

    private bool isMenuOpen = false;

    // ============================================================
    //  Lifecycle
    // ============================================================
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                const navbar = document.getElementById('navbar');
                window.addEventListener('scroll', () => {
                    navbar?.classList.toggle('scrolled', window.scrollY > 30);
                });
            ");
        }

        await JSRuntime.InvokeVoidAsync("eval",
            $"document.body.classList.toggle('menu-open', {(isMenuOpen ? "true" : "false")});");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (isMenuOpen)
        {
            isMenuOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    // ============================================================
    //  Active route detection
    // ============================================================
    private bool IsActive(string path)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);

        var cut = relative.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0) relative = relative[..cut];

        relative = relative.Trim('/');
        var target = path.Trim('/');

        return relative.Equals(target, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsGroupActive(MenuGroup group)
        => group.Items.Any(i => IsActive(i.Path));

    // ============================================================
    //  UI
    // ============================================================
    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private void CloseMenu() => isMenuOpen = false;

    private void GoToProfile() => Navigation.NavigateTo("/Admin/Profile", true);
}