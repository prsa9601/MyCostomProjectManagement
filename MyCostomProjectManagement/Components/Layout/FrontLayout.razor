@code {

    /* ============================================================
       STATE
    ============================================================ */

    private bool isMenuOpen = false;

    private bool _hasAdminAccess = false;
    private bool UserIsAuthenticate = false;


    /* ============================================================
       LIFECYCLE
    ============================================================ */

    protected override async Task OnInitializedAsync()
    {
        await GetUserPermission(Permissions.AccessToAdminPanel);
        await GetUser();
    }


    /* ============================================================
       PERMISSION & AUTH
    ============================================================ */

    private async Task GetUserPermission(Permissions permissions)
    {
        try
        {
            _hasAdminAccess = await _getUserPermission.CheckAccess(permissions);
        }
        catch
        {
            _hasAdminAccess = false;
        }
    }


    private async Task GetUser()
    {
        try
        {
            Guid userId = await _userAuthentication.GetCurrentUserId();

            if (userId == Guid.Empty)
            {
                UserIsAuthenticate = false;
                return;
            }

            var user = await _userFacade.GetId(userId);
            UserIsAuthenticate = user != null;
        }
        catch
        {
            UserIsAuthenticate = false;
        }
    }


    /* ============================================================
       NAVIGATION
    ============================================================ */

    private void NavigateToDashboard()
        => Navigation.NavigateTo("/Dashboard", true);


    private void NavigateToAdminDashboard()
        => Navigation.NavigateTo("/Admin", true);


    private void NavigateToLogin()
        => Navigation.NavigateTo("/Auth", true);


    private void Logout()
        => Navigation.NavigateTo("/Auth/Logout", true);


    /* ============================================================
       MENU
    ============================================================ */

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }


    private void CloseMenu()
    {
        isMenuOpen = false;
    }


    /* ============================================================
       JAVASCRIPT (Navbar Scroll Effect)
    ============================================================ */

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "eval",
                    @"
                        (() => {

                            const navbar = document.getElementById('frontNavbar');

                            if (!navbar)
                                return;

                            const updateNavbar = () => {
                                navbar.classList.toggle(
                                    'scrolled',
                                    window.scrollY > 35
                                );
                            };

                            updateNavbar();

                            window.addEventListener(
                                'scroll',
                                updateNavbar,
                                { passive: true }
                            );

                        })();
                    "
                );
            }
            catch
            {
                // اگر JS در دسترس نبود، خطا را نادیده بگیر
            }
        }
    }

}