@page "/Upgrade"
@layout FrontLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>سیستم در حال ارتقا | محمد رضایی</title>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>

    /* ============================================================
           PAGE RESET
        ============================================================ */

    .upgrade-page,
    .upgrade-page *,
    .upgrade-page *::before,
    .upgrade-page *::after {
        box-sizing: border-box;
    }

    .upgrade-page {
        width: 100%;
        min-height: calc(100vh - 140px);
        padding: 110px 20px 50px;
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        direction: rtl;
        overflow: hidden;
    }


    /* ============================================================
           MAIN CONTAINER
        ============================================================ */

    .upgrade-container {
        width: 100%;
        max-width: 920px;
        margin: 0 auto;
        position: relative;
        z-index: 3;
    }


    /* ============================================================
           BACKGROUND GLOW
        ============================================================ */

    .upgrade-page::before,
    .upgrade-page::after {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(100px);
        opacity: 0.08;
        z-index: 0;
    }

    .upgrade-page::before {
        top: 5%;
        right: -180px;
        background: #3b82f6;
    }

    .upgrade-page::after {
        bottom: 5%;
        left: -180px;
        background: #8b5cf6;
    }


    /* ============================================================
           PARTICLES
        ============================================================ */

    .upgrade-particles {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

        .upgrade-particles span {
            position: absolute;
            display: block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(59, 130, 246, 0.2);
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
            animation: upgradeFloatParticle 12s infinite alternate ease-in-out;
        }

            .upgrade-particles span:nth-child(1) {
                top: 10%;
                left: 20%;
                width: 8px;
                height: 8px;
                animation-duration: 14s;
            }

            .upgrade-particles span:nth-child(2) {
                top: 60%;
                left: 80%;
                animation-duration: 16s;
                animation-delay: 2s;
            }

            .upgrade-particles span:nth-child(3) {
                top: 30%;
                left: 70%;
                width: 10px;
                height: 10px;
                animation-duration: 18s;
                animation-delay: 4s;
            }

            .upgrade-particles span:nth-child(4) {
                top: 80%;
                left: 10%;
                animation-duration: 15s;
                animation-delay: 1s;
            }

            .upgrade-particles span:nth-child(5) {
                top: 50%;
                left: 40%;
                width: 12px;
                height: 12px;
                background: rgba(59, 130, 246, 0.12);
                animation-duration: 20s;
                animation-delay: 3s;
            }

            .upgrade-particles span:nth-child(6) {
                top: 15%;
                left: 90%;
                animation-duration: 13s;
                animation-delay: 5s;
            }

            .upgrade-particles span:nth-child(7) {
                top: 70%;
                left: 50%;
                width: 7px;
                height: 7px;
                animation-duration: 17s;
                animation-delay: 2s;
            }

            .upgrade-particles span:nth-child(8) {
                top: 40%;
                left: 5%;
                animation-duration: 19s;
                animation-delay: 3s;
            }

    @@keyframes upgradeFloatParticle {

        0% {
            transform: translate(0, 0) scale(1);
            opacity: 0.2;
        }

        50% {
            transform: translate(30px, -60px) scale(1.6);
            opacity: 0.7;
        }

        100% {
            transform: translate(-20px, 40px) scale(0.8);
            opacity: 0.1;
        }
    }


    /* ============================================================
           GLASS CARD
        ============================================================ */

    .upgrade-glass-card {
        width: 100%;
        position: relative;
        overflow: hidden;
        background: linear-gradient( 145deg, rgba(255,255,255,0.065), rgba(255,255,255,0.018) );
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.075);
        border-radius: 28px;
        padding: 52px 48px;
        text-align: center;
        box-shadow: 0 20px 80px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.035);
        transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }

        .upgrade-glass-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 12%;
            right: 12%;
            height: 1px;
            background: linear-gradient( 90deg, transparent, rgba(59,130,246,0.5), transparent );
        }

        .upgrade-glass-card:hover {
            border-color: rgba(59,130,246,0.13);
            box-shadow: 0 25px 100px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.045);
        }


    /* ============================================================
           ICON
        ============================================================ */

    .upgrade-icon {
        width: 100%;
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8a838;
        margin-bottom: 18px;
        animation: upgradePulse 2s ease-in-out infinite;
        text-shadow: 0 0 40px rgba(232,168,56,0.12);
    }

        .upgrade-icon .fa-rocket {
            font-size: clamp(3.2rem, 8vw, 5rem);
        }

        .upgrade-icon .fa-sync-alt {
            font-size: clamp(1.7rem, 5vw, 2.8rem);
            margin-right: -7px;
            display: inline-block;
            animation: upgradeSpin 4s linear infinite;
        }

    @@keyframes upgradePulse {

        0%,
        100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.07);
        }
    }

    @@keyframes upgradeSpin {

        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }


    /* ============================================================
           TYPOGRAPHY
        ============================================================ */

    .upgrade-title {
        width: 100%;
        font-size: clamp( 1.8rem, 5vw, 2.5rem );
        font-weight: 800;
        line-height: 1.45;
        color: #ffffff;
        margin: 0 0 10px;
        letter-spacing: -0.5px;
        overflow-wrap: anywhere;
    }

        .upgrade-title span {
            color: #3b82f6;
            text-shadow: 0 0 30px rgba(59,130,246,0.18);
        }

    .upgrade-subtitle {
        width: 100%;
        font-size: clamp( 0.9rem, 2.5vw, 1.1rem );
        color: #94a3b8;
        margin: 0 0 14px;
        line-height: 1.9;
    }

        .upgrade-subtitle i {
            margin-left: 5px;
        }

    .upgrade-description {
        width: 100%;
        max-width: 620px;
        margin: 0 auto 32px;
        font-size: clamp( 0.86rem, 2.2vw, 1rem );
        color: #b8c4d6;
        line-height: 2.05;
        text-align: center;
    }


    /* ============================================================
           PROGRESS
        ============================================================ */

    .upgrade-progress {
        width: 100%;
        max-width: 560px;
        margin: 0 auto 32px;
    }

    .upgrade-progress-label {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 9px;
        color: #94a3b8;
        font-size: 0.8rem;
    }

        .upgrade-progress-label span:last-child {
            color: #e8a838;
            font-weight: 700;
        }

    .upgrade-progress-bar {
        width: 100%;
        height: 7px;
        background: rgba(255,255,255,0.045);
        border-radius: 999px;
        overflow: hidden;
    }

    .upgrade-progress-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient( 90deg, #3b82f6, #8b5cf6, #e8a838 );
        background-size: 200% 100%;
        animation: upgradeProgressShimmer 3s ease-in-out infinite;
        transition: width 1.2s cubic-bezier(0.2,0.9,0.3,1);
    }

    @@keyframes upgradeProgressShimmer {

        0% {
            background-position: 0% 0;
        }

        100% {
            background-position: 200% 0;
        }
    }


    /* ============================================================
           TIMER
        ============================================================ */

    .upgrade-timer {
        width: 100%;
        max-width: 430px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin: 0 auto 34px;
    }

    .upgrade-timer-item {
        min-width: 0;
        padding: 17px 10px;
        background: rgba(255,255,255,0.025);
        border: 1px solid rgba(255,255,255,0.055);
        border-radius: 16px;
        text-align: center;
        transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    }

        .upgrade-timer-item:hover {
            border-color: rgba(59,130,246,0.15);
            background: rgba(59,130,246,0.035);
            transform: translateY(-3px);
        }

    .upgrade-timer-number {
        display: block;
        font-size: clamp( 1.5rem, 5vw, 2.2rem );
        font-weight: 700;
        color: #3b82f6;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }

    .upgrade-timer-label {
        display: block;
        margin-top: 5px;
        color: #94a3b8;
        font-size: clamp( 0.62rem, 2vw, 0.7rem );
        white-space: nowrap;
    }


    /* ============================================================
           FEATURES
        ============================================================ */

    .upgrade-features {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 34px;
    }

    .upgrade-feature {
        min-width: 0;
        padding: 18px 10px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.045);
        border-radius: 14px;
        opacity: 0.68;
        filter: grayscale(0.45);
        transition: opacity 0.3s ease, filter 0.3s ease, transform 0.3s ease, background 0.3s ease, border-color 0.3s ease;
    }

        .upgrade-feature:hover {
            opacity: 1;
            filter: grayscale(0);
            transform: translateY(-4px);
            background: rgba(59,130,246,0.035);
            border-color: rgba(59,130,246,0.15);
        }

        .upgrade-feature i {
            display: block;
            margin-bottom: 8px;
            color: #3b82f6;
            font-size: clamp( 1.2rem, 4vw, 1.6rem );
            opacity: 0.6;
        }

    .upgrade-feature-label {
        display: block;
        color: #94a3b8;
        font-size: clamp( 0.68rem, 2vw, 0.75rem );
        white-space: nowrap;
    }

        .upgrade-feature-label .highlight {
            color: #e8a838;
        }


    /* ============================================================
           ACTIONS
        ============================================================ */

    .upgrade-actions {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .upgrade-btn-notify,
    .upgrade-btn-back {
        min-height: 48px;
        border-radius: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: inherit;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, border-color 0.3s ease;
    }

    .upgrade-btn-notify {
        min-width: 210px;
        padding: 12px 32px;
        border: none;
        background: linear-gradient( 135deg, #3b82f6, #2563eb );
        color: #fff;
        font-size: 0.95rem;
        font-weight: 600;
        box-shadow: 0 4px 24px rgba(59,130,246,0.12);
    }

        .upgrade-btn-notify:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 40px rgba(59,130,246,0.25);
        }

        .upgrade-btn-notify:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none !important;
        }

        .upgrade-btn-notify p {
            margin: 0;
        }

    .upgrade-btn-back {
        min-width: 210px;
        padding: 10px 28px;
        border: 1px solid rgba(255,255,255,0.08);
        background: transparent;
        color: #94a3b8;
        font-size: 0.85rem;
        font-weight: 500;
    }

        .upgrade-btn-back:hover {
            border-color: rgba(59,130,246,0.15);
            color: #eef2f8;
            background: rgba(255,255,255,0.025);
            transform: translateY(-2px);
        }


    /* ============================================================
           RIPPLE
        ============================================================ */

    .upgrade-ripple {
        position: relative;
        overflow: hidden;
        isolation: isolate;
    }

    .upgrade-ripple-effect {
        position: absolute;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.16);
        transform: scale(0);
        animation: upgradeRipple 0.6s linear;
        pointer-events: none;
        z-index: 5;
    }

    @@keyframes upgradeRipple {

        to {
            transform: scale(4);
            opacity: 0;
        }
    }


    /* ============================================================
           TOAST
        ============================================================ */

    .upgrade-toast {
        position: fixed;
        left: 50%;
        bottom: max( 20px, env(safe-area-inset-bottom) );
        transform: translateX(-50%) translateY(120px);
        width: min( calc(100% - 32px), 420px );
        min-height: 50px;
        padding: 13px 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-align: center;
        color: #34d399;
        font-size: 0.85rem;
        font-weight: 500;
        background: rgba(10,14,23,0.94);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(52,211,153,0.1);
        border-radius: 16px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.4);
        z-index: 99999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2,0.9,0.3,1);
    }

        .upgrade-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .upgrade-toast i {
            flex-shrink: 0;
            font-size: 1.1rem;
        }


    /* ============================================================
           LARGE TABLET
        ============================================================ */

    @@media (max-width: 1000px) {

        .upgrade-page {
            padding-left: 18px;
            padding-right: 18px;
        }

        .upgrade-glass-card {
            padding: 46px 36px;
        }

        .upgrade-features {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    /* ============================================================
           TABLET
        ============================================================ */

    @@media (max-width: 768px) {

        .upgrade-page {
            min-height: auto;
            padding: 105px 14px 45px;
            align-items: flex-start;
        }

        .upgrade-container {
            max-width: 680px;
        }

        .upgrade-glass-card {
            padding: 40px 28px;
            border-radius: 24px;
        }

        .upgrade-title {
            font-size: clamp( 1.65rem, 6vw, 2.2rem );
        }

        .upgrade-description {
            max-width: 560px;
        }

        .upgrade-features {
            gap: 10px;
        }

        .upgrade-feature {
            padding: 16px 8px;
        }
    }


    /* ============================================================
           MOBILE
        ============================================================ */

    @@media (max-width: 600px) {

        .upgrade-page {
            padding: 92px 10px 32px;
        }

        .upgrade-container {
            width: 100%;
        }

        .upgrade-glass-card {
            padding: 34px 18px 28px;
            border-radius: 21px;
        }

        .upgrade-icon {
            min-height: 68px;
            margin-bottom: 13px;
        }

            .upgrade-icon .fa-rocket {
                font-size: clamp( 2.8rem, 14vw, 4rem );
            }

            .upgrade-icon .fa-sync-alt {
                font-size: clamp( 1.5rem, 7vw, 2.2rem );
                margin-right: -5px;
            }

        .upgrade-title {
            font-size: clamp( 1.45rem, 7vw, 1.9rem );
            line-height: 1.6;
        }

        .upgrade-subtitle {
            font-size: 0.86rem;
            line-height: 1.9;
        }

        .upgrade-description {
            font-size: 0.82rem;
            line-height: 2;
            margin-bottom: 25px;
        }

        .upgrade-progress {
            margin-bottom: 26px;
        }

        .upgrade-progress-label {
            font-size: 0.7rem;
        }

        .upgrade-progress-bar {
            height: 6px;
        }

        .upgrade-timer {
            max-width: 100%;
            gap: 8px;
            margin-bottom: 26px;
        }

        .upgrade-timer-item {
            padding: 13px 6px;
            border-radius: 13px;
        }

        .upgrade-timer-number {
            font-size: clamp( 1.3rem, 7vw, 1.8rem );
        }

        .upgrade-timer-label {
            font-size: 0.58rem;
        }

        .upgrade-features {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 9px;
            margin-bottom: 26px;
        }

        .upgrade-feature {
            padding: 14px 6px;
            border-radius: 12px;
        }

            .upgrade-feature i {
                font-size: 1.15rem;
                margin-bottom: 5px;
            }

        .upgrade-feature-label {
            font-size: 0.64rem;
        }

        .upgrade-btn-notify,
        .upgrade-btn-back {
            width: 100%;
            min-width: 0;
            min-height: 49px;
            padding: 12px 18px;
            font-size: 0.82rem;
        }

        .upgrade-toast {
            width: calc(100% - 24px);
            font-size: 0.78rem;
            padding: 12px 14px;
        }
    }


    /* ============================================================
           SMALL MOBILE
        ============================================================ */

    @@media (max-width: 420px) {

        .upgrade-page {
            padding: 88px 7px 25px;
        }

        .upgrade-glass-card {
            padding: 28px 13px 23px;
            border-radius: 19px;
        }

        .upgrade-title {
            font-size: 1.35rem;
            line-height: 1.65;
        }

        .upgrade-subtitle {
            font-size: 0.77rem;
        }

        .upgrade-description {
            font-size: 0.75rem;
            line-height: 1.95;
            margin-bottom: 22px;
        }

        .upgrade-progress-label {
            font-size: 0.65rem;
        }

        .upgrade-timer {
            gap: 6px;
        }

        .upgrade-timer-item {
            padding: 10px 4px;
            border-radius: 11px;
        }

        .upgrade-timer-number {
            font-size: 1.2rem;
        }

        .upgrade-timer-label {
            font-size: 0.52rem;
        }

        .upgrade-features {
            gap: 7px;
        }

        .upgrade-feature {
            padding: 11px 5px;
        }

            .upgrade-feature i {
                font-size: 1rem;
            }

        .upgrade-feature-label {
            font-size: 0.56rem;
        }

        .upgrade-btn-notify,
        .upgrade-btn-back {
            min-height: 46px;
            font-size: 0.76rem;
        }
    }


    /* ============================================================
           VERY SMALL DEVICES
        ============================================================ */

    @@media (max-width: 340px) {

        .upgrade-page {
            padding: 84px 5px 20px;
        }

        .upgrade-glass-card {
            padding: 24px 9px 20px;
            border-radius: 17px;
        }

        .upgrade-title {
            font-size: 1.18rem;
        }

        .upgrade-subtitle {
            font-size: 0.68rem;
        }

        .upgrade-description {
            font-size: 0.68rem;
        }

        .upgrade-timer-number {
            font-size: 1.05rem;
        }

        .upgrade-timer-label {
            font-size: 0.48rem;
        }

        .upgrade-feature-label {
            font-size: 0.51rem;
        }

        .upgrade-btn-notify,
        .upgrade-btn-back {
            font-size: 0.7rem;
            gap: 6px;
        }
    }


    /* ============================================================
           LANDSCAPE MOBILE
        ============================================================ */

    @@media (max-height: 650px) and (max-width: 900px) {

        .upgrade-page {
            padding-top: 88px;
            padding-bottom: 25px;
            align-items: flex-start;
        }

        .upgrade-glass-card {
            padding-top: 28px;
            padding-bottom: 24px;
        }

        .upgrade-icon {
            min-height: 60px;
            margin-bottom: 9px;
        }

        .upgrade-description {
            margin-bottom: 20px;
        }

        .upgrade-progress {
            margin-bottom: 20px;
        }

        .upgrade-timer {
            margin-bottom: 20px;
        }

        .upgrade-features {
            margin-bottom: 20px;
        }
    }


    /* ============================================================
           REDUCED MOTION
        ============================================================ */

    @@media (prefers-reduced-motion: reduce) {

        .upgrade-page *,
        .upgrade-page *::before,
        .upgrade-page *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
    }

</style>


<!-- ============================================================
     PARTICLES
============================================================ -->

<div class="upgrade-particles">

    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>

</div>


<!-- ============================================================
     TOAST
============================================================ -->

<div class="upgrade-toast @(showToast ? "show" : "")">

    <i class="fas fa-check-circle"></i>

    <span>
        @toastText
    </span>

</div>


<!-- ============================================================
     MAIN PAGE
============================================================ -->

<section class="upgrade-page">

    <div class="upgrade-container">

        <div class="upgrade-glass-card">


            <!-- ====================================================
                 ICON
            ===================================================== -->

            <div class="upgrade-icon">

                <i class="fas fa-rocket"></i>

                <i class="fas fa-sync-alt"></i>

            </div>


            <!-- ====================================================
                 TITLE
            ===================================================== -->

            <h1 class="upgrade-title">

                سیستم در حال
                <span>ارتقا</span>

            </h1>


            <!-- ====================================================
                 SUBTITLE
            ===================================================== -->

            <p class="upgrade-subtitle">

                <i class="fas fa-code"
                   style="color:#3b82f6;">
                </i>

                در حال اعمال به‌روزرسانی‌های جدید

            </p>


            <!-- ====================================================
                 DESCRIPTION
            ===================================================== -->

            <p class="upgrade-description">

                ما در حال ارتقا و بهبود سیستم هستیم تا تجربه‌ای بهتر
                و امکاناتی جدید را به شما ارائه دهیم.
                لطفاً شکیبا باشید و پس از اتمام، از نسخه جدید استفاده کنید.

            </p>


            <!-- ====================================================
                 PROGRESS
            ===================================================== -->

            <div class="upgrade-progress">

                <div class="upgrade-progress-label">

                    <span>
                        پیشرفت ارتقا
                    </span>

                    <span>
                        @progressPercent%
                    </span>

                </div>

                <div class="upgrade-progress-bar">

                    <div class="upgrade-progress-fill"
                         style="width:@(progressPercent)%;">
                    </div>

                </div>

            </div>


            <!-- ====================================================
                 TIMER
            ===================================================== -->

            <div class="upgrade-timer">

                <div class="upgrade-timer-item">

                    <span class="upgrade-timer-number">
                        @hours.ToString("00")
                    </span>

                    <span class="upgrade-timer-label">
                        ساعت
                    </span>

                </div>


                <div class="upgrade-timer-item">

                    <span class="upgrade-timer-number">
                        @minutes.ToString("00")
                    </span>

                    <span class="upgrade-timer-label">
                        دقیقه
                    </span>

                </div>


                <div class="upgrade-timer-item">

                    <span class="upgrade-timer-number">
                        @seconds.ToString("00")
                    </span>

                    <span class="upgrade-timer-label">
                        ثانیه
                    </span>

                </div>

            </div>


            <!-- ====================================================
                 FEATURES
            ===================================================== -->

            <div class="upgrade-features">

                <div class="upgrade-feature">

                    <i class="fas fa-bolt"></i>

                    <span class="upgrade-feature-label">

                        سرعت

                        <span class="highlight">
                            بالاتر
                        </span>

                    </span>

                </div>


                <div class="upgrade-feature">

                    <i class="fas fa-shield-alt"></i>

                    <span class="upgrade-feature-label">

                        امنیت

                        <span class="highlight">
                            بهتر
                        </span>

                    </span>

                </div>


                <div class="upgrade-feature">

                    <i class="fas fa-palette"></i>

                    <span class="upgrade-feature-label">

                        طراحی

                        <span class="highlight">
                            جدید
                        </span>

                    </span>

                </div>


                <div class="upgrade-feature">

                    <i class="fas fa-cogs"></i>

                    <span class="upgrade-feature-label">

                        امکانات

                        <span class="highlight">
                            پیشرفته
                        </span>

                    </span>

                </div>

            </div>


            <!-- ====================================================
                 ACTIONS
            ===================================================== -->

            <div class="upgrade-actions">

                <button type="button"
                        class="upgrade-btn-notify upgrade-ripple"
                        @onclick="NotifyMe"
                        disabled="@isLoading">

                    @if (isLoading)
                    {
                        <i class="fas fa-spinner fa-spin"></i>

                        <p>
                            در حال ارسال...
                        </p>
                    }
                    else
                    {
                        <span>

                            <i class="fas fa-bell"></i>

                            به من اطلاع بده

                        </span>
                    }

                </button>


                <a href="/"
                   class="upgrade-btn-back upgrade-ripple">

                    <i class="fas fa-arrow-right"></i>

                    بازگشت به صفحه اصلی

                </a>

            </div>

        </div>

    </div>

</section>


@code {

    /* ============================================================
       STATE
    ============================================================ */

    private int progressPercent = 68;

    private bool isLoading = false;

    private bool showToast = false;

    private string toastText =
        "با موفقیت ثبت شد!";


    /* ============================================================
       TIMER
    ============================================================ */

    private int hours = 3;

    private int minutes = 45;

    private int seconds = 20;

    private System.Timers.Timer? countdownTimer;


    /* ============================================================
       INITIALIZATION
    ============================================================ */

    protected override void OnInitialized()
    {
        StartCountdown();
    }


    /* ============================================================
       COUNTDOWN
    ============================================================ */

    private void StartCountdown()
    {
        countdownTimer =
            new System.Timers.Timer(1000);

        countdownTimer.AutoReset = true;

        countdownTimer.Elapsed += async (sender, e) =>
        {
            if (seconds > 0)
            {
                seconds--;
            }
            else if (minutes > 0)
            {
                minutes--;
                seconds = 59;
            }
            else if (hours > 0)
            {
                hours--;
                minutes = 59;
                seconds = 59;
            }
            else
            {
                countdownTimer?.Stop();

                progressPercent = 100;

                await InvokeAsync(
                    StateHasChanged
                );

                return;
            }


            /* ====================================================
               PROGRESS CALCULATION
            ==================================================== */

            const int totalSeconds =
                3 * 3600;

            var remainingSeconds =
                hours * 3600
                + minutes * 60
                + seconds;

            var elapsed =
                totalSeconds - remainingSeconds;

            var progress =
                (int)
                (
                    elapsed /
                    (double)totalSeconds *
                    100
                );

            progressPercent =
                Math.Min(
                    Math.Max(progress, 0),
                    99
                );


            await InvokeAsync(
                StateHasChanged
            );
        };

        countdownTimer.Start();
    }


    /* ============================================================
       NOTIFY
    ============================================================ */

    private async Task NotifyMe()
    {
        if (isLoading)
            return;

        isLoading = true;

        StateHasChanged();


        /*
         * Simulated API call
         */

        await Task.Delay(1500);


        toastText =
            "شما در لیست اطلاع‌رسانی ثبت شدید!";

        showToast = true;

        StateHasChanged();


        await Task.Delay(3000);


        showToast = false;

        isLoading = false;

        StateHasChanged();
    }


    /* ============================================================
       JS INTEROP
    ============================================================ */

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        await InitializeJsInterop();
    }


    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync(
            "eval",
            @"
                (() => {

                    document
                        .querySelectorAll('.upgrade-ripple')
                        .forEach(btn => {

                            if (btn.dataset.rippleInitialized === 'true')
                                return;

                            btn.dataset.rippleInitialized = 'true';

                            btn.addEventListener(
                                'click',
                                function(e) {

                                    const rect =
                                        this.getBoundingClientRect();

                                    const x =
                                        e.clientX - rect.left;

                                    const y =
                                        e.clientY - rect.top;

                                    const ripple =
                                        document.createElement('span');

                                    ripple.className =
                                        'upgrade-ripple-effect';

                                    ripple.style.left =
                                        (x - 20) + 'px';

                                    ripple.style.top =
                                        (y - 20) + 'px';

                                    this.appendChild(ripple);

                                    setTimeout(
                                        () => ripple.remove(),
                                        600
                                    );
                                }
                            );
                        });


                    /*
                     * Initial progress animation
                     */

                    setTimeout(() => {

                        const fill =
                            document.querySelector(
                                '.upgrade-progress-fill'
                            );

                        if (!fill)
                            return;

                        const width =
                            fill.style.width;

                        fill.style.width = '0%';

                        requestAnimationFrame(() => {

                            setTimeout(() => {

                                fill.style.width =
                                    width || '68%';

                            }, 100);

                        });

                    }, 300);

                })();
            "
        );
    }


    /* ============================================================
       DISPOSE
    ============================================================ */

    public void Dispose()
    {
        countdownTimer?.Stop();

        countdownTimer?.Dispose();

        countdownTimer = null;
    }

}
