@page "/Upgrade"
@layout FrontLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>سیستم در حال ارتقا | محمد رضایی</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
       UPGRADE PAGE - با پس‌زمینه #0a0e17
    ============================================================ */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
       PARTICLES BACKGROUND
    ============================================================ */
    .bg-particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .bg-particles span {
        position: absolute;
        display: block;
        width: 6px;
        height: 6px;
        background: rgba(59, 130, 246, 0.2);
        border-radius: 50%;
        animation: floatParticle 12s infinite alternate ease-in-out;
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
    }

    .bg-particles span:nth-child(1) {
        top: 10%;
        left: 20%;
        animation-duration: 14s;
        width: 8px;
        height: 8px;
    }
    .bg-particles span:nth-child(2) {
        top: 60%;
        left: 80%;
        animation-duration: 16s;
        animation-delay: 2s;
    }
    .bg-particles span:nth-child(3) {
        top: 30%;
        left: 70%;
        animation-duration: 18s;
        animation-delay: 4s;
        width: 10px;
        height: 10px;
    }
    .bg-particles span:nth-child(4) {
        top: 80%;
        left: 10%;
        animation-duration: 15s;
        animation-delay: 1s;
    }
    .bg-particles span:nth-child(5) {
        top: 50%;
        left: 40%;
        animation-duration: 20s;
        animation-delay: 3s;
        width: 12px;
        height: 12px;
        background: rgba(59, 130, 246, 0.12);
    }
    .bg-particles span:nth-child(6) {
        top: 15%;
        left: 90%;
        animation-duration: 13s;
        animation-delay: 5s;
    }
    .bg-particles span:nth-child(7) {
        top: 70%;
        left: 50%;
        animation-duration: 17s;
        animation-delay: 2s;
        width: 7px;
        height: 7px;
    }
    .bg-particles span:nth-child(8) {
        top: 40%;
        left: 5%;
        animation-duration: 19s;
        animation-delay: 3s;
    }

    @@keyframes floatParticle {
        0% { transform: translate(0, 0) scale(1); opacity: 0.2; }
        50% { transform: translate(30px, -60px) scale(1.6); opacity: 0.7; }
        100% { transform: translate(-20px, 40px) scale(0.8); opacity: 0.1; }
    }

    /* ============================================================
       GLASS CARD
    ============================================================ */
    .glass-card {
        background: rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 8px 48px rgba(0, 0, 0, 0.4);
        border-radius: 28px;
        padding: 48px 40px;
        transition: all 0.3s ease;
        text-align: center;
    }

    .glass-card:hover {
        border-color: rgba(59, 130, 246, 0.08);
        box-shadow: 0 8px 64px rgba(0, 0, 0, 0.5);
    }

    /* ============================================================
       ICON & ANIMATION
    ============================================================ */
    .upgrade-icon {
        font-size: 5rem;
        color: #e8a838;
        display: block;
        margin-bottom: 16px;
        animation: pulse 2s ease-in-out infinite;
        text-shadow: 0 0 60px rgba(232, 168, 56, 0.1);
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.08); }
    }

    .upgrade-icon .fa-sync-alt {
        animation: spin 4s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }

    .title span {
        color: #3b82f6;
        text-shadow: 0 0 30px rgba(59, 130, 246, 0.15);
    }

    .subtitle {
        font-size: 1.1rem;
        color: #94a3b8;
        margin-bottom: 12px;
    }

    .description {
        font-size: 1rem;
        color: #b8c4d6;
        max-width: 580px;
        margin: 0 auto 28px;
        line-height: 1.8;
    }

    /* ============================================================
       PROGRESS BAR
    ============================================================ */
    .progress-container {
        max-width: 500px;
        margin: 0 auto 32px;
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: #94a3b8;
        margin-bottom: 6px;
    }

    .progress-bar {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar .fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6, #e8a838);
        background-size: 200% 100%;
        animation: shimmerProgress 3s ease-in-out infinite;
        transition: width 1.2s cubic-bezier(0.2, 0.9, 0.3, 1);
        width: 0%;
    }

    @@keyframes shimmerProgress {
        0% { background-position: 0% 0%; }
        100% { background-position: 200% 0%; }
    }

    /* ============================================================
       FEATURES / UPGRADE ITEMS
    ============================================================ */
    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .feature-item {
        padding: 16px 12px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 14px;
        transition: all 0.3s ease;
        opacity: 0.5;
        filter: grayscale(0.5);
    }

    .feature-item:hover {
        opacity: 0.7;
        border-color: rgba(59, 130, 246, 0.06);
        transform: translateY(-3px);
    }

    .feature-item i {
        font-size: 1.6rem;
        color: #3b82f6;
        display: block;
        margin-bottom: 6px;
        opacity: 0.3;
    }

    .feature-item .label {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .feature-item .label .highlight {
        color: #e8a838;
    }

    /* ============================================================
       COUNTDOWN / TIMER
    ============================================================ */
    .timer-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 32px;
        flex-wrap: wrap;
    }

    .timer-item {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        padding: 16px 24px;
        min-width: 70px;
        text-align: center;
        transition: 0.3s;
    }

    .timer-item:hover {
        border-color: rgba(59, 130, 246, 0.06);
        transform: translateY(-2px);
    }

    .timer-item .number {
        font-size: 2.2rem;
        font-weight: 700;
        color: #3b82f6;
        display: block;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }

    .timer-item .label {
        font-size: 0.7rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ============================================================
       BUTTONS
    ============================================================ */
    .btn-notify {
        padding: 12px 36px;
        border-radius: 40px;
        border: none;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 24px rgba(59, 130, 246, 0.12);
        font-family: inherit;
        margin-bottom: 16px;
    }

    .btn-notify:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 40px rgba(59, 130, 246, 0.2);
    }

    .btn-notify:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none !important;
    }

    .btn-outline-light {
        padding: 10px 28px;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: transparent;
        color: #94a3b8;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: inherit;
        text-decoration: none;
    }

    .btn-outline-light:hover {
        border-color: rgba(59, 130, 246, 0.1);
        color: #eef2f8;
        background: rgba(255, 255, 255, 0.02);
        transform: translateY(-2px);
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @@media (max-width: 768px) {
        .glass-card {
            padding: 32px 20px;
            border-radius: 20px;
        }

        .title {
            font-size: 1.8rem;
        }

        .upgrade-icon {
            font-size: 3.6rem;
        }

        .features-grid {
            grid-template-columns: 1fr 1fr;
        }

        .description {
            font-size: 0.9rem;
        }

        .timer-container {
            gap: 12px;
        }

        .timer-item {
            padding: 12px 16px;
            min-width: 60px;
        }

        .timer-item .number {
            font-size: 1.6rem;
        }
    }

    @@media (max-width: 480px) {
        .glass-card {
            padding: 24px 16px;
        }

        .title {
            font-size: 1.5rem;
        }

        .upgrade-icon {
            font-size: 3rem;
        }

        .features-grid {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .feature-item {
            padding: 12px 10px;
        }

        .feature-item i {
            font-size: 1.2rem;
        }

        .feature-item .label {
            font-size: 0.65rem;
        }

        .btn-notify {
            width: 100%;
            justify-content: center;
        }

        .btn-outline-light {
            width: 100%;
            justify-content: center;
        }

        .progress-label {
            font-size: 0.7rem;
        }

        .timer-item {
            padding: 10px 12px;
            min-width: 50px;
        }

        .timer-item .number {
            font-size: 1.3rem;
        }

        .timer-item .label {
            font-size: 0.6rem;
        }
    }

    /* ============================================================
       TOAST MESSAGE
    ============================================================ */
    .toast-message {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(100px);
        background: rgba(10, 14, 23, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(52, 211, 153, 0.08);
        padding: 14px 28px;
        border-radius: 16px;
        color: #34d399;
        font-size: 0.9rem;
        font-weight: 500;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
        z-index: 9999;
        transition: all 0.5s cubic-bezier(0.2, 0.9, 0.3, 1);
        opacity: 0;
        pointer-events: none;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .toast-message.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
        pointer-events: auto;
    }

    .toast-message i {
        font-size: 1.2rem;
    }

    /* ============================================================
       RIPPLE
    ============================================================ */
    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to { transform: scale(4); opacity: 0; }
    }
</style>

<!-- ===== PARTICLES ===== -->
<div class="bg-particles">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
</div>

<!-- ===== TOAST ===== -->
<div class="toast-message @(showToast ? "show" : "")" id="toast">
    <i class="fas fa-check-circle"></i>
    <span>@toastText</span>
</div>

<!-- ===== MAIN CONTENT ===== -->
<div class="container">
    <div class="glass-card">

        <!-- Icon -->
        <span class="upgrade-icon">
            <i class="fas fa-rocket"></i>
            <i class="fas fa-sync-alt" style="font-size:2.8rem; margin-left:-6px; display:inline-block;"></i>
        </span>

        <!-- Title -->
        <h1 class="title">
            سیستم در حال <span>ارتقا</span>
        </h1>

        <p class="subtitle">
            <i class="fas fa-code" style="color:#3b82f6;"></i>
            در حال اعمال به‌روزرسانی‌های جدید
        </p>

        <p class="description">
            ما در حال ارتقا و بهبود سیستم هستیم تا تجربه‌ای بهتر و امکاناتی جدید را
            به شما ارائه دهیم. لطفاً شکیبا باشید و پس از اتمام، از نسخه جدید استفاده کنید.
        </p>

        <!-- Progress -->
        <div class="progress-container">
            <div class="progress-label">
                <span>پیشرفت ارتقا</span>
                <span>@progressPercent%</span>
            </div>
            <div class="progress-bar">
                <div class="fill" style="width:@(progressPercent)%;"></div>
            </div>
        </div>

        <!-- Timer / Countdown -->
        <div class="timer-container">
            <div class="timer-item">
                <span class="number" id="hours">@hours</span>
                <span class="label">ساعت</span>
            </div>
            <div class="timer-item">
                <span class="number" id="minutes">@minutes</span>
                <span class="label">دقیقه</span>
            </div>
            <div class="timer-item">
                <span class="number" id="seconds">@seconds</span>
                <span class="label">ثانیه</span>
            </div>
        </div>

        <!-- Features (placeholder) -->
        <div class="features-grid">
            <div class="feature-item">
                <i class="fas fa-bolt"></i>
                <span class="label">سرعت <span class="highlight">بالاتر</span></span>
            </div>
            <div class="feature-item">
                <i class="fas fa-shield-alt"></i>
                <span class="label">امنیت <span class="highlight">بهتر</span></span>
            </div>
            <div class="feature-item">
                <i class="fas fa-palette"></i>
                <span class="label">طراحی <span class="highlight">جدید</span></span>
            </div>
            <div class="feature-item">
                <i class="fas fa-cogs"></i>
                <span class="label">امکانات <span class="highlight">پیشرفته</span></span>
            </div>
        </div>

        <!-- Actions -->
        <button class="btn-notify ripple" @onclick="NotifyMe" disabled="@isLoading">
            @if (isLoading)
            {
                <i class="fas fa-spinner fa-spin"></i>
                <p>در حال ارسال...</p>
            }
            else
            {
                <span><i class="fas fa-bell"></i> به من اطلاع بده</span>
            }
        </button>

        <div>
            <a href="/" class="btn-outline-light">
                <i class="fas fa-arrow-right"></i> بازگشت به صفحه اصلی
            </a>
        </div>

    </div>
</div>

@code {
    // ============================================================
    // STATE
    // ============================================================

    private int progressPercent = 68;
    private bool isLoading = false;
    private bool showToast = false;
    private string toastText = "با موفقیت ثبت شد!";

    // Timer
    private int hours = 3;
    private int minutes = 45;
    private int seconds = 20;
    private System.Timers.Timer? countdownTimer;

    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override void OnInitialized()
    {
        StartCountdown();
    }

    // ============================================================
    // COUNTDOWN
    // ============================================================

    private void StartCountdown()
    {
        countdownTimer = new System.Timers.Timer(1000);
        countdownTimer.Elapsed += (sender, e) =>
        {
            if (seconds > 0)
            {
                seconds--;
            }
            else if (minutes > 0)
            {
                minutes--;
                seconds = 59;
            }
            else if (hours > 0)
            {
                hours--;
                minutes = 59;
                seconds = 59;
            }
            else
            {
                countdownTimer?.Stop();
                // When countdown reaches zero, update progress and show message
                progressPercent = 100;
                InvokeAsync(StateHasChanged);
                return;
            }

            // Update progress based on elapsed time
            // Initial total time: 3 hours = 10800 seconds
            var totalSeconds = 10800;
            var elapsed = totalSeconds - (hours * 3600 + minutes * 60 + seconds);
            var progress = (int)((elapsed / (double)totalSeconds) * 100);
            progressPercent = Math.Min(progress, 99);

            InvokeAsync(StateHasChanged);
        };
        countdownTimer.Start();
    }

    // ============================================================
    // ACTIONS
    // ============================================================

    private async Task NotifyMe()
    {
        if (isLoading) return;

        isLoading = true;
        StateHasChanged();

        // Simulate API call
        await Task.Delay(1500);

        // Show toast
        toastText = "✅ شما در لیست اطلاع‌رسانی ثبت شدید!";
        showToast = true;
        StateHasChanged();

        // Hide toast after 3 seconds
        await Task.Delay(3000);
        showToast = false;
        isLoading = false;
        StateHasChanged();
    }

    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Animate progress bar on load
            setTimeout(() => {
                const fill = document.querySelector('.progress-bar .fill');
                if (fill) {
                    const width = fill.style.width;
                    fill.style.width = '0%';
                    setTimeout(() => {
                        fill.style.width = width || '68%';
                    }, 100);
                }
            }, 300);
        ");
    }

    // ============================================================
    // DISPOSE
    // ============================================================

    public void Dispose()
    {
        countdownTimer?.Dispose();
    }
}