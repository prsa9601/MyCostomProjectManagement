@page "/PageUpgrading"
@layout FrontLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>در حال ارتقا | محمد رضایی</title>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>

    /* ============================================================
           RESET
        ============================================================ */

    *,
    *::before,
    *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        width: 100%;
        min-height: 100%;
        overflow-x: hidden;
        scroll-behavior: smooth;
    }

    body {
        width: 100%;
        min-width: 0;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Arial, system-ui, -apple-system, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        overflow-x: hidden;
        direction: rtl;
    }

    a,
    button {
        font-family: inherit;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    button {
        border: 0;
    }


    /* ============================================================
           PAGE
        ============================================================ */

    .upgrade-page {
        width: 100%;
        min-height: calc(100vh - 110px);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 2;
        padding: clamp(100px, 12vh, 140px) 16px 60px;
    }

    .upgrade-container {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }


    /* ============================================================
           PARTICLES
        ============================================================ */

    .upgrade-particles {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

        .upgrade-particles span {
            position: absolute;
            display: block;
            width: 6px;
            height: 6px;
            background: rgba(59, 130, 246, 0.20);
            border-radius: 50%;
            animation: upgradeFloatParticle 12s infinite alternate ease-in-out;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
        }

            .upgrade-particles span:nth-child(1) {
                top: 10%;
                left: 20%;
                width: 8px;
                height: 8px;
                animation-duration: 14s;
            }

            .upgrade-particles span:nth-child(2) {
                top: 60%;
                left: 80%;
                animation-duration: 16s;
                animation-delay: 2s;
            }

            .upgrade-particles span:nth-child(3) {
                top: 30%;
                left: 70%;
                width: 10px;
                height: 10px;
                animation-duration: 18s;
                animation-delay: 4s;
            }

            .upgrade-particles span:nth-child(4) {
                top: 80%;
                left: 10%;
                animation-duration: 15s;
                animation-delay: 1s;
            }

            .upgrade-particles span:nth-child(5) {
                top: 50%;
                left: 40%;
                width: 12px;
                height: 12px;
                background: rgba(59, 130, 246, 0.12);
                animation-duration: 20s;
                animation-delay: 3s;
            }

            .upgrade-particles span:nth-child(6) {
                top: 15%;
                left: 90%;
                animation-duration: 13s;
                animation-delay: 5s;
            }

            .upgrade-particles span:nth-child(7) {
                top: 70%;
                left: 50%;
                width: 7px;
                height: 7px;
                animation-duration: 17s;
                animation-delay: 2s;
            }

            .upgrade-particles span:nth-child(8) {
                top: 40%;
                left: 5%;
                animation-duration: 19s;
                animation-delay: 3s;
            }


    @@keyframes upgradeFloatParticle {

        0% {
            transform: translate(0, 0) scale(1);
            opacity: 0.2;
        }

        50% {
            transform: translate(30px, -60px) scale(1.6);
            opacity: 0.7;
        }

        100% {
            transform: translate(-20px, 40px) scale(0.8);
            opacity: 0.1;
        }
    }


    /* ============================================================
           GLASS CARD
        ============================================================ */

    .upgrade-card {
        width: 100%;
        background: linear-gradient( 145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018) );
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 28px;
        padding: clamp(30px, 5vw, 50px) clamp(18px, 5vw, 42px);
        box-shadow: 0 8px 48px rgba(0, 0, 0, 0.40), inset 0 1px 0 rgba(255, 255, 255, 0.03);
        text-align: center;
        overflow: hidden;
        position: relative;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .upgrade-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 15%;
            right: 15%;
            height: 1px;
            background: linear-gradient( 90deg, transparent, rgba(59, 130, 246, 0.45), transparent );
            opacity: 0.7;
        }

        .upgrade-card:hover {
            border-color: rgba(59, 130, 246, 0.14);
            box-shadow: 0 15px 70px rgba(0, 0, 0, 0.50), inset 0 1px 0 rgba(255, 255, 255, 0.04);
        }


    /* ============================================================
           ICON
        ============================================================ */

    .upgrade-icon {
        width: 100%;
        min-height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8a838;
        margin-bottom: 18px;
        position: relative;
        animation: upgradePulse 2s ease-in-out infinite;
        text-shadow: 0 0 60px rgba(232, 168, 56, 0.10);
    }

        .upgrade-icon .fa-cog {
            font-size: clamp(3rem, 9vw, 4.5rem);
        }

        .upgrade-icon .fa-sync-alt {
            font-size: clamp(1.6rem, 5vw, 2.6rem);
            margin-right: -7px;
            display: inline-block;
            animation: upgradeSpin 4s linear infinite;
        }


    @@keyframes upgradePulse {

        0%,
        100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.06);
        }
    }


    @@keyframes upgradeSpin {

        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }


    /* ============================================================
           TYPOGRAPHY
        ============================================================ */

    .upgrade-title {
        width: 100%;
        font-size: clamp(1.55rem, 4.8vw, 2.2rem);
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 10px;
        letter-spacing: -0.5px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

        .upgrade-title span {
            color: #3b82f6;
            text-shadow: 0 0 30px rgba(59, 130, 246, 0.15);
        }


    .upgrade-subtitle {
        width: 100%;
        font-size: clamp(0.88rem, 2.4vw, 1.1rem);
        color: #94a3b8;
        margin-bottom: 14px;
        line-height: 1.9;
    }

        .upgrade-subtitle i {
            margin-left: 5px;
        }


    .upgrade-description {
        width: 100%;
        max-width: 580px;
        margin: 0 auto clamp(24px, 4vw, 30px);
        font-size: clamp(0.82rem, 2.1vw, 1rem);
        color: #b8c4d6;
        line-height: 2;
        text-align: center;
        overflow-wrap: break-word;
    }


    /* ============================================================
           ACTION
        ============================================================ */

    .upgrade-actions {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .upgrade-button {
        width: auto;
        min-width: 220px;
        min-height: 48px;
        padding: 11px 28px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 40px;
        background: transparent;
        color: #94a3b8;
        font-size: 0.86rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        white-space: nowrap;
        transition: color 0.3s ease, background 0.3s ease, border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }

        .upgrade-button:hover {
            border-color: rgba(59, 130, 246, 0.20);
            color: #eef2f8;
            background: rgba(255, 255, 255, 0.025);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.20);
        }

        .upgrade-button:active {
            transform: translateY(0);
        }


    /* ============================================================
           RIPPLE
        ============================================================ */

    .ripple {
        position: relative;
        overflow: hidden;
        isolation: isolate;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }


    @@keyframes rippleAnim {

        to {
            transform: scale(4);
            opacity: 0;
        }
    }


    /* ============================================================
           TABLET
        ============================================================ */

    @@media (max-width: 900px) {

        .upgrade-page {
            padding: 105px 14px 45px;
        }

        .upgrade-container {
            max-width: 720px;
        }

        .upgrade-card {
            border-radius: 24px;
        }
    }


    /* ============================================================
           MOBILE
        ============================================================ */

    @@media (max-width: 600px) {

        .upgrade-page {
            min-height: auto;
            align-items: flex-start;
            padding: 92px 10px 35px;
        }

        .upgrade-container {
            width: 100%;
        }

        .upgrade-card {
            border-radius: 21px;
            padding: 32px 18px 28px;
        }

        .upgrade-icon {
            min-height: 65px;
            margin-bottom: 13px;
        }

        .upgrade-title {
            font-size: clamp(1.4rem, 7vw, 1.9rem);
            line-height: 1.65;
        }

        .upgrade-subtitle {
            font-size: 0.86rem;
            line-height: 1.9;
        }

        .upgrade-description {
            font-size: 0.82rem;
            line-height: 2;
            margin-bottom: 25px;
        }

        .upgrade-button {
            width: 100%;
            min-width: 0;
            min-height: 50px;
            padding: 12px 16px;
            font-size: 0.82rem;
        }
    }


    /* ============================================================
           SMALL MOBILE
        ============================================================ */

    @@media (max-width: 420px) {

        .upgrade-page {
            padding: 84px 7px 25px;
        }

        .upgrade-card {
            padding: 27px 14px 24px;
            border-radius: 19px;
        }

        .upgrade-icon {
            min-height: 58px;
            margin-bottom: 10px;
        }

            .upgrade-icon .fa-cog {
                font-size: 3rem;
            }

            .upgrade-icon .fa-sync-alt {
                font-size: 1.65rem;
                margin-right: -5px;
            }

        .upgrade-title {
            font-size: 1.35rem;
            line-height: 1.7;
        }

        .upgrade-subtitle {
            font-size: 0.77rem;
            line-height: 2;
        }

        .upgrade-description {
            font-size: 0.75rem;
            line-height: 2.05;
            margin-bottom: 21px;
        }

        .upgrade-button {
            min-height: 47px;
            padding: 10px 12px;
            font-size: 0.76rem;
        }
    }


    /* ============================================================
           VERY SMALL MOBILE
        ============================================================ */

    @@media (max-width: 340px) {

        .upgrade-page {
            padding: 80px 5px 20px;
        }

        .upgrade-card {
            padding: 23px 10px 20px;
            border-radius: 17px;
        }

        .upgrade-icon .fa-cog {
            font-size: 2.7rem;
        }

        .upgrade-icon .fa-sync-alt {
            font-size: 1.4rem;
        }

        .upgrade-title {
            font-size: 1.18rem;
        }

        .upgrade-subtitle {
            font-size: 0.69rem;
        }

        .upgrade-description {
            font-size: 0.69rem;
        }

        .upgrade-button {
            min-height: 45px;
            font-size: 0.69rem;
            gap: 6px;
        }
    }


    /* ============================================================
           SHORT SCREEN
        ============================================================ */

    @@media (max-height: 650px) {

        .upgrade-page {
            min-height: auto;
            padding-top: 90px;
            padding-bottom: 25px;
        }

        .upgrade-card {
            padding-top: 25px;
            padding-bottom: 22px;
        }

        .upgrade-icon {
            margin-bottom: 8px;
        }

        .upgrade-description {
            margin-bottom: 18px;
        }
    }


    /* ============================================================
           REDUCED MOTION
        ============================================================ */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }

</style>


<!-- ============================================================
     PARTICLES
============================================================ -->

<div class="upgrade-particles"
     aria-hidden="true">

    <span></span>
    <span></span>
    <span></span>
    <span></span>

    <span></span>
    <span></span>
    <span></span>
    <span></span>

</div>


<!-- ============================================================
     MAIN
============================================================ -->

<main class="upgrade-page">

    <div class="upgrade-container">

        <section class="upgrade-card">

            <!-- ICON -->

            <div class="upgrade-icon"
                 aria-hidden="true">

                <i class="fas fa-cog"></i>

                <i class="fas fa-sync-alt"></i>

            </div>


            <!-- TITLE -->

            <h1 class="upgrade-title">

                این صفحه در حال
                <span>ارتقا</span>
                می‌باشد

            </h1>


            <!-- SUBTITLE -->

            <p class="upgrade-subtitle">

                <i class="fas fa-code"
                   style="color:#3b82f6;"></i>

                به‌زودی با امکانات جدید بازمی‌گردیم

            </p>


            <!-- DESCRIPTION -->

            <p class="upgrade-description">

                تیم ما در حال بهبود و به‌روزرسانی این بخش است تا
                تجربه‌ای بهتر را برای شما فراهم کند.
                لطفاً شکیبا باشید و پس از اتمام، دوباره بازدید کنید.

            </p>


            <!-- ACTION -->

            <div class="upgrade-actions">

                <a href="/"
                   class="upgrade-button ripple">

                    <i class="fas fa-arrow-right"></i>

                    <span>بازگشت به صفحه اصلی</span>

                </a>

            </div>

        </section>

    </div>

</main>


@code {

    /* ============================================================
       JS INTEROP
    ============================================================ */

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }


    /* ============================================================
       RIPPLE
    ============================================================ */

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync(
            "eval",
            @"
                document
                    .querySelectorAll('.upgrade-button.ripple')
                    .forEach(btn => {

                        if (btn.dataset.rippleReady === 'true')
                            return;

                        btn.dataset.rippleReady = 'true';

                        btn.addEventListener(
                            'click',
                            function(e) {

                                const rect =
                                    this.getBoundingClientRect();

                                const x =
                                    e.clientX - rect.left;

                                const y =
                                    e.clientY - rect.top;

                                const ripple =
                                    document.createElement('span');

                                ripple.className =
                                    'ripple-effect';

                                ripple.style.left =
                                    (x - 20) + 'px';

                                ripple.style.top =
                                    (y - 20) + 'px';

                                ripple.style.width =
                                    '40px';

                                ripple.style.height =
                                    '40px';

                                this.appendChild(ripple);

                                setTimeout(
                                    () => ripple.remove(),
                                    600
                                );
                            }
                        );
                    });
            "
        );
    }

}