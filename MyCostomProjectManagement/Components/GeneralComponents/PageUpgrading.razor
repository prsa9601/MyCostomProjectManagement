@page "/PageUpgrading"
@layout FrontLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>در حال ارتقا | محمد رضایی</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
           PAGE UPGRADING - با پس‌زمینه #0a0e17
        ============================================================ */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
           PARTICLES BACKGROUND
        ============================================================ */
    .bg-particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

        .bg-particles span {
            position: absolute;
            display: block;
            width: 6px;
            height: 6px;
            background: rgba(59, 130, 246, 0.2);
            border-radius: 50%;
            animation: floatParticle 12s infinite alternate ease-in-out;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
        }

            .bg-particles span:nth-child(1) {
                top: 10%;
                left: 20%;
                animation-duration: 14s;
                width: 8px;
                height: 8px;
            }

            .bg-particles span:nth-child(2) {
                top: 60%;
                left: 80%;
                animation-duration: 16s;
                animation-delay: 2s;
            }

            .bg-particles span:nth-child(3) {
                top: 30%;
                left: 70%;
                animation-duration: 18s;
                animation-delay: 4s;
                width: 10px;
                height: 10px;
            }

            .bg-particles span:nth-child(4) {
                top: 80%;
                left: 10%;
                animation-duration: 15s;
                animation-delay: 1s;
            }

            .bg-particles span:nth-child(5) {
                top: 50%;
                left: 40%;
                animation-duration: 20s;
                animation-delay: 3s;
                width: 12px;
                height: 12px;
                background: rgba(59, 130, 246, 0.12);
            }

            .bg-particles span:nth-child(6) {
                top: 15%;
                left: 90%;
                animation-duration: 13s;
                animation-delay: 5s;
            }

            .bg-particles span:nth-child(7) {
                top: 70%;
                left: 50%;
                animation-duration: 17s;
                animation-delay: 2s;
                width: 7px;
                height: 7px;
            }

            .bg-particles span:nth-child(8) {
                top: 40%;
                left: 5%;
                animation-duration: 19s;
                animation-delay: 3s;
            }

    @@keyframes floatParticle {
        0% {
            transform: translate(0, 0) scale(1);
            opacity: 0.2;
        }

        50% {
            transform: translate(30px, -60px) scale(1.6);
            opacity: 0.7;
        }

        100% {
            transform: translate(-20px, 40px) scale(0.8);
            opacity: 0.1;
        }
    }

    /* ============================================================
           GLASS CARD
        ============================================================ */
    .glass-card {
        background: rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 8px 48px rgba(0, 0, 0, 0.4);
        border-radius: 28px;
        padding: 48px 40px;
        transition: all 0.3s ease;
        text-align: center;
    }

        .glass-card:hover {
            border-color: rgba(59, 130, 246, 0.08);
            box-shadow: 0 8px 64px rgba(0, 0, 0, 0.5);
        }

    /* ============================================================
           ICON & ANIMATION
        ============================================================ */
    .upgrade-icon {
        font-size: 4.5rem;
        color: #e8a838;
        display: block;
        margin-bottom: 16px;
        animation: pulse 2s ease-in-out infinite;
        text-shadow: 0 0 60px rgba(232, 168, 56, 0.1);
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.06);
        }
    }

    .upgrade-icon .fa-sync-alt {
        animation: spin 4s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .title {
        font-size: 2.2rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }

        .title span {
            color: #3b82f6;
            text-shadow: 0 0 30px rgba(59, 130, 246, 0.15);
        }

    .subtitle {
        font-size: 1.1rem;
        color: #94a3b8;
        margin-bottom: 12px;
    }

    .description {
        font-size: 1rem;
        color: #b8c4d6;
        max-width: 500px;
        margin: 0 auto 28px;
        line-height: 1.8;
    }

    /* ============================================================
           BUTTONS
        ============================================================ */
    .btn-outline-light {
        padding: 10px 28px;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: transparent;
        color: #94a3b8;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: inherit;
        text-decoration: none;
    }

        .btn-outline-light:hover {
            border-color: rgba(59, 130, 246, 0.1);
            color: #eef2f8;
            background: rgba(255, 255, 255, 0.02);
            transform: translateY(-2px);
        }

    /* ============================================================
           RESPONSIVE
        ============================================================ */
    @@media (max-width: 768px) {
        .glass-card {
            padding: 32px 20px;
            border-radius: 20px;
        }

        .title {
            font-size: 1.8rem;
        }

        .upgrade-icon {
            font-size: 3.6rem;
        }

        .description {
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 480px) {
        .glass-card {
            padding: 24px 16px;
        }

        .title {
            font-size: 1.5rem;
        }

        .upgrade-icon {
            font-size: 3rem;
        }

        .btn-outline-light {
            width: 100%;
            justify-content: center;
        }
    }

    /* ============================================================
           RIPPLE
        ============================================================ */
    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }
</style>

<!-- ===== PARTICLES ===== -->
<div class="bg-particles">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
</div>

<!-- ===== MAIN CONTENT ===== -->
<div class="container">
    <div class="glass-card">

        <!-- Icon -->
        <span class="upgrade-icon">
            <i class="fas fa-cog"></i>
            <i class="fas fa-sync-alt" style="font-size:2.6rem; margin-left:-6px; display:inline-block;"></i>
        </span>

        <!-- Title -->
        <h1 class="title">
            این صفحه در حال <span>ارتقا</span> می‌باشد
        </h1>

        <p class="subtitle">
            <i class="fas fa-code" style="color:#3b82f6;"></i>
            به‌زودی با امکانات جدید بازمی‌گردیم
        </p>

        <p class="description">
            تیم ما در حال بهبود و به‌روزرسانی این بخش است تا تجربه‌ای بهتر را
            برای شما فراهم کند. لطفاً شکیبا باشید و پس از اتمام، دوباره بازدید کنید.
        </p>

        <!-- Actions -->
        <a href="/" class="btn-outline-light ripple">
            <i class="fas fa-arrow-right"></i> بازگشت به صفحه اصلی
        </a>

    </div>
</div>

@code {
    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });
        ");
    }
}