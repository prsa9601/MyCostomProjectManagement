@page "/Dashboard"
@layout FrontLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>داشبورد کاربری | محمد رضایی</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ===== RESET & BASE ===== */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
    }
    a {
        text-decoration: none;
        color: inherit;
    }
    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ===== PARTICLES BACKGROUND ===== */
    .bg-particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }
    .bg-particles span {
        position: absolute;
        display: block;
        width: 6px;
        height: 6px;
        background: rgba(59, 130, 246, 0.2);
        border-radius: 50%;
        animation: floatParticle 12s infinite alternate ease-in-out;
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
    }
    .bg-particles span:nth-child(1) {
        top: 10%;
        left: 20%;
        animation-duration: 14s;
        width: 8px;
        height: 8px;
    }
    .bg-particles span:nth-child(2) {
        top: 60%;
        left: 80%;
        animation-duration: 16s;
        animation-delay: 2s;
    }
    .bg-particles span:nth-child(3) {
        top: 30%;
        left: 70%;
        animation-duration: 18s;
        animation-delay: 4s;
        width: 10px;
        height: 10px;
    }
    .bg-particles span:nth-child(4) {
        top: 80%;
        left: 10%;
        animation-duration: 15s;
        animation-delay: 1s;
    }
    .bg-particles span:nth-child(5) {
        top: 50%;
        left: 40%;
        animation-duration: 20s;
        animation-delay: 3s;
        width: 12px;
        height: 12px;
        background: rgba(59, 130, 246, 0.12);
    }
    .bg-particles span:nth-child(6) {
        top: 15%;
        left: 90%;
        animation-duration: 13s;
        animation-delay: 5s;
    }
    .bg-particles span:nth-child(7) {
        top: 70%;
        left: 50%;
        animation-duration: 17s;
        animation-delay: 2s;
        width: 7px;
        height: 7px;
    }
    .bg-particles span:nth-child(8) {
        top: 40%;
        left: 5%;
        animation-duration: 19s;
        animation-delay: 3s;
    }
    @@keyframes floatParticle {
        0% { transform: translate(0, 0) scale(1); opacity: 0.2; }
        50% { transform: translate(30px, -60px) scale(1.6); opacity: 0.7; }
        100% { transform: translate(-20px, 40px) scale(0.8); opacity: 0.1; }
    }

    /* ===== GLASS + GRADIENT BORDERS ===== */
    .glass {
        background: rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.35s ease;
    }
    .glass::before {
        content: '';
        position: absolute;
        inset: -2px;
        z-index: -1;
        border-radius: 26px;
        background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6, #8b5cf6, #3b82f6);
        background-size: 400% 400%;
        animation: rotateBorder 8s linear infinite;
        opacity: 0.25;
        transition: opacity 0.4s;
    }
    .glass:hover::before { opacity: 0.6; }
    @@keyframes rotateBorder {
        0% { background-position: 0% 50%; }
        100% { background-position: 400% 50%; }
    }

    /* ===== NAVBAR ===== */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: background 0.5s, backdrop-filter 0.5s, box-shadow 0.4s;
        background: transparent;
    }
    .navbar.scrolled {
        background: linear-gradient(135deg, rgba(10, 14, 23, 0.92), rgba(20, 30, 48, 0.92));
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 4px 40px rgba(0, 0, 0, 0.4);
    }
    .navbar .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }
    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        text-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
    }
    .logo span {
        color: #3b82f6;
        text-shadow: 0 0 30px rgba(59, 130, 246, 0.3);
    }
    .nav-links {
        display: flex;
        gap: 24px;
        list-style: none;
        font-size: 0.95rem;
        font-weight: 500;
        align-items: center;
    }
    .nav-links a {
        color: #b8c4d6;
        transition: 0.25s;
        position: relative;
        padding: 4px 0;
    }
    .nav-links a:hover { color: #fff; }
    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        right: 0;
        width: 0;
        height: 2px;
        background: #3b82f6;
        transition: 0.35s;
        box-shadow: 0 0 12px #3b82f6;
    }
    .nav-links a:hover::after { width: 100%; }
    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: #3b82f6;
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: 0.3s;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
    }
    .btn-primary:hover {
        background: #2563eb;
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 12px 40px rgba(59, 130, 246, 0.4);
    }

    .btn-outline {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #eef2f8;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        transition: 0.3s;
    }
    .btn-outline:hover {
        border-color: #3b82f6;
        color: #fff;
        background: rgba(59, 130, 246, 0.08);
        box-shadow: 0 0 30px rgba(59, 130, 246, 0.1);
    }

    .btn-success {
        background: #34d399;
        color: #0a0e17;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: 0.3s;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 0 20px rgba(52, 211, 153, 0.15);
    }
    .btn-success:hover {
        background: #10b981;
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 12px 40px rgba(52, 211, 153, 0.3);
    }

    .btn-warning {
        background: #fb923c;
        color: #0a0e17;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: 0.3s;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 0 20px rgba(251, 146, 60, 0.15);
    }
    .btn-warning:hover {
        background: #f97316;
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 12px 40px rgba(251, 146, 60, 0.3);
    }

    .btn-danger-outline {
        background: transparent;
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #ef4444;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        transition: 0.3s;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-danger-outline:hover {
        background: rgba(239, 68, 68, 0.05);
        border-color: #ef4444;
        transform: translateY(-2px);
    }

    .btn-dashboard {
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #3b82f6;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.8rem;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-dashboard:hover {
        background: rgba(59, 130, 246, 0.25);
        transform: scale(1.04);
        box-shadow: 0 0 30px rgba(59, 130, 246, 0.15);
    }

    .btn-admin {
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.3);
        color: #a78bfa;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.8rem;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-admin:hover {
        background: rgba(139, 92, 246, 0.25);
        transform: scale(1.04);
        box-shadow: 0 0 30px rgba(139, 92, 246, 0.15);
    }

    .avatar-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid rgba(59, 130, 246, 0.3);
        background: rgba(59, 130, 246, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #3b82f6;
        font-size: 1.2rem;
        transition: 0.3s;
        cursor: pointer;
    }
    .avatar-btn:hover {
        border-color: #3b82f6;
        transform: scale(1.05);
    }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
    }
    .hamburger span {
        display: block;
        width: 28px;
        height: 2.5px;
        background: #eef2f8;
        border-radius: 4px;
        transition: 0.3s;
    }

    /* ===== DASHBOARD LAYOUT ===== */
    .dashboard {
        padding-top: 100px;
        padding-bottom: 60px;
        position: relative;
        z-index: 1;
    }
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }
    .dashboard-header h1 {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .dashboard-header .date {
        color: #94a3b8;
        font-size: 0.95rem;
        background: rgba(255, 255, 255, 0.05);
        padding: 8px 18px;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    /* ===== STATS CARDS ===== */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .stat-card {
        padding: 22px 20px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: 0.3s;
        position: relative;
        overflow: hidden;
    }
    .stat-card::before {
        content: '';
        position: absolute;
        inset: -2px;
        z-index: -1;
        border-radius: 22px;
        background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
        background-size: 300% 300%;
        animation: rotateBorder 10s linear infinite;
        opacity: 0;
        transition: opacity 0.4s;
    }
    .stat-card:hover::before { opacity: 0.4; }
    .stat-card:hover {
        border-color: transparent;
        transform: translateY(-4px);
    }
    .stat-card .icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 12px;
    }
    .stat-card .icon.blue { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
    .stat-card .icon.purple { background: rgba(139, 92, 246, 0.15); color: #a78bfa; }
    .stat-card .icon.green { background: rgba(52, 211, 153, 0.15); color: #34d399; }
    .stat-card .icon.orange { background: rgba(251, 146, 60, 0.15); color: #fb923c; }
    .stat-card .number {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 2px;
    }
    .stat-card .label {
        color: #94a3b8;
        font-size: 0.9rem;
    }
    .stat-card .change {
        font-size: 0.75rem;
        margin-top: 6px;
        display: inline-block;
        padding: 2px 12px;
        border-radius: 30px;
        background: rgba(52, 211, 153, 0.12);
        color: #34d399;
        border: 1px solid rgba(52, 211, 153, 0.1);
    }
    .stat-card .change.orange {
        background: rgba(251, 146, 60, 0.12);
        color: #fb923c;
        border-color: rgba(251, 146, 60, 0.1);
    }

    /* ===== SECTION TITLE ===== */
    .section-title-custom {
        font-size: 1.1rem;
        font-weight: 600;
        color: #e8edf5;
        margin: 32px 0 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        padding-bottom: 12px;
    }
    .section-title-custom i { color: #3b82f6; }
    .section-title-custom .count {
        font-size: 0.8rem;
        color: #94a3b8;
        margin-right: auto;
        font-weight: 400;
    }

    /* ===== ACTIVE PACKAGE ===== */
    .active-package {
        padding: 24px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        margin-bottom: 20px;
        transition: 0.3s;
        position: relative;
        overflow: hidden;
    }
    .active-package::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #3b82f6, #8b5cf6);
        border-radius: 0 4px 4px 0;
        opacity: 0.6;
    }
    .active-package:hover {
        border-color: rgba(59, 130, 246, 0.15);
        transform: translateY(-3px);
    }
    .active-package .pkg-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 10px;
    }
    .active-package .pkg-name {
        font-size: 1.2rem;
        font-weight: 600;
        color: #fff;
    }
    .active-package .pkg-status {
        padding: 4px 14px;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 500;
    }
    .active-package .pkg-status.active {
        background: rgba(52, 211, 153, 0.08);
        color: #34d399;
        border: 1px solid rgba(52, 211, 153, 0.04);
    }
    .active-package .pkg-status.expired {
        background: rgba(239, 68, 68, 0.06);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.04);
    }
    .active-package .pkg-details {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        margin-top: 10px;
        font-size: 0.85rem;
        color: #94a3b8;
    }
    .active-package .pkg-details span {
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .active-package .pkg-details i {
        color: rgba(59, 130, 246, 0.3);
    }
    .active-package .pkg-details .highlight {
        color: #3b82f6;
        font-weight: 500;
    }
    .active-package .pkg-progress {
        margin-top: 12px;
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        overflow: hidden;
    }
    .active-package .pkg-progress .fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6);
        transition: width 1.2s ease;
        width: 0%;
    }

    /* ===== API ACCESS GRID ===== */
    .api-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }
    .api-item {
        padding: 16px 18px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        transition: 0.3s;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .api-item:hover {
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(59, 130, 246, 0.08);
        transform: translateY(-2px);
    }
    .api-item .api-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .api-item .api-info i {
        color: #3b82f6;
        font-size: 0.9rem;
        opacity: 0.5;
    }
    .api-item .api-info .name {
        font-size: 0.9rem;
        color: #e8edf5;
    }
    .api-item .api-info .project {
        font-size: 0.7rem;
        color: #94a3b8;
    }
    .api-item .api-duration {
        font-size: 0.75rem;
        color: #94a3b8;
        white-space: nowrap;
    }
    .api-item .api-duration .days {
        color: #34d399;
        font-weight: 500;
    }
    .api-item .api-status {
        font-size: 0.6rem;
        padding: 2px 12px;
        border-radius: 30px;
        background: rgba(52, 211, 153, 0.06);
        color: #34d399;
        border: 1px solid rgba(52, 211, 153, 0.02);
        white-space: nowrap;
    }
    .api-item .api-status.warning {
        background: rgba(251, 146, 60, 0.06);
        color: #fb923c;
        border-color: rgba(251, 146, 60, 0.02);
    }

    /* ===== PURCHASE HISTORY TABLE ===== */
    .history-wrapper {
        overflow-x: auto;
        margin-bottom: 20px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        padding: 4px;
    }
    .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    .history-table thead th {
        text-align: right;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        color: #94a3b8;
        font-weight: 500;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }
    .history-table tbody td {
        padding: 12px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.02);
        vertical-align: middle;
    }
    .history-table tbody tr:last-child td { border-bottom: none; }
    .history-table tbody tr:hover { background: rgba(255, 255, 255, 0.02); }
    .history-table .status-badge {
        font-size: 0.7rem;
        padding: 3px 12px;
        border-radius: 30px;
        font-weight: 500;
        white-space: nowrap;
    }
    .history-table .status-badge.success {
        background: rgba(52, 211, 153, 0.06);
        color: #34d399;
        border: 1px solid rgba(52, 211, 153, 0.02);
    }
    .history-table .status-badge.pending {
        background: rgba(251, 146, 60, 0.06);
        color: #fb923c;
        border: 1px solid rgba(251, 146, 60, 0.02);
    }
    .history-table .status-badge.failed {
        background: rgba(239, 68, 68, 0.04);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.02);
    }

    /* ===== FORMS ===== */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 20px;
    }
    .form-box {
        padding: 24px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: 0.3s;
    }
    .form-box:hover {
        border-color: rgba(59, 130, 246, 0.08);
    }
    .form-box .form-title {
        font-size: 1rem;
        font-weight: 600;
        color: #e8edf5;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .form-box .form-title i { color: #3b82f6; }
    .form-box .form-group {
        margin-bottom: 14px;
    }
    .form-box .form-group label {
        display: block;
        font-size: 0.8rem;
        color: #94a3b8;
        margin-bottom: 4px;
        font-weight: 500;
    }
    .form-box .form-group input,
    .form-box .form-group select,
    .form-box .form-group textarea {
        width: 100%;
        padding: 10px 14px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 12px;
        color: #eef2f8;
        font-size: 0.9rem;
        outline: none;
        transition: 0.35s;
        font-family: inherit;
    }
    .form-box .form-group input:focus,
    .form-box .form-group select:focus,
    .form-box .form-group textarea:focus {
        border-color: #3b82f6;
        background: rgba(255, 255, 255, 0.04);
        box-shadow: 0 0 24px rgba(59, 130, 246, 0.02);
    }
    .form-box .form-group input::placeholder,
    .form-box .form-group textarea::placeholder {
        color: #64748b;
    }
    .form-box .form-group select option {
        background: #0a0e17;
        color: #eef2f8;
    }
    .form-box .form-group textarea {
        min-height: 80px;
        resize: vertical;
    }
    .form-box .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 16px;
        flex-wrap: wrap;
    }

    /* ===== PROFILE & QUICK ACTIONS (overriding template) ===== */
    .profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-top: 20px;
    }
    .profile-card {
        padding: 28px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    .profile-card .avatar-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        color: #fff;
        margin-bottom: 12px;
        box-shadow: 0 0 40px rgba(59, 130, 246, 0.2);
    }
    .profile-card h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
    }
    .profile-card .role {
        color: #94a3b8;
        font-size: 0.9rem;
        margin-bottom: 12px;
    }
    .profile-card .info-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        justify-content: center;
        margin: 8px 0;
    }
    .profile-card .info-row span {
        font-size: 0.85rem;
        color: #b8c4d6;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .profile-card .info-row span i { color: #3b82f6; }

    .quick-actions {
        padding: 28px;
    }
    .quick-actions h3 {
        font-size: 1.1rem;
        color: #e8edf5;
        margin-bottom: 16px;
    }
    .quick-actions h3 i { color: #fb923c; }
    .quick-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    .quick-btn {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        padding: 16px 12px;
        text-align: center;
        transition: 0.3s;
        cursor: pointer;
        color: #b8c4d6;
    }
    .quick-btn:hover {
        border-color: #3b82f6;
        background: rgba(59, 130, 246, 0.05);
        transform: translateY(-3px);
        color: #fff;
    }
    .quick-btn i {
        font-size: 1.8rem;
        color: #3b82f6;
        display: block;
        margin-bottom: 6px;
    }
    .quick-btn span {
        font-size: 0.85rem;
    }

    /* ===== PREVIEW: Portfolio & Skills ===== */
    .preview-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 20px;
    }
    .preview-box {
        padding: 24px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: 0.3s;
    }
    .preview-box:hover {
        border-color: rgba(59, 130, 246, 0.08);
    }
    .preview-box .box-title {
        font-size: 1rem;
        font-weight: 600;
        color: #e8edf5;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .preview-box .box-title i { color: #3b82f6; }
    .preview-box .box-title .view-link {
        font-size: 0.75rem;
        color: #94a3b8;
        margin-right: auto;
        cursor: pointer;
        transition: 0.3s;
    }
    .preview-box .box-title .view-link:hover { color: #3b82f6; }

    .portfolio-items {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    .portfolio-items .item {
        padding: 12px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.02);
        border-radius: 12px;
        transition: 0.3s;
        cursor: pointer;
        text-align: center;
    }
    .portfolio-items .item:hover {
        border-color: rgba(59, 130, 246, 0.08);
        transform: translateY(-2px);
    }
    .portfolio-items .item i {
        font-size: 1.6rem;
        color: rgba(59, 130, 246, 0.2);
        display: block;
        margin-bottom: 4px;
    }
    .portfolio-items .item .title {
        font-size: 0.8rem;
        color: #94a3b8;
    }

    .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .skill-tags .tag {
        padding: 4px 14px;
        border-radius: 30px;
        font-size: 0.75rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #94a3b8;
        transition: 0.3s;
    }
    .skill-tags .tag:hover {
        border-color: rgba(59, 130, 246, 0.08);
        color: #eef2f8;
    }

    /* ===== EMPTY STATE ===== */
    .empty-state-mini {
        text-align: center;
        padding: 30px 20px;
        color: #64748b;
        font-size: 0.9rem;
    }
    .empty-state-mini i {
        font-size: 2rem;
        display: block;
        margin-bottom: 8px;
        color: rgba(59, 130, 246, 0.05);
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .form-grid, .preview-grid {
            grid-template-columns: 1fr;
        }
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }
    @@media (max-width: 768px) {
        .nav-links {
            display: none;
            flex-direction: column;
            width: 100%;
            background: rgba(10, 14, 23, 0.95);
            backdrop-filter: blur(12px);
            padding: 20px 0;
            gap: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            margin-top: 12px;
            border-radius: 20px;
            align-items: center;
        }
        .nav-links.open { display: flex; }
        .hamburger { display: flex; }
        .nav-actions .btn-outline, .nav-actions .btn-dashboard, .nav-actions .btn-admin { display: none; }
        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }
        .quick-grid {
            grid-template-columns: 1fr 1fr;
        }
        .dashboard-header h1 {
            font-size: 1.5rem;
        }
        .dashboard-header .date {
            font-size: 0.8rem;
            padding: 4px 12px;
        }
        .api-grid {
            grid-template-columns: 1fr;
        }
        .history-table thead {
            display: none;
        }
        .history-table tbody td {
            display: block;
            padding: 8px 14px;
            border-bottom: none;
        }
        .history-table tbody tr {
            display: block;
            border-bottom: 1px solid rgba(255,255,255,0.03);
            padding: 4px 0;
        }
        .history-table tbody tr:last-child { border-bottom: none; }
        .history-table td:before {
            content: attr(data-label);
            display: inline-block;
            width: 80px;
            font-size: 0.7rem;
            color: #64748b;
            font-weight: 500;
        }
        .portfolio-items {
            grid-template-columns: 1fr 1fr;
        }
        .form-grid .form-actions .btn-primary,
        .form-grid .form-actions .btn-success {
            width: 100%;
            justify-content: center;
        }
    }
    @@media (max-width: 480px) {
        .stats-grid { grid-template-columns: 1fr; }
        .quick-grid { grid-template-columns: 1fr; }
        .portfolio-items { grid-template-columns: 1fr; }
        .dashboard-header h1 { font-size: 1.2rem; }
        .active-package .pkg-header { flex-direction: column; }
        .active-package .pkg-details { flex-direction: column; gap: 6px; }
    }

    /* ===== FOOTER ===== */
    .footer {
        position: relative;
        padding: 30px 0 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.04);
        background: rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(8px);
        z-index: 1;
        margin-top: 20px;
    }
    .footer .container {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
    }
    .footer-links {
        display: flex;
        gap: 24px;
        font-size: 0.85rem;
        color: #94a3b8;
    }
    .footer-links a:hover { color: #fff; }
    .footer-copy {
        color: #64748b;
        font-size: 0.8rem;
    }

    /* ===== ANIMATIONS ===== */
    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .fade-up.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .stagger-child { transition-delay: 0s; }
    .stagger-child:nth-child(1) { transition-delay: 0.05s; }
    .stagger-child:nth-child(2) { transition-delay: 0.1s; }
    .stagger-child:nth-child(3) { transition-delay: 0.15s; }
    .stagger-child:nth-child(4) { transition-delay: 0.2s; }
</style>

<!-- ===== PARTICLES ===== -->
<div class="bg-particles">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
</div>

<!-- ===== NAVBAR ===== -->
<header class="navbar" id="navbar">
    <div class="container">
        <div class="logo">Mohammad<span>Dev</span></div>
        <ul class="nav-links @(isMenuOpen ? "open" : "")" id="navLinks">
            <li><a href="/UserDashboard" class="active"><i class="fas fa-chart-pie"></i> داشبورد</a></li>
            <li><a href="/Packages">پکیج‌ها</a></li>
            <li><a href="/ApiManagement">APIها</a></li>
            <li><a href="/Portfolio">نمونه کارها</a></li>
            <li><a href="/Skills">مهارت‌ها</a></li>
        </ul>
        <div class="nav-actions">
            <button class="btn-dashboard"><i class="fas fa-user"></i> حساب من</button>
            <button class="btn-danger-outline" @onclick="Logout"><i class="fas fa-sign-out-alt"></i> خروج</button>
            <button class="hamburger" @onclick="ToggleMenu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<!-- ===== DASHBOARD ===== -->
<main class="dashboard">
    <div class="container">

        <!-- Header -->
        <div class="dashboard-header fade-up visible">
            <h1>داشبورد کاربری</h1>
            <span class="date"><i class="far fa-calendar-alt"></i> @persianDate</span>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card fade-up stagger-child visible">
                <div class="icon blue"><i class="fas fa-box"></i></div>
                <div class="number">@activePackageCount</div>
                <div class="label">پکیج فعال</div>
                <span class="change"><i class="fas fa-arrow-up"></i> @activePackageStatus</span>
            </div>
            <div class="stat-card fade-up stagger-child visible">
                <div class="icon purple"><i class="fas fa-plug"></i></div>
                <div class="number">@apiAccessCount</div>
                <div class="label">APIهای در دسترس</div>
                <span class="change"><i class="fas fa-arrow-up"></i> فعال</span>
            </div>
            <div class="stat-card fade-up stagger-child visible">
                <div class="icon green"><i class="fas fa-shopping-cart"></i></div>
                <div class="number">@purchaseCount</div>
                <div class="label">خریدها</div>
                <span class="change"><i class="fas fa-arrow-up"></i> @purchaseGrowth</span>
            </div>
            <div class="stat-card fade-up stagger-child visible">
                <div class="icon orange"><i class="fas fa-clock"></i></div>
                <div class="number">@remainingDays</div>
                <div class="label">روز باقیمانده</div>
                <span class="change orange"><i class="fas fa-arrow-@(remainingDays > 30 ? "up" : "down")"></i> @remainingDaysText</span>
            </div>
        </div>

        <!-- Active Package -->
        <div class="active-package fade-up visible">
            <div class="pkg-header">
                <div>
                    <div class="pkg-name">@activePackage.Name</div>
                    <div class="pkg-details">
                        <span><i class="far fa-clock"></i> مدت: <span class="highlight">@activePackage.DurationText</span></span>
                        <span><i class="far fa-calendar-alt"></i> شروع: @activePackage.StartDate</span>
                        <span><i class="far fa-calendar-check"></i> انقضا: @activePackage.ExpiryDate</span>
                        <span><i class="fas fa-tag"></i> قیمت: <span class="highlight">@activePackage.Price.ToString("N0") تومان</span></span>
                    </div>
                </div>
                <span class="pkg-status @(activePackage.IsExpired ? "expired" : "active")">
                    @(activePackage.IsExpired ? "❌ منقضی شده" : "✅ فعال")
                </span>
            </div>
            <div class="pkg-progress">
                <div class="fill" style="width:@(activePackage.ProgressPercent)%;"></div>
            </div>
        </div>

        <!-- API Access List -->
        <div class="section-title-custom">
            <i class="fas fa-plug"></i>
            APIهای در دسترس
            <span class="count">@apiAccessCount مورد</span>
        </div>
        <div class="api-grid fade-up visible">
            @foreach (var api in apiAccessList)
            {
                <div class="api-item">
                    <div class="api-info">
                        <i class="fas fa-code"></i>
                        <div>
                            <div class="name">@api.Name</div>
                            <div class="project">@api.Project</div>
                        </div>
                    </div>
                    <div class="api-duration">
                        <span class="days">@api.RemainingDays</span> روز
                    </div>
                    <span class="api-status @(api.RemainingDays < 7 ? "warning" : "")">
                        @(api.RemainingDays < 7 ? "⚠️ در شرف انقضا" : "✅ فعال")
                    </span>
                </div>
            }
        </div>

        <!-- Purchase History -->
        <div class="section-title-custom">
            <i class="fas fa-history"></i>
            تاریخچه خریدها
            <span class="count">@purchaseCount مورد</span>
        </div>
        <div class="history-wrapper fade-up visible">
            <table class="history-table">
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>پکیج</th>
                        <th>قیمت</th>
                        <th>تاریخ</th>
                        <th>وضعیت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in purchaseHistory)
                    {
                        <tr>
                            <td data-label="شناسه">@item.Id</td>
                            <td data-label="پکیج">@item.PackageName</td>
                            <td data-label="قیمت">@item.Price.ToString("N0") تومان</td>
                            <td data-label="تاریخ">@item.Date</td>
                            <td data-label="وضعیت">
                                <span class="status-badge @item.StatusClass">@item.StatusText</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Request & Contact Forms -->
        <div class="section-title-custom">
            <i class="fas fa-headset"></i>
            درخواست پروژه و پشتیبانی
        </div>
        <div class="form-grid fade-up visible">
            <!-- Request Project -->
            <div class="form-box">
                <div class="form-title"><i class="fas fa-clipboard-list"></i> درخواست پروژه جدید</div>
                <div class="form-group">
                    <label>عنوان پروژه</label>
                    <input type="text" placeholder="مثال: طراحی وب‌سایت فروشگاهی" @bind="requestTitle" />
                </div>
                <div class="form-group">
                    <label>نوع پروژه</label>
                    <select @bind="requestType">
                        <option value="">انتخاب کنید</option>
                        <option value="website">وب‌سایت</option>
                        <option value="shop">فروشگاه اینترنتی</option>
                        <option value="app">اپلیکیشن موبایل</option>
                        <option value="api">سرویس API</option>
                        <option value="dashboard">داشبورد مدیریتی</option>
                        <option value="other">سایر</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>توضیحات</label>
                    <textarea placeholder="توضیحات کامل پروژه..." @bind="requestDescription"></textarea>
                </div>
                <div class="form-actions">
                    <button class="btn-success ripple" @onclick="SubmitRequest"><i class="fas fa-paper-plane"></i> ارسال درخواست</button>
                </div>
            </div>

            <!-- Contact Support -->
            <div class="form-box">
                <div class="form-title"><i class="fas fa-headset"></i> تماس با پشتیبانی</div>
                <div class="form-group">
                    <label>موضوع</label>
                    <input type="text" placeholder="مثال: مشکل در پرداخت" @bind="contactSubject" />
                </div>
                <div class="form-group">
                    <label>پیام</label>
                    <textarea placeholder="پیام خود را بنویسید..." @bind="contactMessage"></textarea>
                </div>
                <div class="form-actions">
                    <button class="btn-primary ripple" @onclick="SubmitContact"><i class="fas fa-envelope"></i> ارسال پیام</button>
                </div>
            </div>
        </div>

        <!-- Portfolio & Skills Preview -->
        <div class="section-title-custom">
            <i class="fas fa-images"></i>
            نمونه کارها و مهارت‌ها
        </div>
        <div class="preview-grid fade-up visible">
            <!-- Portfolio -->
            <div class="preview-box">
                <div class="box-title">
                    <i class="fas fa-images"></i>
                    نمونه کارها
                    <span class="view-link" @onclick="GoToPortfolio">مشاهده همه →</span>
                </div>
                <div class="portfolio-items">
                    @foreach (var item in portfolioPreview)
                    {
                        <div class="item" @onclick="() => ViewPortfolioItem(item.Id)">
                            <i class="fas fa-image"></i>
                            <div class="title">@item.Title</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Skills -->
            <div class="preview-box">
                <div class="box-title">
                    <i class="fas fa-code"></i>
                    مهارت‌های فنی
                    <span class="view-link" @onclick="GoToSkills">مشاهده همه →</span>
                </div>
                <div class="skill-tags">
                    @foreach (var skill in skillPreview)
                    {
                        <span class="tag">@skill</span>
                    }
                </div>
            </div>
        </div>

    </div>
</main>

<!-- ===== FOOTER ===== -->
<footer class="footer">
    <div class="container">
        <div class="footer-copy">© ۲۰۲۶ محمد رضایی · تمامی حقوق محفوظ است</div>
        <div class="footer-links">
            <a href="#">حریم خصوصی</a>
            <a href="#">قوانین</a>
            <a href="#"><i class="fab fa-github"></i></a>
            <a href="#"><i class="fab fa-linkedin"></i></a>
            <a href="#"><i class="fab fa-telegram"></i></a>
        </div>
    </div>
</footer>

