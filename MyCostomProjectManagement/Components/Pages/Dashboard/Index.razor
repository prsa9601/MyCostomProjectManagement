@page "/Dashboard"
@layout FrontLayout
@rendermode InteractiveServer

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>داشبورد کاربری | محمد رضایی</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        /* ===== RESET & BASE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #0a0e17;
            color: #eef2f8;
            line-height: 1.7;
            scroll-behavior: smooth;
            overflow-x: hidden;
        }
        a {
            text-decoration: none;
            color: inherit;
        }
        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            position: relative;
            z-index: 2;
        }

        /* ===== PARTICLES BACKGROUND ===== */
        .bg-particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }
        .bg-particles span {
            position: absolute;
            display: block;
            width: 6px;
            height: 6px;
            background: rgba(59, 130, 246, 0.2);
            border-radius: 50%;
            animation: floatParticle 12s infinite alternate ease-in-out;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
        }
        .bg-particles span:nth-child(1) {
            top: 10%;
            left: 20%;
            animation-duration: 14s;
            width: 8px;
            height: 8px;
        }
        .bg-particles span:nth-child(2) {
            top: 60%;
            left: 80%;
            animation-duration: 16s;
            animation-delay: 2s;
        }
        .bg-particles span:nth-child(3) {
            top: 30%;
            left: 70%;
            animation-duration: 18s;
            animation-delay: 4s;
            width: 10px;
            height: 10px;
        }
        .bg-particles span:nth-child(4) {
            top: 80%;
            left: 10%;
            animation-duration: 15s;
            animation-delay: 1s;
        }
        .bg-particles span:nth-child(5) {
            top: 50%;
            left: 40%;
            animation-duration: 20s;
            animation-delay: 3s;
            width: 12px;
            height: 12px;
            background: rgba(59, 130, 246, 0.12);
        }
        .bg-particles span:nth-child(6) {
            top: 15%;
            left: 90%;
            animation-duration: 13s;
            animation-delay: 5s;
        }
        .bg-particles span:nth-child(7) {
            top: 70%;
            left: 50%;
            animation-duration: 17s;
            animation-delay: 2s;
            width: 7px;
            height: 7px;
        }
        .bg-particles span:nth-child(8) {
            top: 40%;
            left: 5%;
            animation-duration: 19s;
            animation-delay: 3s;
        }
        @@keyframes floatParticle {
            0% {
                transform: translate(0, 0) scale(1);
                opacity: 0.2;
            }
            50% {
                transform: translate(30px, -60px) scale(1.6);
                opacity: 0.7;
            }
            100% {
                transform: translate(-20px, 40px) scale(0.8);
                opacity: 0.1;
            }
        }

        /* ===== GLASS + GRADIENT BORDERS ===== */
        .glass {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.35s ease;
        }
        .glass::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 26px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 400% 400%;
            animation: rotateBorder 8s linear infinite;
            opacity: 0.25;
            transition: opacity 0.4s;
        }
        .glass:hover::before {
            opacity: 0.6;
        }
        @@keyframes rotateBorder {
            0% {
                background-position: 0% 50%;
            }
            100% {
                background-position: 400% 50%;
            }
        }

        /* ===== NAVBAR ===== */
        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 999;
            padding: 14px 0;
            transition: background 0.5s, backdrop-filter 0.5s, box-shadow 0.4s;
            background: transparent;
        }
        .navbar.scrolled {
            background: linear-gradient(135deg, rgba(10, 14, 23, 0.92), rgba(20, 30, 48, 0.92));
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 4px 40px rgba(0, 0, 0, 0.4);
        }
        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }
        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
            text-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
        }
        .logo span {
            color: #3b82f6;
            text-shadow: 0 0 30px rgba(59, 130, 246, 0.3);
        }
        .nav-links {
            display: flex;
            gap: 24px;
            list-style: none;
            font-size: 0.95rem;
            font-weight: 500;
            align-items: center;
        }
        .nav-links a {
            color: #b8c4d6;
            transition: 0.25s;
            position: relative;
            padding: 4px 0;
        }
        .nav-links a:hover {
            color: #fff;
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            right: 0;
            width: 0;
            height: 2px;
            background: #3b82f6;
            transition: 0.35s;
            box-shadow: 0 0 12px #3b82f6;
        }
        .nav-links a:hover::after {
            width: 100%;
        }
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .btn-primary {
            background: #3b82f6;
            color: #fff;
            padding: 8px 22px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: 0.3s;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
        }
        .btn-primary:hover {
            background: #2563eb;
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 12px 40px rgba(59, 130, 246, 0.4);
        }
        .btn-outline {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #eef2f8;
            padding: 8px 22px;
            border-radius: 40px;
            font-weight: 500;
            transition: 0.3s;
        }
        .btn-outline:hover {
            border-color: #3b82f6;
            color: #fff;
            background: rgba(59, 130, 246, 0.08);
            box-shadow: 0 0 30px rgba(59, 130, 246, 0.1);
        }
        .btn-dashboard {
            background: rgba(59, 130, 246, 0.15);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #3b82f6;
            padding: 6px 16px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.8rem;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-dashboard:hover {
            background: rgba(59, 130, 246, 0.25);
            transform: scale(1.04);
            box-shadow: 0 0 30px rgba(59, 130, 246, 0.15);
        }
        .btn-admin {
            background: rgba(139, 92, 246, 0.15);
            border: 1px solid rgba(139, 92, 246, 0.3);
            color: #a78bfa;
            padding: 6px 16px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.8rem;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-admin:hover {
            background: rgba(139, 92, 246, 0.25);
            transform: scale(1.04);
            box-shadow: 0 0 30px rgba(139, 92, 246, 0.15);
        }
        .avatar-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid rgba(59, 130, 246, 0.3);
            background: rgba(59, 130, 246, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #3b82f6;
            font-size: 1.2rem;
            transition: 0.3s;
            cursor: pointer;
        }
        .avatar-btn:hover {
            border-color: #3b82f6;
            transform: scale(1.05);
        }
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            background: none;
            border: none;
        }
        .hamburger span {
            display: block;
            width: 28px;
            height: 2.5px;
            background: #eef2f8;
            border-radius: 4px;
            transition: 0.3s;
        }

        /* ===== DASHBOARD LAYOUT ===== */
        .dashboard {
            padding-top: 100px;
            padding-bottom: 60px;
            position: relative;
            z-index: 1;
        }
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 32px;
        }
        .dashboard-header h1 {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(to left, #f0f4ff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .dashboard-header .date {
            color: #94a3b8;
            font-size: 0.95rem;
            background: rgba(255, 255, 255, 0.05);
            padding: 8px 18px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        /* ===== STATS CARDS ===== */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        .stat-card {
            padding: 22px 20px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: 0.3s;
            position: relative;
            overflow: hidden;
        }
        .stat-card::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 22px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 300% 300%;
            animation: rotateBorder 10s linear infinite;
            opacity: 0;
            transition: opacity 0.4s;
        }
        .stat-card:hover::before {
            opacity: 0.4;
        }
        .stat-card:hover {
            border-color: transparent;
            transform: translateY(-4px);
        }
        .stat-card .icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 12px;
        }
        .stat-card .icon.blue {
            background: rgba(59, 130, 246, 0.15);
            color: #3b82f6;
        }
        .stat-card .icon.purple {
            background: rgba(139, 92, 246, 0.15);
            color: #a78bfa;
        }
        .stat-card .icon.green {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
        }
        .stat-card .icon.orange {
            background: rgba(251, 146, 60, 0.15);
            color: #fb923c;
        }
        .stat-card .number {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 2px;
        }
        .stat-card .label {
            color: #94a3b8;
            font-size: 0.9rem;
        }
        .stat-card .change {
            font-size: 0.75rem;
            margin-top: 6px;
            display: inline-block;
            padding: 2px 12px;
            border-radius: 30px;
            background: rgba(16, 185, 129, 0.12);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.1);
        }

        /* ===== MAIN GRID (chart + recent) ===== */
        .main-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
            margin-bottom: 32px;
        }
        .chart-box {
            padding: 24px;
        }
        .chart-box h3 {
            font-size: 1.1rem;
            margin-bottom: 16px;
            color: #e8edf5;
        }
        .chart-container {
            width: 100%;
            height: 200px;
            display: flex;
            align-items: flex-end;
            gap: 12px;
            padding-top: 10px;
        }
        .chart-bar-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            height: 100%;
            justify-content: flex-end;
        }
        .chart-bar {
            width: 100%;
            max-width: 40px;
            border-radius: 8px 8px 0 0;
            background: linear-gradient(180deg, #3b82f6, #8b5cf6);
            transition: height 1.2s cubic-bezier(0.2, 0.9, 0.3, 1);
            min-height: 8px;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.1);
        }
        .chart-bar-label {
            font-size: 0.7rem;
            color: #94a3b8;
        }

        /* ===== RECENT ACTIVITY ===== */
        .recent-box {
            padding: 24px;
        }
        .recent-box h3 {
            font-size: 1.1rem;
            margin-bottom: 16px;
            color: #e8edf5;
        }
        .recent-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }
        .recent-item:last-child {
            border-bottom: none;
        }
        .recent-item .r-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(59, 130, 246, 0.08);
            color: #3b82f6;
            font-size: 0.9rem;
            flex-shrink: 0;
        }
        .recent-item .r-info {
            flex: 1;
        }
        .recent-item .r-info .title {
            font-size: 0.9rem;
            font-weight: 500;
        }
        .recent-item .r-info .time {
            font-size: 0.75rem;
            color: #94a3b8;
        }
        .recent-item .r-status {
            font-size: 0.7rem;
            padding: 3px 12px;
            border-radius: 30px;
            background: rgba(16, 185, 129, 0.1);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.05);
        }
        .recent-item .r-status.pending {
            background: rgba(251, 146, 60, 0.1);
            color: #fb923c;
        }
        .recent-item .r-status.done {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
        }

        /* ===== PROFILE & QUICK ACTIONS ===== */
        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }
        .profile-card {
            padding: 28px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        .profile-card .avatar-large {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.4rem;
            color: #fff;
            margin-bottom: 12px;
            box-shadow: 0 0 40px rgba(59, 130, 246, 0.2);
        }
        .profile-card h3 {
            font-size: 1.2rem;
            font-weight: 700;
        }
        .profile-card .role {
            color: #94a3b8;
            font-size: 0.9rem;
            margin-bottom: 12px;
        }
        .profile-card .info-row {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
            margin: 8px 0;
        }
        .profile-card .info-row span {
            font-size: 0.85rem;
            color: #b8c4d6;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .profile-card .info-row span i {
            color: #3b82f6;
        }
        .quick-actions {
            padding: 28px;
        }
        .quick-actions h3 {
            font-size: 1.1rem;
            margin-bottom: 16px;
        }
        .quick-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .quick-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 16px;
            padding: 16px 12px;
            text-align: center;
            transition: 0.3s;
            cursor: pointer;
            color: #b8c4d6;
        }
        .quick-btn:hover {
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.05);
            transform: translateY(-3px);
            color: #fff;
        }
        .quick-btn i {
            font-size: 1.8rem;
            color: #3b82f6;
            display: block;
            margin-bottom: 6px;
        }
        .quick-btn span {
            font-size: 0.85rem;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 992px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            .profile-grid {
                grid-template-columns: 1fr;
            }
        }
        @@media (max-width: 768px) {
            .nav-links {
                display: none;
                flex-direction: column;
                width: 100%;
                background: rgba(10, 14, 23, 0.95);
                backdrop-filter: blur(12px);
                padding: 20px 0;
                gap: 16px;
                border-top: 1px solid rgba(255, 255, 255, 0.06);
                margin-top: 12px;
                border-radius: 20px;
                align-items: center;
            }
            .nav-links.open {
                display: flex;
            }
            .hamburger {
                display: flex;
            }
            .nav-actions .btn-outline,
            .nav-actions .btn-dashboard,
            .nav-actions .btn-admin {
                display: none;
            }
            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }
            .quick-grid {
                grid-template-columns: 1fr 1fr;
            }
            .dashboard-header h1 {
                font-size: 1.5rem;
            }
            .dashboard-header .date {
                font-size: 0.8rem;
                padding: 4px 12px;
            }
        }
        @@media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
            .quick-grid {
                grid-template-columns: 1fr;
            }
            .chart-container {
                height: 150px;
                gap: 8px;
            }
        }

        /* ===== FOOTER ===== */
        .footer {
            position: relative;
            padding: 30px 0 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            background: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(8px);
            z-index: 1;
            margin-top: 20px;
        }
        .footer .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
        }
        .footer-links {
            display: flex;
            gap: 24px;
            font-size: 0.85rem;
            color: #94a3b8;
        }
        .footer-links a:hover {
            color: #fff;
        }
        .footer-copy {
            color: #64748b;
            font-size: 0.8rem;
        }

        /* ===== ANIMATIONS ===== */
        .fade-up {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }
        .stagger-child {
            transition-delay: 0s;
        }
        .stagger-child:nth-child(1) {
            transition-delay: 0.05s;
        }
        .stagger-child:nth-child(2) {
            transition-delay: 0.1s;
        }
        .stagger-child:nth-child(3) {
            transition-delay: 0.15s;
        }
        .stagger-child:nth-child(4) {
            transition-delay: 0.2s;
        }
    </style>
</head>
<body>

    <!-- ===== PARTICLES ===== -->
    <div class="bg-particles">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
    </div>

    <!-- ===== NAVBAR ===== -->
    <header class="navbar" id="navbar">
        <div class="container">
            <div class="logo">Mohammad<span>Dev</span></div>
            <ul class="nav-links" id="navLinks">
                <li><a href="#"><i class="fas fa-chart-pie"></i> داشبورد</a></li>
                <li><a href="#">پروژه‌ها</a></li>
                <li><a href="#">پیام‌ها</a></li>
                <li><a href="#">تنظیمات</a></li>
            </ul>
            <div class="nav-actions">
                <a href="#" class="btn-dashboard"><i class="fas fa-chart-pie"></i> داشبورد</a>
                <a href="#" class="btn-admin"><i class="fas fa-user-cog"></i> ادمین</a>
                <a href="#" class="btn-outline"><i class="fas fa-plus"></i> پروژه جدید</a>
                <div class="avatar-btn"><i class="fas fa-user"></i></div>
                <button class="hamburger" id="hamburger" aria-label="منو">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ===== DASHBOARD ===== -->
    <main class="dashboard">
        <div class="container">

            <!-- Header -->
            <div class="dashboard-header fade-up visible">
                <h1>داشبورد کاربری</h1>
                <span class="date"><i class="far fa-calendar-alt"></i> امروز، ۱۰ تیر ۱۴۰۵</span>
            </div>

            <!-- Stats -->
            <div class="stats-grid">
                <div class="stat-card fade-up stagger-child visible">
                    <div class="icon blue"><i class="fas fa-folder-open"></i></div>
                    <div class="number">۲۴</div>
                    <div class="label">پروژه‌های فعال</div>
                    <span class="change"><i class="fas fa-arrow-up"></i> ۱۲٪ نسبت به ماه قبل</span>
                </div>
