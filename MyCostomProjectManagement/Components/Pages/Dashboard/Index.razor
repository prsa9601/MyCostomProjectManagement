    <script>
        // ===== HAMBURGER =====
        const hamburger = document.getElementById('hamburger');
        const navLinks = document.getElementById('navLinks');
        hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', () => navLinks.classList.remove('open'));
        });

        // ===== NAVBAR SCROLL =====
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            navbar.classList.toggle('scrolled', window.scrollY > 50);
        });

        // ===== CHART BARS ANIMATION =====
        function animateBars() {
            const bars = document.querySelectorAll('.chart-bar');
            bars.forEach(bar => {
                const target = parseFloat(bar.dataset.height) || 50;
                setTimeout(() => {
                    bar.style.height = target + '%';
                }, 300);
            });
        }

        // ===== OBSERVER FOR FADE + TRIGGER BARS =====
        const fadeEls = document.querySelectorAll('.fade-up');
        const observer = new IntersectionObserver((entries) => {
            let chartVisible = false;
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    if (entry.target.closest('.chart-box')) chartVisible = true;
                }
            });
            if (chartVisible) animateBars();
        }, { threshold: 0.15 });

        fadeEls.forEach(el => observer.observe(el));

        // Also trigger on load if chart already visible
        setTimeout(() => {
            const chart = document.querySelector('.chart-box');
            if (chart && chart.getBoundingClientRect().top < window.innerHeight) {
                animateBars();
            }
            // Force visible for any element already in view
            fadeEls.forEach(el => {
                if (el.getBoundingClientRect().top < window.innerHeight) {
                    el.classList.add('visible');
                }
            });
        }, 400);
    </script>
