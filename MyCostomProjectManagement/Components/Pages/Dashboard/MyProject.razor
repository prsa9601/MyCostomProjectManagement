@page "/MyProjects"
@using MyCostomProjectManagement.Infrastructure
@layout MainLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject UserAlertService _alertService

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>پروژه‌های من | محمد پارسا کریمی</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
           MY PROJECTS PAGE - با پس‌زمینه #0a0e17
        ============================================================ */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
           PARTICLES BACKGROUND
        ============================================================ */
    .bg-particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

        .bg-particles span {
            position: absolute;
            display: block;
            width: 6px;
            height: 6px;
            background: rgba(59, 130, 246, 0.2);
            border-radius: 50%;
            animation: floatParticle 12s infinite alternate ease-in-out;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
        }

            .bg-particles span:nth-child(1) {
                top: 10%;
                left: 20%;
                animation-duration: 14s;
                width: 8px;
                height: 8px;
            }

            .bg-particles span:nth-child(2) {
                top: 60%;
                left: 80%;
                animation-duration: 16s;
                animation-delay: 2s;
            }

            .bg-particles span:nth-child(3) {
                top: 30%;
                left: 70%;
                animation-duration: 18s;
                animation-delay: 4s;
                width: 10px;
                height: 10px;
            }

            .bg-particles span:nth-child(4) {
                top: 80%;
                left: 10%;
                animation-duration: 15s;
                animation-delay: 1s;
            }

            .bg-particles span:nth-child(5) {
                top: 50%;
                left: 40%;
                animation-duration: 20s;
                animation-delay: 3s;
                width: 12px;
                height: 12px;
                background: rgba(59, 130, 246, 0.12);
            }

            .bg-particles span:nth-child(6) {
                top: 15%;
                left: 90%;
                animation-duration: 13s;
                animation-delay: 5s;
            }

            .bg-particles span:nth-child(7) {
                top: 70%;
                left: 50%;
                animation-duration: 17s;
                animation-delay: 2s;
                width: 7px;
                height: 7px;
            }

            .bg-particles span:nth-child(8) {
                top: 40%;
                left: 5%;
                animation-duration: 19s;
                animation-delay: 3s;
            }

    @@keyframes floatParticle {
        0% {
            transform: translate(0, 0) scale(1);
            opacity: 0.2;
        }

        50% {
            transform: translate(30px, -60px) scale(1.6);
            opacity: 0.7;
        }

        100% {
            transform: translate(-20px, 40px) scale(0.8);
            opacity: 0.1;
        }
    }

    /* ============================================================
           GLASS EFFECT
        ============================================================ */
    .glass {
        background: rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        border-radius: 24px;
        transition: all 0.35s ease;
    }

        .glass:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(59, 130, 246, 0.08);
            transform: translateY(-3px);
            box-shadow: 0 8px 40px rgba(0, 0, 0, 0.35);
        }

    /* ============================================================
           PAGE HEADER
        ============================================================ */
    .page-header {
        padding-top: 100px;
        padding-bottom: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .page-header h1 i {
                color: #3b82f6;
            }

        .page-header .subtitle {
            color: #94a3b8;
            font-size: 0.9rem;
            margin-top: 4px;
        }

    /* ============================================================
           USER PROFILE CARD
        ============================================================ */
    .profile-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 24px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 28px 32px;
        margin-bottom: 32px;
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        align-items: center;
        transition: all 0.3s ease;
    }

        .profile-card:hover {
            border-color: rgba(59, 130, 246, 0.06);
        }

        .profile-card .avatar {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 4px 20px rgba(59, 130, 246, 0.08);
        }

        .profile-card .info {
            flex: 1;
            min-width: 200px;
        }

            .profile-card .info .name {
                font-size: 1.4rem;
                font-weight: 700;
                color: #ffffff;
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .profile-card .info .details {
                display: flex;
                gap: 20px;
                flex-wrap: wrap;
                margin-top: 4px;
                font-size: 0.85rem;
                color: #94a3b8;
            }

                .profile-card .info .details span {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }

                .profile-card .info .details i {
                    color: #3b82f6;
                    opacity: 0.4;
                }

        .profile-card .stats {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
            margin-left: auto;
        }

            .profile-card .stats .stat-item {
                text-align: center;
                padding: 8px 16px;
                background: rgba(255, 255, 255, 0.02);
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.02);
                min-width: 80px;
            }

                .profile-card .stats .stat-item .number {
                    font-size: 1.4rem;
                    font-weight: 700;
                    color: #3b82f6;
                    display: block;
                }

                .profile-card .stats .stat-item .label {
                    font-size: 0.7rem;
                    color: #94a3b8;
                }

    /* ============================================================
           PROJECTS SECTION
        ============================================================ */
    .section-title {
        font-size: 1.2rem;
        font-weight: 600;
        color: #ffffff;
        margin: 32px 0 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        padding-bottom: 12px;
    }

        .section-title i {
            color: #3b82f6;
        }

        .section-title .count {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-right: auto;
            font-weight: 400;
        }

    /* ===== PROJECTS GRID ===== */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
    }

    .project-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 24px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        position: relative;
        overflow: hidden;
    }

        .project-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 3px;
            height: 100%;
            border-radius: 0 3px 3px 0;
            opacity: 0.4;
        }

        .project-card.status-active::before {
            background: #52b788;
        }

        .project-card.status-completed::before {
            background: #3b82f6;
        }

        .project-card.status-pending::before {
            background: #e8a838;
        }

        .project-card.status-hold::before {
            background: #dc3545;
        }

        .project-card:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(59, 130, 246, 0.06);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }

        .project-card .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
        }

            .project-card .card-header .title-group {
                flex: 1;
            }

                .project-card .card-header .title-group h3 {
                    font-size: 1.1rem;
                    font-weight: 600;
                    color: #ffffff;
                    margin-bottom: 2px;
                }

                .project-card .card-header .title-group .project-id {
                    font-size: 0.7rem;
                    color: #94a3b8;
                    opacity: 0.4;
                }

            .project-card .card-header .status-badge {
                padding: 4px 14px;
                border-radius: 30px;
                font-size: 0.65rem;
                font-weight: 500;
                white-space: nowrap;
            }

                .project-card .card-header .status-badge.active {
                    background: rgba(82, 183, 136, 0.08);
                    color: #52b788;
                    border: 1px solid rgba(82, 183, 136, 0.04);
                }

                .project-card .card-header .status-badge.completed {
                    background: rgba(59, 130, 246, 0.08);
                    color: #3b82f6;
                    border: 1px solid rgba(59, 130, 246, 0.04);
                }

                .project-card .card-header .status-badge.pending {
                    background: rgba(232, 168, 56, 0.08);
                    color: #e8a838;
                    border: 1px solid rgba(232, 168, 56, 0.04);
                }

                .project-card .card-header .status-badge.hold {
                    background: rgba(220, 53, 69, 0.06);
                    color: #dc3545;
                    border: 1px solid rgba(220, 53, 69, 0.04);
                }

        .project-card .card-body {
            color: #b8c4d6;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 14px;
            min-height: 40px;
        }

            .project-card .card-body .description {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

        /* Progress Bar */
        .project-card .progress-wrapper {
            margin-bottom: 14px;
        }

            .project-card .progress-wrapper .progress-label {
                display: flex;
                justify-content: space-between;
                font-size: 0.75rem;
                color: #94a3b8;
                margin-bottom: 4px;
            }

            .project-card .progress-wrapper .progress-bar {
                width: 100%;
                height: 4px;
                background: rgba(255, 255, 255, 0.04);
                border-radius: 10px;
                overflow: hidden;
            }

                .project-card .progress-wrapper .progress-bar .fill {
                    height: 100%;
                    border-radius: 10px;
                    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
                    transition: width 1.2s cubic-bezier(0.2, 0.9, 0.3, 1);
                    width: 0%;
                }

        /* Card Meta */
        .project-card .card-meta {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            font-size: 0.75rem;
            color: #94a3b8;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
        }

            .project-card .card-meta span {
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .project-card .card-meta i {
                color: #3b82f6;
                opacity: 0.3;
                font-size: 0.7rem;
            }

            .project-card .card-meta .highlight {
                color: #e8a838;
                font-weight: 500;
            }

    /* ============================================================
           HISTORY SECTION
        ============================================================ */
    .history-wrapper {
        overflow-x: auto;
        margin-bottom: 32px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        padding: 4px;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

        .history-table thead th {
            text-align: right;
            padding: 14px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            color: #94a3b8;
            font-weight: 500;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .history-table tbody td {
            padding: 12px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.02);
            vertical-align: middle;
        }

        .history-table tbody tr:last-child td {
            border-bottom: none;
        }

        .history-table tbody tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .history-table .activity-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            background: rgba(59, 130, 246, 0.06);
            color: #3b82f6;
        }

        .history-table .activity-title {
            color: #e8edf5;
            font-weight: 500;
        }

        .history-table .activity-desc {
            color: #94a3b8;
            font-size: 0.8rem;
        }

        .history-table .activity-date {
            color: #94a3b8;
            font-size: 0.75rem;
            white-space: nowrap;
        }

        .history-table .activity-status {
            font-size: 0.65rem;
            padding: 3px 12px;
            border-radius: 30px;
            font-weight: 500;
            white-space: nowrap;
        }

            .history-table .activity-status.done {
                background: rgba(82, 183, 136, 0.06);
                color: #52b788;
                border: 1px solid rgba(82, 183, 136, 0.02);
            }

            .history-table .activity-status.progress {
                background: rgba(59, 130, 246, 0.06);
                color: #3b82f6;
                border: 1px solid rgba(59, 130, 246, 0.02);
            }

            .history-table .activity-status.pending {
                background: rgba(232, 168, 56, 0.06);
                color: #e8a838;
                border: 1px solid rgba(232, 168, 56, 0.02);
            }

    /* ============================================================
           EMPTY STATE
        ============================================================ */
    .empty-state-mini {
        text-align: center;
        padding: 50px 20px;
        color: #64748b;
        font-size: 0.9rem;
    }

        .empty-state-mini i {
            font-size: 3rem;
            display: block;
            margin-bottom: 12px;
            color: rgba(59, 130, 246, 0.05);
        }

        .empty-state-mini h3 {
            color: #94a3b8;
            font-size: 1.1rem;
            margin-bottom: 4px;
        }

    /* ============================================================
           RESPONSIVE
        ============================================================ */
    @@media (max-width: 992px) {
        .projects-grid {
            grid-template-columns: 1fr 1fr;
        }

        .profile-card .stats {
            margin-left: 0;
            width: 100%;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .page-header h1 {
                font-size: 1.5rem;
            }

        .profile-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 20px;
        }

            .profile-card .info .details {
                justify-content: center;
            }

            .profile-card .stats {
                justify-content: center;
            }

        .projects-grid {
            grid-template-columns: 1fr;
        }

        .history-table thead {
            display: none;
        }

        .history-table tbody td {
            display: block;
            padding: 8px 14px;
            border-bottom: none;
        }

        .history-table tbody tr {
            display: block;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            padding: 4px 0;
        }

            .history-table tbody tr:last-child {
                border-bottom: none;
            }

        .history-table td:before {
            content: attr(data-label);
            display: inline-block;
            width: 80px;
            font-size: 0.7rem;
            color: #64748b;
            font-weight: 500;
        }
    }

    @@media (max-width: 480px) {
        .page-header h1 {
            font-size: 1.2rem;
        }

        .profile-card .stats .stat-item {
            min-width: 60px;
            padding: 6px 12px;
        }

            .profile-card .stats .stat-item .number {
                font-size: 1.1rem;
            }

        .project-card {
            padding: 18px;
        }
    }

    /* ============================================================
           RIPPLE & FADE UP
        ============================================================ */
    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .stagger-child {
        transition-delay: 0s;
    }

        .stagger-child:nth-child(1) {
            transition-delay: 0.05s;
        }

        .stagger-child:nth-child(2) {
            transition-delay: 0.1s;
        }

        .stagger-child:nth-child(3) {
            transition-delay: 0.15s;
        }

        .stagger-child:nth-child(4) {
            transition-delay: 0.2s;
        }
</style>

<!-- ===== PARTICLES ===== -->
<div class="bg-particles">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
</div>

<!-- ===== PAGE CONTENT ===== -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-project-diagram"></i>
                    پروژه‌های من
                </h1>
                <div class="subtitle">مشاهده و پیگیری پروژه‌های اختصاص داده شده به شما</div>
            </div>
        </div>

        <!-- Profile Card -->
        <div class="profile-card fade-up visible">
            <div class="avatar">@userProfile.Initials</div>
            <div class="info">
                <div class="name">
                    @userProfile.FullName
                    <span style="font-size:0.7rem; color:#94a3b8; font-weight:400;">
                        <i class="fas fa-id-badge"></i> @userProfile.Id
                    </span>
                </div>
                <div class="details">
                    <span><i class="fas fa-envelope"></i> @userProfile.Email</span>
                    <span><i class="fas fa-phone"></i> @userProfile.Phone</span>
                    <span><i class="fas fa-calendar-check"></i> عضو از @userProfile.JoinDate</span>
                </div>
            </div>
            <div class="stats">
                <div class="stat-item">
                    <span class="number">@totalProjects</span>
                    <span class="label">کل پروژه‌ها</span>
                </div>
                <div class="stat-item">
                    <span class="number" style="color:#52b788;">@activeProjects</span>
                    <span class="label">فعال</span>
                </div>
                <div class="stat-item">
                    <span class="number" style="color:#3b82f6;">@completedProjects</span>
                    <span class="label">تکمیل شده</span>
                </div>
                <div class="stat-item">
                    <span class="number" style="color:#e8a838;">@pendingProjects</span>
                    <span class="label">در انتظار</span>
                </div>
            </div>
        </div>

        <!-- Projects Grid -->
        <div class="section-title fade-up visible">
            <i class="fas fa-list"></i>
            پروژه‌های فعال
            <span class="count">@projects.Count مورد</span>
        </div>

        @if (projects.Any())
        {
            <div class="projects-grid">
                @foreach (var project in projects.OrderBy(p => p.StatusText == "pending" ? 1 : p.StatusText == "active" ? 2 : 3))
                {
                    <div class="project-card status-@project.StatusClass fade-up stagger-child">
                        <div class="card-header">
                            <div class="title-group">
                                <h3>@project.Title</h3>
                                <span class="project-id">#@project.Id</span>
                            </div>
                            <span class="status-badge @project.StatusClass">@project.StatusText</span>
                        </div>
                        <div class="card-body">
                            <div class="description">@project.Description</div>
                        </div>
                        <div class="progress-wrapper">
                            <div class="progress-label">
                                <span>پیشرفت پروژه</span>
                                <span>@project.Progress%</span>
                            </div>
                            <div class="progress-bar">
                                <div class="fill" style="width:@(project.Progress)%;"></div>
                            </div>
                        </div>
                        <div class="card-meta">
                            <span><i class="far fa-calendar-alt"></i> شروع: @project.StartDate</span>
                            <span><i class="far fa-calendar-check"></i> پایان: @project.EndDate</span>
                            <span><i class="fas fa-user"></i> مسئول: <span class="highlight">@project.Assignee</span></span>
                            <span><i class="fas fa-tag"></i> @project.Budget</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state-mini">
                <i class="fas fa-inbox"></i>
                <h3>هیچ پروژه‌ای به شما اختصاص داده نشده است</h3>
                <p>به‌زودی پروژه‌های جدید به شما اضافه می‌شود.</p>
            </div>
        }

        <!-- History Section -->
        <div class="section-title fade-up visible">
            <i class="fas fa-history"></i>
            تاریخچه فعالیت‌ها
            <span class="count">@activities.Count مورد</span>
        </div>

        @if (activities.Any())
        {
            <div class="history-wrapper fade-up visible">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th style="width:40px;">#</th>
                            <th style="min-width:160px;">فعالیت</th>
                            <th style="min-width:200px;">توضیحات</th>
                            <th style="min-width:120px;">تاریخ</th>
                            <th style="width:100px; text-align:center;">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in activities)
                        {
                            <tr>
                                <td data-label="#">
                                    <span class="activity-icon"><i class="@activity.Icon"></i></span>
                                </td>
                                <td data-label="فعالیت">
                                    <div class="activity-title">@activity.Title</div>
                                </td>
                                <td data-label="توضیحات">
                                    <div class="activity-desc">@activity.Description</div>
                                </td>
                                <td data-label="تاریخ">
                                    <span class="activity-date">@activity.Date</span>
                                </td>
                                <td data-label="وضعیت" style="text-align:center;">
                                    <span class="activity-status @activity.StatusClass">@activity.StatusText</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state-mini">
                <i class="fas fa-clock"></i>
                <h3>هیچ فعالیتی ثبت نشده است</h3>
                <p>با شروع کار روی پروژه‌ها، تاریخچه فعالیت‌ها در اینجا نمایش داده می‌شود.</p>
            </div>
        }

    </div>
</main>

