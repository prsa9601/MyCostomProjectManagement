@page "/"
@using BackEnd.Core
@using BackEnd.Core.ContactUs.Commands.Create
@using BackEnd.Core.Portfolio.Queries.DTOs
@using BackEnd.Core.SiteSetting.Queries.DTOs
@using BackEnd.Data.Entities.Role
@using BackEnd.Shared.Extentions.Enum
@using BackEnd.Core.Project.Commands.ProjectRequestV1.Create
@using BackEnd.Data.Entities.ProjectRequestV1
@using BackEnd.Data.Infrastructure.Blog
@using BackEnd.Data.Infrastructure.Blog.DTOs
@using BackEnd.Data.Entities.Blogs
@using BackEnd.Data.Entities.Comment
@using BackEnd.Data.Entities.Qualification
@using BackEnd.Data.Entities.ProgrammingServices
@using BackEnd.Data.Entities.SpecializedTechnology
@using Microsoft.EntityFrameworkCore
@using MyCostomProjectManagement.Facade.ContactUs
@using MyCostomProjectManagement.Facade.FAQ
@using MyCostomProjectManagement.Facade.Portfolio
@using MyCostomProjectManagement.Facade.ProjectRequestV1
@using MyCostomProjectManagement.Facade.SiteSettings
@using MyCostomProjectManagement.Facade.Skills
@using MyCostomProjectManagement.Facade.User
@using MyCostomProjectManagement.Infrastructure
@using MyCostomProjectManagement.Shared.Attributes
@layout FrontLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IContactUsFacade _contactUsFacade
@inject ISkillFacade _skillFacade
@inject IPortfolioFacade _portfolioFacade
@inject IFAQFacade _faqFacade
@inject UserAlertService _userAlertService
@inject ISiteSettingFacade _siteSettingFacade
@inject IUserFacade _userFacade
@inject GetUserPermission _getUserPermission
@inject UserAuthentication _userAuthentication
@inject IProjectRequestV1Facade _prV1Facade
@inject IBlogApiService _blogApiService
@inject IDbContextFactory<BackEnd.Data.DB.Context> DbFactory

<HeadContent>
    <title>برنامه نویس دات نت و سی‌شارپ | محمد پارسا کریمی</title>
    <meta name="description" content="توسعه‌دهنده بک‌اند با ASP.NET Core و Blazor. طراحی APIهای مقیاس‌پذیر و داشبوردهای مدیریتی." />
    <meta name="author" content="محمد پارسا کریمی" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://parsakarimidev.ir/" />
    <script type="application/ld+json">@((MarkupString)BuildPersonJsonLd())</script>
    <script type="application/ld+json">@((MarkupString)BuildFaqJsonLd())</script>
</HeadContent>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    .bg-particles {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

        .bg-particles span {
            position: absolute;
            width: 6px;
            height: 6px;
            background: rgba(59,130,246,0.2);
            border-radius: 50%;
            animation: floatParticle 12s infinite alternate ease-in-out;
        }

            .bg-particles span:nth-child(1) {
                top: 10%;
                left: 20%;
            }

            .bg-particles span:nth-child(2) {
                top: 60%;
                left: 80%;
                animation-delay: 2s;
            }

            .bg-particles span:nth-child(3) {
                top: 30%;
                left: 70%;
                animation-delay: 4s;
            }

            .bg-particles span:nth-child(4) {
                top: 80%;
                left: 10%;
                animation-delay: 1s;
            }

            .bg-particles span:nth-child(5) {
                top: 50%;
                left: 40%;
                animation-delay: 3s;
            }

    @@keyframes floatParticle {
        0% {
            transform: translate(0,0);
            opacity: 0.2;
        }

        50% {
            transform: translate(30px,-60px);
            opacity: 0.7;
        }

        100% {
            transform: translate(-20px,40px);
            opacity: 0.1;
        }
    }

    .hero {
        padding: 160px 0 100px;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(59,130,246,0.12);
        padding: 6px 22px;
        border-radius: 40px;
        font-size: 0.8rem;
        color: #3b82f6;
        border: 1px solid rgba(59,130,246,0.15);
        margin-bottom: 28px;
    }

    .hero h1 {
        font-size: clamp(3rem, 10vw, 5.2rem);
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 20px;
    }

    .hero p {
        font-size: 1.3rem;
        max-width: 720px;
        margin: 0 auto 40px;
        color: #b8c4d6;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: center;
    }

    .typewriter .text {
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .typewriter .cursor {
        display: inline-block;
        width: 3px;
        height: 1em;
        background: #3b82f6;
        margin-right: 6px;
        animation: blink 0.8s step-end infinite;
        vertical-align: text-bottom;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }

    .section {
        padding: 90px 0;
        position: relative;
        z-index: 1;
    }

        .section:nth-child(odd) {
            background: rgba(255,255,255,0.01);
        }

        .section:nth-child(even) {
            background: rgba(0,0,0,0.15);
        }

    .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 12px;
        text-align: center;
    }

        .section-title span {
            color: #3b82f6;
        }

    .section-subtitle {
        text-align: center;
        color: #94a3b8;
        max-width: 640px;
        margin: 0 auto 56px;
        font-size: 1.1rem;
    }

    .btn-primary {
        background: #3b82f6;
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: 0.3s;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: inherit;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(59,130,246,0.4);
            filter: brightness(1.1);
        }

    .btn-outline {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.15);
        color: #eef2f8;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        transition: 0.3s;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: inherit;
    }

        .btn-outline:hover {
            border-color: #3b82f6;
            background: rgba(59,130,246,0.08);
        }

    .btn-portfolio {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        padding: 8px 18px;
        background: rgba(59,130,246,0.10);
        border: 1px solid rgba(59,130,246,0.20);
        border-radius: 40px;
        color: #3b82f6;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    .about-text p {
        color: #c8d2e0;
        margin-bottom: 20px;
        font-size: 1.05rem;
    }

    .about-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 30px;
    }

    .stat-item {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        padding: 22px 12px;
        border-radius: 20px;
        text-align: center;
    }

        .stat-item:hover {
            border-color: #3b82f6;
            transform: translateY(-4px);
        }

        .stat-item .number {
            font-size: 2.2rem;
            font-weight: 800;
            color: #3b82f6;
        }

        .stat-item .label {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-top: 4px;
        }

    .about-image {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 280px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 32px;
    }

        .about-image i {
            font-size: 9rem;
            color: #3b82f6;
            opacity: 0.5;
        }

    .why-me-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
        gap: 22px;
    }

    .why-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 22px;
        padding: 26px 24px;
        transition: all 0.35s;
        position: relative;
    }

        .why-card:hover {
            transform: translateY(-6px);
            border-color: rgba(59,130,246,0.35);
        }

    .why-icon {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 18px;
        background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(139,92,246,0.12));
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,0.22);
    }

    .why-card h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
    }

    .why-card p {
        color: #94a3b8;
        font-size: 0.9rem;
        line-height: 1.95;
        margin: 0;
    }

    .achievements-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 22px;
    }

    .achievement-card {
        background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 22px;
        padding: 32px 24px;
        text-align: center;
    }

        .achievement-card:hover {
            transform: translateY(-8px);
            border-color: rgba(59,130,246,0.4);
            box-shadow: 0 24px 60px rgba(59,130,246,0.18);
        }

    .achievement-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 20px;
        background: linear-gradient(135deg, rgba(59,130,246,0.18), rgba(139,92,246,0.14));
        color: #60a5fa;
        border: 1.5px solid rgba(59,130,246,0.28);
    }

    .achievement-number {
        font-size: 2.8rem;
        font-weight: 900;
        background: linear-gradient(135deg, #60a5fa, #c4b5fd);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 8px;
        font-family: 'Fira Code', monospace;
    }

    .achievement-label {
        color: #b8c4d6;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .achievement-desc {
        color: #64748b;
        font-size: 0.78rem;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 24px;
    }

    .service-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 22px;
        padding: 28px 24px;
    }

        .service-card:hover {
            transform: translateY(-6px);
            border-color: rgba(59,130,246,0.35);
        }

    .service-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 18px;
        background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(139,92,246,0.12));
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,0.2);
    }

    .service-card h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
    }

    .service-card p {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.9;
        margin: 0;
    }

    .process-timeline {
        position: relative;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 24px;
    }

        .process-timeline::before {
            content: '';
            position: absolute;
            top: 42px;
            left: 8%;
            right: 8%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(59,130,246,0.4), rgba(139,92,246,0.5), rgba(59,130,246,0.4), transparent);
        }

    .process-step {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 0 6px;
    }

    .process-number {
        position: absolute;
        top: -8px;
        right: 12px;
        font-size: 2.2rem;
        font-weight: 900;
        color: rgba(59,130,246,0.06);
        font-family: 'Fira Code', monospace;
        z-index: -1;
    }

    .process-icon {
        width: 84px;
        height: 84px;
        margin: 0 auto 22px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
        background: linear-gradient(135deg, rgba(59,130,246,0.14), rgba(139,92,246,0.10));
        color: #60a5fa;
        border: 1.5px solid rgba(59,130,246,0.25);
        transition: all 0.4s;
    }

    .process-step:hover .process-icon {
        transform: translateY(-8px) scale(1.06);
        color: #93c5fd;
        box-shadow: 0 20px 60px rgba(59,130,246,0.25);
    }

    .process-step h3 {
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
    }

    .process-step p {
        font-size: 0.85rem;
        color: #94a3b8;
        line-height: 1.9;
        margin: 0;
    }

    .testi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
    }

    .testi-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 24px;
        padding: 28px 26px;
    }

        .testi-card:hover {
            transform: translateY(-6px);
            border-color: rgba(59,130,246,0.35);
        }

    .testi-stars {
        display: flex;
        gap: 4px;
        margin-bottom: 16px;
        color: #fbbf24;
    }

    .testi-text {
        color: #cbd5e1;
        font-size: 0.95rem;
        line-height: 2;
        margin-bottom: 22px;
        min-height: 90px;
    }

    .testi-author {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,0.06);
    }

    .testi-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    }

    .testi-info .name {
        font-size: 0.95rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 3px;
    }

    .testi-info .role {
        font-size: 0.78rem;
        color: #64748b;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 28px;
    }

    .skill-item {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        padding: 24px 20px;
    }

        .skill-item:hover {
            border-color: rgba(59,130,246,0.4);
            transform: translateY(-4px);
        }

        .skill-item .skill-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

            .skill-item .skill-header i {
                font-size: 1.8rem;
                color: #3b82f6;
            }

            .skill-item .skill-header span {
                font-weight: 600;
            }

    .skill-progress {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.08);
        border-radius: 10px;
        overflow: hidden;
    }

        .skill-progress .bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            border-radius: 10px;
            transition: width 1.2s;
        }

    .tech-category {
        margin-bottom: 44px;
    }

    .tech-category-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
        font-weight: 700;
        color: #60a5fa;
        margin-bottom: 20px;
    }

        .tech-category-title::before {
            content: '';
            width: 4px;
            height: 1.1rem;
            background: linear-gradient(180deg, #3b82f6, #8b5cf6);
            border-radius: 4px;
        }

        .tech-category-title i {
            font-size: 1rem;
            color: #8b5cf6;
        }

    .tech-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 14px;
    }

    .tech-item {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        padding: 18px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        position: relative;
    }

        .tech-item:hover {
            transform: translateY(-6px);
            border-color: rgba(59,130,246,0.4);
        }

        .tech-item i {
            font-size: 2.2rem;
        }

        .tech-item span {
            font-size: 0.82rem;
            font-weight: 600;
            color: #b8c4d6;
        }

        .tech-item .tech-years {
            position: absolute;
            top: 8px;
            left: 8px;
            font-size: 0.62rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 20px;
            background: rgba(139,92,246,0.15);
            color: #c4b5fd;
            border: 1px solid rgba(139,92,246,0.25);
            opacity: 0;
            transition: all 0.3s;
        }

        .tech-item:hover .tech-years {
            opacity: 1;
        }

    .opensource-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 22px;
    }

    .repo-card {
        background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01));
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        padding: 24px;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
    }

        .repo-card:hover {
            transform: translateY(-8px);
            border-color: rgba(96,165,250,0.4);
        }

    .repo-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .repo-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        background: rgba(96,165,250,0.12);
        color: #60a5fa;
        border: 1px solid rgba(96,165,250,0.25);
    }

    .repo-name {
        font-size: 1.05rem;
        font-weight: 800;
        color: #fff;
        font-family: 'Fira Code', monospace;
    }

    .repo-desc {
        color: #94a3b8;
        font-size: 0.88rem;
        line-height: 1.9;
        margin-bottom: 18px;
        flex: 1;
    }

    .repo-stats {
        display: flex;
        gap: 18px;
        padding-top: 16px;
        border-top: 1px solid rgba(255,255,255,0.05);
        font-size: 0.8rem;
    }

    .repo-stat {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #94a3b8;
    }

        .repo-stat i {
            color: #fbbf24;
            font-size: 0.85rem;
        }

    .repo-lang-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-left: 4px;
    }

    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 32px;
    }

    .portfolio-item {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 24px;
        overflow: hidden;
    }

        .portfolio-item:hover {
            transform: translateY(-8px);
            border-color: rgba(59,130,246,0.4);
        }

        .portfolio-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background: #1a2636;
        }

        .portfolio-item .info {
            padding: 24px;
        }

            .portfolio-item .info h4 {
                font-size: 1.2rem;
                margin-bottom: 4px;
            }

            .portfolio-item .info p {
                color: #94a3b8;
                font-size: 0.95rem;
            }

    .case-grid {
        display: grid;
