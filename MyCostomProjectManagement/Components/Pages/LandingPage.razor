<section class="section" id="latest-blog">
    <div class="container">
        <h2 class="section-title fade-up">آخرین <span>مقالات فنی</span></h2>
        <p class="section-subtitle fade-up">مقالات تخصصی در حوزه ASP.NET Core و Blazor</p>
        @if (latestBlogs.Any())
        {
            <div class="blog-preview-grid">
