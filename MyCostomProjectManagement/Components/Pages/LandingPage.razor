<!-- REQUEST -->
<section class="section" id="request">
    <div class="container">
        <h2 class="section-title fade-up">درخواست <span>پروژه</span></h2>
        <p class="section-subtitle fade-up">پروژه خود را شرح دهید تا هماهنگ کنیم</p>
        <EditForm Model="@_createCommand" OnValidSubmit="@HandleSubmit" class="request-grid">
            <div class="request-form fade-up">
                <InputText @bind-Value="_createCommand.FullName" placeholder="نام کامل" />
                <ValidationMessage For="@(() => _createCommand.FullName)" />
                <InputText @bind-Value="_createCommand.Email" placeholder="ایمیل" type="email" />
                <ValidationMessage For="@(() => _createCommand.Email)" />
                <InputText @bind-Value="_createCommand.PhoneNumber" placeholder="شماره تماس" />
                <ValidationMessage For="@(() => _createCommand.PhoneNumber)" />
                <InputSelect @bind-Value="_createCommand.Type">
                    <option value="">نوع پروژه</option>
                    @foreach (ProjectRequestType type in Enum.GetValues(typeof(ProjectRequestType)))
                    {
                        <option value="@type">@type.GetDisplayName()</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => _createCommand.Type)" />
                <InputNumber @bind-Value="_createCommand.Price" placeholder="بودجه تقریبی (تومان)" />
                <ValidationMessage For="@(() => _createCommand.Price)" />
                <InputTextArea @bind-Value="_createCommand.Description" placeholder="توضیحات کامل پروژه..." />
                <ValidationMessage For="@(() => _createCommand.Description)" />
                <InputCheckbox @bind-Value="_createCommand.IsWasSeen" style="display:none" />
                <InputCheckbox @bind-Value="_createCommand.IsWorked" style="display:none" />
                <InputCheckbox @bind-Value="_createCommand.IsDone" style="display:none" />
                <button type="submit" class="btn-primary ripple" disabled="@_isSubmitting"><i class="fas fa-paper-plane"></i> @(_isSubmitting ? "در حال ارسال..." : "ارسال درخواست")</button>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="@(_isSuccess ? "alert-success" : "alert-danger")">@_message</div>
                }
            </div>
            <div class="request-info fade-up">
                <div class="feature-box"><i class="fas fa-clock"></i><h4>پاسخگویی سریع</h4><p>حداکثر ۲۴ ساعت پس از ثبت درخواست، تماس گرفته می‌شود.</p></div>
                <div class="feature-box"><i class="fas fa-shield-alt"></i><h4>حریم خصوصی</h4><p>اطلاعات پروژه محرمانه نگهداری می‌شود.</p></div>
                <div class="feature-box"><i class="fas fa-handshake"></i><h4>تضمین کیفیت</h4><p>یک ماه پشتیبانی رایگان پس از تحویل.</p></div>
            </div>
        </EditForm>
    </div>
</section>

