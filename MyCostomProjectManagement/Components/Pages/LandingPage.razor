        return System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object> { ["@context"] = "https://schema.org", ["@type"] = "FAQPage", ["mainEntity"] = faqItems.Select(f => new Dictionary<string, object> { ["@type"] = "Question", ["name"] = f.Question, ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = f.Answer } }).ToList() }, JsonOpts);
