    // ---- متدهای JS Interop ----
    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // اسکرول نوار
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 50);
            });

            // ریپل افکت
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // پارالاکس
            document.addEventListener('mousemove', (e) => {
                document.querySelectorAll('.parallax').forEach(el => {
                    const x = (e.clientX / window.innerWidth - 0.5) * 8;
                    const y = (e.clientY / window.innerHeight - 0.5) * 8;
                    el.style.transform = `translate(${x}px, ${y}px)`;
                });
            });

            // مشاهده اسکرول برای fade-up و نوارهای مهارت
            const fadeElements = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        const skillItem = entry.target.closest('.skill-item');
                        if (skillItem) {
                            const bar = skillItem.querySelector('.bar');
                            const progress = skillItem.dataset.progress || 0;
                            if (bar) {
                                setTimeout(() => bar.style.width = progress + '%', 300);
                            }
                        }
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });
            fadeElements.forEach(el => observer.observe(el));

            // آیتم‌هایی که از قبل در ویو هستند
            setTimeout(() => {
                fadeElements.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                        const skillItem = el.closest('.skill-item');
                        if (skillItem) {
                            const bar = skillItem.querySelector('.bar');
                            const progress = skillItem.dataset.progress || 0;
                            if (bar) bar.style.width = progress + '%';
                        }
                    }
                });
            }, 400);
        ");
    }

    // ---- متدهای اسکرول به بخش‌ها ----
    private async Task ScrollToSection(string sectionId)
    {
        await JSRuntime.InvokeVoidAsync("eval", $@"
            const element = document.getElementById('{sectionId}');
            if (element) {{
                const navbarHeight = document.querySelector('.navbar')?.offsetHeight || 80;
                const offset = element.getBoundingClientRect().top + window.pageYOffset - navbarHeight - 20;
                window.scrollTo({{ top: offset, behavior: 'smooth' }});
            }}
        ");
        // بستن منو در موبایل
        isMenuOpen = false;
        StateHasChanged();
    }

