    <div class="container">
        <h2 class="section-title fade-up">آخرین <span>مقالات فنی</span></h2>
        <p class="section-subtitle fade-up">مقالات تخصصی در حوزه ASP.NET Core و Blazor</p>
        @if (latestBlogs.Any())
        {
            <div class="blog-preview-grid">
                @foreach (var b in latestBlogs)
                {
                    <a class="blog-preview-card fade-up" href="@($"/Blogs/{Uri.EscapeDataString(b.Slug ?? "")}")">
                        <div class="blog-preview-icon"><i class="fas fa-newspaper"></i></div>
                        <div class="blog-preview-body">
                            @if (!string.IsNullOrWhiteSpace(b.Topic))
                            {
                                <div class="blog-preview-topic"><i class="fas fa-hashtag"></i> @b.Topic</div>
                            }
                            <h3>@b.Title</h3>
                            <p class="blog-preview-excerpt">@GetBlogExcerpt(b.Content)</p>
                            <div class="blog-preview-footer">
                                <span class="blog-preview-date"><i class="far fa-calendar-alt"></i> @ToPersianDate(b.CreatedAt == default ? b.CreationDate : b.CreatedAt)</span>
                                <span class="blog-preview-read">مطالعه <i class="fas fa-arrow-left"></i></span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="blog-preview-grid"><div class="blog-preview-empty"><i class="fas fa-pen-fancy" style="font-size:2rem; opacity:0.3; display:block; margin-bottom:12px;"></i>مقالات به‌زودی منتشر می‌شوند...</div></div>
        }
        <div style="text-align:center; margin-top:40px;"><a href="/Blogs" class="btn-outline ripple"><i class="fas fa-book-open"></i> مشاهده همه مقالات</a></div>
    </div>
</section>

<!-- POPULAR POSTS -->
<section class="section" id="popular-posts">
    <div class="container">
        <h2 class="section-title fade-up">مقالات <span>پرطرفدار</span></h2>
        <p class="section-subtitle fade-up">پرطرفدارترین مقالات</p>
        <div class="popular-list">
            @for (int i = 0; i < popularPosts.Count; i++)
            {
                var post = popularPosts[i];
                var rank = i + 1;
                <a href="@post.Link" class="popular-item fade-up">
                    <div class="popular-rank">@rank</div>
                    <div class="popular-body">
                        <div class="popular-topic"><i class="fas fa-hashtag"></i> @post.Topic</div>
                        <div class="popular-title">@post.Title</div>
                        <div class="popular-meta"><span><i class="fas fa-eye"></i> @post.Views بازدید</span><span><i class="far fa-calendar"></i> @post.Date</span></div>
                    </div>
                    <div class="popular-arrow"><i class="fas fa-arrow-left"></i></div>
                </a>
            }
        </div>
    </div>
</section>

