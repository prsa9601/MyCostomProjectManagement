<!-- INTERVIEW SIM -->
<section class="section" id="interview-sim">
    <div class="container">
        <h2 class="section-title fade-up">پاسخ به <span>سوالات فنی</span></h2>
        <p class="section-subtitle fade-up">۸ سؤال کلیدی معماری و پاسخ‌های من</p>
        <div class="interview-sim-wrapper fade-up">
            <div class="interview-questions">
                @for (int i = 0; i < interviewBank.Count; i++)
                {
                    var idx = i;
                    var qNum = (i + 1).ToString();
                    <button class="interview-q-btn @(intSelectedQuestion == idx ? "active" : "")" @onclick="() => intSelectedQuestion = idx">
                        <span class="q-num">@qNum</span>
                        <span>@interviewBank[idx].Question</span>
                    </button>
                }
            </div>
            @if (interviewBank.Any() && intSelectedQuestion < interviewBank.Count)
            {
                var current = interviewBank[intSelectedQuestion];
                <div class="interview-answer">
                    <div class="interview-answer-header"><div class="interview-answer-num">Q@(intSelectedQuestion + 1)</div><h3>@current.Question</h3></div>
                    <span class="interview-answer-tag"><i class="fas fa-tag"></i> @current.Tag</span>
                    <div class="interview-answer-body">
                        <p>@current.AnswerIntro</p><ul>
                        @foreach (var pt in current.BulletPoints)
                        {
                            <li>@pt</li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>
</section>

<!-- FIT QUIZ -->
<section class="section" id="hiring-quiz">
    <div class="container">
        <h2 class="section-title fade-up">تطبیق <span>رویکرد</span></h2>
        <p class="section-subtitle fade-up">۴ سؤال کوتاه برای بررسی تناسب رویکرد کاری</p>
        <div class="quiz-wrapper fade-up">
            @if (!quizFinished)
            {
                <div class="quiz-progress">
                    @for (int i = 0; i < quizQuestions.Count; i++)
                    {
                        var dotClass = i < quizCurrentIndex ? "done" : (i == quizCurrentIndex ? "active" : "");
                        <div class="quiz-progress-dot @dotClass"></div>
                    }
                </div>
                <div class="quiz-question-box">
                    <span class="quiz-q-num">سؤال @(quizCurrentIndex + 1) از @quizQuestions.Count</span>
                    <div class="quiz-question">@quizQuestions[quizCurrentIndex].Question</div>
                    <div class="quiz-options">
                        @for (int i = 0; i < quizQuestions[quizCurrentIndex].Options.Count; i++)
                        {
                            var optIdx = i;
                            var letter = ((char)('A' + i)).ToString();
                            <button class="quiz-option" @onclick="() => AnswerQuiz(optIdx)"><span class="opt-letter">@letter</span>@quizQuestions[quizCurrentIndex].Options[optIdx].Text</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="quiz-result" style="animation: fadeIn 0.5s ease;">
                    <span class="quiz-result-emoji">@GetQuizEmoji()</span>
                    <div class="quiz-result-title" style="color: @GetQuizColor();">@GetQuizTitle()</div>
                    
                    <!-- نوار پیشرفت داینامیک -->
