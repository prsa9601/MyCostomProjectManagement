@code {
    private DateTime birthDate = new DateTime(2004, 7, 1);

    private int GetAge()
    {
        var today = DateTime.Today;
        var age = today.Year - birthDate.Year;
        if (birthDate.Date > today.AddYears(-age)) age--;
        return age;
    }

    private int GetExperience()
    {
        return GetAge() - 18;
    }
}

