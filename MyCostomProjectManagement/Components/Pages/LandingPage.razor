        .nav-links {
            display: none;
            flex-direction: column;
            width: 100%;
            background: rgba(10,14,23,0.95);
            backdrop-filter: blur(12px);
            padding: 20px 0;
            gap: 16px;
            border-top: 1px solid rgba(255,255,255,0.06);
            margin-top: 12px;
            border-radius: 20px;
