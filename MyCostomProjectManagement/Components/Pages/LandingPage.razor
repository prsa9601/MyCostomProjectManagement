                font-size: 0.7rem;
                margin-top: 5px;
                flex-shrink: 0;
            }

    .ltc-plan .btn-ltc {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 10px 16px;
        border-radius: 40px;
        font-weight: 700;
        font-size: 0.84rem;
        text-decoration: none;
        border: 1.5px solid rgba(59,130,246,0.4);
        background: transparent;
        color: #93c5fd;
        cursor: pointer;
        font-family: inherit;
    }

    .ltc-plan.highlight .btn-ltc {
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        color: #fff;
        border-color: transparent;
    }

    .edu-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .edu-card {
        background: linear-gradient(180deg, rgba(52,211,153,0.05), rgba(59,130,246,0.02));
        border: 1.5px solid rgba(52,211,153,0.18);
        border-radius: 18px;
        padding: 24px 22px;
    }

        .edu-card:hover {
            transform: translateY(-5px);
            border-color: rgba(52,211,153,0.4);
        }

    .edu-type {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 20px;
        background: rgba(52,211,153,0.15);
        color: #34d399;
        border: 1px solid rgba(52,211,153,0.3);
        margin-bottom: 12px;
    }

    .edu-card h4 {
        font-size: 1rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 8px;
        line-height: 1.5;
    }

    .edu-card p {
        color: #94a3b8;
        font-size: 0.85rem;
        line-height: 1.85;
        margin: 0 0 14px 0;
    }

    .edu-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,0.06);
        font-size: 0.72rem;
        color: #64748b;
    }

        .edu-meta span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .edu-meta i {
            color: #60a5fa;
        }

    .edu-card .btn-edu {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 12px;
        color: #34d399;
        font-size: 0.8rem;
        font-weight: 700;
        text-decoration: none;
    }

    @@keyframes float {
        0% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-12px);
        }

        100% {
            transform: translateY(0);
        }
    }

    .float-icon {
        animation: float 4s ease-in-out infinite;
    }

    .float-icon-delay {
        animation-delay: 1s;
    }

    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.3);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .alert-success, .alert-danger {
        margin-top: 14px;
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .alert-success {
        background: rgba(16,185,129,0.12);
        color: #34d399;
        border: 1px solid rgba(16,185,129,0.2);
    }

    .alert-danger {
        background: rgba(239,68,68,0.12);
        color: #f87171;
        border: 1px solid rgba(239,68,68,0.2);
    }

    @@media (max-width: 992px) {
        .about-grid, .contact-wrapper, .request-grid, .ideal-role-wrapper {
            grid-template-columns: 1fr;
        }

        .hero h1 {
            font-size: 3.2rem;
        }

        .services-grid {
            grid-template-columns: 1fr 1fr;
        }

        .process-timeline {
            grid-template-columns: repeat(2, 1fr);
            gap: 32px;
        }

            .process-timeline::before {
                display: none;
            }

        .consult-card.featured {
            transform: scale(1);
        }

        .trust-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .trust-item:nth-child(2)::after {
            display: none;
        }

        .capacity-grid {
            grid-template-columns: repeat(6, 1fr);
        }

        .interview-sim-wrapper {
            grid-template-columns: 1fr;
        }

        .interview-questions {
            max-height: 240px;
        }

        .pricing-card.featured {
            transform: scale(1);
        }

        .fpd-hero-metrics {
            grid-template-columns: repeat(2, 1fr);
        }

        .fpd-grid {
            grid-template-columns: 1fr;
        }

        .qs-wrapper {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .hero h1 {
            font-size: 2.8rem;
        }

        .skills-grid, .services-grid {
            grid-template-columns: 1fr;
        }

        .section {
            padding: 60px 0;
        }

        .section-title {
            font-size: 2rem;
        }

        .live-stats-row {
            grid-template-columns: 1fr;
        }

        .cost-breakdown-row {
            grid-template-columns: 110px 1fr 70px;
            gap: 8px;
        }

        .cost-breakdown-label {
            font-size: 0.78rem;
        }

        .journey-story-chapter {
            grid-template-columns: 70px 1fr;
            gap: 16px;
        }

        .journey-story-chapter-num {
            width: 70px;
            height: 70px;
            border-radius: 18px;
        }

            .journey-story-chapter-num .num {
                font-size: 1.3rem;
            }

            .journey-story-chapter-num .lbl {
                font-size: 0.55rem;
            }

        .journey-story-chapter:not(:last-child)::after {
            right: 34px;
            top: 70px;
        }
    }

    @@media (max-width: 600px) {
        .process-timeline {
            grid-template-columns: 1fr;
            gap: 26px;
        }

        .process-icon {
            width: 68px;
            height: 68px;
            font-size: 1.5rem;
            margin-bottom: 16px;
        }

        .case-metrics {
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .case-metric-value {
            font-size: 1.1rem;
        }

        .comm-timeline {
            padding-right: 25px;
        }

        .comm-dot {
            right: -34px;
            width: 16px;
            height: 16px;
        }

        .capacity-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .arch-layer::before {
            display: none;
        }

        .fpd-hero {
            padding: 24px 20px;
        }

            .fpd-hero h3 {
                font-size: 1.3rem;
            }

        .security-hero {
            padding: 24px 20px;
        }

        .wrs-body {
            padding: 20px 18px;
        }

        .intl-map {
            padding: 24px 20px;
        }
    }

    @@media (max-width: 500px) {
        .tech-grid {
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 10px;
        }

        .tech-item {
            padding: 14px 8px;
        }

            .tech-item i {
                font-size: 1.8rem;
            }

            .tech-item span {
                font-size: 0.72rem;
            }
    }

    @@media (max-width: 480px) {
        .hero h1 {
            font-size: 2.2rem;
        }

        .portfolio-grid, .about-stats {
            grid-template-columns: 1fr;
        }

        .container {
            padding: 0 16px;
        }

        .hero {
            padding: 120px 0 60px;
        }

        .hero-actions {
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

            .hero-actions .btn-primary, .hero-actions .btn-outline {
                width: 100%;
                justify-content: center;
            }

        .trust-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="bg-particles"><span></span><span></span><span></span><span></span><span></span></div>

<!-- HERO -->
<section class="hero">
    <div class="container">
        <div class="hero-badge"><i class="fas fa-code"></i> توسعه‌دهنده بک‌اند</div>
        <h1>
            <span class="typewriter"><span class="text">@typewriterText</span><span class="cursor"></span></span>
            <br />
            <span style="background:linear-gradient(to left,#f0f4ff,#94a3b8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">توسعه‌دهنده وب</span>
        </h1>
        <p>توسعه بک‌اند با ASP.NET Core و Blazor. طراحی APIهای مقیاس‌پذیر، ساخت داشبوردهای مدیریتی و پیاده‌سازی معماری تمیز.</p>
        <div class="hero-actions">
            <button @onclick='() => ScrollToSection("portfolio")' class="btn-primary ripple"><i class="fas fa-eye"></i> نمونه‌کارها</button>
            <button @onclick='() => ScrollToSection("contact")' class="btn-outline ripple"><i class="fas fa-paper-plane"></i> شروع همکاری</button>
        </div>
    </div>
</section>

<!-- TRUST BAR -->
<section class="trust-bar">
    <div class="container">
        <div class="trust-grid">
            @foreach (var t in trustStats)
            {
                <div class="trust-item"><div class="num">@t.Number</div><div class="lbl">@t.Label</div></div>
            }
        </div>
    </div>
</section>

<!-- ABOUT -->
<section class="section" id="about">
    <div class="container">
        <h2 class="section-title fade-up">درباره <span>من</span></h2>
        <p class="section-subtitle fade-up">توسعه‌دهنده بک‌اند با تمرکز بر کیفیت، معماری و مقیاس‌پذیری</p>
        <div class="about-grid">
            <div class="about-text fade-up">
                <p>من محمد پارسا کریمی هستم، توسعه‌دهنده‌ی <strong>سی‌شارپ</strong> و <strong>دات‌نت</strong> با @GetExperience() سال تجربه در ساخت اپلیکیشن‌های وب و APIهای production.</p>
                <p>تمرکز من روی <strong>بک‌اند</strong> با <strong>ASP.NET Core</strong>، طراحی <strong>API</strong>های مقیاس‌پذیر و ساخت <strong>داشبورد</strong>های مدیریتی است.</p>
                <div class="about-stats">
                    @foreach (var stat in stats)
                    {
                        <div class="stat-item"><div class="number">@stat.CurrentValue</div><div class="label">@stat.Label</div></div>
                    }
                </div>
            </div>
            <div class="about-image fade-up"><i class="fas fa-user-astronaut float-icon"></i></div>
        </div>
    </div>
</section>

<!-- HOW I WORK -->
<section class="section" id="why-me">
    <div class="container">
        <h2 class="section-title fade-up">روش <span>کار من</span></h2>
        <p class="section-subtitle fade-up">اصولی که در هر پروژه رعایت می‌کنم</p>
        <div class="why-me-grid">
            <div class="why-card fade-up"><div class="why-icon"><i class="fas fa-medal"></i></div><h3>تجربه عملی</h3><p>@GetExperience() سال کار در پروژه‌های شخصی، فریلنسری و تیمی.</p></div>
            <div class="why-card fade-up"><div class="why-icon"><i class="fas fa-code-branch"></i></div><h3>کیفیت کد</h3><p>پیروی از Clean Architecture، SOLID و استانداردهای کدنویسی.</p></div>
            <div class="why-card fade-up"><div class="why-icon"><i class="fas fa-headset"></i></div><h3>پاسخگویی سریع</h3><p>پاسخ در کمتر از ۲۴ ساعت، در تمام طول همکاری.</p></div>
            <div class="why-card fade-up"><div class="why-icon"><i class="fas fa-hand-holding-dollar"></i></div><h3>شفافیت کامل</h3><p>برآورد دقیق زمان و هزینه پیش از شروع کار.</p></div>
            <div class="why-card fade-up"><div class="why-icon"><i class="fas fa-tachometer-alt"></i></div><h3>تعهد به زمان</h3><p>پروژه‌ها با برنامه هفتگی دقیق پیش می‌روند.</p></div>
            <div class="why-card fade-up"><div class="why-icon"><i class="fas fa-sync-alt"></i></div><h3>به‌روز بودن</h3><p>کار با آخرین نسخه .NET، Blazor و تکنولوژی‌های جدید.</p></div>
        </div>
    </div>
</section>

<!-- CAREER -->
<section class="section" id="achievements">
    <div class="container">
        <h2 class="section-title fade-up">کارنامه <span>حرفه‌ای</span></h2>
        <p class="section-subtitle fade-up">خلاصه‌ای از فعالیت‌های حرفه‌ای</p>
        <div class="achievements-grid">
            @foreach (var a in achievements)
            {
                <div class="achievement-card fade-up">
                    <div class="achievement-icon"><i class="@a.Icon"></i></div>
                    <div class="achievement-number">@a.Number</div>
                    <div class="achievement-label">@a.Label</div>
                    <div class="achievement-desc">@a.Desc</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- FEATURED PROJECT -->
<section class="section" id="featured-project">
    <div class="container">
        <h2 class="section-title fade-up">پروژه <span>برجسته</span></h2>
        <p class="section-subtitle fade-up">تحلیل عمیق یک پروژه واقعی — از چالش تا نتیجه</p>
        <div class="fpd-wrapper">
            @if (featuredProject != null)
            {
                <div class="fpd-hero fade-up">
                    <span class="fpd-hero-badge"><i class="fas fa-star"></i> @featuredProject.Badge</span>
                    <h3>@featuredProject.Title</h3>
                    <p class="fpd-summary">@featuredProject.Summary</p>
                    <div class="fpd-hero-metrics">
                        @foreach (var m in featuredProject.Metrics)
                        {
                            <div class="fpd-hero-metric"><div class="val">@m.Value</div><div class="lbl">@m.Label</div></div>
                        }
                    </div>
                </div>
                <div class="fpd-grid">
                    <div class="fpd-card fade-up"><div class="fpd-card-header"><i class="fas fa-exclamation-triangle"></i><h4>چالش</h4></div><p>@featuredProject.Challenge</p></div>
                    <div class="fpd-card fade-up"><div class="fpd-card-header"><i class="fas fa-lightbulb"></i><h4>راه‌حل</h4></div><p>@featuredProject.Solution</p></div>
                    <div class="fpd-card fade-up"><div class="fpd-card-header"><i class="fas fa-layer-group"></i><h4>معماری</h4></div><ul>@foreach (var a in featuredProject.Architecture) {
                        <li>@a</li>
                    }
                </ul></div>
                <div class="fpd-card fade-up"><div class="fpd-card-header"><i class="fas fa-check-circle"></i><h4>نتایج</h4></div><ul>@foreach (var r in featuredProject.Results) {
                    <li>@r</li>
                }
            </ul></div>
        </div>
    }
</div>
</div>
</section>

<!-- JOURNEY STORY -->
<section class="section" id="journey-story">
    <div class="container">
        <h2 class="section-title fade-up">مسیر <span>حرفه‌ای</span></h2>
        <p class="section-subtitle fade-up">از اولین خط کد تا امروز — بدون اغراق</p>
        <div class="journey-story-wrapper">
            <div class="journey-story-intro fade-up"><p>هر توسعه‌دهنده مسیر خودش را دارد. این مسیر من است — واقعی و بدون بزرگ‌نمایی.</p></div>
            <div class="journey-story-chapters">
                @foreach (var jc in journeyChapters)
                {
                    <div class="journey-story-chapter fade-up">
                        <div class="journey-story-chapter-num"><span class="num">@jc.Num</span><span class="lbl">@jc.Label</span></div>
                        <div class="journey-story-chapter-body"><h3>@jc.Title</h3><p>@jc.Text</p></div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- CAREER TIMELINE -->
<section class="section" id="career">
    <div class="container">
        <h2 class="section-title fade-up">مسیر <span>کاری</span></h2>
        <p class="section-subtitle fade-up">از اولین خط کد تا امروز</p>
        <div class="comm-timeline">
            @foreach (var c in careerSteps)
            {
                <div class="comm-step fade-up">
                    <div class="comm-dot"></div>
                    <div class="comm-body">
                        <span class="comm-time">@c.Year</span>
                        <h4><i class="@c.Icon" style="color:#60a5fa; margin-left:6px;"></i> @c.Title</h4>
                        <div style="color:#8b5cf6; font-size:0.82rem; font-weight:600; margin-bottom:8px;">@c.Company</div>
                        <p>@c.Desc</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- PHILOSOPHY -->
<section class="section" id="philosophy">
    <div class="container">
        <h2 class="section-title fade-up">اصول <span>کاری</span></h2>
        <p class="section-subtitle fade-up">اصولی که در هر خط کد رعایت می‌کنم</p>
        <div class="why-me-grid">
            @foreach (var p in philosophy)
            {
                <div class="why-card fade-up">
                    <div class="why-icon"><i class="@p.Icon"></i></div>
                    <h3>@p.Title</h3>
                    <p>@p.Desc</p>
                    <div style="margin-top:14px; padding-top:12px; border-top:1px dashed rgba(255,255,255,0.06); font-size:0.78rem; font-style:italic; color:#64748b;">"@p.Quote"</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CERTIFICATIONS -->
<section class="section" id="certifications">
    <div class="container">
        <h2 class="section-title fade-up">مدارک <span>تخصصی</span></h2>
        <p class="section-subtitle fade-up">مدارک تخصصی دریافت‌شده</p>
        <div class="cert-grid">
            @foreach (var c in certifications)
            {
                <div class="cert-card fade-up">
                    <div class="cert-icon"><i class="@c.Icon"></i></div>
                    <div class="cert-body"><h3>@c.Title</h3><div class="issuer">@c.Issuer</div><div class="cert-meta"><span>@c.Year</span><span>@c.Level</span></div></div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ADR -->
<section class="section" id="adr">
    <div class="container">
        <h2 class="section-title fade-up">تصمیمات <span>معماری (ADR)</span></h2>
        <p class="section-subtitle fade-up">سند تصمیمات کلیدی معماری — استاندارد صنعتی</p>
        <div class="adr-grid">
            @foreach (var adr in adrRecords)
            {
                <div class="adr-card fade-up">
                    <span class="adr-num">ADR-@adr.Number</span>
                    <h3>@adr.Title</h3>
                    <span class="adr-status @adr.Status">@adr.StatusLabel</span>
                    <div class="adr-block"><div class="adr-block-label">Context</div><p>@adr.Context</p></div>
                    <div class="adr-block"><div class="adr-block-label">Decision</div><p>@adr.Decision</p></div>
                    <div class="adr-block"><div class="adr-block-label">Consequences</div><p>@adr.Consequences</p></div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ARCHITECTURE -->
<section class="section" id="architecture">
    <div class="container">
        <h2 class="section-title fade-up">معماری <span>Clean</span></h2>
        <p class="section-subtitle fade-up">معماری با لایه‌های مستقل و قابل تست</p>
        <div class="arch-diagram">
            @foreach (var layer in archLayers)
            {
                <div class="arch-layer @layer.CssClass fade-up" data-num="@layer.Number">
                    <div class="layer-info"><h4>@layer.Title</h4><p>@layer.Desc</p></div>
                    <div class="layer-icon"><i class="@layer.Icon"></i></div>
                </div>
                @if (!layer.IsLast)
                {
                    <div class="arch-arrow"><i class="fas fa-arrow-down"></i></div>
                }
            }
        </div>
    </div>
</section>

<!-- CODE REVIEW -->
<section class="section" id="code-review">
    <div class="container">
        <h2 class="section-title fade-up">نمونه <span>Code Review</span></h2>
        <p class="section-subtitle fade-up">نمونه‌ای از سبک بازبینی کد من</p>
        <div class="code-review-wrapper fade-up">
            <div class="code-review-header">
                <div class="code-review-header-title"><i class="fab fa-github"></i><span>PR #142 — Feature: Add Payment Gateway</span></div>
                <span class="code-review-badge"><i class="fas fa-check-circle"></i> Approved with suggestions</span>
            </div>
            @foreach (var cr in codeReviewComments)
            {
                <div class="code-review-comment">
                    <div class="code-review-comment-header"><div class="code-review-comment-avatar">م</div><div><div class="code-review-comment-author">@cr.Author</div><div class="code-review-comment-time">@cr.Time</div></div></div>
                    <div class="code-review-comment-body">@cr.Comment</div>
                    @if (!string.IsNullOrEmpty(cr.CodeSnippet))
                    {
                        <div class="code-review-code">@cr.CodeSnippet</div>
                    }
                    @if (!string.IsNullOrEmpty(cr.Suggestion))
                    {
                        <div class="code-review-suggestion">@cr.Suggestion</div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- SERVICES -->
<section class="section" id="services">
    <div class="container">
        <h2 class="section-title fade-up">خدمات <span>برنامه نویسی</span></h2>
        <p class="section-subtitle fade-up">طراحی سایت، توسعه API و ساخت داشبورد</p>
        <div class="services-grid">
            <div class="service-card fade-up"><div class="service-icon"><i class="fas fa-globe"></i></div><h3>طراحی سایت</h3><p>ساخت وب‌سایت‌های سریع، امن و مقیاس‌پذیر با ASP.NET Core و Blazor.</p></div>
            <div class="service-card fade-up"><div class="service-icon"><i class="fas fa-code"></i></div><h3>توسعه API</h3><p>طراحی APIهای مقیاس‌پذیر با احراز هویت JWT و مستندات Swagger.</p></div>
            <div class="service-card fade-up"><div class="service-icon"><i class="fas fa-chart-line"></i></div><h3>داشبورد مدیریتی</h3><p>ساخت داشبوردهای تحلیلی با نمودار و گزارش‌گیری پیشرفته.</p></div>
            <div class="service-card fade-up"><div class="service-icon"><i class="fas fa-cubes"></i></div><h3>پروژه‌های Blazor</h3><p>ساخت اپلیکیشن‌های وب مدرن و تعاملی با Blazor Server و WASM.</p></div>
            <div class="service-card fade-up"><div class="service-icon"><i class="fas fa-database"></i></div><h3>پایگاه داده</h3><p>طراحی و بهینه‌سازی پایگاه داده SQL Server و PostgreSQL.</p></div>
            <div class="service-card fade-up"><div class="service-icon"><i class="fas fa-cloud"></i></div><h3>میکروسرویس</h3><p>طراحی معماری میکروسرویس، Dockerize و استقرار ابری.</p></div>
        </div>
    </div>
</section>

<!-- WAR STORIES -->
<section class="section" id="war-stories">
    <div class="container">
        <h2 class="section-title fade-up">موارد <span>واقعی</span></h2>
        <p class="section-subtitle fade-up">۳ مشکل واقعی که در production حل کردم — با عدد و نتیجه</p>
        <div class="war-stories-grid">
            @foreach (var ws in warStories)
            {
                <div class="war-story-card fade-up">
                    <span class="war-story-badge"><i class="fas fa-fire"></i> @ws.Badge</span>
                    <h3>@ws.Title</h3>
                    <div class="war-story-section"><div class="war-story-section-label">مشکل</div><p>@ws.Problem</p></div>
                    <div class="war-story-section"><div class="war-story-section-label">راه‌حل</div><p>@ws.Solution</p></div>
                    <div class="war-story-section"><div class="war-story-section-label">نتیجه</div><p>@ws.Result</p></div>
                    <div class="war-story-metrics">
                        @foreach (var m in ws.Metrics)
                        {
                            <span class="war-story-metric"><i class="fas fa-arrow-trend-up"></i> @m</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- WORKSHOPS -->
<section class="section" id="workshops">
    <div class="container">
        <h2 class="section-title fade-up">کارگاه‌های <span>تخصصی</span></h2>
        <p class="section-subtitle fade-up">آموزش تیم شما در موضوعات تخصصی .NET</p>
        <div class="workshops-grid">
            @foreach (var w in workshops)
            {
                <div class="workshop-card fade-up">
                    <span class="workshop-level">@w.Level</span>
                    <div class="workshop-icon"><i class="@w.Icon"></i></div>
                    <h3>@w.Title</h3>
                    <p>@w.Description</p>
                    <div class="workshop-meta">
                        <span><i class="far fa-clock"></i> @w.Duration</span>
                        <span><i class="fas fa-users"></i> @w.Participants</span>
                        <span><i class="fas fa-laptop"></i> @w.Format</span>
                    </div>
                    <div class="workshop-price"><span class="num">@w.Price</span><span class="unit">@w.Unit</span></div>
                    <a href="/#contact" class="btn-workshop"><i class="fas fa-paper-plane"></i> درخواست کارگاه</a>
                </div>
            }
        </div>
    </div>
</section>

<!-- SECURITY PROTOCOL -->
<section class="section" id="security-protocol">
    <div class="container">
        <h2 class="section-title fade-up">پروتکل <span>امنیتی</span></h2>
        <p class="section-subtitle fade-up">چک‌لیست امنیتی در هر پروژه — بر اساس OWASP Top 10</p>
        <div class="security-wrapper">
            <div class="security-hero fade-up">
                <div class="security-hero-icon"><i class="fas fa-shield-halved"></i></div>
                <div class="security-hero-text"><h3>امنیت، بخشی از تحویل است</h3><p>هر پروژه با بررسی امنیتی کامل و پوشش OWASP Top 10 تحویل داده می‌شود.</p></div>
            </div>
            <div class="security-cats">
                @foreach (var cat in securityCategories)
                {
                    <div class="security-cat fade-up">
                        <div class="security-cat-header"><div class="security-cat-header-icon"><i class="@cat.Icon"></i></div><h4>@cat.Title</h4></div>
                        <ul class="security-items">@foreach (var item in cat.Items) {
                            <li><i class="fas fa-check"></i> @item</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
</section>

<!-- PROCESS -->
<section class="section" id="process">
    <div class="container">
        <h2 class="section-title fade-up">فرآیند <span>همکاری</span></h2>
        <p class="section-subtitle fade-up">از اولین تماس تا تحویل پروژه، در ۵ مرحله</p>
        <div class="process-timeline">
            <div class="process-step fade-up"><div class="process-number">۰۱</div><div class="process-icon"><i class="fas fa-comments"></i></div><h3>مشاوره و تحلیل</h3><p>بررسی دقیق نیازها و ارائه راه‌حل فنی — رایگان.</p></div>
            <div class="process-step fade-up"><div class="process-number">۰۲</div><div class="process-icon"><i class="fas fa-drafting-compass"></i></div><h3>طراحی</h3><p>طراحی معماری، انتخاب تکنولوژی و زمان‌بندی.</p></div>
            <div class="process-step fade-up"><div class="process-number">۰۳</div><div class="process-icon"><i class="fas fa-code"></i></div><h3>توسعه</h3><p>کدنویسی تمیز، مستندسازی و دموی هفتگی.</p></div>
            <div class="process-step fade-up"><div class="process-number">۰۴</div><div class="process-icon"><i class="fas fa-vial-circle-check"></i></div><h3>تست</h3><p>اجرای Unit Test و Integration Test.</p></div>
            <div class="process-step fade-up"><div class="process-number">۰۵</div><div class="process-icon"><i class="fas fa-rocket"></i></div><h3>تحویل و پشتیبانی</h3><p>استقرار، آموزش و ۳۰ روز پشتیبانی رایگان.</p></div>
        </div>
    </div>
</section>

<!-- KPIs -->
<section class="section" id="kpis">
    <div class="container">
        <h2 class="section-title fade-up">شاخص‌های <span>کیفیت</span></h2>
        <p class="section-subtitle fade-up">شاخص‌های قابل اندازه‌گیری همکاری</p>
        <div class="kpi-grid">
            @foreach (var k in workKpis)
            {
                <div class="kpi-card fade-up">
                    <div class="kpi-icon"><i class="@k.Icon"></i></div>
                    <div class="kpi-value">@k.Value</div>
                    <div class="kpi-label">@k.Label</div>
                    <div class="kpi-desc">@k.Desc</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- RISK -->
<section class="section" id="risk-register">
    <div class="container">
        <h2 class="section-title fade-up">ریسک‌ها و <span>مدیریت آن‌ها</span></h2>
        <p class="section-subtitle fade-up">ریسک‌های فعال و برنامه کاهش آن‌ها</p>
        <div class="risk-wrapper fade-up">
            <table class="risk-table">
                <thead><tr><th>ریسک</th><th>سطح</th><th>راهکار کاهش</th><th>مالک</th></tr></thead>
                <tbody>
                    @foreach (var r in riskRegister)
                    {
                        <tr><td>@r.Risk</td><td><span class="risk-level @r.Level">@r.LevelLabel</span></td><td>@r.Mitigation</td><td>@r.Owner</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- QUICK START -->
<section class="section" id="quick-start">
    <div class="container">
        <h2 class="section-title fade-up">شروع <span>سریع</span></h2>
        <p class="section-subtitle fade-up">برای پروژه‌های کوچک و MVP — دو مسیر شروع</p>
        <div class="qs-wrapper">
            @foreach (var qs in quickStartOptions)
            {
                <div class="qs-col fade-up @(qs.IsFeatured ? "featured" : "")">
                    <div class="qs-col-icon"><i class="@qs.Icon"></i></div>
                    <h3>@qs.Title</h3>
                    <p class="qs-desc">@qs.Description</p>
                    <div class="qs-timeline">
                        @for (int i = 0; i < qs.Steps.Count; i++)
                        {
                            <div class="qs-step"><span class="qs-step-num">@(i + 1)</span><span>@qs.Steps[i]</span></div>
                        }
                    </div>
                    <div class="qs-price"><span class="num">@qs.Price</span><span class="unit">@qs.Unit</span></div>
                    <a href="/#contact" class="btn-qs @(qs.IsFeatured ? "primary" : "outline")"><i class="fas fa-rocket"></i> @qs.ButtonText</a>
                </div>
            }
        </div>
    </div>
</section>

<!-- INTERNATIONAL -->
<section class="section" id="international">
    <div class="container">
        <h2 class="section-title fade-up">تجربه <span>بین‌المللی</span></h2>
        <p class="section-subtitle fade-up">همکاری با کارفرمایان خارج از ایران</p>
        <div class="intl-wrapper">
            <div class="intl-map fade-up">
                <h3>همکاری با کارفرمایان از</h3>
                <p>تجربه همکاری Remote با تیم‌ها و کارفرمایان بین‌المللی</p>
                <div class="intl-countries">
                    @foreach (var c in intlCountries)
                    {
                        <div class="intl-country"><span class="flag">@c.Flag</span><span class="name">@c.Name</span><span class="tag">@c.Tag</span></div>
                    }
                </div>
            </div>
            <div class="intl-projects">
                @foreach (var p in intlProjects)
                {
                    <div class="intl-project fade-up">
                        <div class="intl-project-header"><span class="intl-project-flag">@p.Flag</span><div><h4>@p.Title</h4><span class="country">@p.Country</span></div></div>
                        <p>@p.Description</p>
                        <div class="intl-project-tags">@foreach (var t in p.Tags) {
                            <span>@t</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
</section>

<!-- QUARTERLY STACK -->
<section class="section" id="quarterly-stack">
    <div class="container">
        <h2 class="section-title fade-up">استک <span>فصلی</span></h2>
        <p class="section-subtitle fade-up">ابزارهای فعلی — به‌روزرسانی هر فصل</p>
        <div class="qstack-wrapper">
            <div class="qstack-header fade-up">
                <span class="qstack-quarter"><i class="far fa-calendar"></i> @currentQuarter</span>
                <p>ابزارها و تکنولوژی‌هایی که در این فصل استفاده می‌کنم</p>
            </div>
            <div class="qstack-cats">
                @foreach (var cat in quarterlyStack)
                {
                    <div class="qstack-cat fade-up">
                        <div class="qstack-cat-header"><i class="@cat.Icon"></i><h4>@cat.Category</h4>@if (!string.IsNullOrEmpty(cat.ChangeType)) {
                            <span class="qstack-change @cat.ChangeType">@cat.ChangeLabel</span>
                        }
                    </div>
                    <div class="qstack-chips">@foreach (var item in cat.Items) {
                        <span class="qstack-chip"><i class="@item.Icon"></i> @item.Name</span>
                    }
                </div>
            </div>
        }
    </div>
</div>
</div>
</section>

<!-- WEEKLY REPORT -->
<section class="section" id="weekly-report">
    <div class="container">
        <h2 class="section-title fade-up">نمونه <span>گزارش هفتگی</span></h2>
        <p class="section-subtitle fade-up">فرمت گزارش‌هایی که هر هفته دریافت می‌کنید</p>
        <div class="wrs-wrapper fade-up">
            <div class="wrs-toolbar"><div class="wrs-toolbar-left"><i class="fas fa-file-alt"></i><span>گزارش-هفتگی-نمونه.pdf</span></div><span class="wrs-toolbar-badge">نمونه واقعی</span></div>
            <div class="wrs-body">
                <div class="wrs-header"><h3>گزارش هفتگی پروژه فین‌تک</h3><span class="wrs-week">هفته ۴ — ۱۴۰۴/۰۳/۱۵</span></div>
                <div class="wrs-summary">
                    <div class="wrs-summary-item"><div class="val">۱۲</div><div class="lbl">تسک انجام‌شده</div></div>
                    <div class="wrs-summary-item"><div class="val">۹۸٪</div><div class="lbl">پیشرفت هفته</div></div>
                    <div class="wrs-summary-item"><div class="val">۲</div><div class="lbl">تسک در حال انجام</div></div>
                    <div class="wrs-summary-item"><div class="val">۴۵٪</div><div class="lbl">پیشرفت کلی</div></div>
                </div>
                <div class="wrs-section">
                    <div class="wrs-section-title"><i class="fas fa-check-circle"></i> کارهای انجام‌شده</div>
                    <div class="wrs-tasks">
                        <div class="wrs-task"><span class="wrs-task-status done"><i class="fas fa-check"></i></span><div class="wrs-task-body"><h5>پیاده‌سازی Endpoint احراز هویت</h5><p>JWT + Refresh Token — تست شده و مستند</p></div></div>
                        <div class="wrs-task"><span class="wrs-task-status done"><i class="fas fa-check"></i></span><div class="wrs-task-body"><h5>اتصال به درگاه زرین‌پال</h5><p>تست موفق در Sandbox — آماده Production</p></div></div>
                        <div class="wrs-task"><span class="wrs-task-status done"><i class="fas fa-check"></i></span><div class="wrs-task-body"><h5>Unit Test های لایه Domain</h5><p>پوشش تست به ۸۵٪ رسید</p></div></div>
                    </div>
                </div>
                <div class="wrs-section">
                    <div class="wrs-section-title"><i class="fas fa-spinner"></i> در حال انجام</div>
                    <div class="wrs-tasks">
                        <div class="wrs-task"><span class="wrs-task-status progress"><i class="fas fa-ellipsis-h"></i></span><div class="wrs-task-body"><h5>داشبورد مدیریت</h5><p>۶۰٪ تکمیل — تحویل هفته آینده</p></div></div>
                    </div>
                </div>
                <div class="wrs-next"><strong style="color:#60a5fa;">برنامه هفته آینده: </strong><p>تکمیل داشبورد مدیریت، اتصال به آیدی‌پی، پیاده‌سازی گزارش‌گیری و شروع Integration Tests.</p></div>
            </div>
        </div>
    </div>
</section>

<!-- AGILE -->
<section class="section" id="agile">
    <div class="container">
        <h2 class="section-title fade-up">کار تیمی و <span>روش Agile</span></h2>
        <p class="section-subtitle fade-up">روش کار در تیم‌های فنی</p>
        <div class="agile-grid">
            @foreach (var ag in agilePractices)
            {
                <div class="agile-card fade-up"><div class="agile-icon"><i class="@ag.Icon"></i></div><h3>@ag.Title</h3><p>@ag.Desc</p></div>
            }
        </div>
    </div>
</section>

<!-- TESTIMONIALS -->
<section class="section" id="testimonials">
    <div class="container">
        <h2 class="section-title fade-up">نظرات <span>همکاران</span></h2>
        <p class="section-subtitle fade-up">آنچه همکاران درباره همکاری با من می‌گویند</p>
        <div class="testi-grid">
            @foreach (var t in testimonials)
            {
                <div class="testi-card fade-up">
                    <div class="testi-stars">@for (int i = 0; i < t.Rating; i++) {
                        <i class="fas fa-star"></i>
                    }
                    @for (int i = t.Rating; i < 5; i++)
                    {
                        <i class="far fa-star"></i>
                    }
                </div>
                <p class="testi-text">@t.Text</p>
                <div class="testi-author"><div class="testi-avatar">@t.Initial</div><div class="testi-info"><div class="name">@t.Name</div><div class="role">@t.Role</div></div></div>
            </div>
        }
    </div>
</div>
</section>

<!-- REFERENCES -->
<section class="section" id="references">
    <div class="container">
        <h2 class="section-title fade-up">مراجع <span>قابل استعلام</span></h2>
        <p class="section-subtitle fade-up">مراجع قابل استعلام برای پروژه‌های کلیدی</p>
        <div class="references-grid">
            @foreach (var r in referenceClients)
            {
                <div class="reference-card fade-up">
                    <div class="reference-header"><div class="reference-avatar">@r.Initial</div><div class="reference-info"><h4>@r.Name</h4><p>@r.Role</p></div></div>
                    <div class="reference-verified"><i class="fas fa-check-circle"></i> تأیید‌شده</div>
                    <p class="ref-text">"@r.Text"</p>
                    <div class="reference-project"><i class="fas fa-briefcase"></i> @r.Project</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CONCERNS -->
<section class="section" id="concerns">
    <div class="container">
        <h2 class="section-title fade-up">پاسخ به <span>نگرانی‌ها</span></h2>
        <p class="section-subtitle fade-up">پاسخ صادقانه به دغدغه‌های رایج پیش از همکاری</p>
        <div class="concerns-grid">
            @foreach (var c in commonConcerns)
            {
                <div class="concern-card fade-up">
                    <div class="concern-q"><span class="concern-q-icon">Q</span><span>@c.Question</span></div>
                    <div class="concern-a"><span class="concern-a-icon">A</span><div class="concern-a-body">@c.Answer</div></div>
                </div>
            }
        </div>
    </div>
</section>

<!-- SKILLS -->
<section class="section" id="skills">
    <div class="container">
        <h2 class="section-title fade-up">مهارت‌های <span>فنی</span></h2>
        <p class="section-subtitle fade-up">ابزارها و فناوری‌هایی که روزانه با آنها کار می‌کنم</p>
        <div class="skills-grid">
            @foreach (var skill in skills)
            {
                <div class="skill-item fade-up" data-progress="@skill.Progress">
                    <div class="skill-header"><i class="@skill.Icon"></i><span>@skill.Name</span></div>
                    <div class="skill-progress"><div class="bar" style="width: @(skill.IsVisible ? skill.Progress + "%" : "0%")"></div></div>
                </div>
            }
        </div>
    </div>
</section>

<!-- TECH MATCHER -->
<section class="section" id="tech-matcher">
    <div class="container">
        <h2 class="section-title fade-up">تطبیق <span>استک فنی</span></h2>
        <p class="section-subtitle fade-up">تکنولوژی‌های پروژه خود را انتخاب کنید تا درصد تطبیق را ببینید</p>
        <div class="tech-matcher-wrapper fade-up">
            <div class="tech-matcher-header">
                <div class="tech-matcher-score">@computedMatchScore%</div>
                <div class="tech-matcher-score-label">تطبیق با استک شما (@selectedTechs.Count از @totalAvailableTechs تکنولوژی)</div>
                <div class="tech-matcher-bar"><div class="fill" style="width: @(computedMatchScore)%;"></div></div>
            </div>
            <div class="tech-matcher-cats">
                @foreach (var cat in techMatchCategories)
                {
                    <div class="tech-matcher-cat">
                        <h4><i class="@cat.Icon"></i> @cat.Name</h4>
                        <div class="tech-matcher-items">
                            @foreach (var tech in cat.Techs)
                            {
                                var t = tech;
                                <button class="tech-matcher-item @(selectedTechs.Contains(t) ? "selected" : "")" @onclick="() => ToggleTech(t)">@t</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- TECH -->
<section class="section" id="tech">
    <div class="container">
        <h2 class="section-title fade-up">تکنولوژی‌های <span>تخصصی</span></h2>
        <p class="section-subtitle fade-up">ابزارها و پایگاه داده‌هایی که در پروژه‌های واقعی استفاده می‌کنم</p>
        <div class="tech-category">
            <div class="tech-category-title"><i class="fas fa-server"></i> بک‌اند و API</div>
            <div class="tech-grid">
                <div class="tech-item fade-up"><span class="tech-years">۵ سال</span><i class="devicon-csharp-plain colored"></i><span>C#</span></div>
                <div class="tech-item fade-up"><span class="tech-years">۵ سال</span><i class="devicon-dotnetcore-plain colored"></i><span>.NET Core</span></div>
                <div class="tech-item fade-up"><span class="tech-years">۴ سال</span><i class="fas fa-fire" style="color:#a855f7;"></i><span>ASP.NET Core</span></div>
                <div class="tech-item fade-up"><span class="tech-years">۴ سال</span><i class="fas fa-database" style="color:#60a5fa;"></i><span>EF Core</span></div>
