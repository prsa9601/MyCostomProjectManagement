    private string GetBlogExcerpt(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "برای مطالعه کامل این مقاله کلیک کنید...";
        var plain = System.Text.RegularExpressions.Regex.Replace(content, @"```[\s\S]*?```", " ");
        plain = System.Text.RegularExpressions.Regex.Replace(plain, @"[#*`>\[\]()!\-]", " ");
        plain = System.Text.RegularExpressions.Regex.Replace(plain, @"\s+", " ").Trim();
        return plain.Length > 130 ? plain.Substring(0, 127).TrimEnd() + "..." : plain;
    }
    private static string ToPersianDate(DateTime dt)
    {
        try { var pc = new System.Globalization.PersianCalendar(); return $"{pc.GetYear(dt):0000}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00}"; }
        catch { return dt.ToString("yyyy/MM/dd"); }
    }
    private void AnswerQuiz(int optionIndex)
    {
        if (quizCurrentIndex >= quizQuestions.Count) return;
        quizScore += quizQuestions[quizCurrentIndex].Options[optionIndex].Points;
        if (quizCurrentIndex < quizQuestions.Count - 1) quizCurrentIndex++;
        else quizFinished = true;
    }
    private void ResetQuiz() { quizCurrentIndex = 0; quizScore = 0; quizFinished = false; }

    private async Task HandleSubmit()
    {
        _isSubmitting = true; _message = "";
        try
        {
            _createCommand.IsWasSeen = false; _createCommand.IsWorked = false; _createCommand.IsDone = false;
            var result = await _prV1Facade.Create(_createCommand);
            if (result.Status == BackEnd.Shared.CoreShared.OperationResultStatus.Success)
            { _isSuccess = true; _message = "✅ درخواست شما ثبت شد."; _createCommand = new(); }
            else { _isSuccess = false; _message = $"❌ خطا: {result.Message ?? "مشکلی پیش آمد."}"; }
        }
        catch (Exception ex) { _isSuccess = false; _message = $"❌ خطا: {ex.Message}"; }
        finally { _isSubmitting = false; StateHasChanged(); await InitializeJsInterop(); }
    }
