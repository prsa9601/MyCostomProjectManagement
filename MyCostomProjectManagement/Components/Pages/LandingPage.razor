        item.IsActive = !item.IsActive;
    }

    private void StartCounterAnimation()
    {
        counterTimer = new System.Timers.Timer(30);
        counterTimer.Elapsed += (sender, e) =>
        {
            bool allDone = true;
            foreach (var stat in stats)
            {
                if (stat.CurrentValue < stat.Target)
                {
                    stat.CurrentValue = Math.Min(stat.CurrentValue + 1, stat.Target);
                    allDone = false;
                }
            }
            if (!allDone) InvokeAsync(StateHasChanged);
            else counterTimer?.Stop();
        };
        counterTimer.Start();
    }

    private void StartTypewriter()
    {
        typewriterTimer = new System.Timers.Timer(120);
        typewriterTimer.Elapsed += (sender, e) =>
        {
            var currentWord = typewriterWords[typewriterIndex];
            if (isDeleting)
            {
                if (charIndex > 0) charIndex--;
                else
                {
                    isDeleting = false;
                    typewriterIndex = (typewriterIndex + 1) % typewriterWords.Length;
                    typewriterTimer.Interval = 400;
                }
            }
            else
            {
                if (charIndex < currentWord.Length) charIndex++;
                else
                {
                    isDeleting = true;
                    typewriterTimer.Interval = 500;
                }
            }
            typewriterText = currentWord.Substring(0, charIndex);
            InvokeAsync(StateHasChanged);
        };
        typewriterTimer.Start();
    }

    public void Dispose()
    {
        counterTimer?.Stop();
        counterTimer?.Dispose();
        typewriterTimer?.Stop();
        typewriterTimer?.Dispose();
    }
