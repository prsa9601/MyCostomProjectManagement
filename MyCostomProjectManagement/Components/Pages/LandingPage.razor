<!-- WEEKLY RHYTHM -->
<section class="section" id="weekly-rhythm">
    <div class="container">
        <h2 class="section-title fade-up">ریتم <span>هفتگی</span></h2>
        <p class="section-subtitle fade-up">یک هفته کاری معمولی</p>
        <div class="weekly-rhythm-wrapper fade-up">
            <table class="weekly-rhythm-table">
                <thead>
                    <tr>
                        <th>بازه زمانی</th>
                        @foreach (var d in new[] { "شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه" })
                        {
                            <th class="day-header">@d</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in weeklyRhythm)
                    {
                        <tr>
                            <td><strong style="color:#cbd5e1;">@slot.TimeRange</strong></td>
                            @foreach (var s in slot.Slots)
                            {
                                var slotClass = s.ToLower() switch { "deep" => "deep-work", "meet" => "meeting", "learn" => "learning", "personal" => "personal", _ => "off" };
                                var slotLabel = s.ToLower() switch { "deep" => "Deep Work", "meet" => "جلسه", "learn" => "یادگیری", "personal" => "شخصی", _ => "—" };
                                <td><span class="weekly-rhythm-slot @slotClass">@slotLabel</span></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <div class="weekly-rhythm-legend">
