                    </div>
                    <p class="repo-desc">@repo.Description</p>
                    <div class="repo-stats">
                        <span class="repo-stat lang"><span class="repo-lang-dot" style="background:@repo.LangColor;"></span>@repo.Language</span>
                        <span class="repo-stat"><i class="fas fa-star"></i> @repo.Stars</span>
                        <span class="repo-stat"><i class="fas fa-code-branch"></i> @repo.Forks</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- ===== منابع آموزشی ===== -->
<section class="section" id="resources">
    <div class="container">
        <h2 class="section-title fade-up">منابع <span>آموزشی پیشنهادی</span></h2>
        <p class="section-subtitle fade-up">بهترین کتاب‌ها، دوره‌ها و ابزارهایی که برای یادگیری دات نت پیشنهاد می‌کنم</p>
        <div class="resources-grid">
            @foreach (var r in resources)
            {
                <div class="resource-card fade-up">
                    <span class="resource-type @r.TypeClass"><i class="@r.TypeIcon"></i> @r.TypeLabel</span>
                    <h3><i class="@r.Icon"></i> @r.Title</h3>
                    <p>@r.Desc</p>
                    @if (!string.IsNullOrEmpty(r.Link))
                    {
                        <a href="@r.Link" target="_blank" rel="noopener noreferrer" class="resource-link">مشاهده <i class="fas fa-arrow-left"></i></a>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- ===== دوره‌ها و کارگاه‌ها ===== -->
<section class="section" id="courses">
    <div class="container">
        <h2 class="section-title fade-up">دوره‌ها و <span>کارگاه‌های آموزشی</span></h2>
        <p class="section-subtitle fade-up">آموزش‌های تخصصی که خودم برگزار می‌کنم — از مبتدی تا پیشرفته</p>
        <div class="courses-grid">
            @foreach (var c in courses)
            {
                <div class="course-card fade-up @(c.IsFeatured ? "featured" : "")">
                    <div class="course-header">
                        <div class="course-icon"><i class="@c.Icon"></i></div>
                        <div class="course-meta">
                            <span>@c.Level</span>
                            <span>@c.Format</span>
                        </div>
                    </div>
                    <h3>@c.Title</h3>
                    <p>@c.Description</p>
                    <div class="course-topics">
                        @foreach (var topic in c.Topics)
                        {
                            <span>@topic</span>
                        }
                    </div>
                    <div class="course-footer">
                        <div class="course-price">
                            <span class="label">شهریه</span>
                            <span class="amount @(c.IsFree ? "free" : "")">@c.Price</span>
                        </div>
                        <a href="/#contact" class="course-enroll @(c.IsFeatured ? "primary" : "outline")">
                            @(c.IsFree ? "ثبت‌نام رایگان" : "ثبت‌نام") <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===== نمونه کارها ===== -->
@{
    if (PortfolioResult == null || PortfolioResult.Data == null || PortfolioResult.Data.Count == 0) { }
    else
    {
        <section class="section" id="portfolio">
            <div class="container">
                <h2 class="section-title fade-up">نمونه <span>کارها</span></h2>
                <p class="section-subtitle fade-up">برخی از پروژه‌های اخیر من</p>
                <div class="portfolio-grid">
                    @foreach (var item in PortfolioResult.Data)
                    {
                        <div class="portfolio-item fade-up" @key="item.Title">
                            @if (item.PortfolioFile.IsImage)
                            {
                                <img src="@(Directories.GetPortfolioImage(item.PortfolioFile.FileAddress))" alt="@item.Title" loading="lazy" />
                            }
                            else
                            {
                                <video controls style="width:100%; max-height:200px; border-radius:8px; background:#111; object-fit:cover;">
                                    <source src="@(Directories.GetPortfolioVideo(item.PortfolioFile.FileAddress))" type="video/mp4" />
                                    مرورگر شما از نمایش ویدیو پشتیبانی نمی‌کند.
                                </video>
                            }
                            <div class="info">
                                <h4>@item.Title</h4>
                                <p>@item.Description</p>
                                @if (!string.IsNullOrEmpty(item.Link))
                                {
                                    <a href="@item.Link" target="_blank" rel="noopener noreferrer" class="btn-portfolio"><i class="fas fa-external-link-alt"></i> مشاهده پروژه</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}

