                        <div style="width: @(QuizPercentage)%; height: 100%; background: @GetQuizColor(); border-radius: 10px; transition: width 1s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 0 10px @(GetQuizColor() + "80");"></div>
                    </div>

                    <p class="quiz-result-desc">
                        @GetQuizDesc()
                    </p>
                    
                    <div class="quiz-result-score" style="border-color: @(GetQuizColor() + "60"); color: @GetQuizColor();">
                        <i class="fas fa-star"></i> @quizScore از @MaxQuizScore امتیاز (@QuizPercentage٪)
                    </div>
                    
                    <!-- دکمه‌های عملیات (شروع دوباره و درخواست جلسه) -->
                    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:20px;">
                        <button class="quiz-restart" @onclick="ResetQuiz"><i class="fas fa-redo"></i> شرکت دوباره در آزمون</button>
                        <a href="/#contact" class="btn-primary ripple" style="padding:11px 24px; border-radius:30px; font-size:0.88rem; text-decoration:none; background: @GetQuizColor(); border-color: @GetQuizColor();"><i class="fas fa-paper-plane"></i> درخواست جلسه</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- QUICK CONTACT -->
<section class="section" id="quick-contact">
    <div class="container">
