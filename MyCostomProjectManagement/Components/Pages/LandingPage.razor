<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />

<style>
    /* ===== دکمه / لینک داخل کارت نمونه‌کار ===== */
    .btn-portfolio {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        padding: 8px 18px;
        background: rgba(59, 130, 246, 0.10);
        border: 1px solid rgba(59, 130, 246, 0.20);
        border-radius: 40px;
        color: #3b82f6;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        backdrop-filter: blur(4px);
    }

        .btn-portfolio i {
            font-size: 0.85rem;
            transition: transform 0.3s ease;
        }

        .btn-portfolio:hover {
            background: rgba(59, 130, 246, 0.20);
            border-color: #3b82f6;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.15);
            color: #ffffff;
        }

            .btn-portfolio:hover i {
                transform: translateX(4px);
            }

        .btn-portfolio:active {
            transform: scale(0.96);
        }

    /* ====================================================
           LOADING OVERLAY
           ==================================================== */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 14, 23, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 99999;
        transition: opacity 0.6s ease, visibility 0.6s ease;
    }

        .loading-overlay.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

    .loader-spinner {
        width: 60px;
        height: 60px;
        border: 3px solid rgba(59, 130, 246, 0.15);
        border-top: 3px solid #3b82f6;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
        box-shadow: 0 0 40px rgba(59, 130, 246, 0.15);
        margin-bottom: 24px;
    }

    .loader-text {
        font-size: 1.1rem;
        color: #94a3b8;
        font-weight: 500;
        letter-spacing: 1px;
    }

    .loader-progress {
        width: 200px;
        height: 3px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        margin-top: 16px;
        overflow: hidden;
    }

        .loader-progress .bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            border-radius: 10px;
            animation: loadingProgress 1.8s ease-in-out infinite;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    @@keyframes loadingProgress {
        0% {
            width: 0%;
            transform: translateX(0);
        }

        50% {
            width: 70%;
            transform: translateX(0);
        }

        100% {
            width: 100%;
            transform: translateX(0);
        }
    }

    /* ----- RESET & BASE ----- */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ----- PARTICLES BACKGROUND ----- */
    .bg-particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

        .bg-particles span {
            position: absolute;
            display: block;
            width: 6px;
            height: 6px;
            background: rgba(59, 130, 246, 0.2);
            border-radius: 50%;
            animation: floatParticle 12s infinite alternate ease-in-out;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
        }

            .bg-particles span:nth-child(1) {
                top: 10%;
                left: 20%;
                animation-duration: 14s;
                width: 8px;
                height: 8px;
            }

            .bg-particles span:nth-child(2) {
                top: 60%;
                left: 80%;
                animation-duration: 16s;
                animation-delay: 2s;
            }

            .bg-particles span:nth-child(3) {
                top: 30%;
                left: 70%;
                animation-duration: 18s;
                animation-delay: 4s;
                width: 10px;
                height: 10px;
            }

            .bg-particles span:nth-child(4) {
                top: 80%;
                left: 10%;
                animation-duration: 15s;
                animation-delay: 1s;
            }

            .bg-particles span:nth-child(5) {
                top: 50%;
                left: 40%;
                animation-duration: 20s;
                animation-delay: 3s;
                width: 12px;
                height: 12px;
                background: rgba(59,130,246,0.12);
            }

            .bg-particles span:nth-child(6) {
                top: 15%;
                left: 90%;
                animation-duration: 13s;
                animation-delay: 5s;
            }

            .bg-particles span:nth-child(7) {
                top: 70%;
                left: 50%;
                animation-duration: 17s;
                animation-delay: 2s;
                width: 7px;
                height: 7px;
            }

            .bg-particles span:nth-child(8) {
                top: 40%;
                left: 5%;
                animation-duration: 19s;
                animation-delay: 3s;
            }

    @@keyframes floatParticle {
        0% {
            transform: translate(0,0) scale(1);
            opacity: 0.2;
        }

        50% {
            transform: translate(30px,-60px) scale(1.6);
            opacity: 0.7;
        }

        100% {
            transform: translate(-20px,40px) scale(0.8);
            opacity: 0.1;
        }
    }

    /* ----- GLASS ----- */
    .glass {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.06);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.35s ease;
    }

    @@keyframes rotateBorder {
        0% {
            background-position: 0% 50%;
        }

        100% {
            background-position: 400% 50%;
        }
    }

    /* ----- NAVBAR ----- */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: background 0.5s, backdrop-filter 0.5s, box-shadow 0.4s;
        background: transparent;
    }

        .navbar.scrolled {
            background: linear-gradient(135deg, rgba(10,14,23,0.92), rgba(20,30,48,0.92));
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            box-shadow: 0 4px 40px rgba(0,0,0,0.4);
        }

        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        text-shadow: 0 0 20px rgba(59,130,246,0.15);
    }

        .logo span {
            color: #3b82f6;
            text-shadow: 0 0 30px rgba(59,130,246,0.3);
        }

    .nav-links {
        display: flex;
        gap: 24px;
        list-style: none;
        font-size: 0.95rem;
        font-weight: 500;
        align-items: center;
    }

        .nav-links a {
            color: #b8c4d6;
            transition: 0.25s;
            position: relative;
            padding: 4px 0;
            cursor: pointer;
        }

            .nav-links a:hover {
                color: #fff;
            }

            .nav-links a::after {
                content: '';
                position: absolute;
                bottom: -2px;
                right: 0;
                width: 0;
                height: 2px;
                background: #3b82f6;
                transition: 0.35s;
                box-shadow: 0 0 12px #3b82f6;
            }

            .nav-links a:hover::after {
                width: 100%;
            }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: #3b82f6;
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: 0.3s;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 0 20px rgba(59,130,246,0.15);
    }

        .btn-primary:hover {
            background: #2563eb;
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 12px 40px rgba(59,130,246,0.4);
        }

    .btn-outline {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.15);
        color: #eef2f8;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        transition: 0.3s;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-outline:hover {
            border-color: #3b82f6;
            color: #fff;
            background: rgba(59,130,246,0.08);
            box-shadow: 0 0 30px rgba(59,130,246,0.1);
        }

    /* ----- HERO ----- */
    .hero {
        padding: 160px 0 100px;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(59,130,246,0.12);
        padding: 6px 22px;
        border-radius: 40px;
        font-size: 0.8rem;
        color: #3b82f6;
        border: 1px solid rgba(59,130,246,0.15);
        margin-bottom: 28px;
        backdrop-filter: blur(4px);
    }

    .hero h1 {
        font-size: clamp(3rem, 10vw, 5.2rem);
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 20px;
    }

    .hero p {
        font-size: 1.3rem;
        max-width: 720px;
        margin: 0 auto 40px;
        color: #b8c4d6;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: center;
    }

    /* ----- TYPEWRITER ----- */
    .typewriter .text {
        display: inline;
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .typewriter .cursor {
        display: inline-block;
        width: 3px;
        height: 1em;
        background: #3b82f6;
        margin-right: 6px;
        animation: blink 0.8s step-end infinite;
        vertical-align: text-bottom;
        box-shadow: 0 0 20px #3b82f6;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }

    /* ----- SECTIONS ----- */
    .section {
        padding: 90px 0;
        position: relative;
        z-index: 1;
        transition: background 0.8s ease;
    }

        .section:nth-child(odd) {
            background: rgba(255,255,255,0.01);
        }

        .section:nth-child(even) {
            background: rgba(0,0,0,0.15);
        }

    .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 12px;
        text-align: center;
    }

        .section-title span {
            color: #3b82f6;
            text-shadow: 0 0 30px rgba(59,130,246,0.15);
        }

    .section-subtitle {
        text-align: center;
        color: #94a3b8;
        max-width: 640px;
        margin: 0 auto 56px;
        font-size: 1.1rem;
    }

    /* ----- ABOUT ----- */
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    .about-text p {
        color: #c8d2e0;
        margin-bottom: 20px;
        font-size: 1.05rem;
    }

    .about-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 30px;
    }

    .stat-item {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        padding: 22px 12px;
        border-radius: 20px;
        text-align: center;
        transition: 0.3s;
    }

        .stat-item:hover {
            border-color: #3b82f6;
            transform: translateY(-4px);
        }

        .stat-item .number {
            font-size: 2.2rem;
            font-weight: 800;
            color: #3b82f6;
            text-shadow: 0 0 20px rgba(59,130,246,0.2);
        }

        .stat-item .label {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-top: 4px;
        }

    .about-image {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 280px;
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 32px;
        transition: 0.4s;
    }

        .about-image i {
            font-size: 9rem;
            color: #3b82f6;
            opacity: 0.5;
            filter: drop-shadow(0 0 40px rgba(59,130,246,0.2));
        }

    /* ====================================================
           SERVICES SECTION
           ==================================================== */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 24px;
        margin-top: 10px;
    }

    .service-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 22px;
        padding: 28px 24px;
        transition: all 0.35s ease;
        position: relative;
        overflow: hidden;
    }

        .service-card::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 24px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 300% 300%;
            animation: rotateBorder 10s linear infinite;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .service-card:hover::before {
            opacity: 0.4;
        }

        .service-card:hover {
            transform: translateY(-6px);
            border-color: transparent;
            box-shadow: 0 20px 50px rgba(59, 130, 246, 0.10);
        }

    .service-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 18px;
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.12));
        color: #60a5fa;
        border: 1px solid rgba(59, 130, 246, 0.2);
    }

    .service-card h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
    }

    .service-card p {
        color: #94a3b8;
        font-size: 0.92rem;
        line-height: 1.9;
        margin: 0;
    }

    /* ----- SKILLS ----- */
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 28px;
        margin-top: 10px;
    }

    .skill-item {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        padding: 24px 20px;
        transition: 0.35s;
        position: relative;
        overflow: hidden;
    }

        .skill-item:hover {
            border-color: rgba(59,130,246,0.4);
            transform: translateY(-4px);
        }

        .skill-item .skill-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

            .skill-item .skill-header i {
                font-size: 1.8rem;
                color: #3b82f6;
            }

            .skill-item .skill-header span {
                font-weight: 600;
            }

    .skill-progress {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.08);
        border-radius: 10px;
        overflow: hidden;
        margin-top: 6px;
    }

        .skill-progress .bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            border-radius: 10px;
            transition: width 1.2s cubic-bezier(0.2,0.9,0.3,1);
            box-shadow: 0 0 20px rgba(59,130,246,0.2);
        }

    /* ----- PORTFOLIO ----- */
    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 32px;
    }

    .portfolio-item {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 24px;
        overflow: hidden;
        transition: 0.35s;
        position: relative;
    }

        .portfolio-item:hover {
            transform: translateY(-8px);
            border-color: rgba(59,130,246,0.4);
            box-shadow: 0 20px 50px rgba(59,130,246,0.08);
        }

        .portfolio-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            display: block;
            background: #1a2636;
        }

        .portfolio-item .info {
