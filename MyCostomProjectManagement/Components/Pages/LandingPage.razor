        await GetUser();
    }

    private async Task GetSetting()
    {
        siteSetting = await _siteSettingFacade.Get();
        siteLinksDtos = siteSetting.SiteLinks.Where(i => i.IsActive == true).ToList();
        AboutMeSection = siteSetting.AboutMeSection;
