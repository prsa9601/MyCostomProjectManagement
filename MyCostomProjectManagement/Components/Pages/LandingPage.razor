        font-size: 1rem;
        margin-bottom: 18px;
        transition: 0.25s;
        font-family: inherit;
    }

        .request-form input:focus, .request-form select:focus, .request-form textarea:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255,255,255,0.07);
            box-shadow: 0 0 30px rgba(59,130,246,0.05);
        }

        .request-form select option {
            background: #0a0e17;
            color: #eef2f8;
        }

    .request-form textarea {
        min-height: 140px;
        resize: vertical;
    }

    .request-info {
        display: flex;
        flex-direction: column;
        gap: 20px;
        justify-content: center;
    }

        .request-info .feature-box {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 20px;
            padding: 24px;
            transition: 0.3s;
        }

            .request-info .feature-box:hover {
                border-color: #3b82f6;
            }

            .request-info .feature-box i {
                font-size: 2rem;
                color: #3b82f6;
                margin-bottom: 10px;
            }

            .request-info .feature-box h4 {
                font-size: 1.1rem;
                margin-bottom: 4px;
            }

            .request-info .feature-box p {
                color: #94a3b8;
                font-size: 0.95rem;
            }

    /* ----- CONTACT ----- */
    .contact-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
    }

    .contact-form input, .contact-form textarea {
        width: 100%;
        padding: 16px 20px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        color: #eef2f8;
        font-size: 1rem;
        margin-bottom: 18px;
        transition: 0.25s;
        font-family: inherit;
    }

        .contact-form input:focus, .contact-form textarea:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255,255,255,0.07);
            box-shadow: 0 0 30px rgba(59,130,246,0.05);
        }

    .contact-form textarea {
        min-height: 140px;
        resize: vertical;
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 24px;
        justify-content: center;
    }

        .contact-info .item {
            display: flex;
            align-items: center;
            gap: 18px;
            font-size: 1.05rem;
        }

            .contact-info .item i {
                font-size: 1.5rem;
                width: 52px;
                height: 52px;
                background: rgba(59,130,246,0.08);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #3b82f6;
                border: 1px solid rgba(59,130,246,0.1);
                transition: 0.3s;
                flex-shrink: 0;
            }

            .contact-info .item:hover i {
                background: rgba(59,130,246,0.15);
                transform: scale(1.05);
            }

    /* ----- FAQ ----- */
    .faq-list {
        max-width: 780px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .faq-item {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 18px;
        overflow: hidden;
        transition: 0.25s;
    }

        .faq-item:hover {
            border-color: rgba(59,130,246,0.4);
        }

    .faq-question {
        padding: 20px 28px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: 0.2s;
    }

        .faq-question:hover {
            background: rgba(255,255,255,0.03);
        }

        .faq-question i {
            transition: 0.3s;
            color: #3b82f6;
        }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        padding: 0 28px;
        color: #b8c4d6;
        transition: max-height 0.4s cubic-bezier(0.2, 0.9, 0.3, 1), padding 0.3s ease, opacity 0.3s ease;
        opacity: 0;
    }

    .faq-item.active .faq-answer {
        max-height: 500px;
        padding: 0 28px 24px;
        opacity: 1;
    }

    .faq-item.active .faq-question i {
        transform: rotate(180deg);
    }

    /* ----- FLOAT ANIMATION ----- */
    @@keyframes float {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-12px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .float-icon {
        animation: float 4s ease-in-out infinite;
    }

    .float-icon-delay {
        animation-delay: 1s;
    }

    /* ----- RIPPLE ----- */
    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.3);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* ----- FADE-UP ----- */
    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* ----- RESPONSIVE ----- */
    @@media (max-width: 992px) {
        .about-grid, .contact-wrapper, .request-grid {
            grid-template-columns: 1fr;
        }

        .hero h1 {
            font-size: 3.2rem;
        }

        .services-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .hero h1 {
            font-size: 2.8rem;
        }

        .skills-grid {
            grid-template-columns: 1fr;
        }

        .services-grid {
            grid-template-columns: 1fr;
        }

        .section {
            padding: 60px 0;
        }

        .section-title {
            font-size: 2rem;
        }
    }

    @@media (max-width: 480px) {
        .hero h1 {
            font-size: 2.2rem;
        }

        .portfolio-grid {
            grid-template-columns: 1fr;
        }

        .about-stats {
            grid-template-columns: 1fr;
        }

        .container {
            padding: 0 16px;
        }

        .hero {
            padding: 120px 0 60px;
        }

            .hero p {
                font-size: 1rem;
                padding: 0 8px;
            }

        .hero-actions {
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

            .hero-actions .btn-primary,
            .hero-actions .btn-outline {
                width: 100%;
