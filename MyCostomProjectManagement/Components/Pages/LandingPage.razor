@page "/"
@using BackEnd.Core
@using BackEnd.Core.ContactUs.Commands.Create
@using BackEnd.Core.Portfolio.Queries.DTOs
@using BackEnd.Core.SiteSetting.Queries.DTOs
@using BackEnd.Data.Entities.Role
@using MyCostomProjectManagement.Facade.ContactUs
@using MyCostomProjectManagement.Facade.FAQ
@using MyCostomProjectManagement.Facade.Portfolio
@using MyCostomProjectManagement.Facade.SiteSettings
@using MyCostomProjectManagement.Facade.Skills
@using MyCostomProjectManagement.Facade.User
@using MyCostomProjectManagement.Infrastructure
@using MyCostomProjectManagement.Shared.Attributes
@layout FrontLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IContactUsFacade _contactUsFacade
@inject ISkillFacade _skillFacade
@inject IPortfolioFacade _portfolioFacade
@inject IFAQFacade _faqFacade
@inject UserAlertService _userAlertService
@inject ISiteSettingFacade _siteSettingFacade
@inject IUserFacade _userFacade
@inject GetUserPermission _getUserPermission
@inject UserAuthentication _userAuthentication

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>محمد رضایی | برنامه‌نویس و توسعه‌دهنده</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/csharp.svg" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ====================================================
                تمام استایل‌های مورد نیاز (لندینگ + داشبورد)
                ==================================================== */
    /* ====================================================
                LOADING OVERLAY
                ==================================================== */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 14, 23, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 99999;
        transition: opacity 0.6s ease, visibility 0.6s ease;
    }

        .loading-overlay.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

    .loader-spinner {
        width: 60px;
        height: 60px;
        border: 3px solid rgba(59, 130, 246, 0.15);
        border-top: 3px solid #3b82f6;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
        box-shadow: 0 0 40px rgba(59, 130, 246, 0.15);
        margin-bottom: 24px;
    }

    .loader-text {
        font-size: 1.1rem;
        color: #94a3b8;
        font-weight: 500;
        letter-spacing: 1px;
    }

    .loader-progress {
        width: 200px;
        height: 3px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        margin-top: 16px;
        overflow: hidden;
    }

        .loader-progress .bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            border-radius: 10px;
            animation: loadingProgress 1.8s ease-in-out infinite;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    @@keyframes loadingProgress {
        0% {
            width: 0%;
            transform: translateX(0);
        }

        50% {
            width: 70%;
            transform: translateX(0);
        }

        100% {
            width: 100%;
            transform: translateX(0);
        }
    }
    /* ----- RESET & BASE ----- */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ----- PARTICLES BACKGROUND ----- */
    .bg-particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

        .bg-particles span {
            position: absolute;
            display: block;
            width: 6px;
            height: 6px;
            background: rgba(59, 130, 246, 0.2);
            border-radius: 50%;
            animation: floatParticle 12s infinite alternate ease-in-out;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
        }

            .bg-particles span:nth-child(1) {
                top: 10%;
                left: 20%;
                animation-duration: 14s;
                width: 8px;
                height: 8px;
            }

            .bg-particles span:nth-child(2) {
                top: 60%;
                left: 80%;
                animation-duration: 16s;
                animation-delay: 2s;
            }

            .bg-particles span:nth-child(3) {
                top: 30%;
                left: 70%;
                animation-duration: 18s;
                animation-delay: 4s;
                width: 10px;
                height: 10px;
            }

            .bg-particles span:nth-child(4) {
                top: 80%;
                left: 10%;
                animation-duration: 15s;
                animation-delay: 1s;
            }

            .bg-particles span:nth-child(5) {
                top: 50%;
                left: 40%;
                animation-duration: 20s;
                animation-delay: 3s;
                width: 12px;
                height: 12px;
                background: rgba(59,130,246,0.12);
            }

            .bg-particles span:nth-child(6) {
                top: 15%;
                left: 90%;
                animation-duration: 13s;
                animation-delay: 5s;
            }

            .bg-particles span:nth-child(7) {
                top: 70%;
                left: 50%;
                animation-duration: 17s;
                animation-delay: 2s;
                width: 7px;
                height: 7px;
            }

            .bg-particles span:nth-child(8) {
                top: 40%;
                left: 5%;
                animation-duration: 19s;
                animation-delay: 3s;
            }

    @@keyframes floatParticle {
        0% {
            transform: translate(0,0) scale(1);
            opacity: 0.2;
        }

        50% {
            transform: translate(30px,-60px) scale(1.6);
            opacity: 0.7;
        }

        100% {
            transform: translate(-20px,40px) scale(0.8);
            opacity: 0.1;
        }
    }

    /* ----- GLASS + GRADIENT BORDERS ----- */
    .glass {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.06);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.35s ease;
    }

        .glass::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 26px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 400% 400%;
            animation: rotateBorder 8s linear infinite;
            opacity: 0.25;
            transition: opacity 0.4s;
        }

        .glass:hover::before {
            opacity: 0.6;
        }

    @@keyframes rotateBorder {
        0% {
            background-position: 0% 50%;
        }

        100% {
            background-position: 400% 50%;
        }
    }

    /* ----- NAVBAR ----- */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: background 0.5s, backdrop-filter 0.5s, box-shadow 0.4s;
        background: transparent;
    }

        .navbar.scrolled {
            background: linear-gradient(135deg, rgba(10,14,23,0.92), rgba(20,30,48,0.92));
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            box-shadow: 0 4px 40px rgba(0,0,0,0.4);
        }

        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        text-shadow: 0 0 20px rgba(59,130,246,0.15);
    }

        .logo span {
            color: #3b82f6;
            text-shadow: 0 0 30px rgba(59,130,246,0.3);
        }

    .nav-links {
        display: flex;
        gap: 24px;
        list-style: none;
        font-size: 0.95rem;
        font-weight: 500;
        align-items: center;
    }

        .nav-links a {
            color: #b8c4d6;
            transition: 0.25s;
            position: relative;
            padding: 4px 0;
            cursor: pointer;
        }

            .nav-links a:hover {
                color: #fff;
            }

            .nav-links a::after {
                content: '';
                position: absolute;
                bottom: -2px;
                right: 0;
                width: 0;
                height: 2px;
                background: #3b82f6;
                transition: 0.35s;
                box-shadow: 0 0 12px #3b82f6;
            }

            .nav-links a:hover::after {
                width: 100%;
            }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: #3b82f6;
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: 0.3s;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 0 20px rgba(59,130,246,0.15);
    }

        .btn-primary:hover {
            background: #2563eb;
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 12px 40px rgba(59,130,246,0.4);
        }

    .btn-outline {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.15);
        color: #eef2f8;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-outline:hover {
            border-color: #3b82f6;
            color: #fff;
            background: rgba(59,130,246,0.08);
            box-shadow: 0 0 30px rgba(59,130,246,0.1);
        }

    .btn-dashboard {
        background: rgba(59,130,246,0.15);
        border: 1px solid rgba(59,130,246,0.3);
        color: #3b82f6;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.8rem;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-dashboard:hover {
            background: rgba(59,130,246,0.25);
            transform: scale(1.04);
            box-shadow: 0 0 30px rgba(59,130,246,0.15);
        }

    .btn-admin {
        background: rgba(139,92,246,0.15);
        border: 1px solid rgba(139,92,246,0.3);
        color: #a78bfa;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.8rem;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-admin:hover {
            background: rgba(139,92,246,0.25);
            transform: scale(1.04);
            box-shadow: 0 0 30px rgba(139,92,246,0.15);
        }

    .btn-login {
        background: rgba(52,211,153,0.12);
        border: 1px solid rgba(52,211,153,0.15);
        color: #34d399;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.8rem;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-login:hover {
            background: rgba(52,211,153,0.2);
            transform: scale(1.04);
            box-shadow: 0 0 30px rgba(52,211,153,0.1);
        }

    .btn-logout {
        background: rgba(239,68,68,0.1);
        border: 1px solid rgba(239,68,68,0.15);
        color: #ef4444;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.8rem;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-logout:hover {
            background: rgba(239,68,68,0.18);
            transform: scale(1.04);
            box-shadow: 0 0 30px rgba(239,68,68,0.1);
        }

    .avatar-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid rgba(59,130,246,0.3);
        background: rgba(59,130,246,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #3b82f6;
        font-size: 1.2rem;
        transition: 0.3s;
        cursor: pointer;
    }

        .avatar-btn:hover {
            border-color: #3b82f6;
            transform: scale(1.05);
        }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
    }

        .hamburger span {
            display: block;
            width: 28px;
            height: 2.5px;
            background: #eef2f8;
            border-radius: 4px;
            transition: 0.3s;
        }

    /* ----- HERO (لندینگ) ----- */
    .hero {
        padding: 160px 0 100px;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(59,130,246,0.12);
        padding: 6px 22px;
        border-radius: 40px;
        font-size: 0.8rem;
        color: #3b82f6;
        border: 1px solid rgba(59,130,246,0.15);
        margin-bottom: 28px;
        backdrop-filter: blur(4px);
    }

    .hero h1 {
        font-size: clamp(3rem, 10vw, 5.2rem);
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 20px;
    }

    .hero p {
        font-size: 1.3rem;
        max-width: 720px;
        margin: 0 auto 40px;
        color: #b8c4d6;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: center;
    }

    /* ----- TYPEWRITER ----- */
    .typewriter .text {
        display: inline;
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .typewriter .cursor {
        display: inline-block;
        width: 3px;
        height: 1em;
        background: #3b82f6;
        margin-right: 6px;
        animation: blink 0.8s step-end infinite;
        vertical-align: text-bottom;
        box-shadow: 0 0 20px #3b82f6;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }

    /* ----- SECTIONS (لندینگ) ----- */
    .section {
        padding: 90px 0;
        position: relative;
        z-index: 1;
        transition: background 0.8s ease;
    }

        .section:nth-child(odd) {
            background: rgba(255,255,255,0.01);
        }

        .section:nth-child(even) {
            background: rgba(0,0,0,0.15);
        }

    .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 12px;
        text-align: center;
    }

        .section-title span {
            color: #3b82f6;
            text-shadow: 0 0 30px rgba(59,130,246,0.15);
        }

    .section-subtitle {
        text-align: center;
        color: #94a3b8;
        max-width: 640px;
        margin: 0 auto 56px;
        font-size: 1.1rem;
    }

    /* ----- ABOUT ----- */
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    .about-text p {
        color: #c8d2e0;
        margin-bottom: 20px;
        font-size: 1.05rem;
    }

    .about-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 30px;
    }

    .stat-item {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        padding: 22px 12px;
        border-radius: 20px;
        text-align: center;
        transition: 0.3s;
    }

        .stat-item:hover {
            border-color: #3b82f6;
            transform: translateY(-4px);
        }

        .stat-item .number {
            font-size: 2.2rem;
            font-weight: 800;
            color: #3b82f6;
            text-shadow: 0 0 20px rgba(59,130,246,0.2);
        }

        .stat-item .label {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-top: 4px;
        }

    .about-image {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 280px;
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 32px;
        transition: 0.4s;
    }

        .about-image i {
            font-size: 9rem;
            color: #3b82f6;
            opacity: 0.5;
            filter: drop-shadow(0 0 40px rgba(59,130,246,0.2));
        }

    /* ----- SKILLS (with progress bars) ----- */
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 28px;
        margin-top: 10px;
    }

    .skill-item {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        padding: 24px 20px;
        transition: 0.35s;
        position: relative;
        overflow: hidden;
    }

        .skill-item::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 22px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 300% 300%;
            animation: rotateBorder 10s linear infinite;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .skill-item:hover::before {
            opacity: 0.4;
        }

        .skill-item:hover {
            border-color: transparent;
            transform: translateY(-4px);
        }

        .skill-item .skill-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

            .skill-item .skill-header i {
                font-size: 1.8rem;
                color: #3b82f6;
            }

            .skill-item .skill-header span {
                font-weight: 600;
            }

    .skill-progress {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.08);
        border-radius: 10px;
        overflow: hidden;
        margin-top: 6px;
    }

        .skill-progress .bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            border-radius: 10px;
            transition: width 1.2s cubic-bezier(0.2,0.9,0.3,1);
            box-shadow: 0 0 20px rgba(59,130,246,0.2);
        }

    /* ----- PORTFOLIO ----- */
    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 32px;
    }

    .portfolio-item {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 24px;
        overflow: hidden;
        transition: 0.35s;
        position: relative;
    }

        .portfolio-item::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 26px;
            background: conic-gradient(from 0deg, #3b82f6, #a78bfa, #3b82f6);
            background-size: 300% 300%;
            animation: rotateBorder 12s linear infinite;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .portfolio-item:hover::before {
            opacity: 0.5;
        }

        .portfolio-item:hover {
            transform: translateY(-8px);
            border-color: transparent;
            box-shadow: 0 20px 50px rgba(59,130,246,0.08);
        }

        .portfolio-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            display: block;
            background: #1a2636;
        }

        .portfolio-item .info {
            padding: 24px;
        }

            .portfolio-item .info h4 {
                font-size: 1.2rem;
                margin-bottom: 4px;
            }

            .portfolio-item .info p {
                color: #94a3b8;
                font-size: 0.95rem;
            }

    /* ----- PROJECTS ----- */
    .project-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .project-row {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        padding: 24px 30px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        transition: 0.3s;
        position: relative;
        overflow: hidden;
    }

        .project-row::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 22px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 300% 300%;
            animation: rotateBorder 14s linear infinite;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .project-row:hover::before {
            opacity: 0.4;
        }

        .project-row:hover {
            border-color: transparent;
            transform: scale(1.01);
        }

        .project-row .info h4 {
            font-size: 1.2rem;
        }

        .project-row .info p {
            color: #94a3b8;
            font-size: 0.95rem;
        }

        .project-row .badge {
            background: rgba(59,130,246,0.15);
            padding: 6px 18px;
            border-radius: 40px;
            color: #3b82f6;
            font-size: 0.8rem;
            font-weight: 500;
            border: 1px solid rgba(59,130,246,0.1);
        }

    /* ----- PURCHASE / API ----- */
    .purchase-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 32px;
        margin-top: 10px;
    }

    .purchase-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 28px;
        padding: 36px 24px;
        text-align: center;
        transition: 0.35s;
        position: relative;
        overflow: hidden;
    }

        .purchase-card::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 30px;
            background: conic-gradient(from 0deg, #3b82f6, #a78bfa, #3b82f6);
            background-size: 300% 300%;
            animation: rotateBorder 10s linear infinite;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .purchase-card:hover::before {
            opacity: 0.5;
        }

        .purchase-card:hover {
            transform: translateY(-6px);
            border-color: transparent;
        }

        .purchase-card.featured {
            border-color: #3b82f6;
            background: rgba(59,130,246,0.06);
            box-shadow: 0 0 50px rgba(59,130,246,0.05);
        }

        .purchase-card h3 {
            font-size: 1.6rem;
            margin-bottom: 8px;
        }

        .purchase-card .price {
            font-size: 2.4rem;
            font-weight: 800;
            color: #3b82f6;
            margin: 16px 0;
            text-shadow: 0 0 20px rgba(59,130,246,0.1);
        }

        .purchase-card ul {
            list-style: none;
            margin: 22px 0;
            color: #b8c4d6;
        }

            .purchase-card ul li {
                padding: 8px 0;
                border-bottom: 1px solid rgba(255,255,255,0.04);
            }

    /* ----- REQUEST PROJECT ----- */
    .request-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        align-items: start;
    }

    .request-form input, .request-form select, .request-form textarea {
        width: 100%;
        padding: 16px 20px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        color: #eef2f8;
        font-size: 1rem;
        margin-bottom: 18px;
        transition: 0.25s;
    }

        .request-form input:focus, .request-form select:focus, .request-form textarea:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255,255,255,0.07);
            box-shadow: 0 0 30px rgba(59,130,246,0.05);
        }

        .request-form select option {
            background: #0a0e17;
            color: #eef2f8;
        }

    .request-form textarea {
        min-height: 140px;
        resize: vertical;
    }

    .request-info {
        display: flex;
        flex-direction: column;
        gap: 20px;
        justify-content: center;
    }

        .request-info .feature-box {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 20px;
            padding: 24px;
            transition: 0.3s;
        }

            .request-info .feature-box:hover {
                border-color: #3b82f6;
            }

            .request-info .feature-box i {
                font-size: 2rem;
                color: #3b82f6;
                margin-bottom: 10px;
            }

            .request-info .feature-box h4 {
                font-size: 1.1rem;
                margin-bottom: 4px;
            }

            .request-info .feature-box p {
                color: #94a3b8;
                font-size: 0.95rem;
            }

    /* ----- CONTACT ----- */
    .contact-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
    }

    .contact-form input, .contact-form textarea {
        width: 100%;
        padding: 16px 20px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        color: #eef2f8;
        font-size: 1rem;
        margin-bottom: 18px;
        transition: 0.25s;
    }

        .contact-form input:focus, .contact-form textarea:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255,255,255,0.07);
            box-shadow: 0 0 30px rgba(59,130,246,0.05);
        }

    .contact-form textarea {
        min-height: 140px;
        resize: vertical;
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 24px;
        justify-content: center;
    }

        .contact-info .item {
            display: flex;
            align-items: center;
            gap: 18px;
            font-size: 1.05rem;
        }

            .contact-info .item i {
                font-size: 1.5rem;
                width: 52px;
                height: 52px;
                background: rgba(59,130,246,0.08);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #3b82f6;
                border: 1px solid rgba(59,130,246,0.1);
                transition: 0.3s;
            }

            .contact-info .item:hover i {
                background: rgba(59,130,246,0.15);
                transform: scale(1.05);
            }

    /* ----- FAQ ----- */
    .faq-list {
        max-width: 780px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .faq-item {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 18px;
        overflow: hidden;
        transition: 0.25s;
        position: relative;
    }

        .faq-item::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 20px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 300% 300%;
            animation: rotateBorder 16s linear infinite;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .faq-item:hover::before {
            opacity: 0.3;
        }

        .faq-item:hover {
            border-color: transparent;
        }

    .faq-question {
        padding: 20px 28px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: 0.2s;
    }

        .faq-question:hover {
            background: rgba(255,255,255,0.03);
        }

        .faq-question i {
            transition: 0.3s;
            color: #3b82f6;
        }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        padding: 0 28px;
        color: #b8c4d6;
        transition: max-height 0.4s cubic-bezier(0.2, 0.9, 0.3, 1), padding 0.3s ease, opacity 0.3s ease;
        opacity: 0;
    }

    .faq-item.active .faq-answer {
        max-height: 500px;
        padding: 0 28px 24px;
        opacity: 1;
    }

    .faq-item.active .faq-question i {
        transform: rotate(180deg);
    }

    /* ----- FLOAT ANIMATION ----- */
    @@keyframes float {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-12px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .float-icon {
        animation: float 4s ease-in-out infinite;
    }

    .float-icon-delay {
        animation-delay: 1s;
    }

    /* ----- RIPPLE EFFECT ----- */
    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.3);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* ----- SCROLL ANIMATIONS (fade-up & stagger) ----- */
    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .stagger-child {
        transition-delay: 0s;
    }

        .stagger-child:nth-child(1) {
            transition-delay: 0.05s;
        }

        .stagger-child:nth-child(2) {
            transition-delay: 0.1s;
        }

        .stagger-child:nth-child(3) {
            transition-delay: 0.15s;
        }

        .stagger-child:nth-child(4) {
            transition-delay: 0.2s;
        }

        .stagger-child:nth-child(5) {
            transition-delay: 0.25s;
        }

        .stagger-child:nth-child(6) {
            transition-delay: 0.3s;
        }

        .stagger-child:nth-child(7) {
            transition-delay: 0.35s;
        }

        .stagger-child:nth-child(8) {
            transition-delay: 0.4s;
        }

    /* ----- DASHBOARD SPECIFIC (stats, chart, profile) ----- */
    .dashboard {
        padding-top: 100px;
        padding-bottom: 60px;
        position: relative;
        z-index: 1;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }

        .dashboard-header h1 {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(to left, #f0f4ff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .dashboard-header .date {
            color: #94a3b8;
            font-size: 0.95rem;
            background: rgba(255,255,255,0.05);
            padding: 8px 18px;
            border-radius: 40px;
            border: 1px solid rgba(255,255,255,0.06);
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .stat-card {
        padding: 22px 20px;
        border-radius: 20px;
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.06);
        transition: 0.3s;
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 22px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 300% 300%;
            animation: rotateBorder 10s linear infinite;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .stat-card:hover::before {
            opacity: 0.4;
        }

        .stat-card:hover {
            border-color: transparent;
            transform: translateY(-4px);
        }

        .stat-card .icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 12px;
        }

            .stat-card .icon.blue {
                background: rgba(59,130,246,0.15);
                color: #3b82f6;
            }

            .stat-card .icon.purple {
                background: rgba(139,92,246,0.15);
                color: #a78bfa;
            }

            .stat-card .icon.green {
                background: rgba(16,185,129,0.15);
                color: #34d399;
            }

            .stat-card .icon.orange {
                background: rgba(251,146,60,0.15);
                color: #fb923c;
            }

        .stat-card .number {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 2px;
        }

        .stat-card .label {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .stat-card .change {
            font-size: 0.75rem;
            margin-top: 6px;
            display: inline-block;
            padding: 2px 12px;
            border-radius: 30px;
            background: rgba(16,185,129,0.12);
            color: #34d399;
            border: 1px solid rgba(16,185,129,0.1);
        }

    .main-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
    }

    .chart-box {
        padding: 24px;
    }

        .chart-box h3 {
            font-size: 1.1rem;
            margin-bottom: 16px;
            color: #e8edf5;
        }

    .chart-container {
        width: 100%;
        height: 200px;
        display: flex;
        align-items: flex-end;
        gap: 12px;
        padding-top: 10px;
    }

    .chart-bar-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        height: 100%;
        justify-content: flex-end;
    }

    .chart-bar {
        width: 100%;
        max-width: 40px;
        border-radius: 8px 8px 0 0;
        background: linear-gradient(180deg, #3b82f6, #8b5cf6);
        transition: height 1.2s cubic-bezier(0.2,0.9,0.3,1);
        min-height: 8px;
        box-shadow: 0 0 20px rgba(59,130,246,0.1);
    }

    .chart-bar-label {
        font-size: 0.7rem;
        color: #94a3b8;
    }

    .recent-box {
        padding: 24px;
    }

        .recent-box h3 {
            font-size: 1.1rem;
            margin-bottom: 16px;
            color: #e8edf5;
        }

    .recent-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

        .recent-item:last-child {
            border-bottom: none;
        }

        .recent-item .r-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(59,130,246,0.08);
            color: #3b82f6;
            font-size: 0.9rem;
            flex-shrink: 0;
        }

        .recent-item .r-info {
            flex: 1;
        }

            .recent-item .r-info .title {
                font-size: 0.9rem;
                font-weight: 500;
            }

            .recent-item .r-info .time {
                font-size: 0.75rem;
                color: #94a3b8;
            }

        .recent-item .r-status {
            font-size: 0.7rem;
            padding: 3px 12px;
            border-radius: 30px;
            background: rgba(16,185,129,0.1);
            color: #34d399;
            border: 1px solid rgba(16,185,129,0.05);
        }

            .recent-item .r-status.pending {
                background: rgba(251,146,60,0.1);
                color: #fb923c;
            }

            .recent-item .r-status.done {
                background: rgba(59,130,246,0.1);
                color: #3b82f6;
            }

    .profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .profile-card {
        padding: 28px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

        .profile-card .avatar-large {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.4rem;
            color: #fff;
            margin-bottom: 12px;
            box-shadow: 0 0 40px rgba(59,130,246,0.2);
        }

        .profile-card h3 {
            font-size: 1.2rem;
            font-weight: 700;
        }

        .profile-card .role {
            color: #94a3b8;
            font-size: 0.9rem;
            margin-bottom: 12px;
        }

        .profile-card .info-row {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
            margin: 8px 0;
        }

            .profile-card .info-row span {
                font-size: 0.85rem;
                color: #b8c4d6;
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .profile-card .info-row span i {
                    color: #3b82f6;
                }

    .quick-actions {
        padding: 28px;
    }

        .quick-actions h3 {
            font-size: 1.1rem;
            margin-bottom: 16px;
        }

    .quick-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .quick-btn {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        padding: 16px 12px;
        text-align: center;
        transition: 0.3s;
        cursor: pointer;
        color: #b8c4d6;
    }

        .quick-btn:hover {
            border-color: #3b82f6;
            background: rgba(59,130,246,0.05);
            transform: translateY(-3px);
            color: #fff;
        }

        .quick-btn i {
            font-size: 1.8rem;
            color: #3b82f6;
            display: block;
            margin-bottom: 6px;
        }

        .quick-btn span {
            font-size: 0.85rem;
        }

    /* ----- FOOTER ----- */
    .footer {
        position: relative;
        padding: 30px 0 20px;
        border-top: 1px solid rgba(255,255,255,0.04);
        background: rgba(0,0,0,0.2);
        backdrop-filter: blur(8px);
        z-index: 1;
        margin-top: 20px;
    }

        .footer .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
        }

    .footer-links {
        display: flex;
        gap: 24px;
        font-size: 0.85rem;
        color: #94a3b8;
    }

        .footer-links a:hover {
            color: #fff;
        }

    .footer-copy {
        color: #64748b;
        font-size: 0.8rem;
    }

