    .template-card .stack {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 14px;
    }

        .template-card .stack span {
            font-size: 0.68rem;
            padding: 3px 10px;
            border-radius: 20px;
            background: rgba(139,92,246,0.1);
            color: #c4b5fd;
            border: 1px solid rgba(139,92,246,0.2);
            font-weight: 600;
        }

    .template-card p {
        color: #94a3b8;
        font-size: 0.87rem;
        line-height: 1.9;
        margin: 0 0 18px 0;
        flex: 1;
    }

    .template-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 18px;
        border-top: 1px solid rgba(255,255,255,0.06);
        gap: 12px;
    }

    .template-price {
        display: flex;
        flex-direction: column;
    }

        .template-price .old {
            font-size: 0.72rem;
            color: #64748b;
            text-decoration: line-through;
        }

        .template-price .new {
            font-size: 1.35rem;
            font-weight: 900;
            color: #f9a8d4;
            font-family: 'Fira Code', monospace;
            text-shadow: 0 0 20px rgba(236,72,153,0.25);
            line-height: 1.2;
        }

        .template-price .currency {
            font-size: 0.72rem;
            color: #94a3b8;
        }

    .template-buy {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 20px;
        border-radius: 40px;
        background: linear-gradient(135deg, #ec4899, #8b5cf6);
        color: #fff;
        font-weight: 700;
        font-size: 0.82rem;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 6px 20px rgba(236,72,153,0.25);
        white-space: nowrap;
    }

        .template-buy:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(236,72,153,0.45);
        }

    /* ===== COMPARE ===== */
    .compare-wrapper {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 24px;
        padding: 8px;
        overflow: hidden;
    }

    .compare-table {
        width: 100%;
        border-collapse: collapse;
        direction: rtl;
    }

        .compare-table thead {
            background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(139,92,246,0.1));
        }

        .compare-table th {
            padding: 20px 16px;
            text-align: right;
            color: #93c5fd;
            font-weight: 800;
            font-size: 0.9rem;
            letter-spacing: 0.3px;
            border-bottom: 2px solid rgba(59,130,246,0.3);
            white-space: nowrap;
        }

            .compare-table th.highlight {
                background: linear-gradient(135deg, rgba(52,211,153,0.15), rgba(59,130,246,0.12));
                color: #34d399;
                position: relative;
            }

                .compare-table th.highlight::after {
                    content: 'بهترین انتخاب';
                    position: absolute;
                    top: 6px;
                    left: 12px;
                    font-size: 0.6rem;
                    padding: 2px 8px;
                    border-radius: 20px;
                    background: rgba(52,211,153,0.25);
                    color: #6ee7b7;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                }

        .compare-table td {
            padding: 16px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            color: #cbd5e1;
            font-size: 0.88rem;
            text-align: right;
            vertical-align: middle;
        }

            .compare-table td.highlight {
                background: rgba(52,211,153,0.04);
                color: #fff;
                font-weight: 600;
            }

            .compare-table td i.fa-check-circle {
                color: #34d399;
                font-size: 1.1rem;
            }

            .compare-table td i.fa-times-circle {
                color: #f87171;
                font-size: 1.1rem;
            }

            .compare-table td i.fa-minus-circle {
                color: #fb923c;
                font-size: 1.1rem;
            }

        .compare-table tbody tr:hover {
            background: rgba(59,130,246,0.05);
        }

        .compare-table tbody tr:last-child td {
            border-bottom: none;
        }

    /* ===== REQUEST / CONTACT ===== */
    .request-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        align-items: start;
    }

    .request-form input, .request-form select, .request-form textarea {
        width: 100%;
        padding: 16px 20px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        color: #eef2f8;
        font-size: 1rem;
        margin-bottom: 18px;
        transition: 0.25s;
        font-family: inherit;
    }

        .request-form input:focus, .request-form select:focus, .request-form textarea:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255,255,255,0.07);
            box-shadow: 0 0 30px rgba(59,130,246,0.05);
        }

        .request-form select option {
            background: #0a0e17;
            color: #eef2f8;
        }

    .request-form textarea {
        min-height: 140px;
        resize: vertical;
    }

    .request-info {
        display: flex;
        flex-direction: column;
        gap: 20px;
        justify-content: center;
    }

        .request-info .feature-box {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 20px;
            padding: 24px;
            transition: 0.3s;
        }

            .request-info .feature-box:hover {
                border-color: #3b82f6;
            }

            .request-info .feature-box i {
                font-size: 2rem;
                color: #3b82f6;
                margin-bottom: 10px;
            }

            .request-info .feature-box h4 {
                font-size: 1.1rem;
                margin-bottom: 4px;
            }

            .request-info .feature-box p {
                color: #94a3b8;
                font-size: 0.95rem;
            }

    .contact-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
    }

    .contact-form input, .contact-form textarea {
        width: 100%;
        padding: 16px 20px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        color: #eef2f8;
        font-size: 1rem;
        margin-bottom: 18px;
        transition: 0.25s;
        font-family: inherit;
    }

        .contact-form input:focus, .contact-form textarea:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(255,255,255,0.07);
            box-shadow: 0 0 30px rgba(59,130,246,0.05);
        }

    .contact-form textarea {
        min-height: 140px;
        resize: vertical;
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 24px;
        justify-content: center;
    }

        .contact-info .item {
            display: flex;
            align-items: center;
            gap: 18px;
            font-size: 1.05rem;
        }

            .contact-info .item i {
                font-size: 1.5rem;
                width: 52px;
                height: 52px;
                background: rgba(59,130,246,0.08);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #3b82f6;
                border: 1px solid rgba(59,130,246,0.1);
                transition: 0.3s;
                flex-shrink: 0;
            }

            .contact-info .item:hover i {
                background: rgba(59,130,246,0.15);
                transform: scale(1.05);
            }

    /* ===== FAQ ===== */
    .faq-list {
        max-width: 780px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .faq-item {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 18px;
        overflow: hidden;
        transition: 0.25s;
    }

        .faq-item:hover {
            border-color: rgba(59,130,246,0.4);
        }

    .faq-question {
        padding: 20px 28px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: 0.2s;
    }

        .faq-question:hover {
            background: rgba(255,255,255,0.03);
        }

        .faq-question i {
            transition: 0.3s;
            color: #3b82f6;
        }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        padding: 0 28px;
        color: #b8c4d6;
        transition: max-height 0.4s cubic-bezier(0.2,0.9,0.3,1), padding 0.3s ease, opacity 0.3s ease;
        opacity: 0;
    }

    .faq-item.active .faq-answer {
        max-height: 500px;
        padding: 0 28px 24px;
        opacity: 1;
    }

    .faq-item.active .faq-question i {
        transform: rotate(180deg);
    }

    /* ===== BLOG PREVIEW ===== */
    .blog-preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 24px;
    }

    .blog-preview-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.35s cubic-bezier(0.2,0.9,0.3,1);
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .blog-preview-card:hover {
            transform: translateY(-6px);
            border-color: rgba(59,130,246,0.4);
            box-shadow: 0 20px 50px rgba(59,130,246,0.12);
        }

    .blog-preview-icon {
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(59,130,246,0.12), rgba(139,92,246,0.08));
        color: #60a5fa;
        font-size: 3rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        position: relative;
        overflow: hidden;
    }

    .blog-preview-card:hover .blog-preview-icon {
        color: #93c5fd;
    }

    .blog-preview-body {
        padding: 22px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .blog-preview-topic {
        font-size: 0.72rem;
        font-weight: 700;
        color: #8b5cf6;
        letter-spacing: 0.4px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .blog-preview-card h3 {
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        line-height: 1.6;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.3s;
    }

    .blog-preview-card:hover h3 {
        color: #60a5fa;
    }

    .blog-preview-excerpt {
        color: #94a3b8;
        font-size: 0.85rem;
        line-height: 1.9;
        margin-bottom: 16px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .blog-preview-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    .blog-preview-date {
        font-size: 0.72rem;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .blog-preview-read {
        font-size: 0.75rem;
        font-weight: 600;
        color: #3b82f6;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: gap 0.3s;
    }

    .blog-preview-card:hover .blog-preview-read {
        gap: 10px;
        color: #60a5fa;
    }

    .blog-preview-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 50px 20px;
        color: #64748b;
        font-size: 0.95rem;
        background: rgba(255,255,255,0.02);
        border: 1px dashed rgba(255,255,255,0.08);
        border-radius: 20px;
    }

    @@keyframes float {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-12px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .float-icon {
        animation: float 4s ease-in-out infinite;
    }

    .float-icon-delay {
        animation-delay: 1s;
    }

    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.3);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    @@media (max-width: 992px) {
        .about-grid, .contact-wrapper, .request-grid {
            grid-template-columns: 1fr;
        }

        .hero h1 {
            font-size: 3.2rem;
        }

        .services-grid {
            grid-template-columns: 1fr 1fr;
        }

        .process-timeline {
            grid-template-columns: repeat(2, 1fr);
            gap: 32px;
        }

            .process-timeline::before {
                display: none;
            }

        .consult-card.featured {
