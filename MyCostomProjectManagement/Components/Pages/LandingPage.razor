            new StatItem { Label = "پروژه موفق", Target = AboutMeSection.AboutStats.SuccessProjects, CurrentValue = 0 },
            new StatItem { Label = "مشتری راضی", Target = AboutMeSection.AboutStats.CustomerSatisfaction, CurrentValue = 0 }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PortfolioResult = await _portfolioFacade.GetFilter(new PortfolioFilterParam
            {
                PageId = 1,
                Take = 3,
                GetPortfolioFileType = GetPortfolioType.GetAll,
                GetForMainPage = true,
            });

            await GetSetting();

            var getSkillResult = await _skillFacade.GetFilter(new BackEnd.Core.Skills.Queries.DTOs.SkillFilterParam
            {
                IsActive = true,
