    private List<FaqItem> faqItems = new();
    private List<SiteLinksDto> siteLinksDtos = new();
    private SiteSettingsDto siteSetting { get; set; }
    private AboutMeSectionDto AboutMeSection { get; set; }

    public CreateContactUsCommand ContactUsModel { get; set; } = new();

    private System.Timers.Timer? counterTimer;
    private System.Timers.Timer? typewriterTimer;
    private int typewriterIndex = 0;
    private int charIndex = 0;
    private bool isDeleting = false;
    private readonly string[] typewriterWords =
    {
        "محمد پارسا کریمی",
        "mohammad Parsa Karimi",
        "Full-Stack Developer"
    };

    public PortfolioFilterResult PortfolioResult { get; set; }

    private CreateProjectRequestV1Command _createCommand = new();
    private bool _isSubmitting = false;
    private string _message = "";
    private bool _isSuccess = false;

    // ─── HANDLERS ───
    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _message = "";

        try
        {
            _createCommand.IsWasSeen = false;
            _createCommand.IsWorked = false;
            _createCommand.IsDone = false;

            var result = await _prV1Facade.Create(_createCommand);
            if (result.Status == BackEnd.Shared.CoreShared.OperationResultStatus.Success)
            {
                _isSuccess = true;
                _message = "✅ درخواست شما با موفقیت ثبت شد. به زودی با شما تماس می‌گیریم.";
                _createCommand = new();
            }
            else
            {
                _isSuccess = false;
                _message = $"❌ خطا: {result.Message ?? "مشکلی پیش آمد، لطفاً دوباره تلاش کنید."}";
            }
        }
        catch (Exception ex)
        {
            _isSuccess = false;
            _message = $"❌ خطای سیستمی: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
            await InitializeJsInterop();
        }
    }

    private async Task SendMessage()
    {
        var result = await _contactUsFacade.Create(ContactUsModel);
        if (result.Status == BackEnd.Shared.CoreShared.OperationResultStatus.Success)
        {
            await JSRuntime.InvokeVoidAsync("showUserAlert", result.Message, "success", "✅ موفقیت", 5000);
            ContactUsModel = new();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("showUserAlert", result.Message, "error", "❌ خطا", 5000);
        }
        StateHasChanged();
    }

    // ─── LIFECYCLE ───
    protected override async Task OnInitializedAsync()
    {
