                IsVisible = i.IsActive,
                Name = i.Title,
                Progress = i.SkillPercentage,
            }).ToList();

            var getFAQFilterResult = await _faqFacade.GetFilter(new BackEnd.Core.FAQ.Queries.DTOs.FAQFilterParam
            {
                PageId = 1,
                Take = 4,
                IsActive = true
            });
            faqItems = getFAQFilterResult.Data.Select(i => new FaqItem
            {
                Question = i.Question,
                Answer = i.Answer,
                IsActive = false,
                Sequense = i.Sequense,
            }).ToList();

            StartCounterAnimation();
            StartTypewriter();
            StateHasChanged();
            await InitializeJsInterop();
        }
    }

    // ─── JS INTEROP ───
    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 50);
            });

            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            const fadeElements = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        const skillItem = entry.target.closest('.skill-item');
                        if (skillItem) {
                            const bar = skillItem.querySelector('.bar');
                            const progress = skillItem.dataset.progress || 0;
                            if (bar) setTimeout(() => bar.style.width = progress + '%', 300);
                        }
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });
            fadeElements.forEach(el => observer.observe(el));

            setTimeout(() => {
                fadeElements.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                        const skillItem = el.closest('.skill-item');
                        if (skillItem) {
                            const bar = skillItem.querySelector('.bar');
                            const progress = skillItem.dataset.progress || 0;
                            if (bar) bar.style.width = progress + '%';
                        }
                    }
                });
            }, 400);
        ");
    }

    private async Task ScrollToSection(string sectionId)
    {
        await JSRuntime.InvokeVoidAsync("eval", $@"
            const element = document.getElementById('{sectionId}');
            if (element) {{
                const navbar = document.querySelector('.navbar') || document.querySelector('.front-navbar');
                const navbarHeight = navbar?.offsetHeight || 80;
                const offset = element.getBoundingClientRect().top + window.pageYOffset - navbarHeight - 20;
                window.scrollTo({{ top: offset, behavior: 'smooth' }});
            }}
        ");
    }

    // ─── FAQ ───
    private void ToggleFaq(FaqItem item)
    {
        foreach (var other in faqItems)
            if (other != item) other.IsActive = false;
        item.IsActive = !item.IsActive;
    }

    // ─── COUNTER ───
    private void StartCounterAnimation()
    {
        counterTimer = new System.Timers.Timer(30);
        counterTimer.Elapsed += (sender, e) =>
        {
            bool allDone = true;
            foreach (var stat in stats)
            {
                if (stat.CurrentValue < stat.Target)
                {
                    stat.CurrentValue = Math.Min(stat.CurrentValue + 1, stat.Target);
                    allDone = false;
                }
            }
            if (!allDone) InvokeAsync(StateHasChanged);
            else counterTimer?.Stop();
        };
        counterTimer.Start();
    }

    // ─── TYPEWRITER ───
    private void StartTypewriter()
    {
        typewriterTimer = new System.Timers.Timer(120);
        typewriterTimer.Elapsed += (sender, e) =>
        {
            var currentWord = typewriterWords[typewriterIndex];
            if (isDeleting)
            {
                if (charIndex > 0) charIndex--;
                else
                {
                    isDeleting = false;
                    typewriterIndex = (typewriterIndex + 1) % typewriterWords.Length;
                    typewriterTimer.Interval = 400;
                }
            }
            else
            {
                if (charIndex < currentWord.Length) charIndex++;
                else
                {
                    isDeleting = true;
                    typewriterTimer.Interval = 500;
                }
            }
            typewriterText = currentWord.Substring(0, charIndex);
            InvokeAsync(StateHasChanged);
        };
        typewriterTimer.Start();
    }

    // ─── HELPERS ───
    public class StatItem
    {
        public string Label { get; set; } = "";
        public int Target { get; set; }
        public int CurrentValue { get; set; }
    }

    public class SkillItem
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public int Progress { get; set; }
        public bool IsVisible { get; set; }
    }

    public class FaqItem
    {
        public string Question { get; set; } = "";
        public string Answer { get; set; } = "";
        public bool IsActive { get; set; }
        public int Sequense { get; set; }
    }
}
