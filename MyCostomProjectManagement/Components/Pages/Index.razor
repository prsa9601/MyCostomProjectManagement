@page "/"
@layout FrontLayout
@rendermode InteractiveServer 

@inject NavigationManager nm
@code {
    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }

    private void RedirectToDashboard()
    {
        nm.NavigateTo("/Dashboard", true);
    }
}
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="../../../../../_framework/blazor.web.js"></script>

   @*  <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> *@
    <PageTitle>محمد رضایی | برنامه‌نویس و توسعه‌دهنده</PageTitle>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
            /* ----- RESET & BASE ----- */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                background: #0a0e17;
                color: #eef2f8;
                line-height: 1.7;
                scroll-behavior: smooth;
                overflow-x: hidden;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            .container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 24px;
                position: relative;
                z-index: 2;
            }

            /* ----- 1️⃣ PARALLAX EFFECT (subtle) ----- */
            .parallax {
                transition: transform 0.1s ease-out;
                will-change: transform;
            }

            /* ----- 2️⃣ RIPPLE BUTTONS ----- */
            .ripple {
                position: relative;
                overflow: hidden;
            }

            .ripple-effect {
                position: absolute;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.3);
                transform: scale(0);
                animation: rippleAnim 0.6s linear;
                pointer-events: none;
            }
            @@keyframes rippleAnim {
                to {
                    transform: scale(4);
                    opacity: 0;
                }
            }

            /* ----- 3️⃣ GRADIENT NAVBAR (on scroll) ----- */
            .navbar {
                position: fixed;
                top: 0;
                width: 100%;
                z-index: 999;
                padding: 16px 0;
                transition: background 0.5s, backdrop-filter 0.5s, box-shadow 0.4s;
                background: transparent;
            }

                .navbar.scrolled {
                    background: linear-gradient(135deg, rgba(10, 14, 23, 0.92), rgba(20, 30, 48, 0.92));
                    backdrop-filter: blur(16px);
                    -webkit-backdrop-filter: blur(16px);
                    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
                    box-shadow: 0 4px 40px rgba(0, 0, 0, 0.4);
                }

                .navbar .container {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    flex-wrap: wrap;
                }

            .logo {
                font-size: 1.7rem;
                font-weight: 800;
                letter-spacing: -0.5px;
                color: #fff;
                text-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
            }

                .logo span {
                    color: #3b82f6;
                    text-shadow: 0 0 30px rgba(59, 130, 246, 0.3);
                }

            .nav-links {
                display: flex;
                gap: 30px;
                list-style: none;
                font-size: 0.95rem;
                font-weight: 500;
                align-items: center;
            }

                .nav-links a {
                    color: #b8c4d6;
                    transition: 0.25s;
                    position: relative;
                    padding: 4px 0;
                }

                    .nav-links a:hover {
                        color: #fff;
                    }

                    .nav-links a::after {
                        content: '';
                        position: absolute;
                        bottom: -2px;
                        right: 0;
                        width: 0;
                        height: 2px;
                        background: #3b82f6;
                        transition: 0.35s;
                        box-shadow: 0 0 12px #3b82f6;
                    }

                    .nav-links a:hover::after {
                        width: 100%;
                    }

            .nav-actions {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .btn-primary {
                background: #3b82f6;
                color: #fff;
                padding: 10px 26px;
                border-radius: 40px;
                font-weight: 600;
                font-size: 0.9rem;
                transition: 0.3s;
                border: none;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
            }

                .btn-primary:hover {
                    background: #2563eb;
                    transform: translateY(-2px) scale(1.02);
                    box-shadow: 0 12px 40px rgba(59, 130, 246, 0.4);
                }

            .btn-outline {
                background: transparent;
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #eef2f8;
                padding: 10px 26px;
                border-radius: 40px;
                font-weight: 500;
                transition: 0.3s;
            }

                .btn-outline:hover {
                    border-color: #3b82f6;
                    color: #fff;
                    background: rgba(59, 130, 246, 0.08);
                    box-shadow: 0 0 30px rgba(59, 130, 246, 0.1);
                }

            .btn-dashboard {
                background: rgba(59, 130, 246, 0.15);
                border: 1px solid rgba(59, 130, 246, 0.3);
                color: #3b82f6;
                padding: 8px 18px;
                border-radius: 40px;
                font-weight: 500;
                font-size: 0.85rem;
                transition: 0.3s;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .btn-dashboard:hover {
                    background: rgba(59, 130, 246, 0.25);
                    transform: scale(1.04);
                    box-shadow: 0 0 30px rgba(59, 130, 246, 0.15);
                }

            .btn-admin {
                background: rgba(139, 92, 246, 0.15);
                border: 1px solid rgba(139, 92, 246, 0.3);
                color: #a78bfa;
                padding: 8px 18px;
                border-radius: 40px;
                font-weight: 500;
                font-size: 0.85rem;
                transition: 0.3s;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .btn-admin:hover {
                    background: rgba(139, 92, 246, 0.25);
                    transform: scale(1.04);
                    box-shadow: 0 0 30px rgba(139, 92, 246, 0.15);
                }

            .hamburger {
                display: none;
                flex-direction: column;
                gap: 5px;
                cursor: pointer;
                background: none;
                border: none;
            }

                .hamburger span {
                    display: block;
                    width: 30px;
                    height: 2.5px;
                    background: #eef2f8;
                    border-radius: 4px;
                    transition: 0.3s;
                }

            /* ----- PARTICLES BACKGROUND ----- */
            .bg-particles {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 0;
                overflow: hidden;
                pointer-events: none;
            }

                .bg-particles span {
                    position: absolute;
                    display: block;
                    width: 6px;
                    height: 6px;
                    background: rgba(59, 130, 246, 0.2);
                    border-radius: 50%;
                    animation: floatParticle 12s infinite alternate ease-in-out;
                    box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
                }

                    .bg-particles span:nth-child(1) {
                        top: 10%;
                        left: 20%;
                        animation-duration: 14s;
                        width: 8px;
                        height: 8px;
                    }

                    .bg-particles span:nth-child(2) {
                        top: 60%;
                        left: 80%;
                        animation-duration: 16s;
                        animation-delay: 2s;
                    }

                    .bg-particles span:nth-child(3) {
                        top: 30%;
                        left: 70%;
                        animation-duration: 18s;
                        animation-delay: 4s;
                        width: 10px;
                        height: 10px;
                    }

                    .bg-particles span:nth-child(4) {
                        top: 80%;
                        left: 10%;
                        animation-duration: 15s;
                        animation-delay: 1s;
                    }

                    .bg-particles span:nth-child(5) {
                        top: 50%;
                        left: 40%;
                        animation-duration: 20s;
                        animation-delay: 3s;
                        width: 12px;
                        height: 12px;
                        background: rgba(59, 130, 246, 0.12);
                    }

                    .bg-particles span:nth-child(6) {
                        top: 15%;
                        left: 90%;
                        animation-duration: 13s;
                        animation-delay: 5s;
                    }

                    .bg-particles span:nth-child(7) {
                        top: 70%;
                        left: 50%;
                        animation-duration: 17s;
                        animation-delay: 2s;
                        width: 7px;
                        height: 7px;
                    }

                    .bg-particles span:nth-child(8) {
                        top: 40%;
                        left: 5%;
                        animation-duration: 19s;
                        animation-delay: 3s;
                    }
            @@keyframes floatParticle {
                0% {
                    transform: translate(0, 0) scale(1);
                    opacity: 0.2;
                }

                50% {
                    transform: translate(30px, -60px) scale(1.6);
                    opacity: 0.7;
                }

                100% {
                    transform: translate(-20px, 40px) scale(0.8);
                    opacity: 0.1;
                }
            }

            /* ----- GLASS + GRADIENT BORDERS ----- */
            .glass {
                background: rgba(255, 255, 255, 0.04);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
                position: relative;
                border-radius: 28px;
                overflow: hidden;
                transition: all 0.35s ease;
            }

                .glass::before {
                    content: '';
                    position: absolute;
                    inset: -2px;
                    z-index: -1;
                    border-radius: 30px;
                    background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6, #8b5cf6, #3b82f6);
                    background-size: 400% 400%;
                    animation: rotateBorder 8s linear infinite;
                    opacity: 0.25;
                    transition: opacity 0.4s;
                }

                .glass:hover::before {
                    opacity: 0.6;
                }
            @@keyframes rotateBorder {
                0% {
                    background-position: 0% 50%;
                }

                100% {
                    background-position: 400% 50%;
                }
            }

            /* ----- FLOAT ANIMATION ----- */
            @@keyframes float {
                0% {
                    transform: translateY(0px);
                }

                50% {
                    transform: translateY(-12px);
                }

                100% {
                    transform: translateY(0px);
                }
            }

            .float-icon {
                animation: float 4s ease-in-out infinite;
            }

            .float-icon-delay {
                animation-delay: 1s;
            }

            /* ----- TYPEWRITER ----- */
            .typewriter .text {
                display: inline;
                background: linear-gradient(to left, #f0f4ff, #94a3b8);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .typewriter .cursor {
                display: inline-block;
                width: 3px;
                height: 1em;
                background: #3b82f6;
                margin-right: 6px;
                animation: blink 0.8s step-end infinite;
                vertical-align: text-bottom;
                box-shadow: 0 0 20px #3b82f6;
            }
            @@keyframes blink {
                0%,
                100% {
                    opacity: 1;
                }

                50% {
                    opacity: 0;
                }
            }

            /* ----- HERO ----- */
            .hero {
                position: relative;
                padding: 160px 0 100px;
                z-index: 1;
                text-align: center;
            }

            .hero-badge {
                display: inline-block;
                background: rgba(59, 130, 246, 0.12);
                padding: 6px 22px;
                border-radius: 40px;
                font-size: 0.8rem;
                color: #3b82f6;
                border: 1px solid rgba(59, 130, 246, 0.15);
                margin-bottom: 28px;
                letter-spacing: 0.5px;
                backdrop-filter: blur(4px);
            }

            .hero h1 {
                font-size: clamp(3rem, 10vw, 5.2rem);
                font-weight: 900;
                line-height: 1.1;
                margin-bottom: 20px;
            }

            .hero p {
                font-size: 1.3rem;
                max-width: 720px;
                margin: 0 auto 40px;
                color: #b8c4d6;
            }

            .hero-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 18px;
                justify-content: center;
            }

            /* ----- SECTIONS ----- */
            .section {
                position: relative;
                padding: 90px 0;
                z-index: 1;
                transition: background 0.8s ease;
            }

                .section:nth-child(odd) {
                    background: rgba(255, 255, 255, 0.01);
                }

                .section:nth-child(even) {
                    background: rgba(0, 0, 0, 0.15);
                }

            .section-title {
                font-size: 2.5rem;
                font-weight: 800;
                margin-bottom: 12px;
                text-align: center;
            }

                .section-title span {
                    color: #3b82f6;
                    text-shadow: 0 0 30px rgba(59, 130, 246, 0.15);
                }

            .section-subtitle {
                text-align: center;
                color: #94a3b8;
                max-width: 640px;
                margin: 0 auto 56px;
                font-size: 1.1rem;
            }

            /* ----- ABOUT ----- */
            .about-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 60px;
                align-items: center;
            }

            .about-text p {
                color: #c8d2e0;
                margin-bottom: 20px;
                font-size: 1.05rem;
            }

            .about-stats {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;
                margin-top: 30px;
            }

            .stat-item {
                background: rgba(255, 255, 255, 0.04);
                backdrop-filter: blur(4px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                padding: 22px 12px;
                border-radius: 20px;
                text-align: center;
                transition: 0.3s;
            }

                .stat-item:hover {
                    border-color: #3b82f6;
                    transform: translateY(-4px);
                }

                .stat-item .number {
                    font-size: 2.2rem;
                    font-weight: 800;
                    color: #3b82f6;
                    text-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
                }

                .stat-item .label {
                    font-size: 0.85rem;
                    color: #94a3b8;
                    margin-top: 4px;
                }

            .about-image {
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 280px;
                background: rgba(255, 255, 255, 0.02);
                backdrop-filter: blur(8px);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: 32px;
                transition: 0.4s;
            }

                .about-image i {
                    font-size: 9rem;
                    color: #3b82f6;
                    opacity: 0.5;
                    filter: drop-shadow(0 0 40px rgba(59, 130, 246, 0.2));
                }

            /* ----- SKILLS with PROGRESS BARS ----- */
            .skills-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 28px;
                margin-top: 10px;
            }

            .skill-item {
                background: rgba(255, 255, 255, 0.04);
                backdrop-filter: blur(6px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                border-radius: 20px;
                padding: 24px 20px;
                transition: 0.35s;
                position: relative;
                overflow: hidden;
            }

                .skill-item::before {
                    content: '';
                    position: absolute;
                    inset: -2px;
                    z-index: -1;
                    border-radius: 22px;
                    background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
                    background-size: 300% 300%;
                    animation: rotateBorder 10s linear infinite;
                    opacity: 0;
                    transition: opacity 0.4s;
                }

                .skill-item:hover::before {
                    opacity: 0.4;
                }

                .skill-item:hover {
                    border-color: transparent;
                    transform: translateY(-4px);
                }

                .skill-item .skill-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 10px;
                }

                    .skill-item .skill-header i {
                        font-size: 1.8rem;
                        color: #3b82f6;
                    }

                    .skill-item .skill-header span {
                        font-weight: 600;
                    }

            .skill-progress {
                width: 100%;
                height: 6px;
                background: rgba(255, 255, 255, 0.08);
                border-radius: 10px;
                overflow: hidden;
                margin-top: 6px;
            }

                .skill-progress .bar {
                    height: 100%;
                    width: 0%;
                    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
                    border-radius: 10px;
                    transition: width 1.2s cubic-bezier(0.2, 0.9, 0.3, 1);
                    box-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
                }

            /* ----- PORTFOLIO ----- */
            .portfolio-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 32px;
            }

            .portfolio-item {
                background: rgba(255, 255, 255, 0.03);
                backdrop-filter: blur(6px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                border-radius: 24px;
                overflow: hidden;
                transition: 0.35s;
                position: relative;
            }

                .portfolio-item::before {
                    content: '';
                    position: absolute;
                    inset: -2px;
                    z-index: -1;
                    border-radius: 26px;
                    background: conic-gradient(from 0deg, #3b82f6, #a78bfa, #3b82f6);
                    background-size: 300% 300%;
                    animation: rotateBorder 12s linear infinite;
                    opacity: 0;
                    transition: opacity 0.4s;
                }

                .portfolio-item:hover::before {
                    opacity: 0.5;
                }

                .portfolio-item:hover {
                    transform: translateY(-8px);
                    border-color: transparent;
                    box-shadow: 0 20px 50px rgba(59, 130, 246, 0.08);
                }

                .portfolio-item img {
                    width: 100%;
                    height: 200px;
                    object-fit: cover;
                    display: block;
                    background: #1a2636;
                }

                .portfolio-item .info {
                    padding: 24px;
                }

                    .portfolio-item .info h4 {
                        font-size: 1.2rem;
                        margin-bottom: 4px;
                    }

                    .portfolio-item .info p {
                        color: #94a3b8;
                        font-size: 0.95rem;
                    }

            /* ----- PROJECTS ----- */
            .project-list {
                display: flex;
                flex-direction: column;
                gap: 20px;
            }

            .project-row {
                background: rgba(255, 255, 255, 0.03);
                backdrop-filter: blur(6px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                border-radius: 20px;
                padding: 24px 30px;
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: center;
                transition: 0.3s;
                position: relative;
                overflow: hidden;
            }

                .project-row::before {
                    content: '';
                    position: absolute;
                    inset: -2px;
                    z-index: -1;
                    border-radius: 22px;
                    background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
                    background-size: 300% 300%;
                    animation: rotateBorder 14s linear infinite;
                    opacity: 0;
                    transition: opacity 0.4s;
                }

                .project-row:hover::before {
                    opacity: 0.4;
                }

                .project-row:hover {
                    border-color: transparent;
                    transform: scale(1.01);
                }

                .project-row .info h4 {
                    font-size: 1.2rem;
                }

                .project-row .info p {
                    color: #94a3b8;
                    font-size: 0.95rem;
                }

                .project-row .badge {
                    background: rgba(59, 130, 246, 0.15);
                    padding: 6px 18px;
                    border-radius: 40px;
                    color: #3b82f6;
                    font-size: 0.8rem;
                    font-weight: 500;
                    border: 1px solid rgba(59, 130, 246, 0.1);
                }

            /* ----- PURCHASE / API ----- */
            .purchase-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
                gap: 32px;
                margin-top: 10px;
            }

            .purchase-card {
                background: rgba(255, 255, 255, 0.03);
                backdrop-filter: blur(6px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                border-radius: 28px;
                padding: 36px 24px;
                text-align: center;
                transition: 0.35s;
                position: relative;
                overflow: hidden;
            }

                .purchase-card::before {
                    content: '';
                    position: absolute;
                    inset: -2px;
                    z-index: -1;
                    border-radius: 30px;
                    background: conic-gradient(from 0deg, #3b82f6, #a78bfa, #3b82f6);
                    background-size: 300% 300%;
                    animation: rotateBorder 10s linear infinite;
                    opacity: 0;
                    transition: opacity 0.4s;
                }

                .purchase-card:hover::before {
                    opacity: 0.5;
                }

                .purchase-card:hover {
                    transform: translateY(-6px);
                    border-color: transparent;
                }

                .purchase-card.featured {
                    border-color: #3b82f6;
                    background: rgba(59, 130, 246, 0.06);
                    box-shadow: 0 0 50px rgba(59, 130, 246, 0.05);
                }

                .purchase-card h3 {
                    font-size: 1.6rem;
                    margin-bottom: 8px;
                }

                .purchase-card .price {
                    font-size: 2.4rem;
                    font-weight: 800;
                    color: #3b82f6;
                    margin: 16px 0;
                    text-shadow: 0 0 20px rgba(59, 130, 246, 0.1);
                }

                .purchase-card ul {
                    list-style: none;
                    margin: 22px 0;
                    color: #b8c4d6;
                }

                    .purchase-card ul li {
                        padding: 8px 0;
                        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
                    }

            /* ----- REQUEST PROJECT (جدید) ----- */
            .request-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 50px;
                align-items: start;
            }

            .request-form input,
            .request-form select,
            .request-form textarea {
                width: 100%;
                padding: 16px 20px;
                background: rgba(255, 255, 255, 0.04);
                backdrop-filter: blur(4px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                border-radius: 16px;
                color: #eef2f8;
                font-size: 1rem;
                margin-bottom: 18px;
                transition: 0.25s;
            }

                .request-form input:focus,
                .request-form select:focus,
                .request-form textarea:focus {
                    outline: none;
                    border-color: #3b82f6;
                    background: rgba(255, 255, 255, 0.07);
                    box-shadow: 0 0 30px rgba(59, 130, 246, 0.05);
                }

                .request-form select option {
                    background: #0a0e17;
                    color: #eef2f8;
                }

            .request-form textarea {
                min-height: 140px;
                resize: vertical;
            }

            .request-info {
                display: flex;
                flex-direction: column;
                gap: 20px;
                justify-content: center;
            }

                .request-info .feature-box {
                    background: rgba(255, 255, 255, 0.03);
                    border: 1px solid rgba(255, 255, 255, 0.06);
                    border-radius: 20px;
                    padding: 24px;
                    transition: 0.3s;
                }

                    .request-info .feature-box:hover {
                        border-color: #3b82f6;
                    }

                    .request-info .feature-box i {
                        font-size: 2rem;
                        color: #3b82f6;
                        margin-bottom: 10px;
                    }

                    .request-info .feature-box h4 {
                        font-size: 1.1rem;
                        margin-bottom: 4px;
                    }

                    .request-info .feature-box p {
                        color: #94a3b8;
                        font-size: 0.95rem;
                    }

            /* ----- CONTACT ----- */
            .contact-wrapper {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 60px;
            }

            .contact-form input,
            .contact-form textarea {
                width: 100%;
                padding: 16px 20px;
                background: rgba(255, 255, 255, 0.04);
                backdrop-filter: blur(4px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                border-radius: 16px;
                color: #eef2f8;
                font-size: 1rem;
                margin-bottom: 18px;
                transition: 0.25s;
            }

                .contact-form input:focus,
                .contact-form textarea:focus {
                    outline: none;
                    border-color: #3b82f6;
                    background: rgba(255, 255, 255, 0.07);
                    box-shadow: 0 0 30px rgba(59, 130, 246, 0.05);
                }

            .contact-form textarea {
                min-height: 140px;
                resize: vertical;
            }

            .contact-info {
                display: flex;
                flex-direction: column;
                gap: 24px;
                justify-content: center;
            }

                .contact-info .item {
                    display: flex;
                    align-items: center;
                    gap: 18px;
                    font-size: 1.05rem;
                }

                    .contact-info .item i {
                        font-size: 1.5rem;
                        width: 52px;
                        height: 52px;
                        background: rgba(59, 130, 246, 0.08);
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        color: #3b82f6;
                        border: 1px solid rgba(59, 130, 246, 0.1);
                        transition: 0.3s;
                    }

                    .contact-info .item:hover i {
                        background: rgba(59, 130, 246, 0.15);
                        transform: scale(1.05);
                    }

            /* ----- FAQ ----- */
            .faq-list {
                max-width: 780px;
                margin: 0 auto;
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            .faq-item {
                background: rgba(255, 255, 255, 0.03);
                backdrop-filter: blur(4px);
                border: 1px solid rgba(255, 255, 255, 0.06);
                border-radius: 18px;
                overflow: hidden;
                transition: 0.25s;
                position: relative;
            }

                .faq-item::before {
                    content: '';
                    position: absolute;
                    inset: -2px;
                    z-index: -1;
                    border-radius: 20px;
                    background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
                    background-size: 300% 300%;
                    animation: rotateBorder 16s linear infinite;
                    opacity: 0;
                    transition: opacity 0.4s;
                }

                .faq-item:hover::before {
                    opacity: 0.3;
                }

                .faq-item:hover {
                    border-color: transparent;
                }

            .faq-question {
                padding: 20px 28px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                justify-content: space-between;
                align-items: center;
                transition: 0.2s;
            }

                .faq-question:hover {
                    background: rgba(255, 255, 255, 0.03);
                }

                .faq-question i {
                    transition: 0.3s;
                    color: #3b82f6;
                }

            .faq-answer {
                max-height: 0;
                overflow: hidden;
                padding: 0 28px;
                color: #b8c4d6;
                transition: 0.35s ease;
            }

            .faq-item.active .faq-answer {
                max-height: 200px;
                padding: 0 28px 24px;
            }

            .faq-item.active .faq-question i {
                transform: rotate(180deg);
            }

            /* ----- FOOTER ----- */
            .footer {
                position: relative;
                padding: 40px 0 30px;
                border-top: 1px solid rgba(255, 255, 255, 0.04);
                background: rgba(0, 0, 0, 0.2);
                backdrop-filter: blur(8px);
                z-index: 1;
            }

                .footer .container {
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    align-items: center;
                }

            .footer-links {
                display: flex;
                gap: 28px;
                font-size: 0.9rem;
                color: #94a3b8;
            }

                .footer-links a:hover {
                    color: #fff;
                }

            .footer-copy {
                color: #64748b;
                font-size: 0.85rem;
            }

            /* ----- SCROLL ANIMATIONS (staggered) ----- */
            .fade-up {
                opacity: 0;
                transform: translateY(40px);
                transition: opacity 0.8s cubic-bezier(0.2, 0.9, 0.3, 1), transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
            }

                .fade-up.visible {
                    opacity: 1;
                    transform: translateY(0);
                }

            .stagger-child {
                transition-delay: 0s;
            }

                .stagger-child:nth-child(1) {
                    transition-delay: 0.05s;
                }

                .stagger-child:nth-child(2) {
                    transition-delay: 0.1s;
                }

                .stagger-child:nth-child(3) {
                    transition-delay: 0.15s;
                }

                .stagger-child:nth-child(4) {
                    transition-delay: 0.2s;
                }

                .stagger-child:nth-child(5) {
                    transition-delay: 0.25s;
                }

                .stagger-child:nth-child(6) {
                    transition-delay: 0.3s;
                }

                .stagger-child:nth-child(7) {
                    transition-delay: 0.35s;
                }

                .stagger-child:nth-child(8) {
                    transition-delay: 0.4s;
                }

            /* ----- RESPONSIVE ----- */
            @@media (max-width: 992px) {
                .about-grid {
                    grid-template-columns: 1fr;
