    <script>
            // ===== HAMBURGER =====
            const hamburger = document.getElementById('hamburger');
            const navLinks = document.getElementById('navLinks');
            hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
            document.querySelectorAll('.nav-links a').forEach(link => {
                link.addEventListener('click', () => navLinks.classList.remove('open'));
            });

            // ===== NAVBAR SCROLL (gradient) =====
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar.classList.toggle('scrolled', window.scrollY > 50);
            });

            // ===== FAQ ACCORDION =====
            document.querySelectorAll('.faq-item').forEach(item => {
                const q = item.querySelector('.faq-question');
                q.addEventListener('click', () => {
                    document.querySelectorAll('.faq-item').forEach(other => {
                        if (other !== item) other.classList.remove('active');
                    });
                    item.classList.toggle('active');
                });
            });

            // ===== TYPEWRITER =====
            (function typewriter() {
                const words = ['محمد رضایی', 'Mohammad Rezaei', 'Full-Stack Developer'];
                let wordIndex = 0,
                    charIndex = 0,
                    isDeleting = false;
                const el = document.getElementById('typewriter-text');
                if (!el) return;

                function type() {
                    const current = words[wordIndex];
                    if (isDeleting) {
                        el.textContent = current.substring(0, charIndex - 1);
                        charIndex--;
                    } else {
                        el.textContent = current.substring(0, charIndex + 1);
                        charIndex++;
                    }
                    if (!isDeleting && charIndex === current.length) {
                        isDeleting = true;
                        setTimeout(type, 1800);
                        return;
                    }
                    if (isDeleting && charIndex === 0) {
                        isDeleting = false;
                        wordIndex = (wordIndex + 1) % words.length;
                        setTimeout(type, 400);
                        return;
                    }
                    setTimeout(type, isDeleting ? 80 : 120);
                }
                type();
            })();

            // ===== RIPPLE EFFECT (feature 2) =====
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // ===== COUNTER ANIMATION (feature 2) =====
            const counters = document.querySelectorAll('.counter');
            let countersAnimated = false;

            function animateCounters() {
                if (countersAnimated) return;
                countersAnimated = true;
                counters.forEach(counter => {
                    const target = parseInt(counter.dataset.target);
                    const duration = 1500;
                    const startTime = performance.now();

                    function updateCounter(currentTime) {
                        const elapsed = currentTime - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        const eased = 1 - Math.pow(1 - progress, 3);
                        const current = Math.floor(eased * target);
                        counter.textContent = current + (target > 10 ? '+' : '');
                        if (progress < 1) {
                            requestAnimationFrame(updateCounter);
                        } else {
                            counter.textContent = target + (target > 10 ? '+' : '');
                        }
                    }
                    requestAnimationFrame(updateCounter);
                });
            }

            // ===== PARALLAX (feature 1) =====
            document.addEventListener('mousemove', (e) => {
                const parallaxEls = document.querySelectorAll('.parallax');
                const x = (e.clientX / window.innerWidth - 0.5) * 8;
                const y = (e.clientY / window.innerHeight - 0.5) * 8;
                parallaxEls.forEach(el => {
                    el.style.transform = `translate(${x}px, ${y}px)`;
                });
            });

            // ===== SCROLL ANIMATIONS (stagger + progress bars + counter trigger) =====
            const fadeElements = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                let shouldAnimateCounters = false;
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        // Trigger progress bars
                        const skillItem = entry.target.closest('.skill-item');
                        if (skillItem) {
                            const bar = skillItem.querySelector('.bar');
                            const progress = skillItem.dataset.progress || 0;
                            if (bar) {
                                setTimeout(() => {
                                    bar.style.width = progress + '%';
                                }, 300);
                            }
                        }
                        // Check if any stat-item is visible to start counters
                        if (entry.target.closest('.stat-item')) {
                            shouldAnimateCounters = true;
                        }
                    }
                });
                if (shouldAnimateCounters) {
                    animateCounters();
                }
            }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });

            fadeElements.forEach(el => observer.observe(el));

            // Trigger for elements already in view
            setTimeout(() => {
                let anyStatVisible = false;
                fadeElements.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                        const skillItem = el.closest('.skill-item');
                        if (skillItem) {
                            const bar = skillItem.querySelector('.bar');
                            const progress = skillItem.dataset.progress || 0;
                            if (bar) bar.style.width = progress + '%';
                        }
                        if (el.closest('.stat-item')) anyStatVisible = true;
                    }
                });
                if (anyStatVisible) animateCounters();
            }, 400);
    </script>
