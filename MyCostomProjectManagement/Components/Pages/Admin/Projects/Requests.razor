    // ============================================================
    // FILTER & SEARCH
    // ============================================================

    private void ApplyFilters()
    {
        var query = allRequests.AsEnumerable();

        // Filter by status
        if (!string.IsNullOrEmpty(filterStatus) && filterStatus != "all")
        {
            query = query.Where(r => r.StatusClass == filterStatus);
        }

        // Filter by type
        if (!string.IsNullOrEmpty(filterType) && filterType != "all")
        {
            query = query.Where(r => r.TypeClass == filterType);
        }

        // Search
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(r =>
                r.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                r.ClientName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                r.Id.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                r.Description.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        // Pagination
        var total = query.Count();
        totalPages = (int)Math.Ceiling(total / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        filteredRequests = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SetFilter(string status)
    {
        filterStatus = status;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetType(string type)
    {
        filterType = type;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // UI METHODS
    // ============================================================

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    private void GoToProfile() => NavigationManager.NavigateTo("/Profile", true);
    private void RefreshRequests()
    {
        LoadRequests();
        ApplyFilters();
        StateHasChanged();
    }

    private void ViewRequest(string id) => NavigationManager.NavigateTo($"/Request/{id}", true);

    private void ApproveRequest(string id)
    {
        var req = allRequests.FirstOrDefault(r => r.Id == id);
        if (req != null && (req.StatusClass == "new" || req.StatusClass == "reviewing"))
        {
            req.StatusClass = "approved";
            req.StatusText = "تأیید شده";
            ApplyFilters();
            StateHasChanged();
        }
    }

    private void RejectRequest(string id)
    {
        var req = allRequests.FirstOrDefault(r => r.Id == id);
        if (req != null && (req.StatusClass == "new" || req.StatusClass == "reviewing"))
        {
            req.StatusClass = "rejected";
            req.StatusText = "رد شده";
            ApplyFilters();
            StateHasChanged();
        }
    }

    private void DeleteRequest(string id)
    {
        allRequests.RemoveAll(r => r.Id == id);
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Navbar scroll
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 30);
            });

            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Fade-up observer
            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 });

            fadeEls.forEach(el => observer.observe(el));

            // Trigger visible for elements already in view
            setTimeout(() => {
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                    }
                });
            }, 300);
        ");
    }

    // ============================================================
    // HELPER CLASSES
    // ============================================================

    public class RequestItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string ClientName { get; set; } = "";
        public string TypeClass { get; set; } = "";
        public string TypeIcon { get; set; } = "";
        public string TypeText { get; set; } = "";
        public string Budget { get; set; } = "";
        public string Date { get; set; } = "";
        public string StatusClass { get; set; } = "";
        public string StatusText { get; set; } = "";
        public string Description { get; set; } = "";
    }
