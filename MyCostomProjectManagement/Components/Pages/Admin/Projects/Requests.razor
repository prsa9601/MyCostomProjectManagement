                IsWasSeen = req.IsWasSeen,
                IsWorked = req.IsWorked,
                PhoneNumber = req.PhoneNumber,
                Price = req.Price,
                Type = req.Type,
            });
            // ApplyFilters();
            StateHasChanged();
        }
    }

    private void DeleteRequest(Guid id)
    {
        allRequests.RemoveAll(r => r.Id == id);
        // ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // HELPER: Compute status from boolean fields
    // ============================================================

    private string GetStatus(RequestItem req)
    {
        if (!req.IsWasSeen && !req.IsWorked && !req.IsDone)
            return "new";
        if (req.IsWasSeen && !req.IsWorked && !req.IsDone)
            return "reviewing";
        if (req.IsWasSeen && req.IsWorked && !req.IsDone)
            return "working";
        if (req.IsWasSeen && req.IsDone)
            return "done";
        // fallback: rejected if seen but not worked and not done? (we'll treat as new)
        return "new";
    }

    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadRequests();
            // await InitializeJsInterop();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Navbar scroll
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 30);
            });

            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Fade-up observer
            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 });

            fadeEls.forEach(el => observer.observe(el));

            // Trigger visible for elements already in view
            setTimeout(() => {
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                    }
                });
            }, 300);
        ");
    }

    // ============================================================
