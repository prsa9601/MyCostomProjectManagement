<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-clipboard-list"></i>
                    درخواست‌های پروژه
                    <span class="badge-admin" style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalRequests</span>
                </h1>
                <div class="subtitle">مدیریت درخواست‌های پروژه از سوی مشتریان</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshRequests"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی درخواست..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterStatus == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>همه</button>
                <button class="filter-btn @(filterStatus == "new" ? "active" : "")" @onclick='() => SetFilter("new")'>جدید</button>
                <button class="filter-btn @(filterStatus == "reviewing" ? "active" : "")" @onclick='() => SetFilter("reviewing")'>در بررسی</button>
                <button class="filter-btn @(filterStatus == "approved" ? "active" : "")" @onclick='() => SetFilter("approved")'>تأیید شده</button>
                <button class="filter-btn @(filterStatus == "rejected" ? "active" : "")" @onclick='() => SetFilter("rejected")'>رد شده</button>
            </div>
            <div class="filter-group" style="margin-right:auto;">
                <button class="filter-btn @(filterType == "all" ? "active" : "")" @onclick='() => SetType("all")'>همه انواع</button>
                <button class="filter-btn @(filterType == "website" ? "active" : "")" @onclick='() => SetType("website")'>وب‌سایت</button>
                <button class="filter-btn @(filterType == "shop" ? "active" : "")" @onclick='() => SetType("shop")'>فروشگاه</button>
                <button class="filter-btn @(filterType == "app" ? "active" : "")" @onclick='() => SetType("app")'>اپلیکیشن</button>
                <button class="filter-btn @(filterType == "api" ? "active" : "")" @onclick='() => SetType("api")'>API</button>
            </div>
        </div>

        <!-- Requests Grid -->
        @if (filteredRequests.Any())
        {
            <div class="requests-grid">
                @foreach (var req in filteredRequests)
                {
                    <div class="request-row fade-up stagger-child">
                        <div class="req-icon @req.TypeClass">
                            <i class="@req.TypeIcon"></i>
                        </div>
                        <div class="req-info">
                            <div class="title">@req.Title</div>
                            <div class="sub">
                                <span><i class="fas fa-user"></i> @req.ClientName</span>
                                <span><i class="far fa-calendar-alt"></i> @req.Date</span>
                                <span><i class="fas fa-tag"></i> @req.TypeText</span>
                            </div>
                        </div>
                        <div class="req-budget">@req.Budget</div>
                        <span class="req-status @req.StatusClass">@req.StatusText</span>
                        <div class="req-action-btns">
                            @if (req.StatusClass == "new" || req.StatusClass == "reviewing")
                            {
                                <button class="btn-success ripple" @onclick='() => ApproveRequest(req.Id)'><i class="fas fa-check"></i> تأیید</button>
                                <button class="btn-danger ripple" @onclick='() => RejectRequest(req.Id)'><i class="fas fa-times"></i> رد</button>
                            }
                        </div>
                        <div class="req-actions">
                            <button class="ripple" title="مشاهده" @onclick='() => ViewRequest(req.Id)'><i class="fas fa-eye"></i></button>
                            <button class="ripple approve" title="تأیید" @onclick='() => ApproveRequest(req.Id)'><i class="fas fa-check-circle"></i></button>
                            <button class="ripple reject" title="رد" @onclick='() => RejectRequest(req.Id)'><i class="fas fa-times-circle"></i></button>
                            <button class="ripple delete" title="حذف" @onclick='() => DeleteRequest(req.Id)'><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state fade-up visible">
                <i class="fas fa-inbox"></i>
                <h3>هیچ درخواستی یافت نشد</h3>
                <p>با تغییر فیلترها یا جستجو، نتایج را مشاهده کنید</p>
            </div>
        }

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }

    </div>
</main>



