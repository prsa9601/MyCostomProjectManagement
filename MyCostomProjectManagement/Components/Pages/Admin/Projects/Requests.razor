        StateHasChanged();
    }

    private void ViewRequest(Guid id) => NavigationManager.NavigateTo($"/Request/{id}", true);

    private async Task ApproveRequest(Guid id)
    {
        var req = allRequests.FirstOrDefault(r => r.Id == id);
        if (req != null && (GetStatus(req) == "new" || GetStatus(req) == "reviewing"))
        {
            req.IsWasSeen = true;
            req.IsWorked = true;
            req.IsDone = false;
            var result = await _facade.Edit(new BackEnd.Core.Project.Commands.ProjectRequestV1.Edit.EditProjectRequestV1Command
