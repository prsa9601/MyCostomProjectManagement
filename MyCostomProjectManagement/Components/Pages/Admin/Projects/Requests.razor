                PhoneNumber = req.PhoneNumber,
                Price = req.Price,
                Type = req.Type,
            });
            // ApplyFilters();
            StateHasChanged();
        }
    }

    private async Task CompleteRequest(Guid id)
    {
        var req = allRequests.FirstOrDefault(r => r.Id == id);
        if (req != null && GetStatus(req) == "working")
        {
            req.IsDone = true;
            var result = await _facade.Edit(new BackEnd.Core.Project.Commands.ProjectRequestV1.Edit.EditProjectRequestV1Command
            {
