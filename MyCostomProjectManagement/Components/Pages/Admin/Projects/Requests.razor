                Price = req.Price,
                Type = req.Type,
            });
            // ApplyFilters();
            StateHasChanged();
        }
    }

    private async Task RejectRequest(Guid id)
    {
        var req = allRequests.FirstOrDefault(r => r.Id == id);
        if (req != null && (GetStatus(req) == "new" || GetStatus(req) == "reviewing"))
        {
            // Reject: mark as seen and not worked (or could delete)
            req.IsWasSeen = true;
            req.IsWorked = false;
            req.IsDone = false;
            var result = await _facade.Edit(new BackEnd.Core.Project.Commands.ProjectRequestV1.Edit.EditProjectRequestV1Command
            {
                Email = req.Email,
                FullName = req.FullName,
                Description = req.Description,
