    private void ApplyFilters()
    {
        var query = allRequests.AsEnumerable();

        // Filter by status (computed)
        if (!string.IsNullOrEmpty(filterStatus) && filterStatus != "all")
        {
            query = query.Where(r => GetStatus(r) == filterStatus);
        }

        // Filter by type
        if (!string.IsNullOrEmpty(filterType) && filterType != "all")
        {
            query = query.Where(r => r.Type.ToString().ToLower() == filterType);
        }

        // Search
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(r =>
                r.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                r.Email.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                r.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                r.Description.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        // Pagination
        var total = query.Count();
        totalPages = (int)Math.Ceiling(total / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        filteredRequests = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SetFilter(string status)
    {
        filterStatus = status;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetType(string type)
    {
        filterType = type;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyFilters();
        StateHasChanged();
    }

