    public class RequestItem
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public ProjectRequestType Type { get; set; }
        public long Price { get; set; }
        public string Description { get; set; } = "";
        public bool IsWasSeen { get; set; }
        public bool IsWorked { get; set; }
        public bool IsDone { get; set; }
        public DateTime CreationDate { get; set; }

        // Computed properties for display
        public string TypeText
        {
            get
            {
                return Type switch
                {
                    ProjectRequestType.Website => "وب‌سایت",
                    ProjectRequestType.Shop => "فروشگاه",
                    ProjectRequestType.App => "اپلیکیشن",
                    ProjectRequestType.Api => "API",
                    ProjectRequestType.Dashboard => "داشبورد",
                    ProjectRequestType.Other => "سایر",
                    _ => "سایر"
                };
            }
        }

        public string TypeClass
        {
            get
            {
                return Type switch
                {
                    ProjectRequestType.Website => "website",
                    ProjectRequestType.Shop => "shop",
                    ProjectRequestType.App => "app",
                    ProjectRequestType.Api => "api",
                    ProjectRequestType.Dashboard => "dashboard",
                    ProjectRequestType.Other => "other",
                    _ => "other"
                };
            }
        }

        public string TypeIcon
        {
            get
            {
                return Type switch
                {
                    ProjectRequestType.Website => "fas fa-globe",
                    ProjectRequestType.Shop => "fas fa-shopping-cart",
                    ProjectRequestType.App => "fas fa-mobile-alt",
                    ProjectRequestType.Api => "fas fa-code",
                    ProjectRequestType.Dashboard => "fas fa-chart-pie",
                    ProjectRequestType.Other => "fas fa-cubes",
                    _ => "fas fa-cubes"
                };
            }
        }

        public string StatusText
        {
            get
            {
                if (!IsWasSeen && !IsWorked && !IsDone) return "جدید";
                if (IsWasSeen && !IsWorked && !IsDone) return "در بررسی";
                if (IsWasSeen && IsWorked && !IsDone) return "در حال انجام";
                if (IsWasSeen && IsDone) return "انجام شده";
                return "جدید";
            }
        }

        public string StatusClass
        {
            get
            {
                if (!IsWasSeen && !IsWorked && !IsDone) return "new";
                if (IsWasSeen && !IsWorked && !IsDone) return "reviewing";
                if (IsWasSeen && IsWorked && !IsDone) return "working";
                if (IsWasSeen && IsDone) return "done";
                return "new";
            }
        }
    }

   
}