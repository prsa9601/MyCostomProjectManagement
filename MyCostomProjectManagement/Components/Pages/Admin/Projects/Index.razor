            <a href="#" class="btn-primary ripple" @onclick="CreateNewProject"><i class="fas fa-plus"></i> پروژه جدید</a>
            <div class="avatar-btn" @onclick="GoToProfile"><i class="fas fa-user-cog"></i></div>
            <button class="hamburger" @onclick="ToggleMenu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-project-diagram"></i>
                    پروژه‌ها
                    <span class="badge-admin" style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalProjects</span>
                </h1>
                <div class="subtitle">مدیریت و مشاهده تمام پروژه‌های سیستم</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshProjects"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
                <button class="btn-primary ripple" @onclick="CreateNewProject"><i class="fas fa-plus"></i> پروژه جدید</button>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی پروژه..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterStatus == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>همه</button>
                <button class="filter-btn @(filterStatus == "active" ? "active" : "")" @onclick='() => SetFilter("active")'>فعال</button>
                <button class="filter-btn @(filterStatus == "completed" ? "active" : "")" @onclick='() => SetFilter("completed")'>تکمیل شده</button>
                <button class="filter-btn @(filterStatus == "pending" ? "active" : "")" @onclick='() => SetFilter("pending")'>در انتظار</button>
                <button class="filter-btn @(filterStatus == "hold" ? "active" : "")" @onclick='() => SetFilter("hold")'>متوقف</button>
            </div>
        </div>

        <!-- Projects Grid -->
        <div class="projects-grid">
            @foreach (var project in filteredProjects)
            {
                <div class="project-card status-@project.StatusClass fade-up stagger-child">
                    <div class="card-header">
                        <div class="title-group">
                            <h3>@project.Title</h3>
                            <span class="project-id">#@project.Id</span>
                        </div>
                        <span class="status-badge @project.StatusClass">@project.StatusText</span>
                    </div>

                    <div class="card-body">
                        @project.Description
                    </div>

                    <div class="progress-wrapper">
                        <div class="progress-label">
                            <span>پیشرفت</span>
                            <span>@project.Progress%</span>
                        </div>
                        <div class="progress-bar">
                            <div class="fill" style="width:@(project.Progress)%;"></div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="meta">
                            <span><i class="far fa-calendar-alt"></i> @project.Date</span>
                            <span><i class="fas fa-user"></i> @project.Assignee</span>
                            <span><i class="fas fa-tag"></i> @project.Budget</span>
                        </div>
                        <div class="actions">
                            <button class="ripple" title="مشاهده" @onclick='() => ViewProject(project.Id)'><i class="fas fa-eye"></i></button>
                            <button class="ripple" title="ویرایش" @onclick='() => EditProject(project.Id)'><i class="fas fa-edit"></i></button>
                            <button class="ripple delete" title="حذف" @onclick='() => DeleteProject(project.Id)'><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }

    </div>
</main>

<!-- ============================================================
     FOOTER
============================================================ -->
<footer class="footer">
    <div class="container">
        <div class="footer-copy">© ۲۰۲۶ محمد رضایی · <i class="fas fa-heart"></i> مدیریت پروژه‌ها</div>
        <div class="footer-links">
            <a href="/AdminDashboard">داشبورد</a>
            <a href="/Projects">پروژه‌ها</a>
            <a href="#">تنظیمات</a>
            <a href="#"><i class="fab fa-github"></i></a>
            <a href="#"><i class="fab fa-linkedin"></i></a>
        </div>
    </div>
</footer>

