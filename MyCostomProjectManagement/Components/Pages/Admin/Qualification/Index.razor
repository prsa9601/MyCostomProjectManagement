@page "/Admin/SpecializedQualifications"
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<BackEnd.Data.DB.Context> DbFactory
@inject NavigationManager Navigation
@using BackEnd.Data.Entities.Qualification
@using Microsoft.EntityFrameworkCore

<PageTitle>مدیریت مدارک تخصصی | پنل ادمین</PageTitle>

<style>
    .qual-page {
        padding-top: 100px;
        padding-bottom: 40px;
    }

    .qual-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

        .qual-header h1 {
            font-size: 1.8rem;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .qual-header h1 i {
                color: #e8a838;
            }

        .qual-header .subtitle {
            color: rgba(232,240,241,0.55);
            font-size: 0.88rem;
            margin-top: 4px;
        }

    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        border: none;
        padding: 11px 22px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
        font-family: inherit;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(232,168,56,0.3);
        }

        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .btn-ghost {
        background: rgba(255,255,255,0.04);
        color: #e8f0f1;
        border: 1px solid rgba(255,255,255,0.08);
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.88rem;
        transition: 0.2s;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.08);
        }

    .toolbar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
        align-items: center;
    }

    .search-box {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

        .search-box i {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(232,240,241,0.4);
            font-size: 0.9rem;
        }

        .search-box input {
            width: 100%;
            padding: 11px 44px 11px 16px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 12px;
            color: #e8f0f1;
            font-family: inherit;
            font-size: 0.9rem;
            outline: none;
            transition: 0.2s;
        }

            .search-box input:focus {
                border-color: rgba(232,168,56,0.4);
                background: rgba(255,255,255,0.06);
            }

            .search-box input::placeholder {
                color: rgba(232,240,241,0.35);
            }

    .filter-select {
        padding: 11px 16px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        color: #e8f0f1;
        font-family: inherit;
        font-size: 0.88rem;
        outline: none;
        cursor: pointer;
        min-width: 150px;
    }

        .filter-select option {
            background: #13505b;
            color: #e8f0f1;
        }

    .stats-mini {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

    .stat-mini {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .stat-mini .sm-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

    .sm-icon.green {
        background: rgba(82,183,136,0.1);
        color: #52b788;
    }

    .sm-icon.gold {
        background: rgba(232,168,56,0.1);
        color: #e8a838;
    }

    .sm-icon.blue {
        background: rgba(26,122,138,0.1);
        color: #4ec3d4;
    }

    .stat-mini .sm-info .num {
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
    }

    .stat-mini .sm-info .lbl {
        font-size: 0.78rem;
        color: rgba(232,240,241,0.55);
    }

    .qual-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 18px;
    }

    .qual-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 18px;
        padding: 22px;
        position: relative;
        transition: all 0.3s cubic-bezier(0.2,0.9,0.3,1);
        overflow: hidden;
    }

        .qual-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #e8a838, #52b788);
            opacity: 0.5;
        }

        .qual-card:hover {
            transform: translateY(-4px);
            background: rgba(255,255,255,0.06);
            box-shadow: 0 12px 32px rgba(0,0,0,0.15);
        }

        .qual-card .qc-top {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 14px;
        }

    .qc-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(232,168,56,0.15), rgba(82,183,136,0.15));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #e8a838;
        flex-shrink: 0;
        overflow: hidden;
    }

        .qc-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .qc-title-wrap {
        flex: 1;
        min-width: 0;
    }

    .qc-title {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .qc-provider {
        font-size: 0.78rem;
        color: rgba(232,240,241,0.5);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .qc-status {
        position: absolute;
        top: 16px;
        left: 16px;
        font-size: 0.68rem;
        padding: 3px 12px;
        border-radius: 30px;
        font-weight: 600;
    }

        .qc-status.active {
            background: rgba(82,183,136,0.12);
            color: #52b788;
            border: 1px solid rgba(82,183,136,0.2);
        }

        .qc-status.inactive {
            background: rgba(127,140,141,0.12);
            color: rgba(232,240,241,0.55);
            border: 1px solid rgba(255,255,255,0.08);
        }

    .qc-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 16px;
        min-height: 24px;
    }

    .qc-tag {
        font-size: 0.7rem;
        padding: 3px 10px;
        border-radius: 20px;
        background: rgba(232,168,56,0.08);
        color: #e8a838;
        border: 1px solid rgba(232,168,56,0.15);
    }

    .qc-empty-tags {
        font-size: 0.72rem;
        color: rgba(232,240,241,0.3);
    }

    .qc-actions {
        display: flex;
        gap: 8px;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    .qc-btn {
        flex: 1;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        color: rgba(232,240,241,0.75);
        padding: 8px;
        border-radius: 10px;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: 0.2s;
    }

        .qc-btn:hover {
            background: rgba(255,255,255,0.07);
            color: #fff;
        }

        .qc-btn.edit:hover {
            color: #e8a838;
            border-color: rgba(232,168,56,0.25);
        }

        .qc-btn.toggle:hover {
            color: #52b788;
            border-color: rgba(82,183,136,0.25);
        }

        .qc-btn.delete:hover {
            color: #ff6b6b;
            border-color: rgba(220,53,69,0.25);
        }

    .empty-state, .loading-state {
        text-align: center;
        padding: 70px 20px;
        background: rgba(255,255,255,0.03);
        border: 1px dashed rgba(255,255,255,0.08);
        border-radius: 20px;
        color: rgba(232,240,241,0.5);
    }

        .empty-state i {
            font-size: 3rem;
            color: rgba(232,168,56,0.4);
            margin-bottom: 14px;
            display: block;
        }

        .empty-state h3 {
            color: #fff;
            margin-bottom: 6px;
            font-size: 1.05rem;
        }

        .empty-state p {
            font-size: 0.85rem;
        }

    .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(232,168,56,0.15);
        border-top-color: #e8a838;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 14px;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        backdrop-filter: blur(6px);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .modal-box {
        background: #0f3e48;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        width: 100%;
        max-width: 520px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        animation: slideUp 0.3s cubic-bezier(0.2,0.9,0.3,1);
    }

    @@keyframes slideUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .modal-header h3 {
            font-size: 1.05rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .modal-header h3 i {
                color: #e8a838;
            }

    .modal-close {
        background: none;
        border: none;
        color: rgba(232,240,241,0.6);
        font-size: 1.2rem;
        cursor: pointer;
        padding: 6px;
        border-radius: 8px;
        transition: 0.2s;
    }

        .modal-close:hover {
            background: rgba(255,255,255,0.05);
            color: #fff;
        }

    .modal-body {
        padding: 22px 24px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        font-size: 0.82rem;
        color: rgba(232,240,241,0.75);
        margin-bottom: 7px;
        font-weight: 500;
    }

        .form-label .req {
            color: #ff6b6b;
        }

    .form-control {
        width: 100%;
        padding: 11px 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 11px;
        color: #e8f0f1;
        font-family: inherit;
        font-size: 0.88rem;
        outline: none;
        transition: 0.2s;
    }

        .form-control:focus {
            border-color: rgba(232,168,56,0.5);
            background: rgba(255,255,255,0.06);
        }

        .form-control::placeholder {
            color: rgba(232,240,241,0.3);
        }

    .form-hint {
        font-size: 0.72rem;
        color: rgba(232,240,241,0.4);
        margin-top: 5px;
    }

    .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        background: rgba(255,255,255,0.03);
        border-radius: 11px;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .toggle-row .lbl {
            font-size: 0.88rem;
            color: #e8f0f1;
        }

            .toggle-row .lbl small {
                display: block;
                font-size: 0.72rem;
                color: rgba(232,240,241,0.45);
                margin-top: 2px;
            }

    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 26px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: rgba(255,255,255,0.1);
        border-radius: 30px;
        transition: 0.3s;
    }

        .slider:before {
            content: '';
            position: absolute;
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 3px;
            background: #fff;
            border-radius: 50%;
            transition: 0.3s;
        }

    .switch input:checked + .slider {
        background: #52b788;
    }

        .switch input:checked + .slider:before {
            transform: translateX(20px);
        }

    .modal-footer {
        padding: 18px 24px;
        border-top: 1px solid rgba(255,255,255,0.06);
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .delete-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(220,53,69,0.1);
        color: #ff6b6b;
        font-size: 1.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
    }

    .delete-title {
        text-align: center;
        color: #fff;
        font-size: 1.05rem;
        margin-bottom: 8px;
    }

    .delete-text {
        text-align: center;
        color: rgba(232,240,241,0.6);
        font-size: 0.88rem;
        line-height: 1.7;
    }

        .delete-text strong {
            color: #e8a838;
        }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        color: #fff;
        border: none;
        padding: 10px 22px;
        border-radius: 11px;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: 0.2s;
    }

        .btn-danger:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(220,53,69,0.3);
        }

        .btn-danger:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .toast {
        position: fixed;
        top: 90px;
        left: 50%;
        transform: translateX(-50%);
        padding: 13px 24px;
        border-radius: 12px;
        font-size: 0.88rem;
        font-weight: 500;
        z-index: 3000;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        animation: toastIn 0.3s ease;
    }

        .toast.success {
            background: #1b7a4b;
            color: #fff;
        }

        .toast.error {
            background: #b02a37;
            color: #fff;
        }

    @@keyframes toastIn {
        from {
            opacity: 0;
            transform: translate(-50%, -10px);
        }

        to {
            opacity: 1;
            transform: translate(-50%, 0);
        }
    }

    @@media (max-width: 768px) {
        .qual-page {
            padding-top: 82px;
        }

        .qual-header h1 {
            font-size: 1.3rem;
        }

        .qual-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .qual-header {
            flex-direction: column;
            align-items: stretch;
        }

            .qual-header h1 {
                font-size: 1.15rem;
            }

        .toolbar {
            flex-direction: column;
        }

        .filter-select {
            width: 100%;
        }
    }
</style>

<main class="qual-page">
    <div class="container">

        <!-- Header -->
        <div class="qual-header">
            <div>
                <h1><i class="fas fa-certificate"></i> مدارک تخصصی</h1>
                <div class="subtitle">مدیریت مدارک و گواهینامه‌های تخصصی</div>
            </div>
            <button class="btn-primary" @onclick="OpenCreateModal">
                <i class="fas fa-plus"></i> افزودن مدرک جدید
            </button>
        </div>

        <!-- Stats -->
        <div class="stats-mini">
            <div class="stat-mini">
                <div class="sm-icon blue"><i class="fas fa-certificate"></i></div>
                <div class="sm-info">
                    <div class="num">@allItems.Count</div>
                    <div class="lbl">کل مدارک</div>
                </div>
            </div>
            <div class="stat-mini">
                <div class="sm-icon green"><i class="fas fa-check-circle"></i></div>
                <div class="sm-info">
                    <div class="num">@allItems.Count(x => x.IsActive)</div>
                    <div class="lbl">فعال</div>
                </div>
            </div>
            <div class="stat-mini">
                <div class="sm-icon gold"><i class="fas fa-pause-circle"></i></div>
                <div class="sm-info">
                    <div class="num">@allItems.Count(x => !x.IsActive)</div>
                    <div class="lbl">غیرفعال</div>
                </div>
            </div>
        </div>

        <!-- Toolbar -->
        <div class="toolbar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجو در عنوان، ارائه‌دهنده یا تگ..."
                       @bind="searchTerm" @bind:event="oninput" />
            </div>
            <select class="filter-select" @bind="statusFilter">
                <option value="all">همه وضعیت‌ها</option>
                <option value="active">فقط فعال</option>
                <option value="inactive">فقط غیرفعال</option>
            </select>
        </div>

        <!-- Content -->
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>در حال بارگذاری...</p>
            </div>
        }
        else if (!FilteredItems.Any())
        {
            <div class="empty-state">
                <i class="fas fa-certificate"></i>
                <h3>مدرکی یافت نشد</h3>
                <p>
                    @(string.IsNullOrEmpty(searchTerm) && statusFilter == "all"
                        ? "برای شروع، اولین مدرک تخصصی را اضافه کنید."
                        : "هیچ نتیجه‌ای با فیلترهای فعلی پیدا نشد.")
                </p>
            </div>
        }
        else
        {
            <div class="qual-grid">
                @foreach (var q in FilteredItems)
                {
                    <div class="qual-card">
                        <span class="qc-status @(q.IsActive ? "active" : "inactive")">
                            <i class="fas @(q.IsActive ? "fa-check" : "fa-pause")"></i>
                            @(q.IsActive ? "فعال" : "غیرفعال")
                        </span>

                        <div class="qc-top">
                            <div class="qc-icon">
                                @if (!string.IsNullOrWhiteSpace(q.Icon) &&
                                     (q.Icon.StartsWith("http") || q.Icon.StartsWith("/")))
                                {
                                    <img src="@q.Icon" alt="@q.Title" />
                                }
                                else
                                {
                                    <i class="@(string.IsNullOrWhiteSpace(q.Icon) ? "fas fa-certificate" : q.Icon)"></i>
                                }
                            </div>
                            <div class="qc-title-wrap">
                                <div class="qc-title">@q.Title</div>
                                <div class="qc-provider">
                                    <i class="fas fa-building"></i>
                                    @(string.IsNullOrWhiteSpace(q.Provider) ? "—" : q.Provider)
                                </div>
                            </div>
                        </div>

                        <div class="qc-tags">
                            @if (q.Tags is { Count: > 0 })
                            {
                                foreach (var tag in q.Tags)
                                {
                                    <span class="qc-tag">@tag</span>
                                }
                            }
                            else
                            {
                                <span class="qc-empty-tags">بدون تگ</span>
                            }
                        </div>

                        <div class="qc-actions">
                            <button class="qc-btn edit" @onclick="() => OpenEditModal(q)">
                                <i class="fas fa-edit"></i> ویرایش
                            </button>
                            <button class="qc-btn toggle" @onclick="() => ToggleActiveAsync(q)">
                                <i class="fas @(q.IsActive ? "fa-pause" : "fa-play")"></i>
                                @(q.IsActive ? "غیرفعال" : "فعال")
                            </button>
                            <button class="qc-btn delete" @onclick="() => OpenDeleteModal(q)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</main>

<!-- Create / Edit Modal -->
@if (showFormModal)
{
    <div class="modal-overlay" @onclick="CloseFormModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>
                    <i class="fas @(editingId is null ? "fa-plus-circle" : "fa-edit")"></i>
                    @(editingId is null ? "افزودن مدرک تخصصی" : "ویرایش مدرک")
                </h3>
                <button class="modal-close" @onclick="CloseFormModal"><i class="fas fa-times"></i></button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">عنوان <span class="req">*</span></label>
                    <input class="form-control" @bind="formModel.Title" placeholder="مثلاً: کارشناسی ارشد مهندسی نرم‌افزار" />
                </div>

                <div class="form-group">
                    <label class="form-label">ارائه‌دهنده <span class="req">*</span></label>
                    <input class="form-control" @bind="formModel.Provider" placeholder="مثلاً: دانشگاه تهران" />
                </div>

                <div class="form-group">
                    <label class="form-label">آیکون</label>
                    <input class="form-control" @bind="formModel.Icon" placeholder="fas fa-certificate یا آدرس تصویر" />
                    <div class="form-hint">کلاس FontAwesome یا URL تصویر</div>
                </div>

                <div class="form-group">
                    <label class="form-label">تگ‌ها</label>
                    <input class="form-control" @bind="tagsInput" placeholder="با کاما جدا کنید: برنامه‌نویسی, وب, بک‌اند" />
                    <div class="form-hint">هر تگ را با کاما (,) از دیگری جدا کنید</div>
                </div>

                <div class="form-group">
                    <div class="toggle-row">
                        <div class="lbl">
                            وضعیت فعال
                            <small>مدارک غیرفعال در سایت نمایش داده نمی‌شوند</small>
                        </div>
                        <label class="switch">
                            <input type="checkbox" @bind="formModel.IsActive" />
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-ghost" @onclick="CloseFormModal" disabled="@isSaving">انصراف</button>
                <button class="btn-primary" @onclick="SaveAsync" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>در حال ذخیره...</span>
                    }
                    else
                    {
                        <i class="fas fa-save"></i>
                        <span>ذخیره</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Modal -->
@if (showDeleteModal && deletingItem is not null)
{
    <div class="modal-overlay" @onclick="CloseDeleteModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-body">
                <div class="delete-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <h3 class="delete-title">حذف مدرک تخصصی</h3>
                <p class="delete-text">
                    آیا از حذف مدرک <strong>«@deletingItem.Title»</strong> مطمئن هستید؟
                    <br />این عملیات قابل بازگشت نیست.
                </p>
            </div>
            <div class="modal-footer">
                <button class="btn-ghost" @onclick="CloseDeleteModal" disabled="@isDeleting">انصراف</button>
                <button class="btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>در حال حذف...</span>
                    }
                    else
                    {
                        <i class="fas fa-trash"></i>
                        <span>حذف</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Toast -->
@if (toast is not null)
{
    <div class="toast @toast.Type">
        <i class="fas @(toast.Type == "success" ? "fa-check-circle" : "fa-exclamation-circle")"></i>
        <span>@toast.Message</span>
    </div>
}

@code {
    // ============================================================
    // STATE
    // ============================================================
    private List<SpecializedQualification> allItems = new();
    private bool isLoading = true;

    private string searchTerm = "";
    private string statusFilter = "all";

    // Form
    private bool showFormModal;
    private bool isSaving;
    private Guid? editingId;
    private SpecializedQualification formModel = new();
    private string tagsInput = "";

    // Delete
    private bool showDeleteModal;
    private bool isDeleting;
    private SpecializedQualification? deletingItem;

    // Toast
    private ToastMessage? toast;
    private CancellationTokenSource? _toastCts;

    // ============================================================
    // FILTER
    // ============================================================
    private IEnumerable<SpecializedQualification> FilteredItems
    {
        get
        {
            var query = allItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(q =>
                    (q.Title?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (q.Provider?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (q.Tags?.Any(t => t.Contains(term, StringComparison.OrdinalIgnoreCase)) ?? false));
            }

            query = statusFilter switch
            {
                "active" => query.Where(q => q.IsActive),
                "inactive" => query.Where(q => !q.IsActive),
                _ => query
            };

            return query;
        }
    }

    // ============================================================
    // LIFECYCLE — بارگذاری مستقیم از DB
    // ============================================================
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            allItems = await db.SpecializedQualifications
                                .AsNoTracking()
                                .OrderByDescending(x => x.CreationDate)
                                .ToListAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"خطا در بارگذاری: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    // ============================================================
    // CREATE / EDIT
    // ============================================================
    private void OpenCreateModal()
    {
        editingId = null;
        formModel = new SpecializedQualification { IsActive = true };
        tagsInput = "";
        showFormModal = true;
    }

    private void OpenEditModal(SpecializedQualification item)
    {
        editingId = item.Id;
        formModel = new SpecializedQualification
        {
            Id = item.Id,
            CreationDate = item.CreationDate,
            Icon = item.Icon,
            Title = item.Title,
            Provider = item.Provider,
            Tags = item.Tags?.ToList() ?? new List<string>(),
            IsActive = item.IsActive
        };
        tagsInput = item.Tags is { Count: > 0 } ? string.Join(", ", item.Tags) : "";
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        if (isSaving) return;
        showFormModal = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(formModel.Title))
        {
            ShowToast("عنوان مدرک الزامی است.", "error");
            return;
        }
        if (string.IsNullOrWhiteSpace(formModel.Provider))
        {
            ShowToast("نام ارائه‌دهنده الزامی است.", "error");
            return;
        }

        isSaving = true;
        try
        {
            // Parse tags
            formModel.Tags = tagsInput
                .Split(new[] { ',', '،' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(t => t.Trim())
                .Where(t => !string.IsNullOrEmpty(t))
                .Distinct()
                .ToList();

            await using var db = await DbFactory.CreateDbContextAsync();

            if (editingId is null)
            {
                // CREATE
                var entity = new SpecializedQualification
                {
                    Id = Guid.NewGuid(),
                    CreationDate = DateTime.Now,
                    Icon = formModel.Icon,
                    Title = formModel.Title,
                    Provider = formModel.Provider,
                    Tags = formModel.Tags,
                    IsActive = formModel.IsActive
                };
                db.SpecializedQualifications.Add(entity);
                await db.SaveChangesAsync();
                allItems.Insert(0, entity);
                ShowToast("مدرک با موفقیت اضافه شد.", "success");
            }
            else
            {
                // UPDATE
                var existing = await db.SpecializedQualifications.FindAsync(formModel.Id);
                if (existing is null)
                {
                    ShowToast("مدرک یافت نشد.", "error");
                    return;
                }
                existing.Icon = formModel.Icon;
                existing.Title = formModel.Title;
                existing.Provider = formModel.Provider;
                existing.Tags = formModel.Tags;
                existing.IsActive = formModel.IsActive;
                await db.SaveChangesAsync();

                var idx = allItems.FindIndex(x => x.Id == existing.Id);
                if (idx >= 0) allItems[idx] = existing;
                ShowToast("تغییرات با موفقیت ذخیره شد.", "success");
            }

            showFormModal = false;
        }
        catch (Exception ex)
        {
            ShowToast($"خطا: {ex.Message}", "error");
        }
        finally
        {
            isSaving = false;
        }
    }

    // ============================================================
    // TOGGLE ACTIVE
    // ============================================================
    private async Task ToggleActiveAsync(SpecializedQualification item)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.SpecializedQualifications.FindAsync(item.Id);
            if (existing is null) return;

            existing.IsActive = !existing.IsActive;
            await db.SaveChangesAsync();

            item.IsActive = existing.IsActive;
            ShowToast(item.IsActive ? "مدرک فعال شد." : "مدرک غیرفعال شد.", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"خطا: {ex.Message}", "error");
        }
    }

    // ============================================================
    // DELETE
    // ============================================================
    private void OpenDeleteModal(SpecializedQualification item)
    {
        deletingItem = item;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (isDeleting) return;
        showDeleteModal = false;
        deletingItem = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deletingItem is null) return;
        isDeleting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.SpecializedQualifications.FindAsync(deletingItem.Id);
            if (existing is null)
            {
                ShowToast("مدرک یافت نشد.", "error");
                return;
            }
            db.SpecializedQualifications.Remove(existing);
            await db.SaveChangesAsync();

            allItems.RemoveAll(x => x.Id == deletingItem.Id);
            ShowToast("مدرک با موفقیت حذف شد.", "success");
            showDeleteModal = false;
            deletingItem = null;
        }
        catch (Exception ex)
        {
            ShowToast($"خطا: {ex.Message}", "error");
        }
        finally
        {
            isDeleting = false;
        }
    }

    // ============================================================
    // TOAST
    // ============================================================
    private void ShowToast(string message, string type)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        toast = new ToastMessage { Message = message, Type = type };

        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3500, token);
                await InvokeAsync(() =>
                {
                    toast = null;
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException) { }
        });
    }

    private sealed class ToastMessage
    {
        public string Message { get; set; } = "";
        public string Type { get; set; } = "success";
    }
}