    private void OpenAddModal()
    {
        isEditing = false;
        editingRoleId = "";
        modalRoleName = "";
        modalRoleDescription = "";
        modalRoleIcon = "fa-user-shield";
        modalRoleIconColor = "#e8a838";
        modalPermissions = allPermissions.ToDictionary(p => p, p => false);
        isModalOpen = true;
        StateHasChanged();
    }

    private void OpenEditModal(string roleId)
    {
        var role = roles.FirstOrDefault(r => r.Id == roleId);
        if (role == null) return;

        isEditing = true;
        editingRoleId = roleId;
        modalRoleName = role.Name;
        modalRoleDescription = role.Description;
        modalRoleIcon = role.Icon;
        modalRoleIconColor = role.IconColor;
        modalPermissions = allPermissions.ToDictionary(p => p, p => role.Permissions.Contains(p));
        isModalOpen = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        isModalOpen = false;
        StateHasChanged();
    }

    private void SaveRole()
    {
        if (string.IsNullOrWhiteSpace(modalRoleName))
        {
            // در برنامه واقعی، پیام خطا نمایش دهید
            Console.WriteLine("لطفاً نام نقش را وارد کنید.");
            return;
        }

        var selectedPermissions = modalPermissions.Where(p => p.Value).Select(p => p.Key).ToList();

        if (isEditing)
        {
            var role = roles.FirstOrDefault(r => r.Id == editingRoleId);
            if (role != null)
            {
                role.Name = modalRoleName.Trim();
                role.Description = modalRoleDescription.Trim();
                role.Icon = modalRoleIcon;
                role.IconColor = modalRoleIconColor;
                role.Permissions = selectedPermissions;
            }
        }
        else
        {
            var newRole = new Role
            {
                Id = "ROL-" + (roles.Count + 1).ToString("D3"),
                Name = modalRoleName.Trim(),
                Description = modalRoleDescription.Trim(),
                Icon = modalRoleIcon,
                IconColor = modalRoleIconColor,
                IsDefault = false,
                Permissions = selectedPermissions,
                Users = new List<RoleUser>()
            };
            roles.Add(newRole);
        }

        CloseModal();
        StateHasChanged();
    }

    private void DeleteRole(string roleId)
    {
        var role = roles.FirstOrDefault(r => r.Id == roleId);
        if (role == null) return;

        if (role.IsDefault)
        {
            Console.WriteLine("نقش‌های پیش‌فرض قابل حذف نیستند.");
            return;
        }

        if (role.Users.Any())
        {
            Console.WriteLine($"نقش {role.Name} دارای کاربر است و قابل حذف نیست.");
            return;
        }

        roles.RemoveAll(r => r.Id == roleId);
        StateHasChanged();
    }

