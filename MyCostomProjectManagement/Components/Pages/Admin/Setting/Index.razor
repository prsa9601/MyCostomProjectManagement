@page "/Admin/Settings"
@layout AdminLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>تنظیمات | پنل ادمین</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
       SETTINGS PAGE - با پس‌زمینه #13505b
    ============================================================ */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
       GLASS EFFECT
    ============================================================ */
    .glass {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    .glass:hover {
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 8px 48px rgba(0, 0, 0, 0.12);
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.06);
    }

    /* ============================================================
       ANIMATIONS
    ============================================================ */
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }
    .float-anim {
        animation: float 4s ease-in-out infinite;
    }

    @@keyframes rotateBorder {
        0% { background-position: 0% 50%; }
        100% { background-position: 400% 50%; }
    }
    .gradient-border {
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        background-clip: padding-box;
    }
    .gradient-border::before {
        content: '';
        position: absolute;
        inset: -2px;
        z-index: -1;
        border-radius: 22px;
        background: conic-gradient(from 0deg, #e8a838, #52b788, #1a7a8a, #e8a838, #52b788);
        background-size: 400% 400%;
        animation: rotateBorder 8s linear infinite;
        opacity: 0.2;
        transition: opacity 0.4s;
    }
    .gradient-border:hover::before {
        opacity: 0.5;
    }

    /* Ripple */
    .ripple {
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }
    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }
    @@keyframes rippleAnim {
        to { transform: scale(4); opacity: 0; }
    }

    /* Fade Up */
    .fade-up {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.2, 0.9, 0.3, 1),
                    transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    .fade-up.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .stagger-child { transition-delay: 0s; }
    .stagger-child:nth-child(1) { transition-delay: 0.05s; }
    .stagger-child:nth-child(2) { transition-delay: 0.1s; }
    .stagger-child:nth-child(3) { transition-delay: 0.15s; }
    .stagger-child:nth-child(4) { transition-delay: 0.2s; }
    .stagger-child:nth-child(5) { transition-delay: 0.25s; }
    .stagger-child:nth-child(6) { transition-delay: 0.3s; }

    /* Sparkle Particles */
    .sparkle {
        position: fixed;
        width: 4px;
        height: 4px;
        background: rgba(232, 168, 56, 0.2);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        animation: sparkleAnim 10s infinite alternate ease-in-out;
    }
    @@keyframes sparkleAnim {
        0% { transform: translate(0, 0) scale(1); opacity: 0.1; }
        50% { transform: translate(20px, -30px) scale(1.8); opacity: 0.6; }
        100% { transform: translate(-10px, 20px) scale(0.6); opacity: 0.05; }
    }
    .sparkle:nth-child(1) { left: 5%; top: 20%; animation-duration: 12s; }
    .sparkle:nth-child(2) { left: 85%; top: 60%; animation-duration: 14s; animation-delay: 2s; width: 6px; height: 6px; }
    .sparkle:nth-child(3) { left: 30%; top: 70%; animation-duration: 16s; animation-delay: 4s; }
    .sparkle:nth-child(4) { left: 92%; top: 30%; animation-duration: 11s; animation-delay: 1s; width: 5px; height: 5px; background: rgba(82, 183, 136, 0.15); }
    .sparkle:nth-child(5) { left: 50%; top: 90%; animation-duration: 18s; animation-delay: 3s; }
    .sparkle:nth-child(6) { left: 3%; top: 50%; animation-duration: 13s; animation-delay: 5s; background: rgba(232, 168, 56, 0.15); }

    /* ============================================================
       NAVBAR
    ============================================================ */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: all 0.4s ease;
        background: rgba(19, 80, 91, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .navbar.scrolled {
        background: rgba(19, 80, 91, 0.92);
        box-shadow: 0 4px 40px rgba(0, 0, 0, 0.12);
    }

    .navbar .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #e8f0f1;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .logo span { color: #e8a838; }
    .logo i { color: #e8a838; font-size: 1.3rem; }

    .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 500;
        align-items: center;
    }
    .nav-links a {
        color: rgba(232, 240, 241, 0.6);
        transition: all 0.35s ease;
        position: relative;
        padding: 4px 0;
    }
    .nav-links a:hover { color: #ffffff; }
    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        right: 0;
        width: 0;
        height: 2.5px;
        background: #e8a838;
        transition: 0.35s;
        border-radius: 4px;
        box-shadow: 0 0 12px rgba(232, 168, 56, 0.15);
    }
    .nav-links a:hover::after { width: 100%; }
    .nav-links a.active { color: #ffffff; }
    .nav-links a.active::after { width: 100%; }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 9px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.12);
    }
    .btn-primary:hover {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 8px 32px rgba(232, 168, 56, 0.2);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid rgba(255, 255, 255, 0.1);
        color: #e8f0f1;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
    }
    .btn-outline:hover {
        border-color: #e8a838;
        background: rgba(232, 168, 56, 0.04);
        transform: translateY(-2px);
    }

    .btn-light {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-light:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: #e8a838;
        transform: translateY(-2px);
    }

    .avatar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(232, 168, 56, 0.2);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8f0f1;
        font-size: 1.1rem;
        transition: all 0.35s ease;
        cursor: pointer;
    }
    .avatar-btn:hover {
        background: rgba(232, 168, 56, 0.04);
        transform: scale(1.05);
        border-color: #e8a838;
    }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
    }
    .hamburger span {
        display: block;
        width: 28px;
        height: 2.5px;
        background: #e8f0f1;
        border-radius: 4px;
        transition: 0.3s;
    }

    /* ============================================================
       PAGE HEADER
    ============================================================ */
    .page-header {
        padding-top: 100px;
        padding-bottom: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .page-header h1 i { color: #e8a838; }
    .page-header .subtitle {
        color: rgba(232, 240, 241, 0.5);
        font-size: 0.9rem;
        margin-top: 4px;
    }

    .page-header .actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* ============================================================
       SETTINGS TABS
    ============================================================ */
    .settings-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 32px;
        padding: 8px;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

    .settings-tabs .tab-btn {
        padding: 10px 22px;
        border-radius: 12px;
        border: none;
        background: transparent;
        color: rgba(232, 240, 241, 0.4);
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.35s ease;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .settings-tabs .tab-btn:hover {
        color: #e8f0f1;
        background: rgba(255, 255, 255, 0.02);
    }

    .settings-tabs .tab-btn.active {
        background: rgba(232, 168, 56, 0.06);
        color: #e8a838;
        border: 1px solid rgba(232, 168, 56, 0.04);
    }

    .settings-tabs .tab-btn i {
        font-size: 0.9rem;
    }

    /* ============================================================
       SETTINGS SECTIONS
    ============================================================ */
    .settings-section {
        display: none;
        animation: fadeIn 0.5s ease;
    }

    .settings-section.active {
        display: block;
    }

    @@keyframes fadeIn {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 24px;
    }

    .settings-card {
        padding: 28px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    .settings-card:hover {
        transform: translateY(-3px);
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(232, 168, 56, 0.06);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    }

    .settings-card .card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .settings-card .card-header i {
        font-size: 1.4rem;
        color: #e8a838;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(232, 168, 56, 0.04);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .settings-card .card-header h3 {
        font-size: 1rem;
        font-weight: 600;
        color: #ffffff;
    }
    .settings-card .card-header .desc {
        font-size: 0.8rem;
        color: rgba(232, 240, 241, 0.3);
    }

    /* ============================================================
       FORM ELEMENTS
    ============================================================ */
    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        color: rgba(232, 240, 241, 0.6);
        margin-bottom: 6px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 10px 16px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 12px;
        color: #e8f0f1;
        font-size: 0.9rem;
        transition: all 0.35s ease;
        outline: none;
        font-family: inherit;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        border-color: #e8a838;
        background: rgba(255, 255, 255, 0.04);
        box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: rgba(232, 240, 241, 0.2);
    }

    .form-group select option {
        background: #13505b;
        color: #e8f0f1;
    }

    .form-group textarea {
        min-height: 80px;
        resize: vertical;
    }

    .form-group .toggle-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 0;
    }

    .form-group .toggle-wrapper .toggle-label {
        font-size: 0.85rem;
        color: rgba(232, 240, 241, 0.5);
        flex: 1;
    }

    .toggle-switch {
        position: relative;
        width: 48px;
        height: 26px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 40px;
        cursor: pointer;
        transition: all 0.35s ease;
        border: 1px solid rgba(255, 255, 255, 0.04);
        flex-shrink: 0;
    }

    .toggle-switch.active {
        background: rgba(232, 168, 56, 0.15);
        border-color: rgba(232, 168, 56, 0.1);
    }

    .toggle-switch .toggle-knob {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(232, 240, 241, 0.15);
        transition: all 0.35s ease;
    }

    .toggle-switch.active .toggle-knob {
        right: 24px;
        background: #e8a838;
        box-shadow: 0 0 16px rgba(232, 168, 56, 0.15);
    }

    .btn-save {
        padding: 10px 28px;
        border-radius: 40px;
        border: none;
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.08);
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(232, 168, 56, 0.15);
    }

    .btn-save-secondary {
        padding: 10px 28px;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        background: rgba(255, 255, 255, 0.02);
        color: rgba(232, 240, 241, 0.5);
        font-weight: 500;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-save-secondary:hover {
        border-color: rgba(232, 168, 56, 0.06);
        color: #e8f0f1;
        background: rgba(232, 168, 56, 0.02);
        transform: translateY(-2px);
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        flex-wrap: wrap;
    }

    /* ============================================================
       FOOTER
    ============================================================ */
    .footer {
        position: relative;
        padding: 28px 0 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.02);
        background: rgba(19, 80, 91, 0.2);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1;
        margin-top: 40px;
    }

    .footer .container {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
    }

    .footer-links {
        display: flex;
        gap: 24px;
        font-size: 0.85rem;
        color: rgba(232, 240, 241, 0.2);
    }
    .footer-links a:hover { color: #e8a838; }
    .footer-copy {
        color: rgba(232, 240, 241, 0.2);
        font-size: 0.8rem;
    }
    .footer-copy i { color: #e8a838; }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @@media (max-width: 992px) {
        .settings-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .nav-links {
            display: none;
            flex-direction: column;
            width: 100%;
            background: rgba(19, 80, 91, 0.95);
            backdrop-filter: blur(16px);
            padding: 20px 0;
            gap: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.02);
            margin-top: 12px;
            border-radius: 20px;
            align-items: center;
        }
        .nav-links.open { display: flex; }
        .hamburger { display: flex; }
        .nav-actions .btn-outline { display: none; }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }
        .page-header h1 { font-size: 1.5rem; }
        .page-header .actions { width: 100%; }
        .page-header .actions .btn-primary { flex: 1; justify-content: center; }

        .settings-tabs {
            flex-wrap: nowrap;
            overflow-x: auto;
            padding: 4px;
            gap: 4px;
        }
        .settings-tabs .tab-btn {
            padding: 8px 14px;
            font-size: 0.75rem;
            white-space: nowrap;
        }
        .settings-tabs .tab-btn i { font-size: 0.7rem; }

        .settings-grid {
            grid-template-columns: 1fr;
        }
        .settings-card {
            padding: 20px;
        }
        .form-actions {
            flex-direction: column;
        }
        .form-actions .btn-save,
        .form-actions .btn-save-secondary {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 480px) {
        .settings-card .card-header {
            flex-wrap: wrap;
        }
        .settings-card .card-header .desc {
            font-size: 0.7rem;
        }
        .form-group .toggle-wrapper {
            flex-wrap: wrap;
        }
    }
</style>

<!-- ===== SPARKLE PARTICLES ===== -->
<div class="sparkle"></div>
<div class="sparkle"></div>
<div class="sparkle"></div>
<div class="sparkle"></div>
<div class="sparkle"></div>
<div class="sparkle"></div>

<!-- ============================================================
     NAVBAR
============================================================ -->
<header class="navbar" id="navbar">
    <div class="container">
        <div class="logo">
            <i class="fas fa-crown"></i>
            Admin<span>Panel</span>
        </div>
        <ul class="nav-links @(isMenuOpen ? "open" : "")" id="navLinks">
            <li><a href="/Admin">داشبورد</a></li>
            <li><a href="/Admin/Projects">پروژه‌ها</a></li>
            <li><a href="/Admin/Users">کاربران</a></li>
            <li><a href="/Admin/ApiManagement">APIها</a></li>
            <li><a href="/Admin/Packages">پکیج‌ها</a></li>
            <li><a href="/Admin/PackageApiAccess">دسترسی API</a></li>
            <li><a href="/Admin/Requests">درخواست‌ها</a></li>
            <li><a href="/Admin/Contacts">تماس</a></li>
            <li><a href="/Admin/Skills">مهارت‌ها</a></li>
