                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-cog"></i>
                    تنظیمات
                </h1>
                <div class="subtitle">مدیریت تنظیمات سیستم، کاربری و امنیت</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="ResetSettings"><i class="fas fa-undo-alt"></i> بازنشانی</button>
                <button class="btn-primary ripple" @onclick="SaveAllSettings"><i class="fas fa-save"></i> ذخیره همه</button>
            </div>
        </div>

        <!-- Settings Tabs (افزوده شده) -->
        <div class="settings-tabs fade-up visible">
