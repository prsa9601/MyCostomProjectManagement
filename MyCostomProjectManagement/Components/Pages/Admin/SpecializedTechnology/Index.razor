@page "/Admin/SpecializedTechnologies"
@layout AdminLayout
@rendermode InteractiveServer
@using BackEnd.Data.DB
@using BackEnd.Data.Entities.SpecializedTechnology
@using Microsoft.EntityFrameworkCore
@inject Context DbContext
@inject IJSRuntime JSRuntime

<style>
    .st-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .st-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .st-title i {
            color: #e8a838;
        }

    .st-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
        background: rgba(255,255,255,0.04);
        padding: 6px;
        border-radius: 40px;
        width: fit-content;
        border: 1px solid rgba(255,255,255,0.06);
        flex-wrap: wrap;
    }

    .st-tab {
        padding: 9px 22px;
        border-radius: 40px;
        background: transparent;
        border: none;
        color: #94a3b8;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.88rem;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .st-tab.active {
            background: linear-gradient(135deg, #e8a838, #d4952e);
            color: #fff;
        }

        .st-tab:hover:not(.active) {
            color: #fff;
            background: rgba(255,255,255,0.05);
        }

    .btn-gold {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
        font-family: inherit;
    }

        .btn-gold:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(232,168,56,0.3);
        }

        .btn-gold:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .st-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        overflow: hidden;
    }

    .st-table {
        width: 100%;
        border-collapse: collapse;
        direction: rtl;
    }

        .st-table thead {
            background: rgba(232,168,56,0.08);
        }

        .st-table th {
            padding: 14px 16px;
            text-align: right;
            color: #e8a838;
            font-weight: 700;
            font-size: 0.85rem;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            white-space: nowrap;
        }

        .st-table td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.03);
            color: #cbd5e1;
            font-size: 0.9rem;
            vertical-align: middle;
        }

        .st-table tr:hover td {
            background: rgba(255,255,255,0.02);
        }

        .st-table tr:last-child td {
            border-bottom: none;
        }

    .badge-cat {
        background: rgba(130,100,200,0.15);
        color: #a78bfa;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        display: inline-block;
    }

    .action-btns {
        display: flex;
        gap: 6px;
    }

    .btn-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.08);
        background: transparent;
        color: #cbd5e1;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        font-size: 0.8rem;
    }

        .btn-icon:hover {
            background: rgba(255,255,255,0.05);
        }

        .btn-icon.edit:hover {
            color: #e8a838;
            border-color: rgba(232,168,56,0.3);
        }

        .btn-icon.delete:hover {
            color: #dc3545;
            border-color: rgba(220,53,69,0.3);
        }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.65);
        backdrop-filter: blur(4px);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .modal-box {
        background: #1a5c69;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 28px;
        width: 100%;
        max-width: 520px;
        max-height: 90vh;
        overflow-y: auto;
    }

        .modal-box h3 {
            color: #fff;
            margin-bottom: 20px;
            font-size: 1.2rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .modal-box h3 i {
                color: #e8a838;
            }

    .form-field {
        margin-bottom: 16px;
    }

        .form-field label {
            display: block;
            color: #e8f0f1;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

            .form-field label .req {
                color: #f87171;
            }

        .form-field input, .form-field select {
            width: 100%;
            padding: 11px 14px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            color: #fff;
            font-family: inherit;
            font-size: 0.9rem;
            transition: 0.2s;
        }

            .form-field input:focus, .form-field select:focus {
                outline: none;
                border-color: #e8a838;
                background: rgba(255,255,255,0.06);
            }

            .form-field select option {
                background: #1a5c69;
                color: #fff;
            }

    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid rgba(255,255,255,0.08);
    }

    .btn-secondary {
        background: transparent;
        color: #cbd5e1;
        border: 1px solid rgba(255,255,255,0.15);
        padding: 10px 20px;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: 0.2s;
    }

        .btn-secondary:hover {
            background: rgba(255,255,255,0.05);
        }

    .alert {
        padding: 12px 18px;
        border-radius: 12px;
        margin-bottom: 16px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-success {
        background: rgba(82,183,136,0.15);
        color: #52b788;
        border: 1px solid rgba(82,183,136,0.3);
    }

    .alert-error {
        background: rgba(220,53,69,0.15);
        color: #f87171;
        border: 1px solid rgba(220,53,69,0.3);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #64748b;
    }

        .empty-state i {
            font-size: 3rem;
            opacity: 0.3;
            display: block;
            margin-bottom: 12px;
        }

    .icon-preview {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #e8a838;
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .st-table th, .st-table td {
            padding: 10px 8px;
            font-size: 0.82rem;
        }

        .modal-box {
            padding: 22px 18px;
        }

        .st-tabs {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="st-header">
    <h1 class="st-title"><i class="fas fa-microchip"></i> مدیریت تکنولوژی‌های تخصصی</h1>
    <button class="btn-gold" @onclick="() => OpenAddForm(activeTab)">
        <i class="fas fa-plus"></i>
        @(activeTab == "categories" ? "افزودن دسته‌بندی" : "افزودن تکنولوژی")
    </button>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> @successMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> @errorMessage</div>
}

<div class="st-tabs">
    <button class="st-tab @(activeTab == "categories" ? "active" : "")" @onclick='() => activeTab = "categories"'>
        <i class="fas fa-folder"></i> دسته‌بندی‌ها (@categories.Count)
    </button>
    <button class="st-tab @(activeTab == "technologies" ? "active" : "")" @onclick='() => activeTab = "technologies"'>
        <i class="fas fa-code"></i> تکنولوژی‌ها (@technologies.Count)
    </button>
</div>

@if (activeTab == "categories")
{
    <div class="st-card">
        @if (isLoading)
        {
            <div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>در حال بارگذاری...</p></div>
        }
        else if (!categories.Any())
        {
            <div class="empty-state"><i class="fas fa-folder-open"></i><p>هنوز دسته‌بندی ثبت نشده است</p></div>
        }
        else
        {
            <table class="st-table">
                <thead>
                    <tr>
                        <th>عنوان دسته</th>
                        <th>آیکون</th>
                        <th>تعداد تکنولوژی</th>
                        <th style="width:100px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in categories)
                    {
                        var techCount = technologies.Count(t => t.CategoryId == cat.Id);
                        <tr @key="cat.Id">
                            <td><strong style="color:#fff;">@cat.Title</strong></td>
                            <td><span class="icon-preview"><i class="@cat.Icon"></i></span></td>
                            <td><span class="badge-cat">@techCount تکنولوژی</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="btn-icon edit" @onclick="() => OpenEditCategory(cat)" title="ویرایش">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon delete" @onclick="() => DeleteCategory(cat)" title="حذف">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else
{
    <div class="st-card">
        @if (isLoading)
        {
            <div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>در حال بارگذاری...</p></div>
        }
        else if (!technologies.Any())
        {
            <div class="empty-state"><i class="fas fa-code"></i><p>هنوز تکنولوژی ثبت نشده است</p></div>
        }
        else
        {
            <table class="st-table">
                <thead>
                    <tr>
                        <th>عنوان تکنولوژی</th>
                        <th>آیکون</th>
                        <th>دسته‌بندی</th>
                        <th style="width:100px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tech in technologies.OrderBy(t => t.Title))
                    {
                        var cat = categories.FirstOrDefault(c => c.Id == tech.CategoryId);
                        <tr @key="tech.Id">
                            <td><strong style="color:#fff;">@tech.Title</strong></td>
                            <td><span class="icon-preview"><i class="@tech.Icon"></i></span></td>
                            <td><span class="badge-cat">@(cat?.Title ?? "بدون دسته")</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="btn-icon edit" @onclick="() => OpenEditTechnology(tech)" title="ویرایش">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon delete" @onclick="() => DeleteTechnology(tech)" title="حذف">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (showForm)
{
    <div class="modal-overlay" @onclick="CloseForm">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h3>
                <i class="@(editingId == Guid.Empty ? "fas fa-plus-circle" : "fas fa-edit")"></i>
                @if (formMode == "category")
                {
                    <span>@(editingId == Guid.Empty ? "افزودن دسته‌بندی جدید" : "ویرایش دسته‌بندی")</span>
                }
                else
                {
                    <span>@(editingId == Guid.Empty ? "افزودن تکنولوژی جدید" : "ویرایش تکنولوژی")</span>
                }
            </h3>
            <div class="form-field">
                <label>عنوان <span class="req">*</span></label>
                <input @bind="formTitle" placeholder="@(formMode == "category" ? "مثلاً: Backend" : "مثلاً: ASP.NET Core")" />
            </div>
            <div class="form-field">
                <label>کلاس آیکون <span class="req">*</span></label>
                <input @bind="formIcon" placeholder="مثلاً: devicon-dotnetcore-plain colored" />
                <div style="margin-top:8px; font-size:0.78rem; color:#94a3b8;">
                    پیش‌نمایش: <span class="icon-preview" style="margin-right:8px;"><i class="@formIcon"></i></span>
                </div>
            </div>
            @if (formMode == "technology")
            {
                <div class="form-field">
                    <label>دسته‌بندی <span class="req">*</span></label>
                    <select @bind="formCategoryId">
                        <option value="@Guid.Empty">-- انتخاب دسته --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Title</option>
                        }
                    </select>
                </div>
            }
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseForm">انصراف</button>
                <button class="btn-gold" @onclick="SaveForm" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fas fa-spinner fa-spin"></i> <span>ذخیره...</span>
                    }
                    else
                    {
                        <i class="fas fa-save"></i> <span>ذخیره</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<SpecializedTechnologyCategory> categories = new();
    private List<SpecializedTechnology> technologies = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isSaving = false;
    private string successMessage = "";
    private string errorMessage = "";
    private string activeTab = "categories";
    private string formMode = "category";
    private Guid editingId = Guid.Empty;
    private string formTitle = "";
    private string formIcon = "fas fa-code";
    private Guid formCategoryId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            categories = await DbContext.SpecializedTechnologyCategories
                .OrderBy(c => c.Title)
                .ToListAsync();
            technologies = await DbContext.SpecializedTechnologies
                .OrderBy(t => t.Title)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در بارگذاری داده‌ها: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddForm(string mode)
    {
        formMode = mode;
        editingId = Guid.Empty;
        formTitle = "";
        formIcon = mode == "category" ? "fas fa-folder" : "fas fa-code";
        formCategoryId = Guid.Empty;
        showForm = true;
        successMessage = "";
        errorMessage = "";
    }

    private void OpenEditCategory(SpecializedTechnologyCategory cat)
    {
        formMode = "category";
        editingId = cat.Id;
        formTitle = cat.Title ?? "";
        formIcon = cat.Icon ?? "fas fa-folder";
        formCategoryId = Guid.Empty;
        showForm = true;
        successMessage = "";
        errorMessage = "";
    }

    private void OpenEditTechnology(SpecializedTechnology tech)
    {
        formMode = "technology";
        editingId = tech.Id;
        formTitle = tech.Title ?? "";
        formIcon = tech.Icon ?? "fas fa-code";
        formCategoryId = tech.CategoryId;
        showForm = true;
        successMessage = "";
        errorMessage = "";
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = Guid.Empty;
    }

    private async Task SaveForm()
    {
        if (string.IsNullOrWhiteSpace(formTitle) || string.IsNullOrWhiteSpace(formIcon))
        {
            errorMessage = "لطفاً عنوان و آیکون را پر کنید.";
            return;
        }

        if (formMode == "technology" && formCategoryId == Guid.Empty)
        {
            errorMessage = "لطفاً دسته‌بندی را انتخاب کنید.";
            return;
        }

        isSaving = true;
        errorMessage = "";
        try
        {
            if (formMode == "category")
            {
                if (editingId == Guid.Empty)
                {
                    var newCat = new SpecializedTechnologyCategory
                    {
                        Id = Guid.NewGuid(),
                        Title = formTitle.Trim(),
                        Icon = formIcon.Trim()
                    };
                    DbContext.SpecializedTechnologyCategories.Add(newCat);
                    await DbContext.SaveChangesAsync();
                    successMessage = "✅ دسته‌بندی جدید اضافه شد.";
                }
                else
                {
                    var existing = await DbContext.SpecializedTechnologyCategories.FindAsync(editingId);
                    if (existing == null) { errorMessage = "دسته پیدا نشد."; return; }
                    existing.Title = formTitle.Trim();
                    existing.Icon = formIcon.Trim();
                    await DbContext.SaveChangesAsync();
                    successMessage = "✅ دسته‌بندی به‌روزرسانی شد.";
                }
            }
            else
            {
                if (editingId == Guid.Empty)
                {
                    var newTech = new SpecializedTechnology
                    {
                        Id = Guid.NewGuid(),
                        Title = formTitle.Trim(),
                        Icon = formIcon.Trim(),
                        CategoryId = formCategoryId
                    };
                    DbContext.SpecializedTechnologies.Add(newTech);
                    await DbContext.SaveChangesAsync();
                    successMessage = "✅ تکنولوژی جدید اضافه شد.";
                }
                else
                {
                    var existing = await DbContext.SpecializedTechnologies.FindAsync(editingId);
                    if (existing == null) { errorMessage = "تکنولوژی پیدا نشد."; return; }
                    existing.Title = formTitle.Trim();
                    existing.Icon = formIcon.Trim();
                    existing.CategoryId = formCategoryId;
                    await DbContext.SaveChangesAsync();
                    successMessage = "✅ تکنولوژی به‌روزرسانی شد.";
                }
            }
            CloseForm();
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در ذخیره: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCategory(SpecializedTechnologyCategory cat)
    {
        var techCount = technologies.Count(t => t.CategoryId == cat.Id);
        var message = techCount > 0
            ? $"«{cat.Title}» دارای {techCount} تکنولوژی است. با حذف دسته، تکنولوژی‌های آن بدون دسته می‌شوند. ادامه می‌دهید؟"
            : $"آیا از حذف دسته «{cat.Title}» مطمئن هستید؟";

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", message);
        if (!confirmed) return;

        errorMessage = "";
        successMessage = "";
        try
        {
            var existing = await DbContext.SpecializedTechnologyCategories.FindAsync(cat.Id);
            if (existing != null)
            {
                DbContext.SpecializedTechnologyCategories.Remove(existing);
                await DbContext.SaveChangesAsync();
                successMessage = "✅ دسته‌بندی حذف شد.";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در حذف: {ex.Message}";
        }
    }

    private async Task DeleteTechnology(SpecializedTechnology tech)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"آیا از حذف تکنولوژی «{tech.Title}» مطمئن هستید؟");
        if (!confirmed) return;

        errorMessage = "";
        successMessage = "";
        try
        {
            var existing = await DbContext.SpecializedTechnologies.FindAsync(tech.Id);
            if (existing != null)
            {
                DbContext.SpecializedTechnologies.Remove(existing);
                await DbContext.SaveChangesAsync();
                successMessage = "✅ تکنولوژی حذف شد.";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در حذف: {ex.Message}";
        }
    }
}