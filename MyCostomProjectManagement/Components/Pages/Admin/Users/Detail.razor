@page "/Admin/User/Detail/{UserId}"
@layout AdminLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IUserFacade _userFacade
@inject IRoleFacade _roleFacade
@inject JsAlertService _alertService

@using MyCostomProjectManagement.Facade.Role
@using MyCostomProjectManagement.Facade.User
@using MyCostomProjectManagement.Infrastructure

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>جزئیات کاربر | پنل ادمین</title>

<style>
    /* ============================================================
           USER DETAIL PAGE
        ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 32px;
        padding-top: 20px;
    }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .page-header h1 i {
                color: #e8a838;
            }

        .page-header .subtitle {
            color: rgba(232, 240, 241, 0.5);
            font-size: 0.9rem;
            margin-top: 4px;
        }

        .page-header .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

    .btn-back {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        text-decoration: none;
    }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(232, 168, 56, 0.06);
            transform: translateY(-2px);
        }

    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.12);
        font-family: inherit;
    }

        .btn-primary:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(232, 168, 56, 0.2);
        }

    .btn-success {
        background: linear-gradient(135deg, #52b788, #409f73);
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(82, 183, 136, 0.12);
        font-family: inherit;
    }

        .btn-success:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(82, 183, 136, 0.2);
        }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(220, 53, 69, 0.12);
        font-family: inherit;
    }

        .btn-danger:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(220, 53, 69, 0.2);
        }

    .btn-outline {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #eef2f8;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: 0.3s;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        text-decoration: none;
    }

        .btn-outline:hover {
            border-color: #e8a838;
            color: #fff;
            background: rgba(232, 168, 56, 0.04);
            transform: translateY(-2px);
        }

    /* ============================================================
           PROFILE CARD
        ============================================================ */
    .profile-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 24px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 32px;
        margin-bottom: 32px;
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        align-items: center;
        transition: all 0.3s ease;
    }

        .profile-card:hover {
            border-color: rgba(232, 168, 56, 0.06);
        }

        .profile-card .avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e8a838, #3b82f6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 4px 20px rgba(232, 168, 56, 0.08);
        }

        .profile-card .info {
            flex: 1;
            min-width: 200px;
        }

            .profile-card .info .name {
                font-size: 1.6rem;
                font-weight: 700;
                color: #ffffff;
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

                .profile-card .info .name .status-badge {
                    font-size: 0.7rem;
                    padding: 4px 14px;
                    border-radius: 30px;
                    font-weight: 500;
                }

                    .profile-card .info .name .status-badge.active {
                        background: rgba(82, 183, 136, 0.06);
                        color: #52b788;
                        border: 1px solid rgba(82, 183, 136, 0.04);
                    }

                    .profile-card .info .name .status-badge.inactive {
                        background: rgba(239, 68, 68, 0.06);
                        color: #ef4444;
                        border: 1px solid rgba(239, 68, 68, 0.04);
                    }

            .profile-card .info .details {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 8px 24px;
                margin-top: 12px;
            }

                .profile-card .info .details .item {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    color: #94a3b8;
                    font-size: 0.9rem;
                }

                    .profile-card .info .details .item i {
                        color: #e8a838;
                        opacity: 0.4;
                        width: 20px;
                        text-align: center;
                    }

                    .profile-card .info .details .item .value {
                        color: #e8edf5;
                        font-weight: 500;
                    }

        .profile-card .actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-left: auto;
        }

    /* ============================================================
           STATS ROW
        ============================================================ */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .stat-mini {
        padding: 16px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 14px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all 0.3s ease;
    }

        .stat-mini:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(232, 168, 56, 0.06);
        }

        .stat-mini i {
            font-size: 1.6rem;
            color: #e8a838;
            opacity: 0.5;
            width: 40px;
            text-align: center;
        }

        .stat-mini .info .number {
            font-size: 1.4rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.2;
        }

        .stat-mini .info .label {
            font-size: 0.75rem;
            color: rgba(232, 240, 241, 0.3);
        }

    /* ============================================================
           ROLES SECTION
        ============================================================ */
    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #e8edf5;
        margin: 32px 0 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        padding-bottom: 12px;
    }

        .section-title i {
            color: #e8a838;
        }

        .section-title .count {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-right: auto;
            font-weight: 400;
        }

    .role-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
    }

    .role-tag {
        padding: 6px 16px;
        border-radius: 30px;
        font-size: 0.8rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #b8c4d6;
        transition: 0.3s;
    }

        .role-tag:hover {
            border-color: rgba(232, 168, 56, 0.06);
            color: #e8f0f1;
        }

        .role-tag .role-icon {
            color: #e8a838;
            margin-left: 4px;
        }

    /* ============================================================
           MODAL
        ============================================================ */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.3s ease;
    }

        .modal-overlay.active {
            display: flex;
        }

    @@keyframes fadeIn {
        0% {
            opacity: 0;
        }

        100% {
            opacity: 1;
        }
    }

    .modal-box {
        background: #0a0e17;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 28px;
        padding: 40px 36px;
        max-width: 520px;
        width: 100%;
        margin: 20px;
        box-shadow: 0 8px 64px rgba(0, 0, 0, 0.5);
        animation: scaleIn 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        max-height: 90vh;
        overflow-y: auto;
    }

    @@keyframes scaleIn {
        0% {
            transform: scale(0.95);
            opacity: 0;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-box .modal-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .modal-box .modal-title i {
            color: #e8a838;
        }

    .modal-box .modal-subtitle {
        color: #94a3b8;
        font-size: 0.85rem;
        margin-bottom: 20px;
    }

    .modal-box .form-group {
        margin-bottom: 18px;
    }

        .modal-box .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #94a3b8;
            margin-bottom: 4px;
        }

        .modal-box .form-group input,
        .modal-box .form-group textarea {
            width: 100%;
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            color: #eef2f8;
            font-size: 0.95rem;
            outline: none;
            transition: all 0.35s ease;
            font-family: inherit;
        }

            .modal-box .form-group input:focus,
            .modal-box .form-group textarea:focus {
                border-color: #e8a838;
                background: rgba(255, 255, 255, 0.04);
                box-shadow: 0 0 24px rgba(232, 168, 56, 0.02);
            }

            .modal-box .form-group input::placeholder,
            .modal-box .form-group textarea::placeholder {
                color: #64748b;
            }

        .modal-box .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

    .modal-box .modal-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        flex-wrap: wrap;
    }

        .modal-box .modal-actions .btn-modal-primary {
            flex: 1;
            padding: 12px;
            border-radius: 40px;
            border: none;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.35s ease;
            font-family: inherit;
            background: linear-gradient(135deg, #52b788, #409f73);
            color: #fff;
            box-shadow: 0 4px 20px rgba(82, 183, 136, 0.12);
        }

            .modal-box .modal-actions .btn-modal-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 32px rgba(82, 183, 136, 0.2);
            }

        .modal-box .modal-actions .btn-modal-secondary {
            flex: 1;
            padding: 12px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            background: transparent;
            color: #94a3b8;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.35s ease;
            font-family: inherit;
        }

            .modal-box .modal-actions .btn-modal-secondary:hover {
                background: rgba(255, 255, 255, 0.04);
                border-color: rgba(255, 255, 255, 0.1);
                color: #eef2f8;
                transform: translateY(-2px);
            }

    /* ============================================================
           EMPTY STATE
        ============================================================ */
    .empty-state-mini {
        text-align: center;
        padding: 30px 20px;
        color: #64748b;
        font-size: 0.9rem;
    }

        .empty-state-mini i {
            font-size: 2rem;
            display: block;
            margin-bottom: 8px;
            color: rgba(59, 130, 246, 0.05);
        }

    /* ============================================================
           LOADING
        ============================================================ */
    .loading-spinner {
        text-align: center;
        padding: 60px 20px;
    }

        .loading-spinner i {
            font-size: 2.5rem;
            color: #e8a838;
            animation: spin 1s linear infinite;
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .loading-spinner p {
        color: #94a3b8;
        margin-top: 12px;
    }

    /* ============================================================
           RIPPLE
        ============================================================ */
    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* ============================================================
           FADE UP
        ============================================================ */
    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* ============================================================
           RESPONSIVE
        ============================================================ */
    @@media (max-width: 992px) {
        .profile-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

            .profile-card .info .details {
                justify-content: center;
            }

            .profile-card .actions {
                margin-left: 0;
                justify-content: center;
            }

            .profile-card .info .name {
                justify-content: center;
            }

        .stats-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .page-header h1 {
                font-size: 1.5rem;
            }

            .page-header .actions {
                width: 100%;
            }

                .page-header .actions .btn-primary,
                .page-header .actions .btn-danger,
                .page-header .actions .btn-outline {
                    flex: 1;
                    justify-content: center;
                }

        .profile-card {
            padding: 20px;
        }

            .profile-card .avatar {
                width: 80px;
                height: 80px;
                font-size: 2.4rem;
            }

            .profile-card .info .name {
                font-size: 1.3rem;
            }

            .profile-card .info .details {
                grid-template-columns: 1fr;
                gap: 4px;
            }

        .stats-row {
            grid-template-columns: 1fr 1fr;
        }

        .stat-mini .info .number {
            font-size: 1.1rem;
        }

        .stat-mini i {
            font-size: 1.2rem;
            width: 30px;
        }

        .modal-box {
            padding: 28px 20px;
            margin: 12px;
        }

            .modal-box .modal-actions {
                flex-direction: column;
            }

                .modal-box .modal-actions .btn-modal-primary,
                .modal-box .modal-actions .btn-modal-secondary {
                    width: 100%;
                }
    }

    @@media (max-width: 480px) {
        .stats-row {
            grid-template-columns: 1fr;
        }

        .page-header h1 {
            font-size: 1.2rem;
        }

        .profile-card .info .details .item {
            font-size: 0.8rem;
            justify-content: center;
        }

        .modal-box {
            padding: 20px 16px;
        }
    }

    /* ============================================================
           SCROLLBAR
        ============================================================ */
    .modal-box::-webkit-scrollbar {
        width: 4px;
    }

    .modal-box::-webkit-scrollbar-track {
        background: transparent;
    }

    .modal-box::-webkit-scrollbar-thumb {
        background: rgba(232, 168, 56, 0.2);
        border-radius: 10px;
    }

        .modal-box::-webkit-scrollbar-thumb:hover {
            background: rgba(232, 168, 56, 0.3);
        }
</style>

<!-- ===== ROUTE PARAMETER ===== -->
@code {
    [Parameter]
    public string UserId { get; set; } = "";
}

<!-- ===== PAGE CONTENT ===== -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-user-circle"></i>
                    جزئیات کاربر
                </h1>
                <div class="subtitle">مشاهده اطلاعات کامل کاربر</div>
            </div>
            <div class="actions">
                <a href="/Admin/Users" class="btn-back ripple">
                    <i class="fas fa-arrow-right"></i> بازگشت
                </a>
                <a href="/Admin/User/Edit/@UserId" class="btn-primary ripple">
                    <i class="fas fa-edit"></i> ویرایش
                </a>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner">
                <i class="fas fa-spinner fa-spin"></i>
                <p>در حال بارگذاری اطلاعات کاربر...</p>
            </div>
        }
        else if (user != null)
        {
            <!-- Profile Card -->
            <div class="profile-card fade-up visible">
                <div class="avatar">@user.Initials</div>
                <div class="info">
                    <div class="name">
                        @user.FullName
                        <span class="status-badge @(user.Status == "active" ? "active" : "inactive")">
                            @(user.Status == "active" ? "✅ فعال" : "❌ غیرفعال")
                        </span>
                    </div>
                    <div class="details">
                        <div class="item">
                            <i class="fas fa-envelope"></i>
                            <span class="value">@user.Email</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-phone"></i>
                            <span class="value">@user.Phone</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-calendar-check"></i>
                            <span class="value">عضو از @user.JoinDate</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span class="value">@user.Location</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-clock"></i>
                            <span class="value">آخرین فعالیت: @user.LastActive</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-id-badge"></i>
                            <span class="value">شناسه: @user.Id</span>
                        </div>
                    </div>
                </div>
                <div class="actions">
                    <button class="btn-success ripple" @onclick="OpenEmailModal">
                        <i class="fas fa-envelope"></i> ایمیل
                    </button>
                    @if (user.Status == "active")
                    {
                        <button class="btn-danger ripple" @onclick="ToggleBlock">
                            <i class="fas fa-ban"></i> مسدود کردن
                        </button>
                    }
                    else
                    {
                        <button class="btn-success ripple" @onclick="ToggleBlock">
                            <i class="fas fa-check"></i> فعال کردن
                        </button>
                    }
                    <button class="btn-danger ripple" @onclick="DeleteUser">
                        <i class="fas fa-trash-alt"></i> حذف
                    </button>
                </div>
            </div>

            <!-- Stats -->
            <div class="stats-row fade-up visible">
                <div class="stat-mini">
                    <i class="fas fa-project-diagram"></i>
                    <div class="info">
                        <div class="number">@user.ProjectCount</div>
                        <div class="label">پروژه‌ها</div>
                    </div>
                </div>
                <div class="stat-mini">
                    <i class="fas fa-shopping-cart" style="color:#e8a838;"></i>
                    <div class="info">
                        <div class="number">@user.PurchaseCount</div>
                        <div class="label">خریدها</div>
                    </div>
                </div>
                <div class="stat-mini">
                    <i class="fas fa-plug" style="color:#52b788;"></i>
                    <div class="info">
                        <div class="number">@user.ApiAccessCount</div>
                        <div class="label">APIهای فعال</div>
                    </div>
                </div>
                <div class="stat-mini">
                    <i class="fas fa-box" style="color:#8264c8;"></i>
                    <div class="info">
                        <div class="number">@(user.HasActivePackage ? user.ActivePackageName : "ندارد")</div>
                        <div class="label">پکیج فعال</div>
                    </div>
                </div>
            </div>

            <!-- Roles -->
            <div class="section-title">
                <i class="fas fa-user-tag"></i>
                نقش‌های کاربر
                <span class="count">@user.Roles.Count مورد</span>
            </div>
            <div class="role-tags">
                @foreach (var role in user.Roles)
                {
                    <span class="role-tag">
                        <i class="fas fa-shield-alt role-icon"></i>
                        @role.Name
                    </span>
                }
                @if (!user.Roles.Any())
                {
                    <div class="empty-state-mini" style="padding:10px 0;">
                        <p>هیچ نقشی به این کاربر اختصاص داده نشده است.</p>
                    </div>
                }
            </div>

            <!-- Placeholder for future data -->
            <div style="text-align:center; padding:20px; color:#64748b; font-size:0.9rem; border:1px dashed rgba(255,255,255,0.04); border-radius:16px; margin-top:20px;">
                <i class="fas fa-info-circle" style="color:#e8a838;"></i>
                اطلاعات بیشتر مانند پروژه‌ها و خریدها به‌زودی اضافه می‌شوند.
            </div>
        }
        else
        {
            <div style="text-align:center; padding:60px 20px;">
                <i class="fas fa-user-slash" style="font-size:4rem; color:#64748b; display:block; margin-bottom:16px;"></i>
                <h3 style="color:#94a3b8;">کاربری با این شناسه یافت نشد</h3>
                <p style="color:#64748b; margin-top:8px;">لطفاً شناسه کاربر را بررسی کنید.</p>
                <a href="/Admin/Users" class="btn-primary ripple" style="margin-top:16px; display:inline-flex;">
                    <i class="fas fa-arrow-right"></i> بازگشت به لیست کاربران
                </a>
            </div>
        }

    </div>
</main>

<!-- ============================================================
     EMAIL MODAL
============================================================ -->
<div class="modal-overlay @(isEmailModalOpen ? "active" : "")" @onclick="CloseEmailModal">
    <div class="modal-box" @onclick:stopPropagation="true">
        <div class="modal-title">
            <i class="fas fa-envelope"></i>
            ارسال ایمیل
        </div>
        <div class="modal-subtitle">
            ارسال ایمیل به <strong style="color:#e8a838;">@(user?.Email ?? "")</strong>
        </div>

        <div class="form-group">
            <label>موضوع</label>
            <input type="text" placeholder="موضوع ایمیل..." @bind="emailSubject" />
        </div>

        <div class="form-group">
            <label>پیام</label>
            <textarea placeholder="متن ایمیل را بنویسید..." @bind="emailBody"></textarea>
        </div>

        <div class="modal-actions">
            <button class="btn-modal-primary ripple" @onclick="SendEmail" disabled="@isSending">
                @if (isSending)
                {
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>در حال ارسال...</p>
                }
                else
                {
                    <span><i class="fas fa-paper-plane"></i> ارسال</span>
                }
            </button>
            <button class="btn-modal-secondary ripple" @onclick="CloseEmailModal">
                <i class="fas fa-times"></i> لغو
            </button>
        </div>
    </div>
</div>

@code {
    // ============================================================
    // STATE
    // ============================================================

    private bool isLoading = false;
    private bool isSending = false;
    private bool isEmailModalOpen = false;
    private string emailSubject = "";
    private string emailBody = "";
    private UserDetailDto? user = null;

    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var userResult = await _userFacade.GetId(Guid.Parse(UserId));
            if (userResult == null)
            {
                await _alertService.Error("کاربر مورد نظر یافت نشد.");
                return;
            }

            user = new UserDetailDto
            {
                Id = userResult.Id,
                FullName = userResult.FullName,
                Email = userResult.Email,
                Phone = userResult.PhoneNumber,
                Location = "تهران، ایران",
                JoinDate = userResult.CreationDate.ToString("yyyy/MM/dd") ?? "نامشخص",
                LastActive = "امروز، ۱۴:۳۰",
                Status = userResult.UserBlackLists.Any(i => i.ExpireDate > DateTime.Now) ? "inactive" : "active",
                Initials = userResult.FullName.Length > 0 ? userResult.FullName.Substring(0, 1) : "?",
                ProjectCount = 0,
                PurchaseCount = 0,
                ApiAccessCount = 0,
                HasActivePackage = false,
                ActivePackageName = "—",
                Roles = userResult.UserRoles.Select(i => new RoleDto
                {
                    Id = i.RoleId,
                    Name =  i.Title ??  "نقش ناشناخته"
                }).ToList()
            };
        }
        catch (Exception ex)
        {
            await _alertService.Error($"خطا در بارگذاری اطلاعات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // EMAIL MODAL
    // ============================================================

    private void OpenEmailModal()
    {
        if (user == null) return;
        emailSubject = $"ارسال از پنل ادمین - {user.FullName}";
        emailBody = "";
        isEmailModalOpen = true;
        StateHasChanged();
    }

    private void CloseEmailModal()
    {
        isEmailModalOpen = false;
        StateHasChanged();
    }

    private async Task SendEmail()
    {
        if (user == null) return;

        if (string.IsNullOrWhiteSpace(emailSubject) || string.IsNullOrWhiteSpace(emailBody))
        {
            await _alertService.Warning("لطفاً موضوع و متن ایمیل را وارد کنید.", "تکمیل فیلدها", 4000);
            return;
        }

        isSending = true;
        StateHasChanged();

        try
        {
            // در اینجا متد ارسال ایمیل واقعی را صدا بزنید
            // await _emailService.SendEmailAsync(user.Email, emailSubject, emailBody);

            // شبیه‌سازی تاخیر
            await Task.Delay(1500);

            await _alertService.Success($"ایمیل با موفقیت به {user.Email} ارسال شد.", "ارسال ایمیل", 5000);
            CloseEmailModal();
        }
        catch (Exception ex)
        {
            await _alertService.Error($"خطا در ارسال ایمیل: {ex.Message}", "خطا", 6000);
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // ACTIONS
    // ============================================================

    private async Task ToggleBlock()
    {
        if (user == null) return;

        var newStatus = user.Status == "active" ? "inactive" : "active";
        var action = newStatus == "active" ? "فعال" : "مسدود";

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"آیا از {action} کردن کاربر {user.FullName} اطمینان دارید؟");
        if (!confirmed) return;

        try
        {
            // Call backend to toggle status
            // await _userFacade.ToggleStatus(user.Id, newStatus);
            user.Status = newStatus;
            await _alertService.Success($"کاربر با موفقیت {action} شد.", "تغییر وضعیت", 4000);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _alertService.Error($"خطا در تغییر وضعیت کاربر: {ex.Message}", "خطا", 6000);
        }
    }

    private async Task DeleteUser()
    {
        if (user == null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"آیا از حذف کاربر {user.FullName} اطمینان دارید؟");
        if (!confirmed) return;

        try
        {
            // await _userFacade.Delete(user.Id);
            await _alertService.Success("کاربر با موفقیت حذف شد.", "حذف کاربر", 4000);
            NavigationManager.NavigateTo("/Admin/Users", true);
        }
        catch (Exception ex)
        {
            await _alertService.Error($"خطا در حذف کاربر: {ex.Message}", "خطا", 6000);
        }
    }

    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();

            await InitializeJsInterop();
                       StateHasChanged();

        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Fade-up observer
            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 });

            fadeEls.forEach(el => observer.observe(el));

            // Trigger visible for elements already in view
            setTimeout(() => {
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                    }
                });
            }, 400);
        ");
    }

    // ============================================================
    // HELPER CLASSES
    // ============================================================

    public class UserDetailDto
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Location { get; set; } = "";
        public string JoinDate { get; set; } = "";
        public string LastActive { get; set; } = "";
        public string Status { get; set; } = "active";
        public string Initials { get; set; } = "";
        public int ProjectCount { get; set; }
        public int PurchaseCount { get; set; }
        public int ApiAccessCount { get; set; }
        public bool HasActivePackage { get; set; }
        public string ActivePackageName { get; set; } = "";
        public List<RoleDto> Roles { get; set; } = new();
    }

    public class RoleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
}
