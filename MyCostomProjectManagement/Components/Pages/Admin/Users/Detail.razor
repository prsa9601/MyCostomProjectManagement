@page "/Admin/UserDetail/{UserId}"
@layout AdminLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>جزئیات کاربر | پنل ادمین</title>

<style>
    /* ============================================================
           USER DETAIL PAGE - با پس‌زمینه #13505b
        ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 32px;
        padding-top: 20px;
    }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .page-header h1 i {
                color: #e8a838;
            }

        .page-header .subtitle {
            color: rgba(232, 240, 241, 0.5);
            font-size: 0.9rem;
            margin-top: 4px;
        }

        .page-header .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

    .btn-back {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        text-decoration: none;
    }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(232, 168, 56, 0.06);
            transform: translateY(-2px);
        }

    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.12);
        font-family: inherit;
        text-decoration: none;
    }

        .btn-primary:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(232, 168, 56, 0.2);
        }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(220, 53, 69, 0.12);
        font-family: inherit;
    }

        .btn-danger:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(220, 53, 69, 0.2);
        }

    .btn-outline {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #eef2f8;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: 0.3s;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        text-decoration: none;
    }

        .btn-outline:hover {
            border-color: #e8a838;
            color: #fff;
            background: rgba(232, 168, 56, 0.04);
            transform: translateY(-2px);
        }

    .btn-success {
        background: linear-gradient(135deg, #52b788, #409f73);
        color: #fff;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(82, 183, 136, 0.12);
        font-family: inherit;
    }

        .btn-success:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(82, 183, 136, 0.2);
        }

    /* ============================================================
           USER PROFILE CARD
        ============================================================ */
    .profile-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 24px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 32px;
        margin-bottom: 32px;
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        align-items: center;
        transition: all 0.3s ease;
    }

        .profile-card:hover {
            border-color: rgba(232, 168, 56, 0.06);
        }

        .profile-card .avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e8a838, #3b82f6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 4px 20px rgba(232, 168, 56, 0.08);
        }

        .profile-card .info {
            flex: 1;
            min-width: 200px;
        }

            .profile-card .info .name {
                font-size: 1.6rem;
                font-weight: 700;
                color: #ffffff;
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

                .profile-card .info .name .role-badge {
                    font-size: 0.7rem;
                    padding: 4px 14px;
                    border-radius: 30px;
                    font-weight: 500;
                    background: rgba(59, 130, 246, 0.06);
                    color: #3b82f6;
                    border: 1px solid rgba(59, 130, 246, 0.04);
                }

                    .profile-card .info .name .role-badge.admin {
                        background: rgba(232, 168, 56, 0.06);
                        color: #e8a838;
                        border-color: rgba(232, 168, 56, 0.04);
                    }

            .profile-card .info .details {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 8px 24px;
                margin-top: 12px;
            }

                .profile-card .info .details .item {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    color: #94a3b8;
                    font-size: 0.9rem;
                }

                    .profile-card .info .details .item i {
                        color: #e8a838;
                        opacity: 0.4;
                        width: 20px;
                        text-align: center;
                    }

                    .profile-card .info .details .item .value {
                        color: #e8edf5;
                        font-weight: 500;
                    }

        .profile-card .actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-left: auto;
        }

    /* ============================================================
           STATS ROW
        ============================================================ */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .stat-mini {
        padding: 16px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 14px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all 0.3s ease;
    }

        .stat-mini:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(232, 168, 56, 0.06);
        }

        .stat-mini i {
            font-size: 1.6rem;
            color: #e8a838;
            opacity: 0.5;
            width: 40px;
            text-align: center;
        }

        .stat-mini .info .number {
            font-size: 1.4rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.2;
        }

        .stat-mini .info .label {
            font-size: 0.75rem;
            color: rgba(232, 240, 241, 0.3);
        }

    /* ============================================================
           SECTION TITLE
        ============================================================ */
    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #e8edf5;
        margin: 32px 0 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        padding-bottom: 12px;
    }

        .section-title i {
            color: #e8a838;
        }

        .section-title .count {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-right: auto;
            font-weight: 400;
        }

    /* ============================================================
           TABLES
        ============================================================ */
    .table-wrapper {
        overflow-x: auto;
        margin-bottom: 20px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        padding: 4px;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

        .data-table thead th {
            text-align: right;
            padding: 14px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            color: #94a3b8;
            font-weight: 500;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .data-table tbody td {
            padding: 12px 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.02);
            vertical-align: middle;
        }

        .data-table tbody tr:last-child td {
            border-bottom: none;
        }

        .data-table tbody tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .data-table .status-badge {
            font-size: 0.7rem;
            padding: 3px 12px;
            border-radius: 30px;
            font-weight: 500;
            white-space: nowrap;
        }

            .data-table .status-badge.active {
                background: rgba(82, 183, 136, 0.06);
                color: #52b788;
                border: 1px solid rgba(82, 183, 136, 0.02);
            }

            .data-table .status-badge.pending {
                background: rgba(232, 168, 56, 0.06);
                color: #e8a838;
                border: 1px solid rgba(232, 168, 56, 0.02);
            }

            .data-table .status-badge.completed {
                background: rgba(59, 130, 246, 0.06);
                color: #3b82f6;
                border: 1px solid rgba(59, 130, 246, 0.02);
            }

            .data-table .status-badge.cancelled {
                background: rgba(220, 53, 69, 0.04);
                color: #dc3545;
                border: 1px solid rgba(220, 53, 69, 0.02);
            }

    /* ============================================================
           EMPTY STATE
        ============================================================ */
    .empty-state-mini {
        text-align: center;
        padding: 30px 20px;
        color: #64748b;
        font-size: 0.9rem;
    }

        .empty-state-mini i {
            font-size: 2rem;
            display: block;
            margin-bottom: 8px;
            color: rgba(59, 130, 246, 0.05);
        }

    /* ============================================================
           RESPONSIVE
        ============================================================ */
    @@media (max-width: 992px) {
        .profile-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

            .profile-card .info .details {
                justify-content: center;
            }

            .profile-card .actions {
                margin-left: 0;
                justify-content: center;
            }

            .profile-card .info .name {
                justify-content: center;
            }

        .stats-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .page-header h1 {
                font-size: 1.5rem;
            }

            .page-header .actions {
                width: 100%;
            }

                .page-header .actions .btn-primary,
                .page-header .actions .btn-danger,
                .page-header .actions .btn-outline {
                    flex: 1;
                    justify-content: center;
                }

        .profile-card {
            padding: 20px;
        }

            .profile-card .avatar {
                width: 80px;
                height: 80px;
                font-size: 2.4rem;
            }

            .profile-card .info .name {
                font-size: 1.3rem;
            }

            .profile-card .info .details {
                grid-template-columns: 1fr;
                gap: 4px;
            }

        .stats-row {
            grid-template-columns: 1fr 1fr;
        }

        .stat-mini .info .number {
            font-size: 1.1rem;
        }

        .stat-mini i {
            font-size: 1.2rem;
            width: 30px;
        }

        .data-table thead {
            display: none;
        }

        .data-table tbody td {
            display: block;
            padding: 8px 14px;
            border-bottom: none;
        }

        .data-table tbody tr {
            display: block;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            padding: 4px 0;
        }

            .data-table tbody tr:last-child {
                border-bottom: none;
            }

        .data-table td:before {
            content: attr(data-label);
            display: inline-block;
            width: 80px;
            font-size: 0.7rem;
            color: #64748b;
            font-weight: 500;
        }
    }

    @@media (max-width: 480px) {
        .stats-row {
            grid-template-columns: 1fr;
        }

        .page-header h1 {
            font-size: 1.2rem;
        }

        .profile-card .info .details .item {
            font-size: 0.8rem;
            justify-content: center;
        }
    }

    /* ============================================================
           RIPPLE
        ============================================================ */
    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* ============================================================
           FADE UP
        ============================================================ */
    .fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .stagger-child {
        transition-delay: 0s;
    }

        .stagger-child:nth-child(1) {
            transition-delay: 0.05s;
        }

        .stagger-child:nth-child(2) {
            transition-delay: 0.1s;
        }

        .stagger-child:nth-child(3) {
            transition-delay: 0.15s;
        }

        .stagger-child:nth-child(4) {
            transition-delay: 0.2s;
        }
</style>

<!-- ===== ROUTE PARAMETER ===== -->
@code {
    [Parameter]
    public string UserId { get; set; } = "";
}

<!-- ===== PAGE CONTENT ===== -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-user-circle"></i>
                    جزئیات کاربر
                </h1>
                <div class="subtitle">مشاهده و مدیریت اطلاعات کاربر</div>
            </div>
            <div class="actions">
                <a href="/Admin/Users" class="btn-back ripple">
                    <i class="fas fa-arrow-right"></i> بازگشت
                </a>
                <button class="btn-primary ripple" @onclick="EditUser">
                    <i class="fas fa-edit"></i> ویرایش
                </button>
                <button class="btn-danger ripple" @onclick="DeleteUser">
                    <i class="fas fa-trash-alt"></i> حذف
                </button>
            </div>
        </div>

        @if (user != null)
        {
            <!-- Profile Card -->
            <div class="profile-card fade-up visible">
                <div class="avatar">@user.Initials</div>
                <div class="info">
                    <div class="name">
                        @user.FullName
                        <span class="role-badge @(user.Role == "admin" ? "admin" : "")">@user.RoleText</span>
                        <span style="font-size:0.7rem; color:#94a3b8; font-weight:400;">
                            <i class="fas fa-id-badge"></i> @user.Id
                        </span>
                    </div>
                    <div class="details">
                        <div class="item">
                            <i class="fas fa-envelope"></i>
                            <span class="value">@user.Email</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-phone"></i>
                            <span class="value">@user.Phone</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-calendar-check"></i>
                            <span class="value">عضو از @user.JoinDate</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-@(user.Status == "active" ? "check-circle" : "times-circle")" style="color:@(user.Status == "active" ? "#52b788" : "#dc3545"); opacity:0.8;"></i>
                            <span class="value" style="color:@(user.Status == "active" ? "#52b788" : "#FF9933");">@(user.Status == "active" ? "فعال" : "غیرفعال")</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span class="value">@user.Location</span>
                        </div>
                        <div class="item">
                            <i class="fas fa-clock"></i>
                            <span class="value">آخرین فعالیت: @user.LastActive</span>
                        </div>
                    </div>
                </div>
                <div class="actions">
                    <button class="btn-success ripple" @onclick="SendEmail">
                        <i class="fas fa-envelope"></i> ارسال ایمیل
                    </button>
                    @if (user.Status == "active")
                    {
                        <button class="btn-danger ripple" @onclick="ToggleBlock">
                            <i class="fas fa-ban"></i> مسدود کردن
                        </button>
                    }
                    else
                    {
                        <button class="btn-success ripple" @onclick="ToggleBlock">
                            <i class="fas fa-check"></i> فعال کردن
                        </button>
                    }
                </div>
            </div>

            <!-- Stats -->
            <div class="stats-row fade-up visible">
                <div class="stat-mini">
                    <i class="fas fa-project-diagram"></i>
                    <div class="info">
                        <div class="number">@user.ProjectCount</div>
                        <div class="label">پروژه‌ها</div>
                    </div>
                </div>
                <div class="stat-mini">
                    <i class="fas fa-shopping-cart" style="color:#e8a838;"></i>
                    <div class="info">
                        <div class="number">@user.PurchaseCount</div>
                        <div class="label">خریدها</div>
                    </div>
                </div>
                <div class="stat-mini">
                    <i class="fas fa-plug" style="color:#52b788;"></i>
                    <div class="info">
                        <div class="number">@user.ApiAccessCount</div>
                        <div class="label">APIهای فعال</div>
                    </div>
                </div>
                <div class="stat-mini">
                    <i class="fas fa-box" style="color:#8264c8;"></i>
                    <div class="info">
                        <div class="number">@(user.HasActivePackage ? user.ActivePackageName : "ندارد")</div>
                        <div class="label">پکیج فعال</div>
                    </div>
                </div>
            </div>

            <!-- User Projects -->
            <div class="section-title">
                <i class="fas fa-project-diagram"></i>
                پروژه‌های کاربر
                <span class="count">@user.Projects.Count مورد</span>
            </div>
            <div class="table-wrapper fade-up visible">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>شناسه</th>
                            <th>عنوان</th>
                            <th>وضعیت</th>
                            <th>تاریخ</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proj in user.Projects)
                        {
                            <tr>
                                <td data-label="شناسه">@proj.Id</td>
                                <td data-label="عنوان">@proj.Title</td>
                                <td data-label="وضعیت">
                                    <span class="status-badge @proj.StatusClass">@proj.StatusText</span>
                                </td>
                                <td data-label="تاریخ">@proj.Date</td>
                                <td data-label="عملیات">
                                    <a href="/Admin/Projects/Detail/@proj.Id" class="btn-outline" style="padding:4px 12px; font-size:0.7rem; border-radius:30px;">
                                        <i class="fas fa-eye"></i> مشاهده
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Purchase History -->
            <div class="section-title">
                <i class="fas fa-history"></i>
                تاریخچه خریدها
                <span class="count">@user.Purchases.Count مورد</span>
            </div>
            <div class="table-wrapper fade-up visible">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>شناسه</th>
                            <th>پکیج</th>
                            <th>قیمت</th>
                            <th>تاریخ</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var purchase in user.Purchases)
                        {
                            <tr>
                                <td data-label="شناسه">@purchase.Id</td>
                                <td data-label="پکیج">@purchase.PackageName</td>
                                <td data-label="قیمت">@purchase.Price.ToString("N0") تومان</td>
                                <td data-label="تاریخ">@purchase.Date</td>
                                <td data-label="وضعیت">
                                    <span class="status-badge @purchase.StatusClass">@purchase.StatusText</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- API Access -->
            <div class="section-title">
                <i class="fas fa-plug"></i>
                دسترسی‌های API
                <span class="count">@user.ApiAccesses.Count مورد</span>
            </div>
            <div class="table-wrapper fade-up visible">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>نام API</th>
                            <th>پروژه</th>
                            <th>روز باقیمانده</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var api in user.ApiAccesses)
                        {
                            <tr>
                                <td data-label="نام API">@api.Name</td>
                                <td data-label="پروژه">@api.Project</td>
                                <td data-label="روز باقیمانده">
                                    <span style="color:@(api.RemainingDays < 7 ? "#dc3545" : "#52b788"); font-weight:600;">
                                        @api.RemainingDays روز
                                    </span>
                                </td>
                                <td data-label="وضعیت">
                                    <span class="status-badge @(api.RemainingDays > 0 ? "active" : "cancelled")">
