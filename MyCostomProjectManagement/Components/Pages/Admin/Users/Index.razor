@page "/Admin/Users"
@layout AdminLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>مدیریت کاربران | پنل ادمین</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
       USERS PAGE - با پس‌زمینه #13505b
    ============================================================ */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
       GLASS EFFECT
    ============================================================ */
    .glass {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    .glass:hover {
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 8px 48px rgba(0, 0, 0, 0.12);
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.06);
    }

    /* ============================================================
       ANIMATIONS
    ============================================================ */
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }
    .float-anim {
        animation: float 4s ease-in-out infinite;
    }

    @@keyframes rotateBorder {
        0% { background-position: 0% 50%; }
        100% { background-position: 400% 50%; }
    }
    .gradient-border {
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        background-clip: padding-box;
    }
    .gradient-border::before {
        content: '';
        position: absolute;
        inset: -2px;
        z-index: -1;
        border-radius: 22px;
        background: conic-gradient(from 0deg, #e8a838, #52b788, #1a7a8a, #e8a838, #52b788);
        background-size: 400% 400%;
        animation: rotateBorder 8s linear infinite;
        opacity: 0.2;
        transition: opacity 0.4s;
    }
    .gradient-border:hover::before {
        opacity: 0.5;
    }

    @@keyframes shimmer {
        0% { background-position: -200% center; }
        100% { background-position: 200% center; }
    }
    .shimmer-text {
        background: linear-gradient(90deg, #e8f0f1, #e8a838, #52b788, #e8f0f1);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmer 6s linear infinite;
        display: inline-block;
    }

    /* Ripple */
    .ripple {
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }
    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }
    @@keyframes rippleAnim {
        to { transform: scale(4); opacity: 0; }
    }

    /* Fade Up */
    .fade-up {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.2, 0.9, 0.3, 1),
                    transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    .fade-up.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .stagger-child { transition-delay: 0s; }
    .stagger-child:nth-child(1) { transition-delay: 0.05s; }
    .stagger-child:nth-child(2) { transition-delay: 0.1s; }
    .stagger-child:nth-child(3) { transition-delay: 0.15s; }
    .stagger-child:nth-child(4) { transition-delay: 0.2s; }
    .stagger-child:nth-child(5) { transition-delay: 0.25s; }
    .stagger-child:nth-child(6) { transition-delay: 0.3s; }

    /* Sparkle Particles */
    .sparkle {
        position: fixed;
        width: 4px;
        height: 4px;
        background: rgba(232, 168, 56, 0.2);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        animation: sparkleAnim 10s infinite alternate ease-in-out;
    }
    @@keyframes sparkleAnim {
        0% { transform: translate(0, 0) scale(1); opacity: 0.1; }
        50% { transform: translate(20px, -30px) scale(1.8); opacity: 0.6; }
        100% { transform: translate(-10px, 20px) scale(0.6); opacity: 0.05; }
    }
    .sparkle:nth-child(1) { left: 5%; top: 20%; animation-duration: 12s; }
    .sparkle:nth-child(2) { left: 85%; top: 60%; animation-duration: 14s; animation-delay: 2s; width: 6px; height: 6px; }
    .sparkle:nth-child(3) { left: 30%; top: 70%; animation-duration: 16s; animation-delay: 4s; }
    .sparkle:nth-child(4) { left: 92%; top: 30%; animation-duration: 11s; animation-delay: 1s; width: 5px; height: 5px; background: rgba(82, 183, 136, 0.15); }
    .sparkle:nth-child(5) { left: 50%; top: 90%; animation-duration: 18s; animation-delay: 3s; }
    .sparkle:nth-child(6) { left: 3%; top: 50%; animation-duration: 13s; animation-delay: 5s; background: rgba(232, 168, 56, 0.15); }

    /* ============================================================
       NAVBAR
    ============================================================ */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: all 0.4s ease;
        background: rgba(19, 80, 91, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .navbar.scrolled {
        background: rgba(19, 80, 91, 0.92);
        box-shadow: 0 4px 40px rgba(0, 0, 0, 0.12);
    }

    .navbar .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #e8f0f1;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .logo span { color: #e8a838; }
    .logo i { color: #e8a838; font-size: 1.3rem; }

    .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 500;
        align-items: center;
    }
    .nav-links a {
        color: rgba(232, 240, 241, 0.6);
        transition: all 0.35s ease;
        position: relative;
        padding: 4px 0;
    }
    .nav-links a:hover { color: #ffffff; }
    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        right: 0;
        width: 0;
        height: 2.5px;
        background: #e8a838;
        transition: 0.35s;
        border-radius: 4px;
        box-shadow: 0 0 12px rgba(232, 168, 56, 0.15);
    }
    .nav-links a:hover::after { width: 100%; }
    .nav-links a.active { color: #ffffff; }
    .nav-links a.active::after { width: 100%; }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 9px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.12);
    }
    .btn-primary:hover {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 8px 32px rgba(232, 168, 56, 0.2);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid rgba(255, 255, 255, 0.1);
        color: #e8f0f1;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
    }
    .btn-outline:hover {
        border-color: #e8a838;
        background: rgba(232, 168, 56, 0.04);
        transform: translateY(-2px);
    }

    .btn-light {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-light:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: #e8a838;
        transform: translateY(-2px);
    }

    .avatar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(232, 168, 56, 0.2);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8f0f1;
        font-size: 1.1rem;
        transition: all 0.35s ease;
        cursor: pointer;
    }
    .avatar-btn:hover {
        background: rgba(232, 168, 56, 0.04);
        transform: scale(1.05);
        border-color: #e8a838;
    }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
    }
    .hamburger span {
        display: block;
        width: 28px;
        height: 2.5px;
        background: #e8f0f1;
        border-radius: 4px;
        transition: 0.3s;
    }

    /* ============================================================
       PAGE HEADER
    ============================================================ */
    .page-header {
        padding-top: 100px;
        padding-bottom: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .page-header h1 i { color: #e8a838; }
    .page-header .subtitle {
        color: rgba(232, 240, 241, 0.5);
        font-size: 0.9rem;
        margin-top: 4px;
    }

    .page-header .actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* ============================================================
       FILTER BAR
    ============================================================ */
    .filter-bar {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 32px;
        padding: 16px 24px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        align-items: center;
    }

    .filter-bar .search-box {
        flex: 1;
        min-width: 200px;
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        padding: 0 16px;
        transition: all 0.35s ease;
    }
    .filter-bar .search-box:focus-within {
        border-color: #e8a838;
        background: rgba(255, 255, 255, 0.04);
        box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
    }
    .filter-bar .search-box input {
        background: transparent;
        border: none;
        padding: 12px 12px;
        color: #e8f0f1;
        font-size: 0.9rem;
        width: 100%;
        outline: none;
    }
    .filter-bar .search-box input::placeholder {
        color: rgba(232, 240, 241, 0.3);
    }
    .filter-bar .search-box i {
        color: rgba(232, 240, 241, 0.2);
        font-size: 0.9rem;
    }

    .filter-bar .filter-group {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .filter-bar .filter-group .filter-btn {
        padding: 8px 18px;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        background: rgba(255, 255, 255, 0.02);
        color: rgba(232, 240, 241, 0.4);
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.35s ease;
        cursor: pointer;
    }
    .filter-bar .filter-group .filter-btn:hover {
        border-color: rgba(232, 168, 56, 0.1);
        color: #e8f0f1;
    }
    .filter-bar .filter-group .filter-btn.active {
        background: rgba(232, 168, 56, 0.08);
        border-color: rgba(232, 168, 56, 0.1);
        color: #e8a838;
    }

    /* ============================================================
       USERS TABLE / GRID
    ============================================================ */
    .users-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin-bottom: 40px;
    }

    .user-row {
        display: grid;
        grid-template-columns: auto 1fr auto auto auto;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    .user-row:hover {
        transform: translateY(-3px);
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(232, 168, 56, 0.06);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    }

    .user-row .avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1rem;
        color: #fff;
        flex-shrink: 0;
        background: linear-gradient(135deg, #52b788, #1a7a8a);
    }

    .user-row .avatar.gold {
        background: linear-gradient(135deg, #e8a838, #d4952e);
    }
    .user-row .avatar.purple {
        background: linear-gradient(135deg, #8264c8, #6a4fa8);
    }
    .user-row .avatar.blue {
        background: linear-gradient(135deg, #1a7a8a, #13505b);
    }

    .user-row .user-info {
        flex: 1;
        min-width: 150px;
    }
    .user-row .user-info .name {
        font-size: 0.95rem;
        font-weight: 600;
        color: #ffffff;
    }
    .user-row .user-info .email {
        font-size: 0.8rem;
        color: rgba(232, 240, 241, 0.4);
    }

    .user-row .user-role {
        font-size: 0.75rem;
        padding: 4px 14px;
        border-radius: 40px;
        font-weight: 500;
        background: rgba(232, 168, 56, 0.06);
        color: #e8a838;
        border: 1px solid rgba(232, 168, 56, 0.04);
        white-space: nowrap;
    }
    .user-row .user-role.admin {
        background: rgba(220, 53, 69, 0.06);
        color: #dc3545;
        border-color: rgba(220, 53, 69, 0.04);
    }
    .user-row .user-role.manager {
        background: rgba(82, 183, 136, 0.06);
        color: #52b788;
        border-color: rgba(82, 183, 136, 0.04);
    }
    .user-row .user-role.user {
        background: rgba(130, 100, 200, 0.06);
        color: #8264c8;
        border-color: rgba(130, 100, 200, 0.04);
    }

    .user-row .user-status {
        font-size: 0.7rem;
        padding: 4px 14px;
        border-radius: 40px;
        font-weight: 500;
        white-space: nowrap;
    }
    .user-row .user-status.active {
        background: rgba(82, 183, 136, 0.06);
        color: #52b788;
        border: 1px solid rgba(82, 183, 136, 0.04);
    }
    .user-row .user-status.inactive {
        background: rgba(127, 140, 141, 0.06);
        color: rgba(232, 240, 241, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.02);
    }
    .user-row .user-status.pending {
        background: rgba(232, 168, 56, 0.06);
        color: #e8a838;
        border: 1px solid rgba(232, 168, 56, 0.04);
    }

    .user-row .user-actions {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }
    .user-row .user-actions button {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.04);
        background: rgba(255, 255, 255, 0.02);
        color: rgba(232, 240, 241, 0.2);
        transition: all 0.35s ease;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .user-row .user-actions button:hover {
        border-color: rgba(232, 168, 56, 0.1);
        color: #e8f0f1;
        background: rgba(232, 168, 56, 0.02);
        transform: scale(1.05);
    }
    .user-row .user-actions button.delete:hover {
        border-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        background: rgba(220, 53, 69, 0.02);
    }
    .user-row .user-actions button.block:hover {
        border-color: rgba(220, 53, 69, 0.08);
        color: #dc3545;
        background: rgba(220, 53, 69, 0.02);
    }

    /* ============================================================
       PAGINATION
    ============================================================ */
    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
        padding: 16px 0;
    }
    .pagination button {
        padding: 8px 16px;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        background: rgba(255, 255, 255, 0.02);
        color: rgba(232, 240, 241, 0.3);
        font-size: 0.8rem;
        transition: all 0.35s ease;
        cursor: pointer;
    }
    .pagination button:hover {
        border-color: rgba(232, 168, 56, 0.06);
        color: #e8f0f1;
        background: rgba(232, 168, 56, 0.02);
    }
    .pagination button.active {
        background: rgba(232, 168, 56, 0.06);
        border-color: rgba(232, 168, 56, 0.06);
        color: #e8a838;
    }

    /* ============================================================
       FOOTER
    ============================================================ */
    .footer {
        position: relative;
        padding: 28px 0 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.02);
        background: rgba(19, 80, 91, 0.2);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1;
        margin-top: 20px;
    }
    .footer .container {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
    }
    .footer-links {
        display: flex;
        gap: 24px;
        font-size: 0.85rem;
        color: rgba(232, 240, 241, 0.2);
    }
    .footer-links a:hover { color: #e8a838; }
    .footer-copy {
        color: rgba(232, 240, 241, 0.2);
        font-size: 0.8rem;
    }
    .footer-copy i { color: #e8a838; }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @@media (max-width: 1200px) {
        .user-row {
            grid-template-columns: auto 1fr auto auto;
            gap: 12px;
        }
        .user-row .user-role {
            display: none;
        }
    }

    @@media (max-width: 992px) {
        .user-row {
            grid-template-columns: auto 1fr auto;
            gap: 12px;
        }
        .user-row .user-status {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .nav-links {
            display: none;
            flex-direction: column;
            width: 100%;
            background: rgba(19, 80, 91, 0.95);
            backdrop-filter: blur(16px);
            padding: 20px 0;
            gap: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.02);
            margin-top: 12px;
            border-radius: 20px;
            align-items: center;
        }
        .nav-links.open { display: flex; }
        .hamburger { display: flex; }
        .nav-actions .btn-outline { display: none; }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }
        .page-header h1 { font-size: 1.5rem; }
        .filter-bar {
            flex-direction: column;
            padding: 16px;
        }
        .filter-bar .search-box { width: 100%; }
        .page-header .actions { width: 100%; }
        .page-header .actions .btn-primary { flex: 1; justify-content: center; }

        .user-row {
            grid-template-columns: auto 1fr auto;
            gap: 10px;
            padding: 14px 16px;
            flex-wrap: wrap;
        }
        .user-row .user-actions {
            grid-column: 1 / -1;
            justify-content: flex-end;
            padding-top: 8px;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
        }
        .user-row .user-status {
            display: inline-block;
        }
        .user-row .user-role {
            display: inline-block;
            font-size: 0.65rem;
            padding: 2px 10px;
        }
    }

    @@media (max-width: 480px) {
        .user-row {
            grid-template-columns: auto 1fr;
            gap: 8px;
        }
        .user-row .user-status,
        .user-row .user-role {
            font-size: 0.6rem;
            padding: 2px 10px;
        }
        .user-row .user-actions {
            grid-column: 1 / -1;
            justify-content: flex-end;
        }
        .filter-bar .filter-group {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-users"></i>
                    کاربران
                    <span class="badge-admin" style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalUsers</span>
                </h1>
                <div class="subtitle">مدیریت و مشاهده تمام کاربران سیستم</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshUsers"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
                <button class="btn-primary ripple" @onclick="CreateNewUser"><i class="fas fa-plus"></i> کاربر جدید</button>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی کاربر..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterStatus == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>همه</button>
                <button class="filter-btn @(filterStatus == "active" ? "active" : "")" @onclick='() => SetFilter("active")'>فعال</button>
                <button class="filter-btn @(filterStatus == "inactive" ? "active" : "")" @onclick='() => SetFilter("inactive")'>غیرفعال</button>
                <button class="filter-btn @(filterStatus == "pending" ? "active" : "")" @onclick='() => SetFilter("pending")'>در انتظار</button>
            </div>
            <div class="filter-group" style="margin-right:auto;">
                <button class="filter-btn @(filterRole == "all" ? "active" : "")" @onclick='() => SetRole("all")'>همه نقش‌ها</button>
                <button class="filter-btn @(filterRole == "admin" ? "active" : "")" @onclick='() => SetRole("admin")'>ادمین</button>
                <button class="filter-btn @(filterRole == "manager" ? "active" : "")" @onclick='() => SetRole("manager")'>مدیر</button>
                <button class="filter-btn @(filterRole == "user" ? "active" : "")" @onclick='() => SetRole("user")'>کاربر</button>
            </div>
        </div>

        <!-- Users Grid -->
        <div class="users-grid">
            @foreach (var user in filteredUsers)
            {
                <div class="user-row fade-up stagger-child">
                    <div class="avatar @user.AvatarClass">@user.Initials</div>
                    <div class="user-info">
                        <div class="name">@user.FullName</div>
                        <div class="email">@user.Email</div>
                    </div>
                    <span class="user-role @user.RoleClass">@user.RoleText</span>
                    <span class="user-status @user.StatusClass">@user.StatusText</span>
                    <div class="user-actions">
                        <button class="ripple" title="مشاهده" @onclick='() => ViewUser(user.Id)'><i class="fas fa-eye"></i></button>
                        <button class="ripple" title="ویرایش" @onclick='() => EditUser(user.Id)'><i class="fas fa-edit"></i></button>
                        @if (user.StatusClass == "active")
                        {
                            <button class="ripple block" title="مسدود کردن" @onclick='() => BlockUser(user.Id)'><i class="fas fa-ban"></i></button>
                        }
                        else
                        {
                            <button class="ripple" title="فعال کردن" @onclick='() => ActivateUser(user.Id)' style="color:#52b788;"><i class="fas fa-check-circle"></i></button>
                        }
                        <button class="ripple delete" title="حذف" @onclick='() => DeleteUser(user.Id)'><i class="fas fa-trash-alt"></i></button>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }

    </div>
</main>



