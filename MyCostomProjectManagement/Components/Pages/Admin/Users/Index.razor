<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-users"></i>
                    کاربران
                    <span class="badge-admin" style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalUsers</span>
                </h1>
                <div class="subtitle">مدیریت و مشاهده تمام کاربران سیستم</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshUsers"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
                <button class="btn-primary ripple" @onclick="CreateNewUser"><i class="fas fa-plus"></i> کاربر جدید</button>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی کاربر..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterStatus == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>همه</button>
                <button class="filter-btn @(filterStatus == "active" ? "active" : "")" @onclick='() => SetFilter("active")'>فعال</button>
                <button class="filter-btn @(filterStatus == "inactive" ? "active" : "")" @onclick='() => SetFilter("inactive")'>غیرفعال</button>
                <button class="filter-btn @(filterStatus == "pending" ? "active" : "")" @onclick='() => SetFilter("pending")'>در انتظار</button>
            </div>
            <div class="filter-group" style="margin-right:auto;">
                <button class="filter-btn @(filterRole == "all" ? "active" : "")" @onclick='() => SetRole("all")'>همه نقش‌ها</button>
                <button class="filter-btn @(filterRole == "admin" ? "active" : "")" @onclick='() => SetRole("admin")'>ادمین</button>
                <button class="filter-btn @(filterRole == "manager" ? "active" : "")" @onclick='() => SetRole("manager")'>مدیر</button>
                <button class="filter-btn @(filterRole == "user" ? "active" : "")" @onclick='() => SetRole("user")'>کاربر</button>
            </div>
        </div>

        <!-- Users Grid -->
        @if (isLoading)
        {
            <div style="text-align:center; padding:40px;">
                <i class="fas fa-spinner fa-spin" style="font-size:2rem; color:#e8a838;"></i>
                <p style="color:#94a3b8; margin-top:12px;">در حال بارگذاری...</p>
            </div>
        }
        else
        {
            <div class="users-grid">
                @foreach (var user in filteredUsers)
                {
                    <div class="user-row fade-up stagger-child">
                        <div class="avatar @user.AvatarClass">@user.Initials</div>
                        <div class="user-info">
                            <div class="name">@user.FullName</div>
                            <div class="email">@user.Email</div>
                        </div>
                        <span class="user-role @user.RoleClass">@user.RoleText</span>
                        <span class="user-status @user.StatusClass">@user.StatusText</span>
                        <div class="user-actions">
                            <button class="ripple" title="مشاهده" @onclick='() => ViewUser(user.Id)'><i class="fas fa-eye"></i></button>
                            <button class="ripple" title="ویرایش" @onclick='() => EditUser(user.Id)'><i class="fas fa-edit"></i></button>
                            <!-- دکمه تنظیم نقش (چندگانه) -->
                            <button class="ripple" title="تنظیم نقش" @onclick='() => OpenRoleModal(user)'><i class="fas fa-user-tag"></i></button>
                            <!-- دکمه ارسال ایمیل -->
                            <button class="ripple" title="ارسال ایمیل" @onclick='() => OpenEmailModal(user)'><i class="fas fa-envelope"></i></button>
                            @if (user.StatusClass == "active")
                            {
                                <button class="ripple block" title="مسدود کردن" @onclick='() => OpenBlockModal(user)'><i class="fas fa-ban"></i></button>
                            }
                            else
                            {
                                <button class="ripple" title="فعال کردن" @onclick='() => ActivateUser(user.Id)' style="color:#52b788;"><i class="fas fa-check-circle"></i></button>
                            }
                            <button class="ripple delete" title="حذف" @onclick='() => DeleteUser(user.Id)'><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                }
            </div>            
        }

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }

    </div>
</main>

<!-- ============================================================
MODAL: تنظیم نقش (چندگانه)
============================================================ -->
@if (isRoleModalOpen && selectedUserForRole != null)
{
    <div class="modal-overlay" @onclick="CloseRoleModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h2><i class="fas fa-user-tag"></i> تنظیم نقش‌ها</h2>
            <div class="sub">نقش‌های کاربر <strong>@selectedUserForRole.FullName</strong> را انتخاب کنید.</div>

            <div class="form-group">
                <label>نقش‌ها (چندگانه)</label>
                <div class="checkbox-group">
                    @foreach (var role in availableRoles)
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@selectedRoles.Contains(role)"
                                   @onchange="(e) => ToggleRole(role, e.Value)" />
                            @roleDisplay[role]
                        </label>
                    }
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseRoleModal">انصراف</button>
                <button class="btn-primary" @onclick="SaveRoles">ذخیره نقش‌ها</button>
            </div>
        </div>
    </div>
}

<!-- ============================================================
MODAL: ارسال ایمیل
============================================================ -->
@if (isEmailModalOpen && selectedUserForEmail != null)
{
    <div class="modal-overlay" @onclick="CloseEmailModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h2><i class="fas fa-envelope"></i> ارسال ایمیل</h2>
            <div class="sub">ارسال پیام به <strong>@selectedUserForEmail.FullName</strong></div>

            <div class="form-group">
                <label for="emailTo">گیرنده</label>
                <input id="emailTo" type="email" value="@selectedUserForEmail.Email" disabled />
            </div>

            <div class="form-group">
                <label for="emailSubject">موضوع</label>
                <input id="emailSubject" type="text" placeholder="موضوع پیام..." @bind="emailSubject" />
            </div>

            <div class="form-group">
                <label for="emailBody">متن پیام</label>
                <textarea id="emailBody" placeholder="متن ایمیل را وارد کنید..." @bind="emailBody"></textarea>
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseEmailModal">انصراف</button>
                <button class="btn-primary" @onclick="SendEmail">ارسال ایمیل</button>
            </div>
        </div>
    </div>
}

<!-- ============================================================
MODAL: غیرفعال‌سازی با تاریخ انقضا (شمسی)
============================================================ -->
@if (isBlockModalOpen && selectedUserForBlock != null)
{
    <div class="modal-overlay" @onclick="CloseBlockModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h2><i class="fas fa-ban"></i> مسدود کردن کاربر</h2>
            <div class="sub">مدت زمان مسدودیت برای <strong>@selectedUserForBlock.FullName</strong> را به صورت شمسی مشخص کنید.</div>

            <div class="form-group">
                <label>تاریخ انقضا (شمسی)</label>
                <div class="date-fields">
                    <input type="number" min="1300" max="1500" placeholder="سال" @bind="blockYear" />
                    <input type="number" min="1" max="12" placeholder="ماه" @bind="blockMonth" />
                    <input type="number" min="1" max="31" placeholder="روز" @bind="blockDay" />
                </div>
                <small style="color: rgba(232,240,241,0.3); display:block; margin-top:4px;">مثال: ۱۴۰۴/۰۵/۱۵</small>
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseBlockModal">انصراف</button>
                <button class="btn-primary" @onclick="ConfirmBlock">مسدود کن</button>
            </div>
        </div>
    </div>
}

@code {
    // ============================================================
    // STATE & DATA
    // ============================================================

    private bool isMenuOpen = false;
    private string searchTerm = "";
    private string filterStatus = "all";
    private string filterRole = "all";
    private int currentPage = 1;
    private int pageSize = 8;
    private int totalPages = 1;

    private List<UserItem> allUsers = new();
    private List<UserItem> filteredUsers = new();

    private int totalUsers => allUsers.Count;

    // ============================================================
    // MODAL STATE
    // ============================================================

    // نقش‌ها (چندگانه)
    private bool isRoleModalOpen = false;
    private UserItem? selectedUserForRole = null;
    private List<string> selectedRoles = new();
    private List<string> availableRoles { get; set; }
    private Dictionary<string, string> roleDisplay { get; set; }

    // ایمیل
    private bool isEmailModalOpen = false;
    private UserItem? selectedUserForEmail = null;
    private string emailSubject = "";
    private string emailBody = "";
    private List<RoleDto> roleDtos { get; set; }

    // مسدودسازی با تاریخ شمسی
    private bool isBlockModalOpen = false;
    private UserItem? selectedUserForBlock = null;
    private int blockYear = 1404;
    private int blockMonth = 1;
    private int blockDay = 1;


    private bool isLoading = true;

    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        try{
             roleDtos = await _roleFacade.GetAll();
             availableRoles = roleDtos.Select(i => i.Name).ToList();
             roleDisplay = roleDtos.ToDictionary(i => i.Name, i => i.Name);
             await GetUsers();

             ApplyFilters();
             // تنظیم تاریخ پیش‌فرض شمسی (امروز + ۷ روز)
             var now = DateTime.Now.AddDays(7);
             var persianCal = new PersianCalendar();
             blockYear = persianCal.GetYear(now);
             blockMonth = persianCal.GetMonth(now);
             blockDay = persianCal.GetDayOfMonth(now);
             isLoading = false;
             StateHasChanged();
           }
        catch (Exception ex)
        {
            Console.WriteLine($"خطا در بروزرسانی: {ex.Message}");
        }
    }

    private async Task GetUsers(int pageId = 1, int take = 8, string? search = null)
    {
        var getUsersFilterResult = await _userFacade.GetFilter(new BackEnd.Core.User.Queries.DTOs.UserFilterDto.UserFilterParam
        {
            PageId = pageId,
            Search = search,
            Take = take,
        });
        allUsers = getUsersFilterResult.Data.Select(i => new UserItem
        {
            Id = i.Id,
            FullName = i.FullName,
            Email = i.Email,
            AvatarClass = "",
            Initials = i.FullName.TrimStart()[0].ToString(),
            Roles = new List<string>(),
            JoinDate = i.CreationDate.ToPersianDateString(),
            StatusClass = i.UserBlackLists.Any(b => b.ExpireDate > DateTime.Now) ? "inactive" : "active",
            StatusText = i.UserBlackLists.Any(b => b.ExpireDate > DateTime.Now) ? "غیرفعال" : "فعال",
            BlockExpireDate = i.UserBlackLists.FirstOrDefault(b => b.ExpireDate > DateTime.Now)?.ExpireDate
        }).ToList();

        foreach (var user in allUsers)
        {
            UpdateUserRoleDisplay(user);
            if (user.BlockExpireDate.HasValue)
            {
                var persianCal = new PersianCalendar();
                var date = user.BlockExpireDate.Value;
                user.StatusText = $"غیرفعال تا {persianCal.GetYear(date)}/{persianCal.GetMonth(date):00}/{persianCal.GetDayOfMonth(date):00}";
            }
        }
    }

    private void UpdateUserRoleDisplay(UserItem user)
    {
        if (user.Roles == null || !user.Roles.Any())
        {
            user.RoleText = "بدون نقش";
            user.RoleClass = "";
            return;
        }

        var primaryRole = user.Roles.First();
        user.RoleText = roleDisplay.GetValueOrDefault(primaryRole, primaryRole);
        user.RoleClass = primaryRole switch
        {
            "admin" => "admin",
            "manager" => "manager",
            _ => "user"
        };
    }

    // ============================================================
    // FILTER & SEARCH
    // ============================================================

    private void ApplyFilters()
    {
        var query = allUsers.AsEnumerable();

        if (!string.IsNullOrEmpty(filterStatus) && filterStatus != "all")
        {
            query = query.Where(u => u.StatusClass == filterStatus);
        }

        if (!string.IsNullOrEmpty(filterRole) && filterRole != "all")
        {
            query = query.Where(u => u.Roles != null && u.Roles.Contains(filterRole));
        }

        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(u =>
                u.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        var total = query.Count();
        totalPages = (int)Math.Ceiling(total / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        filteredUsers = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SetFilter(string status)
    {
        filterStatus = status;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void SetRole(string role)
    {
        filterRole = role;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // UI METHODS
    // ============================================================

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    private void GoToProfile() => NavigationManager.NavigateTo("/Profile", true);
    private void CreateNewUser() => NavigationManager.NavigateTo("/NewUser", true);
    private async Task RefreshUsers()
    {
        await GetUsers();
        ApplyFilters();
        StateHasChanged();
    }

    private void ViewUser(Guid id) => NavigationManager.NavigateTo($"/Admin/User/Detail/{id}", true);
    private void EditUser(Guid id) => NavigationManager.NavigateTo($"/Admin/User/Edit/{id}", true);
    private void DeleteUser(Guid id)
    {
        allUsers.RemoveAll(u => u.Id == id);
        ApplyFilters();
        StateHasChanged();
    }

    private void ActivateUser(Guid id)
    {
        var user = allUsers.FirstOrDefault(u => u.Id == id);
        if (user != null)
        {
            user.StatusClass = "active";
            user.StatusText = "فعال";
            user.BlockExpireDate = null;
            ApplyFilters();
            StateHasChanged();
        }
    }

    // ============================================================
    // MODAL: نقش‌های چندگانه
    // ============================================================

    private void OpenRoleModal(UserItem user)
    {
        selectedUserForRole = user;
        selectedRoles = user.Roles?.ToList() ?? new List<string>();
        isRoleModalOpen = true;
        StateHasChanged();
    }

    private void CloseRoleModal()
    {
        isRoleModalOpen = false;
        selectedUserForRole = null;
        StateHasChanged();
    }

    private void ToggleRole(string role, object? checkedValue)
    {
        if (checkedValue is bool isChecked)
        {
            if (isChecked && !selectedRoles.Contains(role))
                selectedRoles.Add(role);
            else if (!isChecked && selectedRoles.Contains(role))
                selectedRoles.Remove(role);
        }
    }

    private void SaveRoles()
    {
        if (selectedUserForRole == null) return;

        selectedUserForRole.Roles = selectedRoles.Distinct().ToList();
        UpdateUserRoleDisplay(selectedUserForRole);
        var rolesSelect = roleDtos.Where(i => selectedRoles.Contains(i.Name)).Select(i => i.Id).ToList();
        var result = _userFacade.SetUserRole(new BackEnd.Core.User.Commands.SetUserRole.SetUserRoleCommand
        {
            UserId = selectedUserForRole.Id,
            RoleIds = rolesSelect
        });
        CloseRoleModal();
        ApplyFilters();
    }

    // ============================================================
    // MODAL: ایمیل
    // ============================================================

    private void OpenEmailModal(UserItem user)
    {
        selectedUserForEmail = user;
        emailSubject = "";
        emailBody = "";
        isEmailModalOpen = true;
        StateHasChanged();
    }

    private void CloseEmailModal()
    {
        isEmailModalOpen = false;
        selectedUserForEmail = null;
        StateHasChanged();
    }

    private async Task SendEmail()
    {
        if (selectedUserForEmail == null) return;

        await JSRuntime.InvokeVoidAsync("alert", $"ایمیل به {selectedUserForEmail.Email} ارسال شد.\nموضوع: {emailSubject}\nمتن: {emailBody}");

        CloseEmailModal();
    }

    // ============================================================
    // MODAL: مسدودسازی با تاریخ شمسی
    // ============================================================

    private void OpenBlockModal(UserItem user)
    {
        selectedUserForBlock = user;
        // مقداردهی پیش‌فرض: امروز + ۷ روز به صورت شمسی
        var now = DateTime.Now.AddDays(7);
        var persianCal = new PersianCalendar();
        blockYear = persianCal.GetYear(now);
        blockMonth = persianCal.GetMonth(now);
        blockDay = persianCal.GetDayOfMonth(now);
        isBlockModalOpen = true;
        StateHasChanged();
    }

    private void CloseBlockModal()
    {
        isBlockModalOpen = false;
        selectedUserForBlock = null;
        StateHasChanged();
    }

    private void ConfirmBlock()
    {
        if (selectedUserForBlock == null) return;

        try
        {
            // تبدیل تاریخ شمسی به میلادی
            var persianCal = new PersianCalendar();
            var expireDate = persianCal.ToDateTime(blockYear, blockMonth, blockDay, 23, 59, 59, 0);

            if (expireDate <= DateTime.Now)
            {
                JSRuntime.InvokeVoidAsync("alert", "تاریخ انقضا باید بزرگتر از زمان فعلی باشد.");
                return;
            }

            selectedUserForBlock.StatusClass = "inactive";
            selectedUserForBlock.BlockExpireDate = expireDate;
            selectedUserForBlock.StatusText = $"غیرفعال تا {blockYear}/{blockMonth:00}/{blockDay:00}";

            CloseBlockModal();
            ApplyFilters();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            JSRuntime.InvokeVoidAsync("alert", $"خطا در تبدیل تاریخ: {ex.Message}");
        }
    }

    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
                  roleDtos = await _roleFacade.GetAll();
             availableRoles = roleDtos.Select(i => i.Name).ToList();
             roleDisplay = roleDtos.ToDictionary(i => i.Name, i => i.Name);
             await GetUsers();

             ApplyFilters();
             // تنظیم تاریخ پیش‌فرض شمسی (امروز + ۷ روز)
             var now = DateTime.Now.AddDays(7);
             var persianCal = new PersianCalendar();
             blockYear = persianCal.GetYear(now);
             blockMonth = persianCal.GetMonth(now);
             blockDay = persianCal.GetDayOfMonth(now);
             isLoading = false;
            await InitializeJsInterop();
            StateHasChanged();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Navbar scroll
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 30);
            });

            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Fade-up observer
            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 });

            fadeEls.forEach(el => observer.observe(el));

            setTimeout(() => {
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                    }
                });
            }, 300);
        ");
    }

