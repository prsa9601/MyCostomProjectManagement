<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-plug"></i>
                    مدیریت APIها
                    <span class="badge-admin" style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalApis</span>
                </h1>
                <div class="subtitle">مدیریت APIها، قیمت‌گذاری تکی و اشتراکی</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshApis"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="stats-row fade-up visible">
            <div class="stat-mini">
                <i class="fas fa-plug"></i>
                <div class="info">
                    <div class="number">@totalApis</div>
                    <div class="label">کل APIها</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-check-circle" style="color:#52b788;"></i>
                <div class="info">
                    <div class="number">@activeCount</div>
                    <div class="label">فعال</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-tag" style="color:#e8a838;"></i>
                <div class="info">
                    <div class="number">@withSinglePriceCount</div>
                    <div class="label">دارای قیمت تکی</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-calendar-alt" style="color:#8264c8;"></i>
                <div class="info">
                    <div class="number">@withSubscriptionCount</div>
                    <div class="label">دارای اشتراک</div>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی API..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterStatus == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>همه</button>
                <button class="filter-btn @(filterStatus == "active" ? "active" : "")" @onclick='() => SetFilter("active")'>فعال</button>
                <button class="filter-btn @(filterStatus == "inactive" ? "active" : "")" @onclick='() => SetFilter("inactive")'>غیرفعال</button>
                <button class="filter-btn @(filterStatus == "maintenance" ? "active" : "")" @onclick='() => SetFilter("maintenance")'>در بروزرسانی</button>
            </div>
        </div>

        <!-- Add API Form -->
        <div class="add-form fade-up visible">
            <div class="form-title">
                <i class="fas fa-plus-circle"></i>
                افزودن API جدید
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>نام API</label>
                    <input type="text" placeholder="مثال: Payment Gateway" @bind="newName" />
                </div>
                <div class="form-group">
                    <label>پروژه مرتبط</label>
                    <input type="text" placeholder="مثال: پروژه فروشگاهی" @bind="newProject" />
                </div>
                <div class="form-group">
                    <label>وضعیت</label>
                    <select @bind="newStatus">
                        <option value="active">فعال</option>
                        <option value="inactive">غیرفعال</option>
                        <option value="maintenance">در بروزرسانی</option>
                    </select>
                </div>
                <button class="btn-add ripple" @onclick="AddApi"><i class="fas fa-plus"></i> افزودن</button>
            </div>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr 1fr; margin-top:0;">
                <div class="form-group">
                    <label>قیمت تکی (تومان)</label>
                    <input type="number" placeholder="مثال: 250000" @bind="newSinglePrice" />
                </div>
                <div class="form-group">
                    <label>قیمت اشتراک ماهانه (تومان)</label>
                    <input type="number" placeholder="مثال: 150000" @bind="newSubscriptionPrice" />
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label>توضیحات</label>
                    <input type="text" placeholder="توضیحات کوتاه..." @bind="newDescription" />
                </div>
            </div>
        </div>

        <!-- API Grid -->
        @if (filteredApis.Any())
        {
            <div class="api-grid">
                @foreach (var api in filteredApis)
                {
                    <div class="api-card status-@api.Status fade-up stagger-child">
                        <div class="card-header">
                            <div class="title-group">
                                <div class="api-name">@api.Name</div>
                                <div class="api-project"><i class="fas fa-folder"></i> @api.Project</div>
                            </div>
                            <span class="status-badge @api.Status">
                                @(api.Status == "active" ? "فعال" : api.Status == "inactive" ? "غیرفعال" : "در بروزرسانی")
                            </span>
                        </div>

                        <div class="card-body">
                            @api.Description
                        </div>

                        <div class="card-pricing">
                            <div class="price-item">
                                <div class="amount">@(api.SinglePrice > 0 ? api.SinglePrice.ToString("N0") + " تومان" : "—")</div>
                                <span class="label">خرید تکی</span>
                            </div>
                            <div class="price-item">
                                <div class="amount subscribe">@(api.SubscriptionPrice > 0 ? api.SubscriptionPrice.ToString("N0") + " تومان" : "—")</div>
                                <span class="label">اشتراک ماهانه</span>
                            </div>
                        </div>

                        <div class="card-actions">
                            <div class="buy-group">
                                @if (api.SinglePrice > 0 && api.Status == "active")
                                {
                                    <button class="btn-buy ripple" @onclick='() => BuySingle(api.Id)'><i class="fas fa-shopping-cart"></i> خرید تکی</button>
                                }
                                @if (api.SubscriptionPrice > 0 && api.Status == "active")
                                {
                                    <button class="btn-subscribe ripple" @onclick='() => Subscribe(api.Id)'><i class="fas fa-calendar-alt"></i> اشتراک</button>
                                }
                            </div>
                            <div class="manage-group">
                                <button class="edit ripple" title="ویرایش" @onclick='() => ToggleEdit(api.Id)'><i class="fas fa-edit"></i></button>
                                <button class="delete ripple" title="حذف" @onclick='() => DeleteApi(api.Id)'><i class="fas fa-trash-alt"></i></button>
                            </div>
                        </div>

                        <!-- Edit Mode -->
                        <div class="edit-mode @(editingId == api.Id ? "active" : "")">
                            <input type="text" @bind="editName" placeholder="نام API" />
                            <input type="text" @bind="editProject" placeholder="پروژه مرتبط" />
                            <select @bind="editStatus">
                                <option value="active">فعال</option>
                                <option value="inactive">غیرفعال</option>
                                <option value="maintenance">در بروزرسانی</option>
                            </select>
                            <input type="number" @bind="editSinglePrice" placeholder="قیمت تکی" />
                            <input type="number" @bind="editSubscriptionPrice" placeholder="قیمت اشتراک" />
                            <input type="text" @bind="editDescription" placeholder="توضیحات" />
                            <div class="edit-actions">
                                <button class="save-edit ripple" @onclick='() => SaveEdit(api.Id)'><i class="fas fa-check"></i> ذخیره</button>
                                <button class="cancel-edit ripple" @onclick='() => CancelEdit()'><i class="fas fa-times"></i> لغو</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state fade-up visible">
                <i class="fas fa-plug"></i>
                <h3>هیچ APIای یافت نشد</h3>
                <p>با تغییر فیلترها یا افزودن API جدید، نتایج را مشاهده کنید</p>
            </div>
        }

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }

    </div>
</main>

