    private void AddApi()
    {
        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newProject)) return;

        var newApi = new ApiItem
        {
            Id = "API-" + (allApis.Count + 1).ToString("D3"),
            Name = newName.Trim(),
            Project = newProject.Trim(),
            Status = newStatus,
            Description = string.IsNullOrWhiteSpace(newDescription) ? "بدون توضیحات" : newDescription.Trim(),
            SinglePrice = newSinglePrice,
            SubscriptionPrice = newSubscriptionPrice
        };

        allApis.Add(newApi);
        newName = "";
        newProject = "";
        newDescription = "";
        newSinglePrice = 0;
        newSubscriptionPrice = 0;
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleEdit(string id)
    {
        var api = allApis.FirstOrDefault(a => a.Id == id);
        if (api == null) return;

        if (editingId == id)
        {
            CancelEdit();
            return;
        }

        editingId = id;
        editName = api.Name;
        editProject = api.Project;
        editStatus = api.Status;
        editDescription = api.Description;
        editSinglePrice = api.SinglePrice;
        editSubscriptionPrice = api.SubscriptionPrice;
        StateHasChanged();
    }

    private void SaveEdit(string id)
    {
        var api = allApis.FirstOrDefault(a => a.Id == id);
        if (api == null) return;

        if (!string.IsNullOrWhiteSpace(editName))
            api.Name = editName.Trim();
        if (!string.IsNullOrWhiteSpace(editProject))
            api.Project = editProject.Trim();
        api.Status = editStatus;
        api.Description = string.IsNullOrWhiteSpace(editDescription) ? "بدون توضیحات" : editDescription.Trim();
        api.SinglePrice = editSinglePrice;
        api.SubscriptionPrice = editSubscriptionPrice;

        CancelEdit();
        ApplyFilters();
        StateHasChanged();
    }

    private void CancelEdit()
    {
        editingId = null;
        editName = "";
        editProject = "";
        editStatus = "active";
        editDescription = "";
        editSinglePrice = 0;
        editSubscriptionPrice = 0;
        StateHasChanged();
    }

    private void DeleteApi(string id)
    {
        allApis.RemoveAll(a => a.Id == id);
        if (editingId == id) CancelEdit();
        ApplyFilters();
        StateHasChanged();
    }

