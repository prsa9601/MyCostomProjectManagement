============================================================ -->
<footer class="footer">
    <div class="container">
        <div class="footer-copy">© ۲۰۲۶ محمد رضایی · <i class="fas fa-heart"></i> مدیریت APIها</div>
        <div class="footer-links">
            <a href="/AdminDashboard">داشبورد</a>
            <a href="/Projects">پروژه‌ها</a>
            <a href="/Users">کاربران</a>
            <a href="/ApiManagement">APIها</a>
            <a href="/Requests">درخواست‌ها</a>
            <a href="/Contacts">تماس</a>
            <a href="/Skills">مهارت‌ها</a>
            <a href="/Portfolio">نمونه کارها</a>
            <a href="/Settings">تنظیمات</a>
        </div>
    </div>
</footer>

@code {
