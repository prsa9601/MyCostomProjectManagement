    // ============================================================
    // FILTER & SEARCH
    // ============================================================

    private void ApplyFilters()
    {
        var query = allApis.AsEnumerable();

        // Filter by status
        if (!string.IsNullOrEmpty(filterStatus) && filterStatus != "all")
        {
            query = query.Where(a => a.Status == filterStatus);
        }

        // Search
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(a =>
                a.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                a.Project.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                a.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                a.Id.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        // Pagination
        var total = query.Count();
        totalPages = (int)Math.Ceiling(total / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        filteredApis = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SetFilter(string status)
    {
        filterStatus = status;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyFilters();
        StateHasChanged();
    }

