<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-crown"></i>
                    اشتراک‌ها
                    <span style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalSubs</span>
                </h1>
                <div class="subtitle">مدیریت پلن‌ها و اشتراک‌های کاربران</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshSubs"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
                <button class="btn-primary ripple" @onclick="OpenCreateModal"><i class="fas fa-plus"></i> اشتراک جدید</button>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی اشتراک..." @bind="searchTerm" @bind:event="oninput" @bind:after="OnSearchChanged" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterActive == "all" ? "active" : "")" @onclick='() => SetActiveFilter("all")'>همه</button>
                <button class="filter-btn @(filterActive == "active" ? "active" : "")" @onclick='() => SetActiveFilter("active")'>فعال</button>
                <button class="filter-btn @(filterActive == "inactive" ? "active" : "")" @onclick='() => SetActiveFilter("inactive")'>غیرفعال</button>
            </div>
        </div>

        <!-- Subscriptions Grid -->
        @if (isLoading)
        {
            <div style="text-align:center; padding:60px;">
                <i class="fas fa-spinner fa-spin" style="font-size:2rem; color:#e8a838;"></i>
                <p style="color:#94a3b8; margin-top:12px;">در حال بارگذاری...</p>
            </div>
        }
        else if (subscriptions.Count == 0)
        {
            <div class="empty-state fade-up visible">
                <i class="fas fa-inbox"></i>
                <p>هیچ اشتراکی یافت نشد.</p>
            </div>
        }
        else
        {
            <div class="subs-grid">
                @foreach (var sub in subscriptions)
                {
                    <div class="sub-card fade-up stagger-child">
                        <div class="card-head">
                            <div class="title">
                                <div class="icon @GetIconColorClass(sub.Type)">
                                    <i class="fas @GetTypeIcon(sub.Type)"></i>
                                </div>
                                <div class="info">
                                    <div class="name">@sub.SubscriptionFor</div>
                                    <div class="desc">@(string.IsNullOrWhiteSpace(sub.Description) ? "بدون توضیحات" : sub.Description)</div>
                                </div>
                            </div>
                            <span class="status @(sub.IsActive ? "active" : "inactive")">
                                @(sub.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </div>

                        <!-- نوع اشتراک -->
                        <span class="type-badge">
                            <i class="fas fa-tag"></i>
                            @GetTypeText(sub.Type)
                        </span>

                        <!-- قیمت -->
                        <div class="price-row">
                            <span class="price-label">
                                <i class="fas fa-coins"></i>
                                قیمت اشتراک
                            </span>
                            @if (sub.Price <= 0)
                            {
                                <span class="price-value free">رایگان</span>
                            }
                            else
                            {
                                <span class="price-value">@sub.Price.ToString("N0") <small>تومان</small></span>
                            }
                        </div>

                        <!-- آمار -->
                        <div class="stats">
                            <div class="stat-pill">
                                <span class="label">توکن</span>
                                <span class="value">@sub.Token.ToString("N0")</span>
                            </div>
                            <div class="stat-pill green">
                                <span class="label">کاربران</span>
                                <span class="value">@(sub.SubscriptionUserDtos?.Count ?? 0)</span>
                            </div>
                            <div class="stat-pill purple">
                                <span class="label">مصرف‌شده</span>
                                <span class="value">@(sub.SubscriptionUserDtos?.Sum(x => x.UsedToken) ?? 0)</span>
                            </div>
                        </div>

                        <div class="card-actions">
                            <button class="ripple" title="ویرایش" @onclick='() => OpenEditModal(sub)'><i class="fas fa-edit"></i></button>
                            <button class="ripple" title="اختصاص به کاربر" @onclick='() => OpenAssignModal(sub)'><i class="fas fa-user-plus"></i></button>
                            <button class="ripple delete" title="حذف" @onclick='() => OpenDeleteModal(sub)'><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }
    </div>
</main>

<!-- ============================================================
     MODAL: ایجاد / ویرایش اشتراک
============================================================ -->
@if (isFormModalOpen)
{
    <div class="modal-overlay" @onclick="CloseFormModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h2>
                <i class="fas @(isEditMode ? "fa-edit" : "fa-plus-circle")"></i>
                @(isEditMode ? "ویرایش اشتراک" : "ایجاد اشتراک جدید")
            </h2>
            <div class="sub">
                @(isEditMode ? "اطلاعات اشتراک را ویرایش کنید." : "اطلاعات اشتراک جدید را وارد کنید.")
            </div>

            <div class="form-group">
                <label>عنوان اشتراک <span class="required">*</span></label>
                <input type="text" placeholder="مثلاً: پلن طلایی" @bind="formSubscriptionFor" />
            </div>

            <div class="form-group">
                <label>توضیحات</label>
                <textarea placeholder="توضیحات اختیاری..." @bind="formDescription"></textarea>
            </div>

            <div class="form-group">
                <label>نوع اشتراک</label>
                <select @bind="formType">
                    @foreach (var t in availableTypes)
                    {
                        <option value="@((int)t)">@GetTypeText(t)</option>
                    }
                </select>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>تعداد توکن</label>
                    <input type="number" min="0" @bind="formToken" />
                </div>

                <div class="form-group">
                    <label>قیمت اشتراک</label>
                    <div class="price-input-wrap">
                        <span class="currency-tag">تومان</span>
                        <input type="number" min="0" step="1000" placeholder="0" @bind="formPrice" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="switch-row">
                    <span class="sw-label">وضعیت فعال</span>
                    <label class="switch">
                        <input type="checkbox" @bind="formIsActive" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseFormModal">انصراف</button>
                <button class="btn-primary" @onclick="SaveForm" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fas fa-spinner fa-spin"></i> <text>در حال ذخیره...</text>
                    }
                    else
                    {
                        <i class="fas fa-save"></i> <text>ذخیره</text>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================================
     MODAL: اختصاص اشتراک به کاربر
============================================================ -->
@if (isAssignModalOpen && selectedSubForAssign != null)
{
    <div class="modal-overlay" @onclick="CloseAssignModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h2><i class="fas fa-user-plus"></i> اختصاص اشتراک</h2>
            <div class="sub">
                اشتراک <strong>@selectedSubForAssign.SubscriptionFor</strong> به کاربر اختصاص داده می‌شود.
            </div>

            <div class="form-group">
                <label>شناسه کاربر (UserId)</label>
                <input type="text" placeholder="Guid کاربر..." @bind="assignUserId" />
                <small style="color: rgba(232,240,241,0.35); display:block; margin-top:6px;">
                    شناسه Guid کاربر مورد نظر را وارد کنید.
                </small>
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseAssignModal">انصراف</button>
                <button class="btn-primary" @onclick="ConfirmAssign" disabled="@isSaving">
                    <i class="fas fa-check"></i> اختصاص بده
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================================
     MODAL: حذف اشتراک
============================================================ -->
@if (isDeleteModalOpen && selectedSubForDelete != null)
{
    <div class="modal-overlay" @onclick="CloseDeleteModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <h2 style="color:#dc3545;"><i class="fas fa-exclamation-triangle" style="color:#dc3545;"></i> حذف اشتراک</h2>
            <div class="sub">
                آیا از حذف اشتراک <strong>@selectedSubForDelete.SubscriptionFor</strong> مطمئن هستید؟
                این عملیات قابل بازگشت نیست.
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseDeleteModal">انصراف</button>
                <button class="btn-primary" style="background: linear-gradient(135deg,#dc3545,#b02a37);" @onclick="ConfirmDelete" disabled="@isSaving">
                    <i class="fas fa-trash"></i> حذف کن
                </button>
            </div>
        </div>
    </div>
}

@code {
    // ============================================================
    // STATE
    // ============================================================
    private string searchTerm = "";
    private string filterActive = "all";
    private int currentPage = 1;
    private int pageSize = 8;
    private int totalPages = 1;
    private int totalItems = 0;
    private int totalSubs => totalItems;

    private List<SubscriptionDto> subscriptions = new();
    private List<BackEnd.Data.Entities.Subscription.SubscriptionType> availableTypes
        = Enum.GetValues<SubscriptionType>().Cast<SubscriptionType>().ToList();

    private bool isLoading = true;
    private bool isSaving = false;

    // Form modal
    private bool isFormModalOpen = false;
    private bool isEditMode = false;
    private Guid editingId = Guid.Empty;
    private string formSubscriptionFor = "";
    private string? formDescription = "";
    private int formType = 0;
    private int formToken = 0;
    private int formPrice = 0;
    private bool formIsActive = true;

    // Assign modal
    private bool isAssignModalOpen = false;
    private SubscriptionDto? selectedSubForAssign = null;
    private string assignUserId = "";

    // Delete modal
    private bool isDeleteModalOpen = false;
    private SubscriptionDto? selectedSubForDelete = null;

    // ============================================================
    // INIT
    // ============================================================
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadData()
    {
        try
        {
            var filter = new SubscriptionFilterParam
            {
                PageId = currentPage,
                Take = pageSize,
                Search = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                IsActive = filterActive switch
                {
                    "active" => true,
                    "inactive" => false,
                    _ => null
                }
            };

            var result = await _subscriptionFacade.GetFilter(filter);
            subscriptions = result?.Data ?? new List<SubscriptionDto>();

            // در صورتی که BaseFilter فیلد Paging داشته باشد، اینجا totalItems ست می‌شود
            // totalItems = result?.Total ?? subscriptions.Count;
            totalItems = subscriptions.Count;
            totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
            if (totalPages < 1) totalPages = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطا در بارگذاری اشتراک‌ها: {ex.Message}");
        }
    }

    // ============================================================
    // FILTERS
    // ============================================================
    private async Task OnSearchChanged()
    {
        currentPage = 1;
        await LoadData();
        StateHasChanged();
    }

    private async Task SetActiveFilter(string value)
    {
        filterActive = value;
        currentPage = 1;
        await LoadData();
        StateHasChanged();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadData();
        StateHasChanged();
    }

    private async Task RefreshSubs()
    {
        await LoadData();
        StateHasChanged();
    }

    // ============================================================
    // FORM MODAL
    // ============================================================
    private void OpenCreateModal()
    {
        isEditMode = false;
        editingId = Guid.Empty;
        formSubscriptionFor = "";
        formDescription = "";
        formType = availableTypes.FirstOrDefault() is var first ? Convert.ToInt32(first) : 0;
        formToken = 100;
        formPrice = 0;
        formIsActive = true;
        isFormModalOpen = true;
        StateHasChanged();
    }

    private void OpenEditModal(SubscriptionDto sub)
    {
        isEditMode = true;
        editingId = sub.Id;
        formSubscriptionFor = sub.SubscriptionFor;
        formDescription = sub.Description;
        formType = Convert.ToInt32(sub.Type);
        formToken = sub.Token;
        formPrice = sub.Price;
        formIsActive = sub.IsActive;
        isFormModalOpen = true;
        StateHasChanged();
    }

    private void CloseFormModal()
    {
        isFormModalOpen = false;
        StateHasChanged();
    }

    private async Task SaveForm()
    {
        if (string.IsNullOrWhiteSpace(formSubscriptionFor))
        {
            await JSRuntime.InvokeVoidAsync("alert", "عنوان اشتراک الزامی است.");
            return;
        }

        if (formToken < 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "تعداد توکن نمی‌تواند منفی باشد.");
            return;
        }

        if (formPrice < 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "قیمت نمی‌تواند منفی باشد.");
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            var result = isEditMode
                ? await _subscriptionFacade.Edit(editingId, formSubscriptionFor, formDescription, formType, formToken, formIsActive, formPrice)
                : await _subscriptionFacade.Create(formSubscriptionFor, formDescription, formType, formToken, formIsActive, formPrice);

            if (result != null && result.Status == BackEnd.Shared.CoreShared.OperationResultStatus.Success)
            {
                CloseFormModal();
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"خطا: {result?.Message ?? "عملیات با خطا مواجه شد"}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطای غیرمنتظره: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // ASSIGN MODAL
    // ============================================================
    private void OpenAssignModal(SubscriptionDto sub)
    {
        selectedSubForAssign = sub;
        assignUserId = "";
        isAssignModalOpen = true;
        StateHasChanged();
    }

    private void CloseAssignModal()
    {
        isAssignModalOpen = false;
        selectedSubForAssign = null;
        StateHasChanged();
    }

    private async Task ConfirmAssign()
    {
        if (selectedSubForAssign == null) return;

        if (!Guid.TryParse(assignUserId, out var userId))
        {
            await JSRuntime.InvokeVoidAsync("alert", "شناسه کاربر نامعتبر است.");
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            var result = await _subscriptionFacade.AssignToUser(userId, selectedSubForAssign.Id);
            if (result != null && result.Status == BackEnd.Shared.CoreShared.OperationResultStatus.Success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "اشتراک با موفقیت به کاربر اختصاص داده شد.");
                CloseAssignModal();
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"خطا: {result?.Message ?? "عملیات ناموفق"}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // DELETE MODAL
    // ============================================================
    private void OpenDeleteModal(SubscriptionDto sub)
    {
        selectedSubForDelete = sub;
        isDeleteModalOpen = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        selectedSubForDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (selectedSubForDelete == null) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            var result = await _subscriptionFacade.Remove(selectedSubForDelete.Id);
            if (result != null && result.Status == BackEnd.Shared.CoreShared.OperationResultStatus.Success)
            {
                CloseDeleteModal();
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"خطا: {result?.Message ?? "حذف ناموفق"}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // HELPERS
    // ============================================================
    private string GetTypeText(BackEnd.Data.Entities.Subscription.SubscriptionType type) => type switch
    {
        // اگر enum شما مقادیر خاصی دارد اینجا نگاشت کنید
        // مثال:
        // BackEnd.Data.Entities.Subscription.SubscriptionType.Monthly => "ماهانه",
        // BackEnd.Data.Entities.Subscription.SubscriptionType.Yearly => "سالانه",
        _ => type.ToString()
    };

    private string GetTypeIcon(BackEnd.Data.Entities.Subscription.SubscriptionType type) => type switch
    {
        // نگاشت نمونه - بر اساس نام enum
        _ => "fa-cube"
    };

    private string GetIconColorClass(BackEnd.Data.Entities.Subscription.SubscriptionType type) => type switch
    {
        _ => ""
    };

    // ============================================================
    // JS INTEROP
    // ============================================================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            await InitializeJsInterop();
            StateHasChanged();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            document.querySelectorAll('.ripple').forEach(btn => {
                if (btn.dataset.rippleBound) return;
                btn.dataset.rippleBound = '1';
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('visible');
                });
            }, { threshold: 0.15 });
            fadeEls.forEach(el => observer.observe(el));

            setTimeout(() => {
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight)
                        el.classList.add('visible');
                });
            }, 200);
        ");
    }
}