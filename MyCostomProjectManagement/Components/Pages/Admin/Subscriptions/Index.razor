@page "/Admin/Subscriptions"
@using System.Globalization
@using BackEnd.Core.Subscription.DTOs
@using BackEnd.Data.Entities.Subscription
@using MyCostomProjectManagement.Facade.Subscription
@layout AdminLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ISubscriptionFacade _subscriptionFacade

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>مدیریت اشتراک‌ها | پنل ادمین</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
                           SUBSCRIPTIONS PAGE - با پس‌زمینه #13505b
                        ============================================================ */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* GLASS EFFECT */
    .glass {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    /* ANIMATIONS */
    @@keyframes float {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-10px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .float-anim {
        animation: float 4s ease-in-out infinite;
    }

    @@keyframes rotateBorder {
        0% {
            background-position: 0% 50%;
        }

        100% {
            background-position: 400% 50%;
        }
    }

    .gradient-border {
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        background-clip: padding-box;
    }

        .gradient-border::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 22px;
            background: conic-gradient(from 0deg, #e8a838, #52b788, #1a7a8a, #e8a838, #52b788);
            background-size: 400% 400%;
            animation: rotateBorder 8s linear infinite;
            opacity: 0.2;
            transition: opacity 0.4s;
        }

        .gradient-border:hover::before {
            opacity: 0.5;
        }

    @@keyframes shimmer {
        0% {
            background-position: -200% center;
        }

        100% {
            background-position: 200% center;
        }
    }

    .shimmer-text {
        background: linear-gradient(90deg, #e8f0f1, #e8a838, #52b788, #e8f0f1);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmer 6s linear infinite;
        display: inline-block;
    }

    /* Ripple */
    .ripple {
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* Fade Up */
    .fade-up {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.2, 0.9, 0.3, 1), transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .stagger-child {
        transition-delay: 0s;
    }

        .stagger-child:nth-child(1) {
            transition-delay: 0.05s;
        }

        .stagger-child:nth-child(2) {
            transition-delay: 0.1s;
        }

        .stagger-child:nth-child(3) {
            transition-delay: 0.15s;
        }

        .stagger-child:nth-child(4) {
            transition-delay: 0.2s;
        }

        .stagger-child:nth-child(5) {
            transition-delay: 0.25s;
        }

        .stagger-child:nth-child(6) {
            transition-delay: 0.3s;
        }

    /* Sparkle */
    .sparkle {
        position: fixed;
        width: 4px;
        height: 4px;
        background: rgba(232, 168, 56, 0.2);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        animation: sparkleAnim 10s infinite alternate ease-in-out;
    }

    @@keyframes sparkleAnim {
        0% {
            transform: translate(0, 0) scale(1);
            opacity: 0.1;
        }

        50% {
            transform: translate(20px, -30px) scale(1.8);
            opacity: 0.6;
        }

        100% {
            transform: translate(-10px, 20px) scale(0.6);
            opacity: 0.05;
        }
    }

    .sparkle:nth-child(1) {
        left: 5%;
        top: 20%;
        animation-duration: 12s;
    }

    .sparkle:nth-child(2) {
        left: 85%;
        top: 60%;
        animation-duration: 14s;
        animation-delay: 2s;
        width: 6px;
        height: 6px;
    }

    .sparkle:nth-child(3) {
        left: 30%;
        top: 70%;
        animation-duration: 16s;
        animation-delay: 4s;
    }

    .sparkle:nth-child(4) {
        left: 92%;
        top: 30%;
        animation-duration: 11s;
        animation-delay: 1s;
        width: 5px;
        height: 5px;
        background: rgba(82, 183, 136, 0.15);
    }

    .sparkle:nth-child(5) {
        left: 50%;
        top: 90%;
        animation-duration: 18s;
        animation-delay: 3s;
    }

    .sparkle:nth-child(6) {
        left: 3%;
        top: 50%;
        animation-duration: 13s;
        animation-delay: 5s;
        background: rgba(232, 168, 56, 0.15);
    }

    /* ============================================================
                           PAGE HEADER
                        ============================================================ */
    .page-header {
        padding-top: 100px;
        padding-bottom: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .page-header h1 i {
                color: #e8a838;
            }

        .page-header .subtitle {
            color: rgba(232, 240, 241, 0.5);
            font-size: 0.9rem;
            margin-top: 4px;
        }

        .page-header .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

    /* ============================================================
                           FILTER BAR
                        ============================================================ */
    .filter-bar {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 32px;
        padding: 16px 24px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        align-items: center;
    }

        .filter-bar .search-box {
            flex: 1;
            min-width: 200px;
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 0 16px;
            transition: all 0.35s ease;
        }

            .filter-bar .search-box:focus-within {
                border-color: #e8a838;
                background: rgba(255, 255, 255, 0.04);
                box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
            }

            .filter-bar .search-box input {
                background: transparent;
                border: none;
                padding: 12px 12px;
                color: #e8f0f1;
                font-size: 0.9rem;
                width: 100%;
                outline: none;
            }

                .filter-bar .search-box input::placeholder {
                    color: rgba(232, 240, 241, 0.3);
                }

            .filter-bar .search-box i {
                color: rgba(232, 240, 241, 0.2);
                font-size: 0.9rem;
            }

        .filter-bar .filter-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .filter-bar .filter-group .filter-btn {
                padding: 8px 18px;
                border-radius: 40px;
                border: 1px solid rgba(255, 255, 255, 0.04);
                background: rgba(255, 255, 255, 0.02);
                color: rgba(232, 240, 241, 0.4);
                font-size: 0.8rem;
                font-weight: 500;
                transition: all 0.35s ease;
                cursor: pointer;
            }

                .filter-bar .filter-group .filter-btn:hover {
                    border-color: rgba(232, 168, 56, 0.1);
                    color: #e8f0f1;
                }

                .filter-bar .filter-group .filter-btn.active {
                    background: rgba(232, 168, 56, 0.08);
                    border-color: rgba(232, 168, 56, 0.1);
                    color: #e8a838;
                }

    /* ============================================================
                           SUBSCRIPTIONS GRID
                        ============================================================ */
    .subs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .sub-card {
        position: relative;
        padding: 22px 22px 18px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

        .sub-card:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(232, 168, 56, 0.08);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
        }

        .sub-card .card-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

            .sub-card .card-head .title {
                display: flex;
                align-items: center;
                gap: 10px;
                flex: 1;
            }

            .sub-card .card-head .icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #e8a838, #d4952e);
                color: #fff;
                font-size: 1rem;
                flex-shrink: 0;
            }

                .sub-card .card-head .icon.green {
                    background: linear-gradient(135deg, #52b788, #1a7a8a);
                }

                .sub-card .card-head .icon.purple {
                    background: linear-gradient(135deg, #8264c8, #6a4fa8);
                }

                .sub-card .card-head .icon.blue {
                    background: linear-gradient(135deg, #1a7a8a, #13505b);
                }

            .sub-card .card-head .info .name {
                font-size: 1rem;
                font-weight: 700;
                color: #ffffff;
                line-height: 1.4;
            }

            .sub-card .card-head .info .desc {
                font-size: 0.78rem;
                color: rgba(232, 240, 241, 0.4);
                margin-top: 2px;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

        .sub-card .status {
            font-size: 0.7rem;
            padding: 4px 12px;
            border-radius: 40px;
            font-weight: 500;
            white-space: nowrap;
        }

            .sub-card .status.active {
                background: rgba(82, 183, 136, 0.06);
                color: #52b788;
                border: 1px solid rgba(82, 183, 136, 0.1);
            }

            .sub-card .status.inactive {
                background: rgba(127, 140, 141, 0.06);
                color: rgba(232, 240, 241, 0.35);
                border: 1px solid rgba(255, 255, 255, 0.03);
            }

        /* ============================================================
                           PRICE ROW (جدید)
                        ============================================================ */
        .sub-card .price-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            background: linear-gradient(135deg, rgba(232, 168, 56, 0.06), rgba(232, 168, 56, 0.02));
            border: 1px solid rgba(232, 168, 56, 0.08);
            border-radius: 12px;
        }

            .sub-card .price-row .price-label {
                font-size: 0.75rem;
                color: rgba(232, 240, 241, 0.5);
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .sub-card .price-row .price-label i {
                    color: #e8a838;
                    font-size: 0.7rem;
                }

            .sub-card .price-row .price-value {
                font-size: 1rem;
                font-weight: 700;
                color: #e8a838;
                text-shadow: 0 0 12px rgba(232, 168, 56, 0.15);
            }

                .sub-card .price-row .price-value small {
                    font-size: 0.7rem;
                    font-weight: 400;
                    color: rgba(232, 240, 241, 0.4);
                    margin-right: 4px;
                }

                .sub-card .price-row .price-value.free {
                    color: #52b788;
                    text-shadow: 0 0 12px rgba(82, 183, 136, 0.15);
                }

        .sub-card .stats {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .sub-card .stat-pill {
            flex: 1;
            min-width: 80px;
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .sub-card .stat-pill .label {
                font-size: 0.68rem;
                color: rgba(232, 240, 241, 0.35);
                margin-bottom: 2px;
            }

            .sub-card .stat-pill .value {
                font-size: 0.95rem;
                font-weight: 700;
                color: #e8a838;
            }

            .sub-card .stat-pill.green .value {
                color: #52b788;
            }

            .sub-card .stat-pill.purple .value {
                color: #8264c8;
            }

        .sub-card .type-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.72rem;
            color: #e8a838;
            padding: 3px 12px;
            border-radius: 40px;
            background: rgba(232, 168, 56, 0.06);
            border: 1px solid rgba(232, 168, 56, 0.08);
            align-self: flex-start;
        }

        .sub-card .card-actions {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
        }

            .sub-card .card-actions button {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                border: 1px solid rgba(255, 255, 255, 0.04);
                background: rgba(255, 255, 255, 0.02);
                color: rgba(232, 240, 241, 0.3);
                transition: all 0.35s ease;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .sub-card .card-actions button:hover {
                    border-color: rgba(232, 168, 56, 0.1);
                    color: #e8f0f1;
                    background: rgba(232, 168, 56, 0.03);
                    transform: scale(1.05);
                }

                .sub-card .card-actions button.delete:hover {
                    border-color: rgba(220, 53, 69, 0.15);
                    color: #dc3545;
                    background: rgba(220, 53, 69, 0.03);
                }

    /* ============================================================
                           PAGINATION
                        ============================================================ */
    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
        padding: 16px 0;
    }

        .pagination button {
            padding: 8px 16px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            background: rgba(255, 255, 255, 0.02);
            color: rgba(232, 240, 241, 0.3);
            font-size: 0.8rem;
            transition: all 0.35s ease;
            cursor: pointer;
        }

            .pagination button:hover {
                border-color: rgba(232, 168, 56, 0.06);
                color: #e8f0f1;
                background: rgba(232, 168, 56, 0.02);
            }

            .pagination button.active {
                background: rgba(232, 168, 56, 0.06);
                border-color: rgba(232, 168, 56, 0.06);
                color: #e8a838;
            }

    /* ============================================================
                           BUTTONS
                        ============================================================ */
    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 9px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.12);
    }

        .btn-primary:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(232, 168, 56, 0.2);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .btn-light {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

        .btn-light:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: #e8a838;
            transform: translateY(-2px);
        }

    /* ============================================================
                           MODALS
                        ============================================================ */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.96);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .modal-box {
        max-width: 520px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        background: rgba(19, 80, 91, 0.85);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 24px;
        padding: 32px 28px;
        box-shadow: 0 20px 80px rgba(0, 0, 0, 0.4);
        color: #e8f0f1;
    }

        .modal-box h2 {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #ffffff;
        }

            .modal-box h2 i {
                color: #e8a838;
            }

        .modal-box .sub {
            color: rgba(232, 240, 241, 0.45);
            font-size: 0.85rem;
            margin-bottom: 22px;
        }

            .modal-box .sub strong {
                color: #e8a838;
            }

        .modal-box .form-group {
            margin-bottom: 18px;
        }

            .modal-box .form-group label {
                display: block;
                font-size: 0.8rem;
                font-weight: 500;
                color: rgba(232, 240, 241, 0.55);
                margin-bottom: 6px;
            }

                .modal-box .form-group label .required {
                    color: #dc3545;
                    margin-right: 2px;
                }

            .modal-box .form-group input[type="text"],
            .modal-box .form-group input[type="number"],
            .modal-box .form-group input[type="email"],
            .modal-box .form-group select,
            .modal-box .form-group textarea {
                width: 100%;
                padding: 10px 14px;
                border-radius: 12px;
                border: 1px solid rgba(255, 255, 255, 0.05);
                background: rgba(255, 255, 255, 0.03);
                color: #e8f0f1;
                font-size: 0.9rem;
                transition: all 0.3s ease;
                font-family: inherit;
            }

                .modal-box .form-group input:focus,
                .modal-box .form-group select:focus,
                .modal-box .form-group textarea:focus {
                    border-color: #e8a838;
                    outline: none;
                    background: rgba(255, 255, 255, 0.05);
                    box-shadow: 0 0 20px rgba(232, 168, 56, 0.04);
                }

            .modal-box .form-group textarea {
                min-height: 90px;
                resize: vertical;
            }

            .modal-box .form-group select option {
                background: #13505b;
                color: #e8f0f1;
            }

    /* Two-column form row */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    @@media (max-width: 480px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    /* Price input with currency */
    .price-input-wrap {
        position: relative;
    }

        .price-input-wrap input {
            padding-left: 60px !important;
        }

        .price-input-wrap .currency-tag {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.75rem;
            color: rgba(232, 168, 56, 0.7);
            pointer-events: none;
            font-weight: 500;
        }

    .switch-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 12px;
    }

        .switch-row .sw-label {
            font-size: 0.85rem;
            color: rgba(232, 240, 241, 0.7);
        }

    .switch {
        position: relative;
        width: 44px;
        height: 24px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 34px;
            transition: 0.3s;
        }

            .switch .slider::before {
                content: "";
                position: absolute;
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background: #e8f0f1;
                border-radius: 50%;
                transition: 0.3s;
            }

