@page "/Admin"
@layout AdminLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@* @implements IAsyncDisposable *@

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>داشبورد مدیریت | پنل ادمین</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
       ADMIN DASHBOARD - با رنگ پس‌زمینه #13505b
       پالت: #13505b (زمینه اصلی), #1a7a8a (روشن‌تر), #0d3d47 (تیره‌تر)
              #e8f0f1 (متن روشن), #f0f8f9 (کارت‌های شیشه‌ای)
              #e8a838 (طلایی برای تاکید), #ffffff (سفید)
    ============================================================ */

    /* ----- RESET & BASE (با پس‌زمینه #13505b) ----- */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
       GLASS EFFECT (شفاف با پس‌زمینه #13505b)
    ============================================================ */
    .glass {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.12);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    .glass:hover {
        background: rgba(255, 255, 255, 0.12);
        box-shadow: 0 8px 48px rgba(0, 0, 0, 0.18);
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.12);
    }

    /* ============================================================
       ANIMATIONS
    ============================================================ */

    /* 1. Float Animation */
    @@keyframes float {
        0% { transform: translateY(0px) scale(1); }
        50% { transform: translateY(-12px) scale(1.02); }
        100% { transform: translateY(0px) scale(1); }
    }
    .float-anim {
        animation: float 4s ease-in-out infinite;
    }
    .float-delay-1 { animation-delay: 0.5s; }
    .float-delay-2 { animation-delay: 1s; }

    /* 2. Pulse Glow */
    @@keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(232, 168, 56, 0.2); }
        70% { box-shadow: 0 0 0 12px rgba(232, 168, 56, 0); }
        100% { box-shadow: 0 0 0 0 rgba(232, 168, 56, 0); }
    }
    .pulse-glow {
        animation: pulseGlow 2.5s infinite;
    }

    /* 3. Gradient Border (rotating) */
    @@keyframes rotateBorder {
        0% { background-position: 0% 50%; }
        100% { background-position: 400% 50%; }
    }
    .gradient-border {
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        background-clip: padding-box;
    }
    .gradient-border::before {
        content: '';
        position: absolute;
        inset: -2px;
        z-index: -1;
        border-radius: 22px;
        background: conic-gradient(from 0deg, #e8a838, #52b788, #1a7a8a, #e8a838, #52b788);
        background-size: 400% 400%;
        animation: rotateBorder 8s linear infinite;
        opacity: 0.3;
        transition: opacity 0.4s;
    }
    .gradient-border:hover::before {
        opacity: 0.7;
    }

    /* 4. Shimmer Text */
    @@keyframes shimmer {
        0% { background-position: -200% center; }
        100% { background-position: 200% center; }
    }
    .shimmer-text {
        background: linear-gradient(90deg, #e8f0f1, #e8a838, #52b788, #e8f0f1);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmer 6s linear infinite;
        display: inline-block;
    }

    /* 5. Slide In From Left */
    @@keyframes slideInLeft {
        0% { opacity: 0; transform: translateX(-40px); }
        100% { opacity: 1; transform: translateX(0); }
    }
    .slide-left {
        animation: slideInLeft 0.6s ease forwards;
    }

    /* 6. Scale In */
    @@keyframes scaleIn {
        0% { opacity: 0; transform: scale(0.85); }
        100% { opacity: 1; transform: scale(1); }
    }
    .scale-in {
        animation: scaleIn 0.5s ease forwards;
    }

    /* 7. Rotate In */
    @@keyframes rotateIn {
        0% { opacity: 0; transform: rotate(-10deg) scale(0.9); }
        100% { opacity: 1; transform: rotate(0) scale(1); }
    }
    .rotate-in {
        animation: rotateIn 0.6s ease forwards;
    }

    /* 8. Bounce In */
    @@keyframes bounceIn {
        0% { opacity: 0; transform: scale(0.3); }
        50% { opacity: 1; transform: scale(1.05); }
        70% { transform: scale(0.95); }
        100% { transform: scale(1); }
    }
    .bounce-in {
        animation: bounceIn 0.7s ease forwards;
    }

    /* 9. Fade Up (برای اسکرول) */
    .fade-up {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.2, 0.9, 0.3, 1),
                    transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    .fade-up.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .stagger-child {
        transition-delay: 0s;
    }
    .stagger-child:nth-child(1) { transition-delay: 0.05s; }
    .stagger-child:nth-child(2) { transition-delay: 0.1s; }
    .stagger-child:nth-child(3) { transition-delay: 0.15s; }
    .stagger-child:nth-child(4) { transition-delay: 0.2s; }
    .stagger-child:nth-child(5) { transition-delay: 0.25s; }
    .stagger-child:nth-child(6) { transition-delay: 0.3s; }

    /* 10. Ripple Effect */
    .ripple {
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }
    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.25);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }
    @@keyframes rippleAnim {
        to { transform: scale(4); opacity: 0; }
    }

    /* 11. Progress Bar Pulse */
    @@keyframes progressPulse {
        0% { opacity: 0.6; }
        50% { opacity: 1; }
        100% { opacity: 0.6; }
    }
    .progress-pulse {
        animation: progressPulse 1.5s ease-in-out infinite;
    }

    /* 12. Sparkle (نقاط نورانی متحرک) */
    @@keyframes sparkle {
        0% { transform: translate(0, 0) scale(1); opacity: 0.2; }
        50% { transform: translate(20px, -30px) scale(1.8); opacity: 0.8; }
        100% { transform: translate(-10px, 20px) scale(0.6); opacity: 0.1; }
    }
    .sparkle {
        position: fixed;
        width: 4px;
        height: 4px;
        background: rgba(232, 168, 56, 0.3);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        animation: sparkle 10s infinite alternate ease-in-out;
    }
    .sparkle:nth-child(1) { left: 10%; top: 20%; animation-duration: 12s; }
    .sparkle:nth-child(2) { left: 80%; top: 60%; animation-duration: 14s; animation-delay: 2s; width: 6px; height: 6px; }
    .sparkle:nth-child(3) { left: 30%; top: 70%; animation-duration: 16s; animation-delay: 4s; }
    .sparkle:nth-child(4) { left: 90%; top: 30%; animation-duration: 11s; animation-delay: 1s; width: 5px; height: 5px; background: rgba(82, 183, 136, 0.25); }
    .sparkle:nth-child(5) { left: 50%; top: 90%; animation-duration: 18s; animation-delay: 3s; }
    .sparkle:nth-child(6) { left: 5%; top: 50%; animation-duration: 13s; animation-delay: 5s; background: rgba(232, 168, 56, 0.2); }
    .sparkle:nth-child(7) { left: 70%; top: 10%; animation-duration: 15s; animation-delay: 2s; width: 7px; height: 7px; }
    .sparkle:nth-child(8) { left: 40%; top: 40%; animation-duration: 17s; animation-delay: 3s; background: rgba(82, 183, 136, 0.2); }

    /* ============================================================
       NAVBAR (شفاف با پس‌زمینه #13505b)
    ============================================================ */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: all 0.4s ease;
        background: rgba(19, 80, 91, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .navbar.scrolled {
        background: rgba(19, 80, 91, 0.92);
        box-shadow: 0 4px 40px rgba(0, 0, 0, 0.15);
    }

    .navbar .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #e8f0f1;
        letter-spacing: -0.3px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .logo span {
        color: #e8a838;
    }

    .logo i {
        color: #e8a838;
        font-size: 1.3rem;
    }

    .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 500;
        align-items: center;
    }

    .nav-links a {
        color: rgba(232, 240, 241, 0.7);
        transition: all 0.35s ease;
        position: relative;
        padding: 4px 0;
    }

    .nav-links a:hover {
        color: #ffffff;
    }

    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        right: 0;
        width: 0;
        height: 2.5px;
        background: #e8a838;
        transition: 0.35s;
        border-radius: 4px;
        box-shadow: 0 0 12px rgba(232, 168, 56, 0.2);
    }

    .nav-links a:hover::after {
        width: 100%;
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* ----- BUTTONS (با رنگ #13505b) ----- */
    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 9px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.15);
    }

    .btn-primary:hover {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 8px 32px rgba(232, 168, 56, 0.25);
        background: linear-gradient(135deg, #f0b84a, #d4952e);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid rgba(255, 255, 255, 0.15);
        color: #e8f0f1;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
    }

    .btn-outline:hover {
        border-color: #e8a838;
        background: rgba(232, 168, 56, 0.04);
        transform: translateY(-2px);
        box-shadow: 0 0 24px rgba(232, 168, 56, 0.04);
    }

    .btn-light {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.06);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-light:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: #e8a838;
        transform: translateY(-2px);
    }

    .btn-admin-badge {
        background: rgba(232, 168, 56, 0.08);
        border: 1px solid rgba(232, 168, 56, 0.1);
        color: #e8a838;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.75rem;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-admin-badge:hover {
        background: rgba(232, 168, 56, 0.12);
        transform: scale(1.02);
        border-color: #e8a838;
    }

    .avatar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(232, 168, 56, 0.3);
        background: rgba(255, 255, 255, 0.04);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8f0f1;
        font-size: 1.1rem;
        transition: all 0.35s ease;
        cursor: pointer;
    }

    .avatar-btn:hover {
        background: rgba(232, 168, 56, 0.06);
        transform: scale(1.05);
        border-color: #e8a838;
        box-shadow: 0 0 24px rgba(232, 168, 56, 0.04);
    }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
    }

    .hamburger span {
        display: block;
        width: 28px;
        height: 2.5px;
        background: #e8f0f1;
        border-radius: 4px;
        transition: 0.3s;
    }

    /* ============================================================
       DASHBOARD LAYOUT
    ============================================================ */
    .dashboard {
        padding-top: 100px;
        padding-bottom: 60px;
        position: relative;
        z-index: 1;
        min-height: 100vh;
    }

    /* ----- HEADER ----- */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }

    .dashboard-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 12px;
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
    }

    .dashboard-header h1 .badge-admin {
        font-size: 0.7rem;
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 4px 14px;
        border-radius: 40px;
        font-weight: 600;
        letter-spacing: 0.3px;
        box-shadow: 0 2px 12px rgba(232, 168, 56, 0.15);
    }

    .dashboard-header .date {
        color: rgba(232, 240, 241, 0.7);
        font-size: 0.9rem;
        background: rgba(255, 255, 255, 0.04);
        padding: 8px 18px;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

    /* ----- STATS CARDS ----- */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .stat-card {
        padding: 24px 22px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        position: relative;
        overflow: hidden;
        cursor: default;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #e8a838, #52b788);
        opacity: 0.4;
        border-radius: 0 4px 4px 0;
    }

    .stat-card:hover {
        transform: translateY(-6px);
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(232, 168, 56, 0.1);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
    }

    .stat-card .icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 12px;
    }

    .stat-card .icon.green {
        background: rgba(82, 183, 136, 0.08);
        color: #52b788;
    }

    .stat-card .icon.blue {
        background: rgba(26, 122, 138, 0.08);
        color: #1a7a8a;
    }

    .stat-card .icon.gold {
        background: rgba(232, 168, 56, 0.08);
        color: #e8a838;
    }

    .stat-card .icon.purple {
        background: rgba(130, 100, 200, 0.08);
        color: #8264c8;
    }

    .stat-card .number {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 2px;
    }

    .stat-card .label {
        color: rgba(232, 240, 241, 0.6);
        font-size: 0.9rem;
    }

    .stat-card .change {
        font-size: 0.75rem;
        margin-top: 6px;
        display: inline-block;
        padding: 2px 12px;
        border-radius: 30px;
        background: rgba(82, 183, 136, 0.06);
        color: #52b788;
        border: 1px solid rgba(82, 183, 136, 0.04);
        font-weight: 500;
    }

    .stat-card .change.down {
        background: rgba(220, 53, 69, 0.04);
        color: #dc3545;
        border-color: rgba(220, 53, 69, 0.04);
    }

    .stat-card .change.gold {
        background: rgba(232, 168, 56, 0.06);
        color: #e8a838;
        border-color: rgba(232, 168, 56, 0.06);
    }

    /* ============================================================
       MAIN GRID (Chart + Recent)
    ============================================================ */
    .main-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
    }

    .chart-box {
        padding: 28px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.4s ease;
    }

    .chart-box:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(232, 168, 56, 0.06);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
    }

    .chart-box h3 {
        font-size: 1.1rem;
        margin-bottom: 18px;
        color: #ffffff;
        font-weight: 600;
    }

    .chart-box h3 i {
        color: #e8a838;
        margin-left: 8px;
    }

    .chart-container {
        width: 100%;
        height: 210px;
        display: flex;
        align-items: flex-end;
        gap: 14px;
        padding-top: 10px;
    }

    .chart-bar-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        height: 100%;
        justify-content: flex-end;
    }

    .chart-bar {
        width: 100%;
        max-width: 36px;
        border-radius: 8px 8px 0 0;
        background: linear-gradient(180deg, #e8a838, #52b788);
        transition: height 1.2s cubic-bezier(0.2, 0.9, 0.3, 1);
        min-height: 8px;
        box-shadow: 0 0 20px rgba(232, 168, 56, 0.04);
        position: relative;
    }

    .chart-bar::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 30%;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), transparent);
        border-radius: 8px 8px 0 0;
    }

    .chart-bar-label {
        font-size: 0.7rem;
        color: rgba(232, 240, 241, 0.5);
        font-weight: 500;
    }

    /* ----- RECENT ACTIVITY ----- */
    .recent-box {
        padding: 28px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.4s ease;
    }

    .recent-box:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(232, 168, 56, 0.06);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
    }

    .recent-box h3 {
        font-size: 1.1rem;
        margin-bottom: 18px;
        color: #ffffff;
        font-weight: 600;
    }

    .recent-box h3 i {
        color: #52b788;
        margin-left: 8px;
    }

    .recent-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        transition: all 0.3s ease;
    }

    .recent-item:hover {
        background: rgba(255, 255, 255, 0.02);
        margin: 0 -8px;
        padding: 12px 8px;
        border-radius: 12px;
    }

    .recent-item:last-child {
        border-bottom: none;
    }

    .recent-item .r-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.04);
        color: #e8a838;
        font-size: 0.9rem;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .recent-item:hover .r-icon {
        background: rgba(232, 168, 56, 0.06);
        transform: scale(1.05);
    }

    .recent-item .r-icon.gold {
        background: rgba(232, 168, 56, 0.06);
        color: #e8a838;
    }

    .recent-item .r-icon.purple {
        background: rgba(130, 100, 200, 0.06);
        color: #8264c8;
    }

    .recent-item .r-icon.green {
        background: rgba(82, 183, 136, 0.06);
        color: #52b788;
    }

    .recent-item .r-info {
        flex: 1;
    }

    .recent-item .r-info .title {
        font-size: 0.9rem;
        font-weight: 500;
        color: #e8f0f1;
    }

    .recent-item .r-info .time {
        font-size: 0.75rem;
