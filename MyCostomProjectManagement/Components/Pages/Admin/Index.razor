    // ============================================================
    // JS INTEROP (با ریپل افکت و انیمیشن‌های بیشتر)
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // ===== NAVBAR SCROLL =====
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 30);
            });

            // ===== CHART BARS ANIMATION =====
            function animateBars() {
                document.querySelectorAll('.chart-bar').forEach(bar => {
                    const target = parseFloat(bar.dataset.height) || 50;
                    setTimeout(() => {
                        bar.style.height = target + '%';
                    }, 300);
                });
            }

            // ===== OBSERVER FOR FADE =====
            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                let chartVisible = false;
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        if (entry.target.closest('.chart-box')) chartVisible = true;
                    }
                });
                if (chartVisible) animateBars();
            }, { threshold: 0.15 });

            fadeEls.forEach(el => observer.observe(el));

            // Trigger on load if chart visible
            setTimeout(() => {
                const chart = document.querySelector('.chart-box');
                if (chart && chart.getBoundingClientRect().top < window.innerHeight) {
                    animateBars();
                }
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                    }
                });
            }, 400);

            // ===== RIPPLE EFFECT (برای دکمه‌های ripple) =====
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });
        ");
    }

    // ============================================================
    // HELPER CLASSES
    // ============================================================

    public class ChartItem
    {
        public string Label { get; set; } = "";
        public int Value { get; set; }
    }

    public class AdminActivity
    {
        public string Icon { get; set; } = "";
        public string IconColor { get; set; } = "";
        public string Title { get; set; } = "";
        public string Time { get; set; } = "";
        public string StatusClass { get; set; } = "";
