@page "/Admin"
@layout AdminLayout
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>داشبورد مدیریت | پنل ادمین</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

        body.menu-open {
            overflow: hidden;
        }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
           NAVBAR
        ============================================================ */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: all 0.4s ease;
        background: rgba(19, 80, 91, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

        .navbar.scrolled {
            background: rgba(19, 80, 91, 0.95);
            box-shadow: 0 4px 40px rgba(0, 0, 0, 0.15);
        }

        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: nowrap;
            gap: 16px;
            min-height: 44px;
        }

    .logo {
        font-size: 1.4rem;
        font-weight: 800;
        color: #e8f0f1;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

        .logo span {
            color: #e8a838;
        }

        .logo i {
            color: #e8a838;
            font-size: 1.2rem;
        }

    .nav-links {
        display: flex;
        gap: 20px;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 500;
        align-items: center;
        flex-wrap: wrap;
        min-width: 0;
    }

        .nav-links a {
            color: rgba(232, 240, 241, 0.7);
            transition: color 0.3s ease;
            position: relative;
            padding: 4px 0;
            white-space: nowrap;
        }

            .nav-links a:hover {
                color: #fff;
            }

            .nav-links a.active {
                color: #fff;
            }

                .nav-links a.active::after {
                    content: '';
                    position: absolute;
                    bottom: -2px;
                    right: 0;
                    width: 100%;
                    height: 2.5px;
                    background: #e8a838;
                    border-radius: 4px;
                }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .avatar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(232, 168, 56, 0.3);
        background: rgba(255, 255, 255, 0.04);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8f0f1;
        font-size: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .avatar-btn:hover {
            background: rgba(232, 168, 56, 0.08);
            border-color: #e8a838;
        }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        transition: background 0.2s;
    }

        .hamburger:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .hamburger span {
            display: block;
            width: 24px;
            height: 2.5px;
            background: #e8f0f1;
            border-radius: 4px;
            transition: transform 0.3s, opacity 0.3s;
        }

        .hamburger.active span:nth-child(1) {
            transform: translateY(7.5px) rotate(45deg);
        }

        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger.active span:nth-child(3) {
            transform: translateY(-7.5px) rotate(-45deg);
        }

    /* ============================================================
           MOBILE MENU (SIDE DRAWER)
        ============================================================ */
    .menu-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        z-index: 1000;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

        .menu-overlay.open {
            display: block;
            opacity: 1;
        }

    .nav-links-mobile {
        position: fixed;
        top: 0;
        right: -100%;
        width: 320px;
        max-width: 88vw;
        height: 100vh;
        height: 100dvh;
        background: rgba(19, 80, 91, 0.99);
        backdrop-filter: blur(16px);
        box-shadow: -4px 0 30px rgba(0, 0, 0, 0.3);
        z-index: 1001;
        display: flex;
        flex-direction: column;
        transition: right 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
        border-radius: 0 0 0 20px;
        overflow: hidden;
    }

        .nav-links-mobile.open {
            right: 0;
        }

    .mobile-menu-header {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        background: rgba(19, 80, 91, 0.99);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
        z-index: 2;
    }

        .mobile-menu-header .logo {
            font-size: 1.1rem;
        }

    .close-btn {
        background: none;
        border: none;
        color: #e8f0f1;
        font-size: 1.3rem;
        padding: 6px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s;
    }

        .close-btn:hover {
            color: #e8a838;
            background: rgba(255, 255, 255, 0.05);
        }

    .mobile-menu-content {
        flex: 1;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
        padding: 8px 0 32px;
    }

        .mobile-menu-content a {
            display: block;
            color: rgba(232, 240, 241, 0.78);
            padding: 11px 24px;
            font-size: 0.95rem;
            border-right: 3px solid transparent;
            transition: background 0.15s, color 0.15s, border-color 0.15s;
        }

            .mobile-menu-content a:hover {
                background: rgba(255, 255, 255, 0.05);
                color: #fff;
            }

            .mobile-menu-content a.active {
                color: #e8a838;
                background: rgba(232, 168, 56, 0.06);
                border-right-color: #e8a838;
            }

        .mobile-menu-content .separator {
            height: 1px;
            background: rgba(255, 255, 255, 0.06);
            margin: 8px 20px;
        }

    /* ============================================================
           DASHBOARD
        ============================================================ */
    .dashboard {
        padding-top: 100px;
        padding-bottom: 40px;
        position: relative;
        z-index: 1;
        min-height: 100vh;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 32px;
    }

        .dashboard-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

            .dashboard-header h1 .badge-admin {
                font-size: 0.7rem;
                background: linear-gradient(135deg, #e8a838, #d4952e);
                color: #fff;
                padding: 4px 14px;
                border-radius: 40px;
                font-weight: 600;
            }

        .dashboard-header .date {
            color: rgba(232, 240, 241, 0.7);
            font-size: 0.9rem;
            background: rgba(255, 255, 255, 0.04);
            padding: 8px 18px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            white-space: nowrap;
        }

    /* STATS */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .stat-card {
        padding: 24px 22px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        backdrop-filter: blur(8px);
        position: relative;
        overflow: hidden;
        min-width: 0;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #e8a838, #52b788);
            opacity: 0.4;
            border-radius: 0 4px 4px 0;
        }

        .stat-card:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(232, 168, 56, 0.1);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card .icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 12px;
        }

            .stat-card .icon.green {
                background: rgba(82, 183, 136, 0.08);
                color: #52b788;
            }

            .stat-card .icon.blue {
                background: rgba(26, 122, 138, 0.08);
                color: #1a7a8a;
            }

            .stat-card .icon.gold {
                background: rgba(232, 168, 56, 0.08);
                color: #e8a838;
            }

            .stat-card .icon.purple {
                background: rgba(130, 100, 200, 0.08);
                color: #8264c8;
            }

        .stat-card .number {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 2px;
            line-height: 1.2;
            overflow-wrap: anywhere;
        }

        .stat-card .label {
            color: rgba(232, 240, 241, 0.6);
            font-size: 0.9rem;
        }

        .stat-card .change {
            font-size: 0.75rem;
            margin-top: 6px;
            display: inline-block;
            padding: 2px 12px;
            border-radius: 30px;
            background: rgba(82, 183, 136, 0.06);
            color: #52b788;
            border: 1px solid rgba(82, 183, 136, 0.04);
            font-weight: 500;
        }

            .stat-card .change.gold {
                background: rgba(232, 168, 56, 0.06);
                color: #e8a838;
                border-color: rgba(232, 168, 56, 0.06);
            }

            .stat-card .change.down {
                background: rgba(220, 53, 69, 0.04);
                color: #dc3545;
                border-color: rgba(220, 53, 69, 0.04);
            }

    /* MAIN GRID */
    .main-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
    }

    .chart-box, .recent-box, .users-box, .quick-actions {
        padding: 28px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 20px;
        backdrop-filter: blur(8px);
        transition: all 0.4s ease;
        min-width: 0;
        overflow: hidden;
    }

        .chart-box h3, .recent-box h3, .users-box h3, .quick-actions h3 {
            font-size: 1.1rem;
            margin-bottom: 18px;
            color: #fff;
            font-weight: 600;
        }

            .chart-box h3 i {
                color: #e8a838;
                margin-left: 8px;
            }

            .recent-box h3 i, .users-box h3 i {
                color: #52b788;
                margin-left: 8px;
            }

            .quick-actions h3 i {
                color: #e8a838;
                margin-left: 8px;
            }

    .chart-container {
        width: 100%;
        height: 210px;
        display: flex;
        align-items: flex-end;
        gap: 14px;
        padding-top: 10px;
    }

    .chart-bar-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        height: 100%;
        justify-content: flex-end;
        min-width: 0;
    }

    .chart-bar {
        width: 100%;
        max-width: 36px;
        border-radius: 8px 8px 0 0;
        background: linear-gradient(180deg, #e8a838, #52b788);
        transition: height 1.2s cubic-bezier(0.2, 0.9, 0.3, 1);
        min-height: 8px;
    }

    .chart-bar-label {
        font-size: 0.7rem;
        color: rgba(232, 240, 241, 0.5);
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .recent-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

        .recent-item:last-child {
            border-bottom: none;
        }

        .recent-item .r-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.04);
            color: #e8a838;
            font-size: 0.9rem;
            flex-shrink: 0;
        }

            .recent-item .r-icon.gold {
                background: rgba(232, 168, 56, 0.06);
                color: #e8a838;
            }

            .recent-item .r-icon.purple {
                background: rgba(130, 100, 200, 0.06);
                color: #8264c8;
            }

        .recent-item .r-info {
            flex: 1;
            min-width: 0;
        }

            .recent-item .r-info .title {
                font-size: 0.9rem;
                font-weight: 500;
                color: #e8f0f1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .recent-item .r-info .time {
                font-size: 0.75rem;
                color: rgba(232, 240, 241, 0.4);
            }

        .recent-item .r-status {
            font-size: 0.7rem;
            padding: 3px 14px;
            border-radius: 30px;
            background: rgba(82, 183, 136, 0.06);
            color: #52b788;
            border: 1px solid rgba(82, 183, 136, 0.04);
            font-weight: 500;
            white-space: nowrap;
            flex-shrink: 0;
        }

            .recent-item .r-status.pending {
                background: rgba(232, 168, 56, 0.06);
                color: #e8a838;
                border-color: rgba(232, 168, 56, 0.04);
            }

            .recent-item .r-status.warning {
                background: rgba(220, 53, 69, 0.04);
                color: #dc3545;
                border-color: rgba(220, 53, 69, 0.04);
            }

    .bottom-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 24px;
    }

    .user-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

        .user-row:last-child {
            border-bottom: none;
        }

        .user-row .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e8a838, #52b788);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
            flex-shrink: 0;
        }

            .user-row .avatar.light {
                background: rgba(255, 255, 255, 0.06);
                color: #e8f0f1;
            }

            .user-row .avatar.gold {
                background: linear-gradient(135deg, #e8a838, #d4952e);
            }

        .user-row .user-info {
            flex: 1;
            min-width: 0;
        }

            .user-row .user-info .name {
                font-size: 0.9rem;
                font-weight: 500;
                color: #e8f0f1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .user-row .user-info .email {
                font-size: 0.75rem;
                color: rgba(232, 240, 241, 0.4);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .user-row .user-status {
            font-size: 0.7rem;
            padding: 3px 14px;
            border-radius: 30px;
            font-weight: 500;
            white-space: nowrap;
            flex-shrink: 0;
        }

            .user-row .user-status.active {
                background: rgba(82, 183, 136, 0.06);
                color: #52b788;
                border: 1px solid rgba(82, 183, 136, 0.04);
            }

            .user-row .user-status.inactive {
                background: rgba(127, 140, 141, 0.06);
                color: rgba(232, 240, 241, 0.3);
                border: 1px solid rgba(255, 255, 255, 0.02);
            }

            .user-row .user-status.pending {
                background: rgba(232, 168, 56, 0.06);
                color: #e8a838;
                border: 1px solid rgba(232, 168, 56, 0.04);
            }

    .quick-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .quick-btn {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        padding: 18px 12px;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        cursor: pointer;
        color: rgba(232, 240, 241, 0.6);
        min-width: 0;
    }

        .quick-btn:hover {
            border-color: rgba(232, 168, 56, 0.15);
            background: rgba(255, 255, 255, 0.04);
            transform: translateY(-4px);
            color: #fff;
        }

        .quick-btn i {
            font-size: 1.8rem;
            color: #e8a838;
            display: block;
            margin-bottom: 6px;
        }

        .quick-btn span {
            font-size: 0.8rem;
            font-weight: 500;
        }

    /* ============================================================
           RESPONSIVE
        ============================================================ */

    /* ≤ ۱۲۰۰px */
    @@media (max-width: 1200px) {
        .bottom-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ≤ ۱۰۲۴px → منوی موبایل */
    @@media (max-width: 1024px) {
        .nav-links {
            display: none;
        }

        .hamburger {
            display: flex;
        }

        .dashboard {
            padding-top: 86px;
        }
    }

    /* ≤ ۹۹۲px */
    @@media (max-width: 992px) {
        .main-grid {
            grid-template-columns: 1fr;
        }

        .chart-box, .recent-box, .users-box, .quick-actions {
            padding: 22px;
        }

        .chart-container {
            height: 180px;
        }

        .dashboard-header h1 {
            font-size: 1.6rem;
        }
    }

    /* ≤ ۷۶۸px */
    @@media (max-width: 768px) {
        .dashboard {
            padding-top: 78px;
            padding-bottom: 30px;
        }

        .container {
            padding: 0 18px;
        }

        .dashboard-header {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
            margin-bottom: 22px;
        }

            .dashboard-header h1 {
                font-size: 1.3rem;
                flex-wrap: wrap;
                gap: 8px;
            }

                .dashboard-header h1 .badge-admin {
                    font-size: 0.62rem;
                }

            .dashboard-header .date {
                align-self: flex-start;
                font-size: 0.78rem;
                padding: 6px 14px;
            }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 22px;
        }

        .stat-card {
            padding: 18px 14px;
        }

            .stat-card .icon {
                width: 40px;
                height: 40px;
                font-size: 1.1rem;
                margin-bottom: 8px;
            }

            .stat-card .number {
                font-size: 1.4rem;
            }

            .stat-card .label {
                font-size: 0.78rem;
            }

            .stat-card .change {
                font-size: 0.65rem;
                padding: 2px 8px;
            }

        .chart-box, .recent-box, .users-box, .quick-actions {
            padding: 16px;
            border-radius: 16px;
        }

            .chart-box h3, .recent-box h3, .users-box h3, .quick-actions h3 {
                font-size: 1rem;
                margin-bottom: 12px;
            }

        .chart-container {
            height: 150px;
            gap: 8px;
        }

        .chart-bar {
            max-width: 28px;
        }

        .chart-bar-label {
            font-size: 0.62rem;
        }

        .recent-item {
            padding: 10px 0;
            gap: 10px;
        }

            .recent-item .r-icon {
                width: 32px;
                height: 32px;
                font-size: 0.78rem;
            }

            .recent-item .r-info .title {
                font-size: 0.82rem;
            }

            .recent-item .r-status {
                font-size: 0.62rem;
                padding: 2px 10px;
            }

        .user-row {
            padding: 10px 0;
            gap: 10px;
        }

            .user-row .avatar {
                width: 34px;
                height: 34px;
                font-size: 0.8rem;
            }

            .user-row .user-info .name {
                font-size: 0.82rem;
            }

            .user-row .user-status {
                font-size: 0.62rem;
                padding: 2px 10px;
            }

        .quick-grid {
            gap: 10px;
        }

        .quick-btn {
            padding: 14px 8px;
            border-radius: 14px;
        }

            .quick-btn i {
                font-size: 1.4rem;
            }

            .quick-btn span {
                font-size: 0.72rem;
            }
    }

    /* ≤ ۴۸۰px */
    @@media (max-width: 480px) {
        .container {
            padding: 0 14px;
        }

        .dashboard {
            padding-top: 72px;
        }

        .stats-grid {
            gap: 10px;
        }

        .stat-card {
            padding: 14px 12px;
            border-radius: 14px;
        }

            .stat-card::before {
                width: 3px;
            }

            .stat-card .icon {
                width: 34px;
                height: 34px;
                font-size: 1rem;
                border-radius: 10px;
                margin-bottom: 6px;
            }

            .stat-card .number {
                font-size: 1.15rem;
            }

