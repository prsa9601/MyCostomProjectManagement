     DASHBOARD
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Header -->
        <div class="dashboard-header">
            <h1>
                <i class="fas fa-crown" style="color:#e8a838; font-size:1.8rem;"></i>
                پنل مدیریت
                <span class="badge-admin">ادمین</span>
            </h1>
            <span class="date"><i class="far fa-calendar-alt"></i> @persianDate</span>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="icon green"><i class="fas fa-users"></i></div>
                <div class="number">@totalUsers.ToString("N0")</div>
                <div class="label">کاربران فعال</div>
                <span class="change"><i class="fas fa-arrow-up"></i> ۸٪ رشد</span>
            </div>
            <div class="stat-card">
                <div class="icon blue"><i class="fas fa-project-diagram"></i></div>
                <div class="number">@totalProjects.ToString("N0")</div>
                <div class="label">پروژه‌ها</div>
                <span class="change gold"><i class="fas fa-arrow-up"></i> ۱۲٪ افزایش</span>
            </div>
            <div class="stat-card">
                <div class="icon gold"><i class="fas fa-dollar-sign"></i></div>
                <div class="number">@totalRevenue.ToString("N0")</div>
                <div class="label">درآمد (تومان)</div>
                <span class="change gold"><i class="fas fa-arrow-up"></i> ۲۲٪ رشد</span>
            </div>
            <div class="stat-card">
                <div class="icon purple"><i class="fas fa-ticket-alt"></i></div>
                <div class="number">@pendingTickets.ToString("N0")</div>
                <div class="label">تیکت‌های باز</div>
                <span class="change down"><i class="fas fa-arrow-down"></i> ۳٪ کاهش</span>
            </div>
        </div>

        <!-- Chart + Recent -->
        <div class="main-grid">
            <div class="chart-box">
                <h3><i class="fas fa-chart-line"></i> بازدید هفتگی</h3>
                <div class="chart-container">
                    @foreach (var day in weekVisits)
                    {
                        <div class="chart-bar-wrapper">
                            <div class="chart-bar" style="height:0%;" data-height="@day.Value"></div>
                            <span class="chart-bar-label">@day.Label</span>
                        </div>
                    }
                </div>
            </div>

            <div class="recent-box">
                <h3><i class="fas fa-clock"></i> آخرین فعالیت‌ها</h3>
                @foreach (var act in adminActivities)
                {
                    <div class="recent-item">
                        <div class="r-icon @(act.IconColor)"><i class="@act.Icon"></i></div>
                        <div class="r-info">
                            <div class="title">@act.Title</div>
                            <div class="time">@act.Time</div>
                        </div>
                        <span class="r-status @act.StatusClass">@act.StatusText</span>
                    </div>
                }
            </div>
        </div>

        <!-- Bottom Grid -->
        <div class="bottom-grid">
            <div class="users-box">
                <h3>
                    <span><i class="fas fa-user-friends"></i> کاربران جدید</span>
                    <span class="view-all" @onclick="ViewAllUsers" style="font-size:0.8rem; color:#e8a838; cursor:pointer;">مشاهده همه →</span>
                </h3>
                @foreach (var user in recentUsers)
                {
                    <div class="user-row">
                        <div class="avatar @(user.AvatarClass)">@user.Initials</div>
                        <div class="user-info">
                            <div class="name">@user.Name</div>
                            <div class="email">@user.Email</div>
                        </div>
                        <span class="user-status @user.StatusClass">@user.StatusText</span>
                    </div>
                }
            </div>

            <div class="quick-actions">
                <h3><i class="fas fa-bolt"></i> اقدامات مدیریتی</h3>
                <div class="quick-grid">
                    <div class="quick-btn" @onclick="CreateNewProject">
                        <i class="fas fa-plus-circle"></i>
                        <span>پروژه جدید</span>
                    </div>
                    <div class="quick-btn" @onclick="ManageUsers">
                        <i class="fas fa-user-cog"></i>
                        <span>مدیریت کاربران</span>
                    </div>
                    <div class="quick-btn" @onclick="ViewReports">
                        <i class="fas fa-chart-bar"></i>
                        <span>گزارشات</span>
                    </div>
                    <div class="quick-btn" @onclick="SystemSettings">
                        <i class="fas fa-cog"></i>
                        <span>تنظیمات سیستم</span>
                    </div>
                    <div class="quick-btn" @onclick="ViewTickets">
                        <i class="fas fa-ticket-alt"></i>
                        <span>تیکت‌ها</span>
                    </div>
                    <div class="quick-btn" @onclick="ViewLogs">
                        <i class="fas fa-history"></i>
                        <span>لاگ‌ها</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>


@code {
    // ============================================================
    // STATE
    // ============================================================
    private bool isMenuOpen = false;
    private string persianDate = "امروز، ۱۰ تیر ۱۴۰۵";

    private long totalUsers = 1248;
    private long totalProjects = 86;
    private long totalRevenue = 12450000;
    private long pendingTickets = 7;

    private List<ChartItem> weekVisits = new()
    {
        new ChartItem { Label = "شنبه",     Value = 420 },
        new ChartItem { Label = "یک‌شنبه",  Value = 580 },
        new ChartItem { Label = "دوشنبه",   Value = 390 },
        new ChartItem { Label = "سه‌شنبه",  Value = 510 },
        new ChartItem { Label = "چهارشنبه", Value = 720 },
        new ChartItem { Label = "پنجشنبه",  Value = 450 },
        new ChartItem { Label = "جمعه",     Value = 380 }
    };

    private List<AdminActivity> adminActivities = new()
    {
        new AdminActivity { Icon = "fas fa-user-plus",           IconColor = "",       Title = "کاربر جدید ثبت نام کرد: علی محمدی", Time = "۱۵ دقیقه پیش", StatusClass = "success", StatusText = "جدید" },
        new AdminActivity { Icon = "fas fa-edit",                IconColor = "gold",   Title = "ویرایش تنظیمات امنیتی",           Time = "۴۵ دقیقه پیش", StatusClass = "pending", StatusText = "در انتظار" },
        new AdminActivity { Icon = "fas fa-check-circle",        IconColor = "purple", Title = "تأیید پروژه فروشگاهی",            Time = "۲ ساعت پیش",   StatusClass = "success", StatusText = "تأیید شد" },
        new AdminActivity { Icon = "fas fa-exclamation-triangle", IconColor = "",       Title = "هشدار: فضای هاست ۸۵٪ پر شده",      Time = "۳ ساعت پیش",   StatusClass = "warning", StatusText = "هشدار" }
    };

    private List<UserItem> recentUsers = new()
    {
        new UserItem { Name = "سارا حسینی", Email = "sara.h@example.com",   Initials = "س", StatusClass = "active",   StatusText = "فعال",      AvatarClass = "" },
        new UserItem { Name = "رضا کریمی",  Email = "reza.k@example.com",   Initials = "ر", StatusClass = "pending",  StatusText = "در انتظار", AvatarClass = "gold" },
        new UserItem { Name = "مریم نادری", Email = "maryam.n@example.com", Initials = "م", StatusClass = "active",   StatusText = "فعال",      AvatarClass = "" },
        new UserItem { Name = "احمد رضایی", Email = "ahmad.r@example.com",  Initials = "ا", StatusClass = "inactive", StatusText = "غیرفعال",   AvatarClass = "light" }
    };

    // ============================================================
    // LIFECYCLE
    // ============================================================
    protected override void OnInitialized()
    {
        // بستن خودکار منو هنگام تغییر مسیر
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                const navbar = document.getElementById('navbar');
                window.addEventListener('scroll', () => {
                    navbar?.classList.toggle('scrolled', window.scrollY > 30);
                });

                function animateBars() {
                    document.querySelectorAll('.chart-bar').forEach(bar => {
                        const target = parseFloat(bar.dataset.height) || 50;
                        setTimeout(() => { bar.style.height = target + '%'; }, 300);
                    });
                }
                setTimeout(animateBars, 400);
            ");
        }

        // قفل/آزاد کردن اسکرول body
        await JSRuntime.InvokeVoidAsync("eval",
            $"document.body.classList.toggle('menu-open', {(isMenuOpen ? "true" : "false")});");
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (isMenuOpen)
        {
            isMenuOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    // ============================================================
    // UI
    // ============================================================
    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    private void GoToProfile() => NavigationManager.NavigateTo("/Admin/Profile", true);
    private void CreateNewProject() => NavigationManager.NavigateTo("/NewProject", true);
    private void ManageUsers() => NavigationManager.NavigateTo("/Admin/Users", true);
    private void ViewReports() => NavigationManager.NavigateTo("/Admin/Reports", true);
    private void SystemSettings() => NavigationManager.NavigateTo("/Admin/Settings", true);
    private void ViewTickets() => NavigationManager.NavigateTo("/Admin/Tickets", true);
    private void ViewLogs() => NavigationManager.NavigateTo("/Admin/Logs", true);
    private void ViewAllUsers() => NavigationManager.NavigateTo("/Admin/Users", true);

    // ============================================================
    // HELPER CLASSES
    // ============================================================
    public class ChartItem
    {
        public string Label { get; set; } = "";
        public int Value { get; set; }
    }
    public class AdminActivity
    {
        public string Icon { get; set; } = "";
        public string IconColor { get; set; } = "";
        public string Title { get; set; } = "";
        public string Time { get; set; } = "";
        public string StatusClass { get; set; } = "";
        public string StatusText { get; set; } = "";
    }
    public class UserItem
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Initials { get; set; } = "";
        public string StatusClass { get; set; } = "";
        public string StatusText { get; set; } = "";
        public string AvatarClass { get; set; } = "";
    }
}