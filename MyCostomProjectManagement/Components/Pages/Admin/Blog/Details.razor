    private static string GetScoreTagClass(int score) => score switch
    {
        >= 8 => "bd-tag-approved",
        >= 5 => "bd-tag-pending",
        _ => "bd-tag-deleted"
    };

    private static string GetScoreCircleClass(int score) => score switch
    {
        >= 8 => "bd-score-high",
        >= 5 => "bd-score-mid",
        _ => "bd-score-low"
    };

    private static string GetScoreLabel(int score) => score switch
    {
        >= 9 => "عالی",
        >= 7 => "خوب",
        >= 5 => "متوسط",
        >= 3 => "ضعیف",
        _ => "خیلی ضعیف"
    };

    private static string ShortenGuid(Guid id)
    {
        var s = id.ToString();
        return s.Length > 12 ? s[..8] + "…" : s;
    }

    private static string ToPersianDate(DateTime dt)
    {
        try
        {
            var pc = new System.Globalization.PersianCalendar();
            return $"{pc.GetYear(dt):0000}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00}";
        }
        catch
        {
            return dt.ToString("yyyy/MM/dd");
        }
    }
