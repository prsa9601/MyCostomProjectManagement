@page "/Admin/Blogs/Details/{Id:int}"
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<Context> _dbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using BackEnd.Data.DB
@using BackEnd.Data.Entities.Blogs
@using Microsoft.EntityFrameworkCore
@using Markdig

<PageTitle>جزئیات مقاله | پنل ادمین</PageTitle>

<!-- Highlight.js CSS -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />

<!-- ============================================================
     STYLES
============================================================ -->
<style>
    .blog-details-page {
        color: #eaeaea;
        animation: bd-fade-in .3s ease;
    }

    @@keyframes bd-fade-in {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ============================================================
           TOP BAR
        ============================================================ */
    .bd-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .bd-back {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: #1c1c24;
        border: 1px solid #2a2a34;
        color: #b8b8c0;
        padding: .55rem 1rem;
        border-radius: 10px;
        font-size: .85rem;
        cursor: pointer;
        font-family: inherit;
        transition: .2s;
    }

        .bd-back:hover {
            border-color: #4dc9dd;
            color: #4dc9dd;
            transform: translateX(-2px);
            box-shadow: 0 0 20px rgba(77, 201, 221, .15);
        }

    .bd-actions {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .bd-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .55rem 1rem;
        border-radius: 10px;
        font-size: .85rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid transparent;
        font-family: inherit;
        transition: .2s;
    }

        .bd-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .bd-btn-approve {
        background: rgba(82, 183, 136, .12);
        color: #52b788;
        border-color: rgba(82, 183, 136, .35);
    }

        .bd-btn-approve:hover:not(:disabled) {
            background: rgba(82, 183, 136, .22);
            border-color: #52b788;
            box-shadow: 0 0 20px rgba(82, 183, 136, .2);
        }

        .bd-btn-approve.is-off {
            background: #1c1c24;
            color: #8a8a95;
            border-color: #2a2a34;
        }

            .bd-btn-approve.is-off:hover:not(:disabled) {
                color: #52b788;
                border-color: #52b788;
            }

    .bd-btn-active {
        background: rgba(77, 201, 221, .12);
        color: #4dc9dd;
        border-color: rgba(77, 201, 221, .35);
    }

        .bd-btn-active:hover:not(:disabled) {
            background: rgba(77, 201, 221, .22);
            border-color: #4dc9dd;
            box-shadow: 0 0 20px rgba(77, 201, 221, .2);
        }

        .bd-btn-active.is-off {
            background: #1c1c24;
            color: #8a8a95;
            border-color: #2a2a34;
        }

            .bd-btn-active.is-off:hover:not(:disabled) {
                color: #4dc9dd;
                border-color: #4dc9dd;
            }

    .bd-btn-danger {
        background: #1c1c24;
        color: #8a8a95;
        border-color: #2a2a34;
    }

        .bd-btn-danger:hover:not(:disabled) {
            background: rgba(231, 76, 60, .12);
            color: #e74c3c;
            border-color: #e74c3c;
            box-shadow: 0 0 20px rgba(231, 76, 60, .2);
        }

    .bd-btn-restore {
        background: #1c1c24;
        color: #8a8a95;
        border-color: #2a2a34;
    }

        .bd-btn-restore:hover:not(:disabled) {
            background: rgba(241, 196, 15, .12);
            color: #f1c40f;
            border-color: #f1c40f;
            box-shadow: 0 0 20px rgba(241, 196, 15, .2);
        }

    /* ============================================================
           STATE BOXES
        ============================================================ */
    .bd-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .75rem;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, #1c1c24, #181820);
        border: 1px solid #2a2a34;
        border-radius: 14px;
        color: #8a8a95;
        text-align: center;
    }

        .bd-state i {
            font-size: 3rem;
            background: linear-gradient(135deg, #4dc9dd, #52b788);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            opacity: .8;
        }

        .bd-state h3 {
            margin: 0;
            color: #eaeaea;
            font-size: 1.1rem;
        }

        .bd-state p {
            margin: 0;
            font-size: .9rem;
        }

    .bd-spinner {
        width: 42px;
        height: 42px;
        border: 3px solid #2a2a34;
        border-top-color: #4dc9dd;
        border-right-color: #52b788;
        border-radius: 50%;
        animation: bd-spin .8s linear infinite;
    }

    @@keyframes bd-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ============================================================
           GRID & CARDS
        ============================================================ */
    .bd-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 1.25rem;
        align-items: flex-start;
    }

    .bd-card {
        background: #1c1c24;
        border: 1px solid #2a2a34;
        border-radius: 14px;
        overflow: hidden;
        transition: border-color .25s ease;
    }

        .bd-card:hover {
            border-color: rgba(77, 201, 221, .2);
        }

    .bd-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #2a2a34;
        background: linear-gradient(90deg, rgba(77, 201, 221, .04), rgba(82, 183, 136, .04));
    }

    .bd-card-title {
        display: flex;
        align-items: center;
        gap: .55rem;
        font-size: .95rem;
        font-weight: 600;
        color: #eaeaea;
        margin: 0;
    }

        .bd-card-title i {
            background: linear-gradient(135deg, #4dc9dd, #52b788);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .bd-card-body {
        padding: 1.25rem;
    }

    /* ============================================================
           HERO
        ============================================================ */
    .bd-hero {
        background: linear-gradient(135deg, #1c1c24 0%, #14141c 50%, #181824 100%);
        border: 1px solid #2a2a34;
        border-radius: 14px;
        padding: 1.5rem;
        margin-bottom: 1.25rem;
        position: relative;
        overflow: hidden;
    }

        .bd-hero::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #4dc9dd, #52b788, #f1c40f);
            box-shadow: 0 0 20px rgba(77, 201, 221, .4);
        }

        .bd-hero::after {
            content: '';
            position: absolute;
            bottom: -50px;
            left: -50px;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(77, 201, 221, .08), transparent 70%);
            pointer-events: none;
        }

    .bd-hero-title {
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(135deg, #ffffff 0%, #b8e6ee 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0 0 .65rem 0;
        line-height: 1.5;
    }

    .bd-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .85rem;
        font-size: .82rem;
        color: #8a8a95;
        margin-bottom: 1rem;
    }

        .bd-hero-meta span {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        .bd-hero-meta i {
            background: linear-gradient(135deg, #4dc9dd, #52b788);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    /* ============================================================
           TAGS
        ============================================================ */
    .bd-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
    }

    .bd-tag {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-size: .75rem;
        padding: .3rem .7rem;
        border-radius: 20px;
        font-weight: 500;
        border: 1px solid transparent;
        white-space: nowrap;
        transition: .2s;
    }

    .bd-tag-approved {
        background: rgba(82, 183, 136, .14);
        color: #52b788;
        border-color: rgba(82, 183, 136, .35);
        box-shadow: 0 0 12px rgba(82, 183, 136, .08);
    }

    .bd-tag-pending {
        background: rgba(241, 196, 15, .14);
        color: #f1c40f;
        border-color: rgba(241, 196, 15, .35);
        box-shadow: 0 0 12px rgba(241, 196, 15, .08);
    }

    .bd-tag-active {
        background: rgba(77, 201, 221, .14);
        color: #4dc9dd;
        border-color: rgba(77, 201, 221, .35);
        box-shadow: 0 0 12px rgba(77, 201, 221, .08);
    }

    .bd-tag-inactive {
        background: rgba(138, 138, 149, .14);
        color: #a8a8b0;
        border-color: rgba(138, 138, 149, .35);
    }

    .bd-tag-deleted {
        background: rgba(231, 76, 60, .14);
        color: #ff7b6b;
        border-color: rgba(231, 76, 60, .35);
        box-shadow: 0 0 12px rgba(231, 76, 60, .08);
    }

    .bd-tag-useful {
        background: rgba(155, 89, 182, .14);
        color: #c084fc;
        border-color: rgba(155, 89, 182, .35);
        box-shadow: 0 0 12px rgba(155, 89, 182, .08);
    }

    .bd-tag-neutral {
        background: rgba(77, 201, 221, .14);
        color: #4dc9dd;
        border-color: rgba(77, 201, 221, .35);
    }

    /* ============================================================
           INFO LIST
        ============================================================ */
    .bd-info-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
    }

    .bd-info-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
        padding: .7rem 0;
        border-bottom: 1px dashed #2a2a34;
        font-size: .85rem;
    }

        .bd-info-item:last-child {
            border-bottom: none;
        }

    .bd-info-label {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: #8a8a95;
        flex-shrink: 0;
    }

        .bd-info-label i {
            color: #4dc9dd;
            width: 14px;
            text-align: center;
            font-size: .8rem;
        }

    .bd-info-value {
        color: #eaeaea;
        font-weight: 500;
        text-align: left;
        word-break: break-word;
    }

        .bd-info-value.mono {
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: .8rem;
            color: #4dc9dd;
        }

    /* ============================================================
           MARKDOWN
        ============================================================ */
    .bd-markdown {
        color: #d0d0d8;
        font-size: .95rem;
        line-height: 1.9;
        word-wrap: break-word;
        word-break: break-word;
    }

        .bd-markdown > *:first-child {
            margin-top: 0;
        }

        .bd-markdown > *:last-child {
            margin-bottom: 0;
        }

        /* Headings with colorful underlines */
        .bd-markdown h1,
        .bd-markdown h2,
        .bd-markdown h3,
        .bd-markdown h4,
        .bd-markdown h5,
        .bd-markdown h6 {
            font-weight: 700;
            line-height: 1.4;
            margin: 1.75em 0 .75em;
            padding-bottom: .35em;
            scroll-margin-top: 90px;
            position: relative;
        }

        .bd-markdown h1 {
            font-size: 1.75rem;
            color: #ffffff;
            background: linear-gradient(135deg, #ffffff 0%, #4dc9dd 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            border-bottom: 2px solid transparent;
            border-image: linear-gradient(90deg, #4dc9dd, #52b788, transparent) 1;
        }

        .bd-markdown h2 {
            font-size: 1.45rem;
            color: #7edce8;
            padding-inline-start: .6rem;
            border-inline-start: 3px solid #4dc9dd;
        }

        .bd-markdown h3 {
            font-size: 1.2rem;
            color: #9be3a8;
            padding-inline-start: .5rem;
            border-inline-start: 3px solid #52b788;
        }

        .bd-markdown h4 {
            font-size: 1.05rem;
            color: #f5d76e;
        }

        .bd-markdown h5 {
            font-size: .95rem;
            color: #d4b8f0;
        }

        .bd-markdown h6 {
            font-size: .88rem;
            color: #8a8a95;
        }

        /* Paragraph */
        .bd-markdown p {
            margin: 0 0 1em;
            color: #d0d0d8;
        }

        /* Links */
        .bd-markdown a {
            color: #4dc9dd;
            text-decoration: none;
            border-bottom: 1px dashed rgba(77, 201, 221, .5);
            transition: .2s;
            padding-inline-end: 2px;
        }

            .bd-markdown a:hover {
                color: #7edce8;
                border-bottom-style: solid;
                text-shadow: 0 0 12px rgba(77, 201, 221, .4);
            }

        /* Lists */
        .bd-markdown ul,
        .bd-markdown ol {
            margin: 0 0 1em;
            padding-inline-start: 1.75em;
        }

        .bd-markdown li {
            margin-bottom: .35em;
            color: #d0d0d8;
        }

            .bd-markdown li > ul,
            .bd-markdown li > ol {
                margin-top: .35em;
                margin-bottom: .35em;
            }

        .bd-markdown ul li::marker {
            color: #4dc9dd;
        }

        .bd-markdown ol li::marker {
            color: #52b788;
            font-weight: 600;
        }

        /* ============================================================
           INLINE CODE
        ============================================================ */
        .bd-markdown code {
            direction: ltr;
            unicode-bidi: embed;
            background: linear-gradient(135deg, #1f1a2e, #1a1a24);
            color: #ffa657;
            padding: .18em .5em;
            border-radius: 6px;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: .88em;
            border: 1px solid rgba(255, 166, 87, .25);
            text-align: left;
            font-weight: 500;
        }

        /* ============================================================
           CODE BLOCK
        ============================================================ */
        .bd-markdown pre {
            position: relative;
            direction: ltr !important;
            text-align: left !important;
            unicode-bidi: embed;
            background: #0d0d13;
            border: 1px solid #2a2a34;
            border-radius: 10px;
            padding: 2.85rem 1.15rem 1rem 1.15rem;
            margin: 0 0 1.4em;
            overflow-x: auto;
            line-height: 1.65;
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            transition: border-color .25s ease, box-shadow .25s ease;
        }

            .bd-markdown pre:hover {
                border-color: rgba(77, 201, 221, .35);
                box-shadow: 0 0 0 1px rgba(77, 201, 221, .08), 0 8px 30px rgba(77, 201, 221, .06);
            }

            .bd-markdown pre code {
                direction: ltr !important;
                text-align: left !important;
                unicode-bidi: embed;
                background: transparent !important;
                color: #e0e0e8;
                padding: 0 !important;
                border: none !important;
                font-size: .85rem;
                display: block;
                white-space: pre;
                font-family: inherit;
                border-radius: 0;
                tab-size: 4;
                font-weight: 400;
            }

                /* Override highlight.js theme background */
                .bd-markdown pre code.hljs {
                    background: transparent !important;
                    padding: 0 !important;
                }

            /* Custom scrollbar */
            .bd-markdown pre::-webkit-scrollbar {
                height: 8px;
            }

            .bd-markdown pre::-webkit-scrollbar-track {
                background: transparent;
            }

            .bd-markdown pre::-webkit-scrollbar-thumb {
                background: #2a2a34;
                border-radius: 4px;
            }

                .bd-markdown pre::-webkit-scrollbar-thumb:hover {
                    background: linear-gradient(90deg, #4dc9dd, #52b788);
                }

        /* ============================================================
           COPY BUTTON & LANGUAGE BADGE
        ============================================================ */
        .bd-markdown .bd-copy-btn {
            position: absolute;
            top: .5rem;
            right: .5rem;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .3rem .7rem;
            background: #1c1c24;
            border: 1px solid #2a2a34;
            color: #b8b8c0;
            border-radius: 6px;
            font-size: .72rem;
            font-family: 'Segoe UI', system-ui, sans-serif;
            cursor: pointer;
            transition: all .2s;
            z-index: 3;
            line-height: 1;
            direction: rtl;
        }

            .bd-markdown .bd-copy-btn:hover {
                background: #2a2a34;
                color: #4dc9dd;
                border-color: #4dc9dd;
                box-shadow: 0 0 15px rgba(77, 201, 221, .3);
            }

            .bd-markdown .bd-copy-btn.copied {
                background: rgba(82, 183, 136, .15);
                color: #52b788;
                border-color: #52b788;
                box-shadow: 0 0 15px rgba(82, 183, 136, .3);
            }

            .bd-markdown .bd-copy-btn i {
                font-size: .72rem;
            }

        .bd-markdown .bd-lang-badge {
            position: absolute;
            top: .5rem;
            left: .5rem;
            padding: .25rem .6rem;
            background: #1c1c24;
            border: 1px solid #2a2a34;
            color: #8a8a95;
            border-radius: 6px;
            font-size: .65rem;
            font-family: 'Consolas', monospace;
            text-transform: uppercase;
            letter-spacing: .5px;
            z-index: 3;
            line-height: 1;
            font-weight: 700;
        }

            /* Colorful language badges */
            .bd-markdown .bd-lang-badge[data-lang="csharp"],
            .bd-markdown .bd-lang-badge[data-lang="cs"] {
                color: #9b59b6;
                border-color: rgba(155, 89, 182, .4);
                background: rgba(155, 89, 182, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="javascript"],
            .bd-markdown .bd-lang-badge[data-lang="js"] {
                color: #f1c40f;
                border-color: rgba(241, 196, 15, .4);
                background: rgba(241, 196, 15, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="typescript"],
            .bd-markdown .bd-lang-badge[data-lang="ts"] {
                color: #3498db;
                border-color: rgba(52, 152, 219, .4);
                background: rgba(52, 152, 219, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="python"],
            .bd-markdown .bd-lang-badge[data-lang="py"] {
                color: #4dc9dd;
                border-color: rgba(77, 201, 221, .4);
                background: rgba(77, 201, 221, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="sql"] {
                color: #e74c3c;
                border-color: rgba(231, 76, 60, .4);
                background: rgba(231, 76, 60, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="html"] {
                color: #e67e22;
                border-color: rgba(230, 126, 34, .4);
                background: rgba(230, 126, 34, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="css"] {
                color: #3498db;
                border-color: rgba(52, 152, 219, .4);
                background: rgba(52, 152, 219, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="json"] {
                color: #f39c12;
                border-color: rgba(243, 156, 18, .4);
                background: rgba(243, 156, 18, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="bash"],
            .bd-markdown .bd-lang-badge[data-lang="shell"] {
                color: #52b788;
                border-color: rgba(82, 183, 136, .4);
                background: rgba(82, 183, 136, .1);
            }

            .bd-markdown .bd-lang-badge[data-lang="xml"] {
                color: #e67e22;
                border-color: rgba(230, 126, 34, .4);
                background: rgba(230, 126, 34, .1);
            }

        /* ============================================================
           BLOCKQUOTE
        ============================================================ */
        .bd-markdown blockquote {
            border-inline-start: 4px solid;
            border-image: linear-gradient(180deg, #4dc9dd, #52b788) 1;
            background: linear-gradient(90deg, rgba(77, 201, 221, .06), transparent);
            padding: .85rem 1.15rem;
            margin: 0 0 1.2em;
            border-radius: 0 10px 10px 0;
            color: #b8c8d0;
            font-style: italic;
            position: relative;
        }

            .bd-markdown blockquote::before {
                content: '"';
                position: absolute;
                top: -8px;
                inset-inline-start: 8px;
                font-size: 3rem;
                color: rgba(77, 201, 221, .15);
                font-family: Georgia, serif;
                line-height: 1;
            }

            .bd-markdown blockquote > *:last-child {
                margin-bottom: 0;
            }

        /* ============================================================
           HORIZONTAL RULE
        ============================================================ */
        .bd-markdown hr {
            border: none;
            height: 1px;
            background: linear-gradient(90deg, transparent, #4dc9dd, #52b788, transparent);
            margin: 2em 0;
            opacity: .5;
        }

        /* ============================================================
           TABLES
        ============================================================ */
        .bd-markdown table {
            width: 100%;
            border-collapse: collapse;
            margin: 0 0 1.4em;
            font-size: .88rem;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #2a2a34;
        }

        .bd-markdown thead {
            background: linear-gradient(135deg, rgba(77, 201, 221, .12), rgba(82, 183, 136, .08));
        }

        .bd-markdown th {
            color: #7edce8;
            text-align: right;
            padding: .75rem .95rem;
            font-weight: 700;
            border-bottom: 2px solid rgba(77, 201, 221, .3);
            font-size: .85rem;
        }

        .bd-markdown td {
            padding: .6rem .95rem;
            border-bottom: 1px solid #2a2a34;
            color: #d0d0d8;
        }

        .bd-markdown tbody tr:nth-child(even) {
            background: rgba(255, 255, 255, .015);
        }

        .bd-markdown tbody tr:hover {
            background: rgba(77, 201, 221, .05);
        }

        .bd-markdown tr:last-child td {
            border-bottom: none;
        }

        /* ============================================================
           IMAGES, STRONG, EM
        ============================================================ */
        .bd-markdown img {
            max-width: 100%;
            border-radius: 10px;
            border: 1px solid #2a2a34;
            margin: .5em 0;
            transition: transform .3s ease, box-shadow .3s ease;
        }

            .bd-markdown img:hover {
                transform: scale(1.01);
                box-shadow: 0 8px 30px rgba(0, 0, 0, .4);
            }

        .bd-markdown strong {
            color: #ffffff;
            font-weight: 700;
            text-shadow: 0 0 8px rgba(255, 255, 255, .1);
        }

        .bd-markdown em {
            color: #c084fc;
            font-style: italic;
        }

        /* Task list */
        .bd-markdown input[type="checkbox"] {
            margin-inline-end: .4em;
            accent-color: #4dc9dd;
        }

        /* Keyboard key */
        .bd-markdown kbd {
            background: #14141c;
            border: 1px solid #2a2a34;
            border-bottom-width: 2px;
            border-radius: 5px;
            padding: .15em .5em;
            font-size: .8em;
            color: #f1c40f;
            font-family: 'Consolas', monospace;
        }

    /* ============================================================
           SCORE
        ============================================================ */
    .bd-content-empty {
        color: #8a8a95;
        font-style: italic;
        font-size: .9rem;
        text-align: center;
        padding: 2rem 0;
    }

    .bd-score-box {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, #14141c, #1a1a24);
        border: 1px solid #2a2a34;
        border-radius: 12px;
        margin-bottom: 1rem;
    }

    .bd-score-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: 800;
        flex-shrink: 0;
        position: relative;
    }

        .bd-score-circle::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px dashed rgba(255, 255, 255, .12);
        }

    .bd-score-high {
        background: linear-gradient(135deg, rgba(82, 183, 136, .2), rgba(82, 183, 136, .1));
        color: #52b788;
        box-shadow: 0 0 30px rgba(82, 183, 136, .25);
