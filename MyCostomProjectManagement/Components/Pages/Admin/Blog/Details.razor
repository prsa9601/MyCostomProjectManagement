    .bd-score-mid {
        background: linear-gradient(135deg, rgba(241, 196, 15, .2), rgba(241, 196, 15, .1));
        color: #f1c40f;
        box-shadow: 0 0 30px rgba(241, 196, 15, .25);
    }

    .bd-score-low {
        background: linear-gradient(135deg, rgba(231, 76, 60, .2), rgba(231, 76, 60, .1));
        color: #ff7b6b;
        box-shadow: 0 0 30px rgba(231, 76, 60, .25);
    }

    .bd-score-info {
        flex: 1;
        min-width: 0;
    }

    .bd-score-label {
        font-size: .78rem;
        color: #8a8a95;
        margin-bottom: .25rem;
    }

    .bd-score-value {
        font-size: 1rem;
        color: #eaeaea;
        font-weight: 600;
    }

    .bd-score-max {
        font-size: .8rem;
        color: #8a8a95;
        font-weight: 400;
    }

    .bd-reason {
        background: linear-gradient(90deg, #14141c, #181822);
        border-right: 3px solid;
        border-image: linear-gradient(180deg, #4dc9dd, #52b788) 1;
        padding: .85rem 1rem;
        border-radius: 0 10px 10px 0;
        color: #d0d0d8;
        font-size: .88rem;
        line-height: 1.8;
        white-space: pre-wrap;
    }

    /* ============================================================
           MODAL
        ============================================================ */
    .bd-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .65);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
        animation: bd-fade-in .2s;
    }

    .bd-modal {
        background: #1c1c24;
        border: 1px solid #2a2a34;
        border-radius: 16px;
        max-width: 420px;
        width: 100%;
        padding: 2rem 1.5rem 1.25rem;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .5);
        animation: bd-slide-up .25s;
    }

    @@keyframes bd-slide-up {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .bd-modal-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 1rem;
        background: linear-gradient(135deg, rgba(231, 76, 60, .2), rgba(231, 76, 60, .08));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff7b6b;
        font-size: 1.8rem;
        box-shadow: 0 0 30px rgba(231, 76, 60, .2);
    }

    .bd-modal h3 {
        margin: 0 0 .5rem;
        color: #eaeaea;
        font-size: 1.15rem;
    }

    .bd-modal p {
        color: #8a8a95;
        font-size: .9rem;
        line-height: 1.7;
        margin: 0 0 1.5rem;
    }

    .bd-modal strong {
        color: #eaeaea;
    }

    .bd-modal-actions {
        display: flex;
        gap: .6rem;
        justify-content: center;
    }

    /* ============================================================
           TOAST
        ============================================================ */
    .bd-toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        padding: .85rem 1.4rem;
        border-radius: 12px;
        font-size: .9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .55rem;
        z-index: 2000;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .3);
        animation: bd-toast-in .3s;
    }

    @@keyframes bd-toast-in {
        from {
            transform: translate(-50%, 20px);
            opacity: 0;
        }

        to {
            transform: translate(-50%, 0);
            opacity: 1;
        }
    }

    .bd-toast-success {
        background: linear-gradient(135deg, #52b788, #3d9970);
        color: #fff;
        box-shadow: 0 8px 24px rgba(82, 183, 136, .35);
    }

    .bd-toast-error {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: #fff;
        box-shadow: 0 8px 24px rgba(231, 76, 60, .35);
    }

    /* ============================================================
           RESPONSIVE
        ============================================================ */
    @@media (max-width: 992px) {
        .bd-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .bd-hero-title {
            font-size: 1.2rem;
        }

        .bd-topbar {
            flex-direction: column;
            align-items: stretch;
        }

        .bd-actions {
            justify-content: center;
        }

        .bd-back {
            justify-content: center;
        }

        .bd-markdown h1 {
            font-size: 1.4rem;
        }

        .bd-markdown h2 {
            font-size: 1.2rem;
        }

        .bd-markdown h3 {
            font-size: 1.05rem;
        }
