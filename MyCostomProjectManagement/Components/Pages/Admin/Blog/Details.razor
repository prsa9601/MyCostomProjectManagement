</style>

<!-- ============================================================
     PAGE
============================================================ -->
<div class="blog-details-page">

    @if (isLoading)
    {
        <div class="bd-state">
            <div class="bd-spinner"></div>
            <h3>در حال بارگذاری...</h3>
        </div>
    }
    else if (blog == null)
    {
        <div class="bd-state">
            <i class="fas fa-newspaper"></i>
            <h3>مقاله یافت نشد</h3>
            <p>
                مقاله‌ای با شناسه
                <strong>@(Id)</strong>
                در پایگاه داده موجود نیست.
            </p>
            <button class="bd-back" style="margin-top:1rem;"
                    @onclick="GoBack">
                <i class="fas fa-arrow-right"></i>
                بازگشت به لیست
            </button>
        </div>
    }
    else
    {
        <!-- Top Bar -->
        <div class="bd-topbar">
            <button class="bd-back" @onclick="GoBack" disabled="@isProcessing">
                <i class="fas fa-arrow-right"></i>
                بازگشت به لیست
            </button>

            <div class="bd-actions">
                <button class="bd-btn @(blog.IsApproved ? "bd-btn-approve" : "bd-btn-approve is-off")"
                        @onclick="ToggleApproved"
                        disabled="@isProcessing">
                    <i class="fas @(blog.IsApproved ? "fa-check-circle" : "fa-circle-notch")"></i>
                    @(blog.IsApproved ? "لغو تأیید" : "تأیید مقاله")
                </button>

                <button class="bd-btn @(blog.IsActive ? "bd-btn-active" : "bd-btn-active is-off")"
                        @onclick="ToggleActive"
                        disabled="@isProcessing">
                    <i class="fas @(blog.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                    @(blog.IsActive ? "غیرفعال کردن" : "فعال کردن")
                </button>

                @if (blog.IsDelete)
                {
                    <button class="bd-btn bd-btn-restore"
                            @onclick="RestoreBlog"
                            disabled="@isProcessing">
                        <i class="fas fa-undo"></i>
                        بازگردانی
                    </button>
                }
                else
                {
                    <button class="bd-btn bd-btn-danger"
                            @onclick="() => showDeleteModal = true"
                            disabled="@isProcessing">
                        <i class="fas fa-trash"></i>
                        حذف
                    </button>
                }
            </div>
        </div>

        <!-- Hero -->
        <div class="bd-hero">
            <h1 class="bd-hero-title">@blog.Title</h1>

            <div class="bd-hero-meta">
                <span>
                    <i class="fas fa-hashtag"></i>
                    @(string.IsNullOrWhiteSpace(blog.Topic) ? "بدون موضوع" : blog.Topic)
                </span>
                <span>
                    <i class="far fa-calendar-alt"></i>
                    @ToPersianDate(blog.CreatedAt == default ? blog.CreationDate : blog.CreatedAt)
                </span>
                <span>
                    <i class="fas fa-fingerprint"></i>
                    API ID: @blog.BlogApiId
                </span>
            </div>

            <div class="bd-tags">
                @if (!string.IsNullOrWhiteSpace(blog.Mode))
                {
                    <span class="bd-tag bd-tag-neutral">
                        <i class="fas fa-cog"></i> @blog.Mode
                    </span>
                }

                <span class="bd-tag @GetScoreTagClass(blog.Score)">
                    <i class="fas fa-star"></i> امتیاز: @blog.Score از ۱۰
                </span>

                @if (blog.IsUseful)
                {
                    <span class="bd-tag bd-tag-useful">
                        <i class="fas fa-thumbs-up"></i> مفید
                    </span>
                }

                <span class="bd-tag @GetSeoTagClass(blog.SeoStatus)">
                    <i class="fas fa-search"></i> سئو: @GetSeoText(blog.SeoStatus)
                </span>

                <span class="bd-tag @(blog.IsApproved ? "bd-tag-approved" : "bd-tag-pending")">
                    <i class="fas @(blog.IsApproved ? "fa-check-circle" : "fa-clock")"></i>
                    @(blog.IsApproved ? "تأیید شده" : "در انتظار")
                </span>

                <span class="bd-tag @(blog.IsActive ? "bd-tag-active" : "bd-tag-inactive")">
                    <i class="fas @(blog.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                    @(blog.IsActive ? "فعال" : "غیرفعال")
                </span>

                @if (blog.IsDelete)
                {
                    <span class="bd-tag bd-tag-deleted">
                        <i class="fas fa-trash"></i> حذف‌شده
                    </span>
                }
            </div>
        </div>

        <!-- Grid -->
        <div class="bd-grid">

            <!-- LEFT: Main Content -->
            <div>

                <!-- Score Card -->
                <div class="bd-card" style="margin-bottom:1.25rem;">
                    <div class="bd-card-header">
                        <h2 class="bd-card-title">
                            <i class="fas fa-star"></i>
                            ارزیابی و امتیاز
                        </h2>
                    </div>
                    <div class="bd-card-body">
                        <div class="bd-score-box">
                            <div class="bd-score-circle @GetScoreCircleClass(blog.Score)">
                                @blog.Score
                            </div>
                            <div class="bd-score-info">
                                <div class="bd-score-label">امتیاز کلی</div>
                                <div class="bd-score-value">
                                    @GetScoreLabel(blog.Score)
                                    <span class="bd-score-max">(@blog.Score از ۱۰)</span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(blog.ScoreReason))
                        {
                            <div class="bd-reason">
                                <strong style="color:#4dc9dd;">
                                    <i class="fas fa-info-circle"></i>
                                    دلیل امتیاز:
                                </strong>
                                <br />
                                @blog.ScoreReason
                            </div>
                        }
                        else
                        {
                            <p style="color:#8a8a95; font-size:.85rem; margin:0; font-style:italic;">
                                دلیلی برای امتیاز ثبت نشده است.
                            </p>
                        }
                    </div>
                </div>

                <!-- Content Card (Markdown) -->
                <div class="bd-card">
                    <div class="bd-card-header">
                        <h2 class="bd-card-title">
                            <i class="fas fa-file-alt"></i>
                            محتوای مقاله
                        </h2>
                        <span style="font-size:.75rem; color:#8a8a95;">
                            @(blog.Content?.Length ?? 0) کاراکتر
                        </span>
                    </div>
                    <div class="bd-card-body">
                        @if (string.IsNullOrWhiteSpace(blog.Content))
                        {
                            <div class="bd-content-empty">
                                <i class="fas fa-inbox" style="display:block; font-size:2rem; margin-bottom:.75rem; opacity:.4;"></i>
                                محتوایی ثبت نشده است.
                            </div>
                        }
                        else
                        {
                            <div class="bd-markdown">
                                @((MarkupString)RenderMarkdown(blog.Content))
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- RIGHT: Sidebar -->
            <div>

                <div class="bd-card" style="margin-bottom:1.25rem;">
                    <div class="bd-card-header">
                        <h2 class="bd-card-title">
                            <i class="fas fa-info-circle"></i>
                            اطلاعات
                        </h2>
                    </div>
                    <div class="bd-card-body" style="padding:.6rem 1.25rem;">
                        <ul class="bd-info-list">

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-fingerprint"></i>
                                    شناسه API
                                </span>
                                <span class="bd-info-value mono">@blog.BlogApiId</span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-key"></i>
                                    شناسه داخلی
                                </span>
                                <span class="bd-info-value mono" title="@blog.Id">
                                    @ShortenGuid(blog.Id)
                                </span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-cog"></i>
                                    حالت
                                </span>
                                <span class="bd-info-value">
                                    @(string.IsNullOrWhiteSpace(blog.Mode) ? "—" : blog.Mode)
                                </span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-star"></i>
                                    امتیاز
                                </span>
                                <span class="bd-info-value">
                                    @blog.Score از ۱۰
                                </span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-search"></i>
                                    وضعیت سئو
                                </span>
                                <span class="bd-info-value">@GetSeoText(blog.SeoStatus)</span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-thumbs-up"></i>
                                    مفید
                                </span>
                                <span class="bd-info-value">
                                    @(blog.IsUseful ? "بله" : "خیر")
                                </span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="far fa-calendar-alt"></i>
                                    تاریخ ایجاد
                                </span>
                                <span class="bd-info-value">
                                    @ToPersianDate(blog.CreatedAt == default ? blog.CreationDate : blog.CreatedAt)
                                </span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-clock"></i>
                                    تاریخ ثبت در سیستم
                                </span>
                                <span class="bd-info-value">
                                    @ToPersianDate(blog.CreationDate)
                                </span>
                            </li>

                        </ul>
                    </div>
                </div>

                <div class="bd-card">
                    <div class="bd-card-header">
                        <h2 class="bd-card-title">
                            <i class="fas fa-shield-alt"></i>
                            وضعیت
                        </h2>
                    </div>
                    <div class="bd-card-body" style="padding:.6rem 1.25rem;">
                        <ul class="bd-info-list">

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-check-circle"></i>
                                    تأیید
                                </span>
                                <span class="bd-info-value">
                                    <span class="bd-tag @(blog.IsApproved ? "bd-tag-approved" : "bd-tag-pending")">
                                        @(blog.IsApproved ? "تأیید شده" : "در انتظار")
                                    </span>
                                </span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-toggle-on"></i>
                                    فعال
                                </span>
                                <span class="bd-info-value">
                                    <span class="bd-tag @(blog.IsActive ? "bd-tag-active" : "bd-tag-inactive")">
                                        @(blog.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                </span>
                            </li>

                            <li class="bd-info-item">
                                <span class="bd-info-label">
                                    <i class="fas fa-trash"></i>
                                    حذف
                                </span>
                                <span class="bd-info-value">
                                    <span class="bd-tag @(blog.IsDelete ? "bd-tag-deleted" : "bd-tag-approved")">
                                        @(blog.IsDelete ? "حذف‌شده" : "سالم")
                                    </span>
                                </span>
                            </li>

                        </ul>
                    </div>
                </div>

            </div>

        </div>
    }

    <!-- DELETE MODAL -->
    @if (showDeleteModal && blog != null)
    {
        <div class="bd-modal-overlay" @onclick="() => showDeleteModal = false">
            <div class="bd-modal" @onclick:stopPropagation="true">
                <div class="bd-modal-icon">
                    <i class="fas fa-trash-alt"></i>
                </div>
                <h3>حذف مقاله</h3>
                <p>
                    آیا از حذف مقاله
                    <strong>«@blog.Title»</strong>
                    اطمینان دارید؟<br />
                    این عمل قابل بازگشت است (Soft Delete).
                </p>
                <div class="bd-modal-actions">
                    <button class="bd-btn"
                            style="background:#2a2a34; color:#eaeaea;"
                            @onclick="() => showDeleteModal = false"
                            disabled="@isProcessing">
                        انصراف
                    </button>
                    <button class="bd-btn"
                            style="background:linear-gradient(135deg,#e74c3c,#c0392b); color:#fff;"
                            @onclick="ConfirmDelete"
                            disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>در حال حذف...</span>
                        }
                        else
                        {
                            <i class="fas fa-trash"></i>
                            <span>حذف کن</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- TOAST -->
    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="bd-toast @(toastIsError ? "bd-toast-error" : "bd-toast-success")">
            <i class="fas @(toastIsError ? "fa-exclamation-circle" : "fa-check-circle")"></i>
            @toastMessage
        </div>
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    private Blog? blog;
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showDeleteModal = false;

    private string toastMessage = "";
    private bool toastIsError = false;
    private System.Threading.Timer? toastTimer;

    private bool _jsReady = false;
    private bool _needsCodeEnhance = false;

    private static readonly MarkdownPipeline MdPipeline =
        new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .UseSoftlineBreakAsHardlineBreak()
            .Build();

    // ============================================================
    // JS: Highlight + Copy + Language Badge
    // ============================================================
    private const string CodeEnhanceJs = """
        (function () {
            // ---- بارگذاری highlight.js فقط یک بار ----
            if (!window.__hljsLoaded) {
                window.__hljsLoaded = true;
                var s1 = document.createElement('script');
                s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js';
                s1.onload = function () {
                    // زبان‌های رایج
                    var langs = ['csharp','javascript','typescript','python','sql','xml','json','bash','css','plaintext'];
                    var loaded = 0;
                    langs.forEach(function (l) {
                        if (l === 'plaintext') return;
                        var s = document.createElement('script');
                        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/' + l + '.min.js';
                        s.onload = s.onerror = function () {
                            loaded++;
                            if (loaded === langs.length - 1) window.__hljsReady = true;
                        };
                        document.head.appendChild(s);
                    });
                };
                document.head.appendChild(s1);
            }

            // ---- تابع اصلی: تزئین کد بلاک‌ها ----
            window.__bdEnhanceCodeBlocks = function () {
                var pres = document.querySelectorAll('.bd-markdown pre');
                pres.forEach(function (pre) {
                    if (pre.getAttribute('data-enhanced') === '1') return;
                    pre.setAttribute('data-enhanced', '1');

                    var code = pre.querySelector('code');
                    var lang = '';
                    if (code && code.className) {
                        var m = code.className.match(/language-([A-Za-z0-9_+-]+)/);
                        if (m) lang = m[1].toLowerCase();
                    }

                    // ---- Language badge ----
                    if (lang) {
                        var badge = document.createElement('span');
                        badge.className = 'bd-lang-badge';
                        badge.setAttribute('data-lang', lang);
                        badge.textContent = lang === 'csharp' ? 'C#' : lang;
                        pre.appendChild(badge);
                    }

                    // ---- Copy button ----
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'bd-copy-btn';
                    btn.setAttribute('aria-label', 'کپی کد');
                    btn.innerHTML = '<i class="fas fa-copy"></i><span>کپی</span>';

                    btn.addEventListener('click', function () {
                        var codeEl = pre.querySelector('code');
                        var text = codeEl ? codeEl.textContent : pre.textContent;

                        var finish = function (ok) {
                            if (ok) {
                                btn.classList.add('copied');
                                btn.innerHTML = '<i class="fas fa-check"></i><span>کپی شد!</span>';
                            } else {
                                btn.innerHTML = '<i class="fas fa-times"></i><span>خطا</span>';
                            }
                            setTimeout(function () {
                                btn.classList.remove('copied');
                                btn.innerHTML = '<i class="fas fa-copy"></i><span>کپی</span>';
                            }, 2000);
                        };

                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(text)
                                .then(function () { finish(true); })
                                .catch(function () { finish(false); });
                        } else {
                            try {
                                var ta = document.createElement('textarea');
                                ta.value = text;
                                ta.style.position = 'fixed';
                                ta.style.top = '-9999px';
                                document.body.appendChild(ta);
                                ta.focus();
                                ta.select();
                                document.execCommand('copy');
                                document.body.removeChild(ta);
                                finish(true);
                            } catch (e) { finish(false); }
                        }
                    });

                    pre.appendChild(btn);
                });

                // ---- اعمال highlight ----
                var applyHl = function () {
                    if (typeof hljs === 'undefined') return;
                    document.querySelectorAll('.bd-markdown pre code').forEach(function (el) {
                        if (el.getAttribute('data-highlighted') === '1') return;
                        try {
                            hljs.highlightElement(el);
                            el.setAttribute('data-highlighted', '1');
                        } catch (e) { /* ignore */ }
                    });
                };

                if (typeof hljs !== 'undefined') {
                    applyHl();
                } else {
                    // منتظر بمان تا اسکریپت‌ها لود شوند
                    var tries = 0;
                    var iv = setInterval(function () {
                        tries++;
                        if (typeof hljs !== 'undefined' || tries > 40) {
                            clearInterval(iv);
                            applyHl();
                        }
                    }, 100);
                }
            };
        })();
        """;

    // ============================================================
    // LIFECYCLE
    // ============================================================
    protected override async Task OnParametersSetAsync()
    {
        await LoadBlog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jsReady)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", CodeEnhanceJs);
                _jsReady = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[BlogDetails] JS init error: {ex.Message}");
                return;
            }
        }

        if (_needsCodeEnhance)
        {
            _needsCodeEnhance = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("__bdEnhanceCodeBlocks");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[BlogDetails] Enhance error: {ex.Message}");
            }
        }
    }

    // ============================================================
    // DATA
    // ============================================================
    private async Task LoadBlog()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            blog = await db.Blogs.AsNoTracking()
                                 .FirstOrDefaultAsync(x => x.BlogApiId == Id);

            if (blog != null)
                _needsCodeEnhance = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BlogDetails] Load error: {ex.Message}");
            blog = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // MARKDOWN RENDER
    // ============================================================
    private static string RenderMarkdown(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        try
        {
            return Markdown.ToHtml(content, MdPipeline);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BlogDetails] Markdown error: {ex.Message}");
            return $"<pre>{System.Net.WebUtility.HtmlEncode(content)}</pre>";
        }
    }

    // ============================================================
    // ACTIONS
    // ============================================================
    private async Task ToggleApproved()
    {
        if (blog == null || isProcessing) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == blog.Id);
            if (entity == null) return;

            entity.IsApproved = !entity.IsApproved;

            if (!entity.IsApproved && entity.IsActive)
                entity.IsActive = false;

            await db.SaveChangesAsync();

            ShowToast(entity.IsApproved ? "مقاله تأیید شد" : "تأیید مقاله لغو شد");
            await LoadBlog();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BlogDetails] ToggleApproved error: {ex.Message}");
            ShowToast("خطا در تغییر وضعیت تأیید", true);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ToggleActive()
    {
        if (blog == null || isProcessing) return;

        if (!blog.IsActive && !blog.IsApproved)
        {
            ShowToast("ابتدا باید مقاله را تأیید کنید", true);
            return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == blog.Id);
            if (entity == null) return;

            entity.IsActive = !entity.IsActive;
            await db.SaveChangesAsync();

            ShowToast(entity.IsActive ? "مقاله فعال شد" : "مقاله غیرفعال شد");
            await LoadBlog();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BlogDetails] ToggleActive error: {ex.Message}");
            ShowToast("خطا در تغییر وضعیت", true);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete()
    {
        if (blog == null || isProcessing) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == blog.Id);
            if (entity != null)
            {
                entity.IsDelete = true;
                entity.IsActive = false;
                await db.SaveChangesAsync();
            }

            showDeleteModal = false;
            ShowToast("مقاله با موفقیت حذف شد");
            await LoadBlog();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BlogDetails] Delete error: {ex.Message}");
            ShowToast("خطا در حذف مقاله", true);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RestoreBlog()
    {
        if (blog == null || isProcessing) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == blog.Id);
            if (entity == null) return;

            entity.IsDelete = false;
            await db.SaveChangesAsync();

            ShowToast("مقاله با موفقیت بازگردانی شد");
            await LoadBlog();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BlogDetails] Restore error: {ex.Message}");
            ShowToast("خطا در بازگردانی مقاله", true);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void GoBack() => Navigation.NavigateTo("/Admin/Blogs");

    private void ShowToast(string message, bool isError = false)
    {
        toastMessage = message;
        toastIsError = isError;
        StateHasChanged();

        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                toastMessage = "";
                StateHasChanged();
            });
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

