@page "/Admin/Blogs"
@layout AdminLayout
@rendermode InteractiveServer
@inject IBlogApiService BlogApiService
@inject NavigationManager Navigation
@inject IDbContextFactory<Context> _dbFactory
@inject IJSRuntime JSRuntime
@using BackEnd.Data.DB
@using BackEnd.Data.Entities.Blogs
@using BackEnd.Data.Infrastructure.Blog
@using BackEnd.Data.Infrastructure.Blog.DTOs
@using Microsoft.EntityFrameworkCore

<PageTitle>مدیریت مقالات | پنل ادمین</PageTitle>

<!-- ============================================================
     STYLES
============================================================ -->
<style>
    /* ---------- Header ---------- */
    .blogs-page .tutorials-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

        .blogs-page .tutorials-header h1 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #eaeaea;
            display: flex;
            align-items: center;
            gap: .6rem;
            margin: 0;
        }

            .blogs-page .tutorials-header h1 .fa-newspaper {
                color: #4dc9dd;
            }

    .blogs-page .badge-count {
        background: rgba(77, 201, 221, .15);
        color: #4dc9dd;
        padding: .25rem .7rem;
        border-radius: 20px;
        font-size: .8rem;
        font-weight: 500;
        margin-inline-start: .5rem;
    }

    .blogs-page .btn-add {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: linear-gradient(135deg, #4dc9dd, #3aa8bd);
        color: #fff;
        border: none;
        padding: .6rem 1.1rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: .9rem;
        cursor: pointer;
        transition: .2s;
        box-shadow: 0 4px 12px rgba(77, 201, 221, .25);
    }

        .blogs-page .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(77, 201, 221, .35);
        }

    /* ---------- Filters ---------- */
    .blogs-page .filters-bar {
        display: flex;
        gap: .75rem;
        align-items: center;
        flex-wrap: wrap;
        padding: 1rem;
        background: #1c1c24;
        border: 1px solid #2a2a34;
        border-radius: 14px;
        margin-bottom: 1.5rem;
    }

    .blogs-page .filter-input {
        flex: 1;
        min-width: 200px;
        background: #14141c;
        border: 1px solid #2a2a34;
        color: #eaeaea;
        padding: .6rem 1rem;
        border-radius: 10px;
        font-size: .9rem;
        outline: none;
        transition: .2s;
        font-family: inherit;
    }

        .blogs-page .filter-input:focus {
            border-color: #4dc9dd;
            box-shadow: 0 0 0 3px rgba(77, 201, 221, .15);
        }

    .blogs-page .filter-select {
        background: #14141c;
        border: 1px solid #2a2a34;
        color: #eaeaea;
        padding: .6rem 1rem;
        border-radius: 10px;
        font-size: .9rem;
        outline: none;
        cursor: pointer;
        font-family: inherit;
        min-width: 130px;
        transition: .2s;
    }

        .blogs-page .filter-select:focus {
            border-color: #4dc9dd;
        }

    .blogs-page .btn-search {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #2a2a34;
        color: #eaeaea;
        border: 1px solid #353540;
        padding: .6rem 1rem;
        border-radius: 10px;
        cursor: pointer;
        font-size: .85rem;
        font-family: inherit;
        transition: .2s;
    }

        .blogs-page .btn-search:hover {
            background: #353540;
            border-color: #4dc9dd;
            color: #4dc9dd;
        }

    /* ---------- State Box ---------- */
    .blogs-page .state-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        background: #1c1c24;
        border: 1px solid #2a2a34;
        border-radius: 14px;
        color: #8a8a95;
        text-align: center;
        gap: .75rem;
    }

        .blogs-page .state-box i {
            font-size: 3rem;
            color: #4dc9dd;
            opacity: .6;
        }

        .blogs-page .state-box h3 {
            margin: 0;
            color: #eaeaea;
            font-size: 1.1rem;
        }

        .blogs-page .state-box p {
            margin: 0;
            font-size: .9rem;
        }

    .blogs-page .spinner {
        width: 42px;
        height: 42px;
        border: 3px solid #2a2a34;
        border-top-color: #4dc9dd;
        border-radius: 50%;
        animation: blogs-spin 0.8s linear infinite;
    }

    @@keyframes blogs-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ---------- Grid ---------- */
    .blogs-page .tutorials-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1.1rem;
    }

    /* ---------- Card ---------- */
    .blogs-page .tutorial-card {
        background: #1c1c24;
        border: 1px solid #2a2a34;
        border-radius: 14px;
        padding: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: .85rem;
        transition: .2s;
        position: relative;
        overflow: hidden;
    }

        .blogs-page .tutorial-card:hover {
            border-color: rgba(77, 201, 221, .4);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, .25);
        }

        .blogs-page .tutorial-card.is-deleted {
            opacity: .65;
            border-right: 3px solid #e74c3c;
        }

    .blogs-page .tutorial-card-header {
        display: flex;
        align-items: flex-start;
        gap: .8rem;
    }

    .blogs-page .tutorial-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

        .blogs-page .tutorial-icon.cat-language {
            background: rgba(77, 201, 221, .15);
            color: #4dc9dd;
        }

        .blogs-page .tutorial-icon.cat-framework {
            background: rgba(155, 89, 182, .15);
            color: #9b59b6;
        }

        .blogs-page .tutorial-icon.cat-tool {
            background: rgba(241, 196, 15, .15);
            color: #f1c40f;
        }

        .blogs-page .tutorial-icon.cat-concept {
            background: rgba(82, 183, 136, .15);
            color: #52b788;
        }

    .blogs-page .tutorial-card h3 {
        font-size: 1rem;
        font-weight: 600;
        color: #eaeaea;
        margin: 0 0 .25rem 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blogs-page .tutorial-card .topic {
        font-size: .78rem;
        color: #8a8a95;
        display: flex;
        align-items: center;
        gap: .35rem;
    }

    /* ---------- Slug Row ---------- */
    .blogs-page .slug-row {
        font-size: .72rem;
        color: #8a8a95;
        display: flex;
        align-items: center;
        gap: .35rem;
        font-family: monospace;
        direction: ltr;
        justify-content: flex-end;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        padding: 0 .25rem;
    }

        .blogs-page .slug-row i {
            color: #4dc9dd;
            flex-shrink: 0;
        }

    /* ---------- Tags ---------- */
    .blogs-page .tags-row {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
    }

    .blogs-page .tag {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-size: .72rem;
        padding: .28rem .6rem;
        border-radius: 20px;
        font-weight: 500;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .blogs-page .tag-subject {
        background: rgba(77, 201, 221, .12);
        color: #4dc9dd;
        border-color: rgba(77, 201, 221, .25);
    }

    .blogs-page .tag-approved {
        background: rgba(82, 183, 136, .12);
        color: #52b788;
        border-color: rgba(82, 183, 136, .25);
    }

    .blogs-page .tag-pending {
        background: rgba(241, 196, 15, .12);
        color: #f1c40f;
        border-color: rgba(241, 196, 15, .25);
    }

    .blogs-page .tag-active {
        background: rgba(77, 201, 221, .12);
        color: #4dc9dd;
        border-color: rgba(77, 201, 221, .25);
    }

    .blogs-page .tag-inactive {
        background: rgba(138, 138, 149, .12);
        color: #8a8a95;
        border-color: rgba(138, 138, 149, .25);
    }

    .blogs-page .tag-deleted {
        background: rgba(231, 76, 60, .12);
        color: #e74c3c;
        border-color: rgba(231, 76, 60, .3);
    }

    .blogs-page .tag-level-beginner {
        background: rgba(82, 183, 136, .12);
        color: #52b788;
        border-color: rgba(82, 183, 136, .25);
    }

    .blogs-page .tag-level-intermediate {
        background: rgba(241, 196, 15, .12);
        color: #f1c40f;
        border-color: rgba(241, 196, 15, .25);
    }

    .blogs-page .tag-level-advanced {
        background: rgba(231, 76, 60, .12);
        color: #e74c3c;
        border-color: rgba(231, 76, 60, .25);
    }

    .blogs-page .tag-level-all {
        background: rgba(77, 201, 221, .12);
        color: #4dc9dd;
        border-color: rgba(77, 201, 221, .25);
    }

    /* ---------- Stats ---------- */
    .blogs-page .tutorial-stats {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        padding: .6rem .75rem;
        background: #14141c;
        border-radius: 10px;
    }

        .blogs-page .tutorial-stats .stat {
            display: flex;
            align-items: center;
            gap: .4rem;
            font-size: .75rem;
            color: #8a8a95;
        }

            .blogs-page .tutorial-stats .stat i {
                color: #4dc9dd;
            }

    /* ---------- Footer ---------- */
    .blogs-page .tutorial-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        padding-top: .75rem;
        border-top: 1px solid #2a2a34;
        margin-top: auto;
    }

    .blogs-page .tutorial-date {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .75rem;
        color: #8a8a95;
    }

    .blogs-page .tutorial-actions {
        display: flex;
        gap: .3rem;
    }

    .blogs-page .btn-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #14141c;
        border: 1px solid #2a2a34;
        color: #8a8a95;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: .8rem;
        transition: .2s;
    }

        .blogs-page .btn-icon:hover {
            background: #2a2a34;
            color: #eaeaea;
            border-color: #4dc9dd;
        }

        .blogs-page .btn-icon.edit:hover {
            color: #4dc9dd;
            border-color: #4dc9dd;
        }

        .blogs-page .btn-icon.approve.is-on {
            color: #52b788;
            background: rgba(82, 183, 136, .12);
            border-color: rgba(82, 183, 136, .35);
        }

        .blogs-page .btn-icon.approve:hover {
            color: #52b788;
            border-color: #52b788;
        }

        .blogs-page .btn-icon.toggle.is-on {
            color: #4dc9dd;
            background: rgba(77, 201, 221, .12);
            border-color: rgba(77, 201, 221, .35);
        }

        .blogs-page .btn-icon.toggle:hover {
            color: #4dc9dd;
            border-color: #4dc9dd;
        }

        .blogs-page .btn-icon.restore:hover {
            color: #f1c40f;
            border-color: #f1c40f;
        }

        .blogs-page .btn-icon.delete:hover {
            color: #e74c3c;
            border-color: #e74c3c;
        }

    /* ---------- Pagination ---------- */
    .blogs-page .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: .4rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

        .blogs-page .pagination button {
            min-width: 38px;
            height: 38px;
            padding: 0 .8rem;
            background: #1c1c24;
            border: 1px solid #2a2a34;
            color: #eaeaea;
            border-radius: 10px;
            cursor: pointer;
            font-size: .85rem;
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .3rem;
            transition: .2s;
        }

            .blogs-page .pagination button:hover:not(:disabled) {
                border-color: #4dc9dd;
                color: #4dc9dd;
            }

            .blogs-page .pagination button.active {
                background: linear-gradient(135deg, #4dc9dd, #3aa8bd);
                color: #fff;
                border-color: transparent;
            }

            .blogs-page .pagination button:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

    /* ---------- Modal ---------- */
    .blogs-page .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .6);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
        animation: blogs-fade-in .2s;
    }

    @@keyframes blogs-fade-in {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .blogs-page .modal-box {
        background: #1c1c24;
        border: 1px solid #2a2a34;
        border-radius: 16px;
        width: 100%;
        max-width: 720px;
        max-height: 90vh;
        overflow-y: auto;
        animation: blogs-slide-up .25s;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .5);
    }

    @@keyframes blogs-slide-up {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .blogs-page .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid #2a2a34;
    }

        .blogs-page .modal-header h2 {
            margin: 0;
            font-size: 1.1rem;
            color: #eaeaea;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

    .blogs-page .modal-close {
        background: transparent;
        border: none;
        color: #8a8a95;
        font-size: 1.1rem;
        cursor: pointer;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }

        .blogs-page .modal-close:hover {
            background: #2a2a34;
            color: #e74c3c;
        }

    .blogs-page .modal-body {
        padding: 1.4rem;
    }

    .blogs-page .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
        padding: 1rem 1.4rem;
        border-top: 1px solid #2a2a34;
    }

    /* ---------- Form ---------- */
    .blogs-page .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .blogs-page .form-field {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

        .blogs-page .form-field.full {
            grid-column: 1 / -1;
        }

        .blogs-page .form-field label {
            font-size: .82rem;
            color: #b8b8c0;
            display: flex;
            align-items: center;
            gap: .35rem;
            font-weight: 500;
        }

            .blogs-page .form-field label i {
                color: #4dc9dd;
                font-size: .8rem;
            }

        .blogs-page .form-field .required {
            color: #e74c3c;
        }

        .blogs-page .form-field input[type="text"],
        .blogs-page .form-field input[type="number"],
        .blogs-page .form-field select,
        .blogs-page .form-field textarea {
            background: #14141c;
            border: 1px solid #2a2a34;
            color: #eaeaea;
            padding: .65rem .9rem;
            border-radius: 10px;
            font-size: .88rem;
            outline: none;
            font-family: inherit;
            transition: .2s;
            width: 100%;
            box-sizing: border-box;
        }

            .blogs-page .form-field input:focus,
            .blogs-page .form-field select:focus,
            .blogs-page .form-field textarea:focus {
                border-color: #4dc9dd;
                box-shadow: 0 0 0 3px rgba(77, 201, 221, .15);
            }

        .blogs-page .form-field textarea {
            min-height: 140px;
            resize: vertical;
            line-height: 1.7;
        }

    .blogs-page .slug-input-row {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .blogs-page .slug-input-row input {
            flex: 1;
        }

    .blogs-page .checkbox-row {
        display: flex;
        gap: 1.2rem;
        flex-wrap: wrap;
    }

    .blogs-page .checkbox-item {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        cursor: pointer;
        font-size: .85rem;
        color: #eaeaea;
    }

        .blogs-page .checkbox-item input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #4dc9dd;
            cursor: pointer;
        }

    .blogs-page .validation-msg {
        background: rgba(231, 76, 60, .1);
        border: 1px solid rgba(231, 76, 60, .3);
        color: #e74c3c;
        padding: .7rem 1rem;
        border-radius: 10px;
        font-size: .85rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    /* ---------- Buttons ---------- */
    .blogs-page .btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem 1.2rem;
        border-radius: 10px;
        font-size: .88rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid transparent;
        transition: .2s;
        font-family: inherit;
    }

        .blogs-page .btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    .blogs-page .btn-primary {
        background: linear-gradient(135deg, #4dc9dd, #3aa8bd);
        color: #fff;
        box-shadow: 0 4px 12px rgba(77, 201, 221, .25);
    }

        .blogs-page .btn-primary:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(77, 201, 221, .35);
        }

    .blogs-page .btn-secondary {
        background: #2a2a34;
        color: #eaeaea;
        border-color: #353540;
    }

        .blogs-page .btn-secondary:hover:not(:disabled) {
            background: #353540;
        }

    .blogs-page .btn-danger {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: #fff;
        box-shadow: 0 4px 12px rgba(231, 76, 60, .25);
    }

        .blogs-page .btn-danger:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(231, 76, 60, .35);
        }

    /* ---------- Delete Modal ---------- */
    .blogs-page .delete-modal {
        max-width: 420px;
    }

        .blogs-page .delete-modal .modal-body {
            text-align: center;
            padding: 2rem 1.5rem;
        }

    .blogs-page .delete-icon-wrap {
        width: 72px;
        height: 72px;
        margin: 0 auto 1rem;
        background: rgba(231, 76, 60, .12);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e74c3c;
        font-size: 1.8rem;
    }

    .blogs-page .delete-modal h3 {
        margin: 0 0 .5rem;
        color: #eaeaea;
        font-size: 1.15rem;
    }

    .blogs-page .delete-modal p {
        color: #8a8a95;
        font-size: .9rem;
        line-height: 1.7;
        margin: 0;
    }

    .blogs-page .delete-modal strong {
        color: #eaeaea;
    }

    /* ---------- Toast ---------- */
    .blogs-page .toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        padding: .85rem 1.4rem;
        border-radius: 12px;
        font-size: .9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .55rem;
        z-index: 2000;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .3);
        animation: blogs-toast-in .3s;
    }

    @@keyframes blogs-toast-in {
        from {
            transform: translate(-50%, 20px);
            opacity: 0;
        }

        to {
            transform: translate(-50%, 0);
            opacity: 1;
        }
    }

    .blogs-page .toast-success {
        background: rgba(82, 183, 136, .95);
        color: #fff;
    }

    .blogs-page .toast-error {
        background: rgba(231, 76, 60, .95);
        color: #fff;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 768px) {
        .blogs-page .tutorials-grid {
            grid-template-columns: 1fr;
        }

        .blogs-page .form-grid {
            grid-template-columns: 1fr;
        }

        .blogs-page .filters-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .blogs-page .filter-select,
        .blogs-page .btn-search {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<!-- ============================================================
     PAGE WRAPPER
============================================================ -->
<div class="blogs-page">

    <!-- ============================================================
         HEADER
    ============================================================ -->
    <div class="tutorials-header">
        <h1>
            <i class="fas fa-newspaper"></i>
            مدیریت مقالات
            @if (totalCount > 0)
            {
                <span class="badge-count">@totalCount.ToString("N0") مورد</span>
            }
        </h1>
        <button class="btn-add" @onclick="ReloadFromApi">
            <i class="fas fa-sync-alt"></i>
            همگام‌سازی با API
        </button>
    </div>

    <!-- ============================================================
         FILTERS
    ============================================================ -->
    <div class="filters-bar">
        <input type="text"
               class="filter-input"
               placeholder="جستجو در عنوان..."
               @bind="searchTerm"
               @bind:event="oninput"
               @onkeydown="OnSearchKeyDown" />

        <select class="filter-select" @bind="filterSeoStatus">
            <option value="">همه وضعیت‌های سئو</option>
            <option value="pending">در انتظار</option>
            <option value="approved">تأیید شده</option>
            <option value="rejected">رد شده</option>
            <option value="null">بدون وضعیت</option>
        </select>

        <select class="filter-select" @bind="filterStatus">
            <option value="">همه وضعیت‌ها</option>
            <option value="approved">تأیید شده</option>
            <option value="pending">در انتظار تأیید</option>
            <option value="active">فعال</option>
            <option value="inactive">غیرفعال</option>
            <option value="deleted">حذف‌شده</option>
            <option value="useful">مفید</option>
        </select>

        <button class="btn-search" @onclick="ApplyFilters">
            <i class="fas fa-search"></i>
            اعمال فیلتر
        </button>

        <button class="btn-search" @onclick="ResetFilters" title="پاک کردن فیلترها">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <!-- ============================================================
         CONTENT
    ============================================================ -->
    @if (isLoading)
    {
        <div class="state-box">
            <div class="spinner"></div>
            <h3>در حال بارگذاری...</h3>
        </div>
    }
    else if (blogs == null || blogs.Count == 0)
    {
        <div class="state-box">
            <i class="fas fa-inbox"></i>
            <h3>هیچ مقاله‌ای یافت نشد</h3>
            <p>هنوز مقاله‌ای اضافه نشده یا فیلترها نتیجه‌ای نداشتند.</p>
        </div>
    }
    else
    {
        <div class="tutorials-grid">
            @foreach (var b in blogs)
            {
                <div class="tutorial-card @(b.IsDelete ? "is-deleted" : "")">
                    <div class="tutorial-card-header">
                        <div class="tutorial-icon @GetSeoClass(b.SeoStatus)">
                            <i class="fas fa-newspaper"></i>
                        </div>
                        <div style="flex:1; min-width:0;">
                            <h3 title="@b.Title">@b.Title</h3>
                            <div class="topic">
                                <i class="fas fa-hashtag"></i>
                                @(string.IsNullOrWhiteSpace(b.Topic) ? "بدون موضوع" : b.Topic)
                            </div>
                        </div>
                    </div>

                    <!-- 👇 نمایش Slug روی کارت -->
                    @if (!string.IsNullOrWhiteSpace(b.Slug))
                    {
                        <div class="slug-row" title="@b.Slug">
                            <i class="fas fa-link"></i>
                            <span>@b.Slug</span>
                        </div>
                    }

                    <div class="tags-row">
                        @if (!string.IsNullOrWhiteSpace(b.Mode))
                        {
                            <span class="tag tag-subject">
                                <i class="fas fa-cog"></i> @b.Mode
                            </span>
                        }
                        <span class="tag @GetScoreClass(b.Score)">
                            <i class="fas fa-star"></i> امتیاز: @b.Score
                        </span>
                        @if (b.IsUseful)
                        {
                            <span class="tag tag-approved">
                                <i class="fas fa-thumbs-up"></i> مفید
                            </span>
                        }
                        <span class="tag @GetSeoTagClass(b.SeoStatus)">
                            <i class="fas fa-search"></i> سئو: @GetSeoText(b.SeoStatus)
                        </span>
                        <span class="tag @(b.IsApproved ? "tag-approved" : "tag-pending")">
                            <i class="fas @(b.IsApproved ? "fa-check-circle" : "fa-clock")"></i>
                            @(b.IsApproved ? "تأیید شده" : "در انتظار")
                        </span>
                        <span class="tag @(b.IsActive ? "tag-active" : "tag-inactive")">
                            <i class="fas @(b.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                            @(b.IsActive ? "فعال" : "غیرفعال")
                        </span>
                        @if (b.IsDelete)
                        {
                            <span class="tag tag-deleted">
                                <i class="fas fa-trash"></i> حذف‌شده
                            </span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(b.ScoreReason))
                    {
                        <div class="tutorial-stats">
                            <div class="stat" style="width:100%;">
                                <i class="fas fa-info-circle"></i>
                                <span title="@b.ScoreReason">@Truncate(b.ScoreReason, 80)</span>
                            </div>
                        </div>
                    }

                    <div class="tutorial-stats">
                        <div class="stat">
                            <i class="fas fa-fingerprint"></i>
                            <span>API: @b.BlogApiId</span>
                        </div>
                    </div>

                    <div class="tutorial-footer">
                        <div class="tutorial-date">
                            <i class="far fa-calendar-alt"></i>
                            @ToPersianDate(b.CreatedAt == default ? b.CreationDate : b.CreatedAt)
                        </div>
                        <div class="tutorial-actions">
                            <button class="btn-icon" title="مشاهده"
                                    @onclick="() => ViewBlog(b.BlogApiId)">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn-icon edit" title="ویرایش"
                                    @onclick="() => OpenEditModal(b)">
                                <i class="fas fa-pen"></i>
                            </button>

                            <button class="btn-icon approve @(b.IsApproved ? "is-on" : "")"
                                    title="@(b.IsApproved ? "لغو تأیید" : "تأیید مقاله")"
                                    @onclick="() => ToggleApproved(b)">
                                <i class="fas @(b.IsApproved ? "fa-check-circle" : "fa-circle-notch")"></i>
                            </button>

                            <button class="btn-icon toggle @(b.IsActive ? "is-on" : "")"
                                    title="@(b.IsActive ? "غیرفعال کردن" : "فعال کردن")"
                                    @onclick="() => ToggleActive(b)">
                                <i class="fas @(b.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                            </button>

                            @if (b.IsDelete)
                            {
                                <button class="btn-icon restore" title="بازگردانی"
                                        @onclick="() => RestoreBlog(b)">
                                    <i class="fas fa-undo"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn-icon delete" title="حذف"
                                        @onclick="() => OpenDeleteModal(b)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage <= 1)">
                    <i class="fas fa-chevron-right"></i>
                    قبلی
                </button>

                @foreach (var p in GetPageNumbers())
                {
                    var pageNum = p;
                    <button class="@(pageNum == currentPage ? "active" : "")"
                            @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }

                <button @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage >= totalPages)">
                    بعدی
                    <i class="fas fa-chevron-left"></i>
                </button>
            </div>
        }
    }

    <!-- ============================================================
         EDIT MODAL
    ============================================================ -->
    @if (showFormModal)
    {
        <div class="modal-overlay" @onclick="CloseFormModal">
            <div class="modal-box" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>
                        <i class="fas fa-pen"></i>
                        ویرایش مقاله
                    </h2>
                    <button class="modal-close" @onclick="CloseFormModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-field full">
                            <label><i class="fas fa-heading"></i> عنوان <span class="required">*</span></label>
                            <input type="text" @bind="formModel.Title" maxlength="500" placeholder="عنوان مقاله..." />
                        </div>

                        <!-- 👇 فیلد جدید: Slug -->
                        <div class="form-field full">
                            <label><i class="fas fa-link"></i> اسلاگ (Slug)</label>
                            <div class="slug-input-row">
                                <input type="text" @bind="formModel.Slug" maxlength="500"
                                       placeholder="مثلاً: how-to-use-blazor"
                                       dir="ltr" />
                                <button type="button" class="btn-search"
                                        @onclick="GenerateSlugFromTitle"
                                        title="تولید خودکار از عنوان">
                                    <i class="fas fa-magic"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-field">
                            <label><i class="fas fa-hashtag"></i> موضوع</label>
                            <input type="text" @bind="formModel.Topic" maxlength="300" placeholder="موضوع مقاله" />
                        </div>

                        <div class="form-field">
                            <label><i class="fas fa-cog"></i> حالت (Mode)</label>
                            <input type="text" @bind="formModel.Mode" maxlength="50" placeholder="مثلاً: auto" />
                        </div>

                        <div class="form-field">
                            <label><i class="fas fa-star"></i> امتیاز</label>
                            <input type="number" @bind="formModel.Score" min="0" max="100" />
                        </div>

                        <div class="form-field">
                            <label><i class="fas fa-search"></i> وضعیت سئو</label>
                            <select @bind="formModel.SeoStatus">
                                <option value="">بدون وضعیت</option>
                                <option value="pending">در انتظار</option>
                                <option value="approved">تأیید شده</option>
                                <option value="rejected">رد شده</option>
                            </select>
                        </div>

                        <div class="form-field full">
                            <label><i class="fas fa-info-circle"></i> دلیل امتیاز</label>
                            <textarea @bind="formModel.ScoreReason" maxlength="1000"
                                      placeholder="توضیح امتیاز..." style="min-height:80px;"></textarea>
                        </div>

                        <div class="form-field full">
                            <label><i class="fas fa-file-alt"></i> محتوا</label>
                            <textarea @bind="formModel.Content" placeholder="محتوای مقاله..."></textarea>
                        </div>

                        <div class="form-field full">
                            <div class="checkbox-row">
                                <label class="checkbox-item">
                                    <input type="checkbox" @bind="formModel.IsUseful" />
                                    <i class="fas fa-thumbs-up" style="color:#4dc9dd"></i>
                                    مفید
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" @bind="formModel.IsApproved" />
                                    <i class="fas fa-check-circle" style="color:#52b788"></i>
                                    تأیید شده
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" @bind="formModel.IsActive" />
                                    <i class="fas fa-toggle-on" style="color:#4dc9dd"></i>
                                    فعال
                                </label>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <div class="form-field full">
                                <div class="validation-msg">
                                    <i class="fas fa-exclamation-circle"></i> @formError
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseFormModal" disabled="@isSaving">
                        انصراف
                    </button>
                    <button class="btn btn-primary" @onclick="SaveBlog" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>در حال ذخیره...</span>
                        }
                        else
                        {
                            <i class="fas fa-save"></i>
                            <span>ذخیره</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ============================================================
         DELETE MODAL
    ============================================================ -->
    @if (showDeleteModal && selectedForDelete != null)
    {
        <div class="modal-overlay" @onclick="CloseDeleteModal">
            <div class="modal-box delete-modal" @onclick:stopPropagation="true">
                <div class="modal-body">
                    <div class="delete-icon-wrap">
                        <i class="fas fa-trash-alt"></i>
                    </div>
                    <h3>حذف مقاله</h3>
                    <p>
                        آیا از حذف مقاله
                        <strong>«@selectedForDelete.Title»</strong>
                        اطمینان دارید؟ این عمل قابل بازگشت است (Soft Delete).
                    </p>
                </div>
                <div class="modal-footer" style="justify-content:center;">
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal" disabled="@isDeleting">
                        انصراف
                    </button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>در حال حذف...</span>
                        }
                        else
                        {
                            <i class="fas fa-trash"></i>
                            <span>حذف کن</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ============================================================
         TOAST
    ============================================================ -->
    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="toast @(toastIsError ? "toast-error" : "toast-success")">
            <i class="fas @(toastIsError ? "fa-exclamation-circle" : "fa-check-circle")"></i>
            @toastMessage
        </div>
    }

</div>

@code {
    // ============================================================
    // STATE
    // ============================================================
    private const int PageSize = 12;

    private List<Blog>? blogs;
    private int currentPage = 1;
    private int totalCount = 0;
    private int totalPages = 0;
    private bool isLoading = true;

    // Filters
    private string searchTerm = "";
    private string filterSeoStatus = "";
    private string filterStatus = "";

    // Form Modal
    private bool showFormModal = false;
    private bool isSaving = false;
    private string formError = "";
    private Guid editingId = Guid.Empty;
    private BlogFormModel formModel = new();

    // Delete Modal
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private Blog? selectedForDelete;

    // Toast
    private string toastMessage = "";
    private bool toastIsError = false;
    private System.Threading.Timer? toastTimer;

    // ============================================================
    // LIFECYCLE
    // ============================================================
    protected override async Task OnInitializedAsync()
    {
        await LoadBlogs();
    }

    // ============================================================
    // DATA LOADING
    // ============================================================
    private async Task LoadBlogs()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var filter = new BlogFilterParam
            {
                PageId = currentPage,
                Take = PageSize,
                IsAdmin = true
            };

            var result = await BlogApiService.GetFilter(filter);

            var allBlogs = result?.Data ?? new List<Blog>();

            // ---- فیلترهای کلاینت‌ساید روی داده‌های این صفحه ----
            var filtered = allBlogs.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(b =>
                    !string.IsNullOrWhiteSpace(b.Title) &&
                    b.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filterSeoStatus))
            {
                if (filterSeoStatus == "null")
                    filtered = filtered.Where(b => string.IsNullOrWhiteSpace(b.SeoStatus));
                else
                    filtered = filtered.Where(b => string.Equals(b.SeoStatus, filterSeoStatus, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filterStatus))
            {
                filtered = filterStatus switch
                {
                    "approved" => filtered.Where(b => b.IsApproved),
                    "pending" => filtered.Where(b => !b.IsApproved),
                    "active" => filtered.Where(b => b.IsActive),
                    "inactive" => filtered.Where(b => !b.IsActive),
                    "deleted" => filtered.Where(b => b.IsDelete),
                    "useful" => filtered.Where(b => b.IsUseful),
                    _ => filtered
                };
            }

            blogs = filtered.ToList();
            totalCount = result?.EntityCount ?? allBlogs.Count;
            totalPages = (int)Math.Ceiling((double)totalCount / PageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Blogs] Load error: {ex.Message}");
            blogs = new List<Blog>();
            totalCount = 0;
            totalPages = 0;
            ShowToast("خطا در بارگذاری داده‌ها", true);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReloadFromApi()
    {
        currentPage = 1;
        await LoadBlogs();
        ShowToast("همگام‌سازی با API انجام شد");
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadBlogs();
    }

    private async Task ResetFilters()
    {
        searchTerm = "";
        filterSeoStatus = "";
        filterStatus = "";
        currentPage = 1;
        await LoadBlogs();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplyFilters();
    }

    // ============================================================
    // PAGINATION
    // ============================================================
    private async Task GoToPage(int page)
    {
        if (page < 1 || (totalPages > 0 && page > totalPages)) return;
        currentPage = page;
        await LoadBlogs();
        await JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 0, behavior: 'smooth' })");
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int maxVisible = 5;
        var start = Math.Max(1, currentPage - maxVisible / 2);
        var end = Math.Min(totalPages, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
            start = Math.Max(1, end - maxVisible + 1);

        for (int i = start; i <= end; i++)
            yield return i;
    }

    // ============================================================
    // FORM MODAL
    // ============================================================
    private void OpenEditModal(Blog b)
    {
        editingId = b.Id;
        formModel = new BlogFormModel
        {
            BlogApiId = b.BlogApiId,
            Title = b.Title,
            Slug = b.Slug ?? "",
            Topic = b.Topic ?? "",
            Content = b.Content ?? "",
            Mode = b.Mode ?? "",
            Score = b.Score,
            ScoreReason = b.ScoreReason ?? "",
            IsUseful = b.IsUseful,
            SeoStatus = b.SeoStatus ?? "",
            IsApproved = b.IsApproved,
            IsActive = b.IsActive
        };
        formError = "";
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        if (isSaving) return;
        showFormModal = false;
        formError = "";
    }

    private void GenerateSlugFromTitle()
    {
        if (string.IsNullOrWhiteSpace(formModel.Title))
        {
            formModel.Slug = string.Empty;
            return;
        }

        var slug = formModel.Title.Trim().ToLowerInvariant();

        // ۱) نیم‌فاصله فارسی (ZWNJ / ZWJ) → خط تیره
        slug = slug.Replace("\u200C", "-").Replace("\u200D", "-");

        // ۲) علائم خاص فارسی و انگلیسی → خط تیره
        slug = System.Text.RegularExpressions.Regex.Replace(
            slug,
            @"[؟?!:؛،\.«»\(\)\[\]\{\}'""`~@#\$%\^&\*\+=\|\\/<>…—–]",
            "-");

        // ۳) ⭐ فاصله (و هر نوع whitespace) → خط تیره  ← باید قبل از مرحله ۴ باشد
        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"\s+", "-");

        // ۴) حذف کاراکترهای غیرمجاز (حالا دیگر فضایی نمانده که حذف شود)
        slug = System.Text.RegularExpressions.Regex.Replace(
            slug,
            @"[^\w\u0600-\u06FF\-]",
            "");

        // ۵) underscore → dash
        slug = slug.Replace("_", "-");

        // ۶) چند dash پشت سر هم → یکی
        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"-+", "-");

        // ۷) dash ابتدا و انتها → حذف
        formModel.Slug = slug.Trim('-');
    }
    private async Task SaveBlog()
    {
        if (string.IsNullOrWhiteSpace(formModel.Title))
        {
            formError = "عنوان مقاله الزامی است.";
            return;
        }
        if (formModel.Title.Length > 500)
        {
            formError = "عنوان نباید بیشتر از ۵۰۰ کاراکتر باشد.";
            return;
        }
        if ((formModel.Slug?.Length ?? 0) > 500)
        {
            formError = "اسلاگ نباید بیشتر از ۵۰۰ کاراکتر باشد.";
            return;
        }
        if ((formModel.Topic?.Length ?? 0) > 300)
        {
            formError = "موضوع نباید بیشتر از ۳۰۰ کاراکتر باشد.";
            return;
        }
        if ((formModel.Mode?.Length ?? 0) > 50)
        {
            formError = "حالت (Mode) نباید بیشتر از ۵۰ کاراکتر باشد.";
            return;
        }
        if ((formModel.ScoreReason?.Length ?? 0) > 1000)
        {
            formError = "دلیل امتیاز نباید بیشتر از ۱۰۰۰ کاراکتر باشد.";
            return;
        }
        if (formModel.Score < 0)
        {
            formError = "امتیاز نمی‌تواند منفی باشد.";
            return;
        }
        if (formModel.IsActive && !formModel.IsApproved)
        {
            formError = "نمی‌توان مقاله‌ای را فعال کرد که هنوز تأیید نشده است.";
            return;
        }

        formError = "";
        isSaving = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();

            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == editingId);
            if (entity == null)
            {
                formError = "مقاله موردنظر یافت نشد.";
                return;
            }

            entity.Title = formModel.Title.Trim();
            entity.Slug = formModel.Slug?.Trim() ?? "";
            entity.Topic = formModel.Topic?.Trim() ?? "";
            entity.Content = formModel.Content ?? "";
            entity.Mode = formModel.Mode?.Trim() ?? "";
            entity.Score = formModel.Score;
            entity.ScoreReason = formModel.ScoreReason?.Trim() ?? "";
            entity.IsUseful = formModel.IsUseful;
            entity.SeoStatus = string.IsNullOrWhiteSpace(formModel.SeoStatus) ? null : formModel.SeoStatus;
            entity.IsApproved = formModel.IsApproved;
            entity.IsActive = formModel.IsActive;

            await db.SaveChangesAsync();
            ShowToast("مقاله با موفقیت ویرایش شد");

            showFormModal = false;
            await LoadBlogs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Blogs] Save error: {ex.Message}");
            formError = "خطا در ذخیره‌سازی. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // DELETE (Soft Delete)
    // ============================================================
    private void OpenDeleteModal(Blog b)
    {
        selectedForDelete = b;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (isDeleting) return;
        showDeleteModal = false;
        selectedForDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (selectedForDelete == null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == selectedForDelete.Id);
            if (entity != null)
            {
                entity.IsDelete = true;
                entity.IsActive = false;
                await db.SaveChangesAsync();
            }

            ShowToast("مقاله با موفقیت حذف شد");
            showDeleteModal = false;
            selectedForDelete = null;
            await LoadBlogs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Blogs] Delete error: {ex.Message}");
            ShowToast("خطا در حذف مقاله", true);
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // RESTORE
    // ============================================================
    private async Task RestoreBlog(Blog b)
    {
        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == b.Id);
            if (entity == null) return;

            entity.IsDelete = false;
            await db.SaveChangesAsync();

            ShowToast("مقاله با موفقیت بازگردانی شد");
            await LoadBlogs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Blogs] Restore error: {ex.Message}");
            ShowToast("خطا در بازگردانی مقاله", true);
        }
    }

    // ============================================================
    // TOGGLE APPROVED
    // ============================================================
    private async Task ToggleApproved(Blog b)
    {
        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == b.Id);
            if (entity == null) return;

            entity.IsApproved = !entity.IsApproved;

            if (!entity.IsApproved && entity.IsActive)
            {
                entity.IsActive = false;
            }

            await db.SaveChangesAsync();

            ShowToast(entity.IsApproved ? "مقاله تأیید شد" : "تأیید مقاله لغو شد");
            await LoadBlogs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Blogs] ToggleApproved error: {ex.Message}");
            ShowToast("خطا در تغییر وضعیت تأیید", true);
        }
    }

    // ============================================================
    // TOGGLE ACTIVE
    // ============================================================
    private async Task ToggleActive(Blog b)
    {
        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Blogs.FirstOrDefaultAsync(x => x.Id == b.Id);
            if (entity == null) return;

            if (!entity.IsActive && !entity.IsApproved)
            {
                ShowToast("ابتدا باید مقاله را تأیید کنید", true);
                return;
            }

            entity.IsActive = !entity.IsActive;
            await db.SaveChangesAsync();

            ShowToast(entity.IsActive ? "مقاله فعال شد" : "مقاله غیرفعال شد");
            await LoadBlogs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Blogs] Toggle error: {ex.Message}");
            ShowToast("خطا در تغییر وضعیت", true);
        }
    }

