    private static string GetSeoClass(string? seo) => seo?.ToLower() switch
    {
        "approved" => "cat-language",
        "pending" => "cat-tool",
        "rejected" => "cat-framework",
        _ => "cat-concept"
    };

    private static string GetSeoTagClass(string? seo) => seo?.ToLower() switch
    {
        "approved" => "tag-approved",
        "pending" => "tag-pending",
        "rejected" => "tag-deleted",
        _ => "tag-inactive"
    };

    private static string GetSeoText(string? seo) => seo?.ToLower() switch
    {
        "approved" => "تأیید شده",
        "pending" => "در انتظار",
        "rejected" => "رد شده",
        _ => "بدون وضعیت"
    };

    private static string GetScoreClass(int score) => score switch
    {
        >= 80 => "tag-approved",
        >= 50 => "tag-level-intermediate",
        _ => "tag-pending"
    };

    private static string Truncate(string? text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        return text.Length <= max ? text : text.Substring(0, max) + "...";
    }

    private static string ToPersianDate(DateTime dt)
    {
        try
        {
            var pc = new System.Globalization.PersianCalendar();
            return $"{pc.GetYear(dt):0000}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00}";
        }
        catch
        {
            return dt.ToString("yyyy/MM/dd");
        }
    }

