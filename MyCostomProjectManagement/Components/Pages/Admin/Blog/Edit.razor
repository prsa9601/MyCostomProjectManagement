    // ============================================================
    // راه‌اندازی CKEditor (با ارائه‌دهنده سفارشی برای ویدیو)
    // ============================================================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await InitializeCKEditor();
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task InitializeCKEditor()
    {
        var content = (post.Content ?? "").Replace("\\", "\\\\")
                                          .Replace("`", "\\`")
                                          .Replace("$", "\\$");

        await JSRuntime.InvokeVoidAsync("eval", $@"
            (async function() {{
                const loadCKEditor = () => new Promise(resolve => {{
                    if (window.CKEditor) {{ resolve(); return; }}
                    const script = document.createElement('script');
                    script.src = 'https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js';
                    script.onload = resolve;
                    document.head.appendChild(script);
                }});
                const loadTranslation = () => new Promise(resolve => {{
                    const script = document.createElement('script');
                    script.src = 'https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/translations/fa.js';
                    script.onload = resolve;
                    document.head.appendChild(script);
                }});
                await loadCKEditor();
                await loadTranslation();

                // آداپتور آپلود برای دکمه داخلی تصویر CKEditor
                class UploadAdapter {{
                    constructor(loader) {{ this.loader = loader; }}
                    upload() {{
                        return this.loader.file.then(file => new Promise((resolve, reject) => {{
                            const formData = new FormData();
                            formData.append('file', file);
                            fetch('/api/upload', {{ method: 'POST', body: formData }})
                                .then(async response => {{
                                    const text = await response.text();
                                    try {{
                                        const data = JSON.parse(text);
                                        if (data.url) resolve({{ default: data.url }});
                                        else reject(data.error || 'آپلود ناموفق');
                                    }} catch (e) {{
                                        reject('پاسخ سرور معتبر نیست: ' + text.substring(0, 100));
                                    }}
                                }})
                                .catch(reject);
                        }}));
                    }}
                    abort() {{}}
                }}
                function uploadPlugin(editor) {{
                    editor.plugins.get('FileRepository').createUploadAdapter = (loader) => new UploadAdapter(loader);
                }}

                const container = document.getElementById('editorContainer');
                if (container) {{
                    ClassicEditor
                        .create(container, {{
                            language: 'fa',
                            toolbar: {{
                                items: [
                                    'heading', '|',
                                    'bold', 'italic', 'underline', 'strikethrough', '|',
                                    'link', '|',
                                    'bulletedList', 'numberedList', '|',
                                    'blockQuote', '|',
                                    'imageUpload', 'mediaEmbed', '|',
                                    'undo', 'redo'
                                ]
                            }},
                            image: {{ toolbar: [ 'imageStyle:inline', 'imageStyle:block', 'imageStyle:side', '|', 'imageTextAlternative' ] }},
                            extraPlugins: [uploadPlugin],
                            mediaEmbed: {{
                                providers: [
                                    {{
                                        name: 'youtube',
                                        url: /^https?:\/\/(?:m\.)?youtube\.com\/watch\?v=([\w-]+)/,
                                        html: match => `<div style='position:relative;padding-bottom:56.25%;height:0;'><iframe src='https://www.youtube.com/embed/${{match[1]}}' style='position:absolute;top:0;left:0;width:100%;height:100%;' frameborder='0' allowfullscreen></iframe></div>`
                                    }},
                                    {{
                                        name: 'vimeo',
                                        url: /^https?:\/\/(?:www\.)?vimeo\.com\/(\d+)/,
                                        html: match => `<div style='position:relative;padding-bottom:56.25%;height:0;'><iframe src='https://player.vimeo.com/video/${{match[1]}}' style='position:absolute;top:0;left:0;width:100%;height:100%;' frameborder='0' allowfullscreen></iframe></div>`
                                    }},
                                    {{
                                        name: 'uploaded-video',
                                        url: /^https?:\/\/.+\/uploads\/.+\.(mp4|webm|ogg|mov)$/,
                                        html: match => `<video controls style='max-width:100%; width:800px; height:auto; border-radius:8px; margin:8px 0;'><source src='${{match.input}}' type='video/${{match[1]}}'></video>`
                                    }}
                                ]
                            }},
                            initialData: `{content}` || ''
                        }})
                        .then(editor => {{
                            window.editor = editor;
                            editor.model.document.on('change:data', () => {{
                                const data = editor.getData();
                                DotNet.invokeMethodAsync('{this.GetType().Assembly.GetName().Name}', 'UpdatePostContent', data);
                            }});
                        }})
                        .catch(error => console.error('CKEditor init error:', error));
                }}
            }})();
        ");
    }

    [JSInvokable]
    public static void UpdatePostContent(string content)
    {
        if (_currentPage != null)
        {
            _currentPage.post.Content = content;
            _currentPage.StateHasChanged();
        }
    }

    // ============================================================
    // عملیات CRUD
    // ============================================================
    private async Task SavePost()
    {
        if (string.IsNullOrWhiteSpace(post.Title) || string.IsNullOrWhiteSpace(post.Content))
        {
            await _alertService.Warning("لطفاً عنوان و محتوای مطلب را وارد کنید.", "تکمیل فیلدها", 4000);
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            if (IsEditMode)
            {
                var existing = posts.FirstOrDefault(p => p.Id == Id);
                if (existing != null)
                {
                    existing.Title = post.Title.Trim();
                    existing.Lang = post.Lang;
                    existing.IsPublished = post.IsPublished;
                    existing.Excerpt = post.Excerpt?.Trim() ?? "";
                    existing.Content = post.Content.Trim();
                    existing.ImageUrl = post.ImageUrl?.Trim() ?? "";
                    existing.Date = DateTime.Now.ToString("yyyy/MM/dd");
                }
                await _alertService.Success("مطلب با موفقیت ویرایش شد.", "ویرایش", 4000);
            }
            else
            {
                var newPost = new PostItem
                {
                    Id = "blog-" + (posts.Count + 1).ToString("D3"),
                    Title = post.Title.Trim(),
                    Lang = post.Lang,
                    IsPublished = post.IsPublished,
                    Excerpt = post.Excerpt?.Trim() ?? "",
                    Content = post.Content.Trim(),
                    ImageUrl = post.ImageUrl?.Trim() ?? "",
                    Date = DateTime.Now.ToString("yyyy/MM/dd")
                };
                posts.Add(newPost);
                await _alertService.Success("مطلب با موفقیت ایجاد شد.", "ایجاد", 4000);
            }
            NavigationManager.NavigateTo("/Admin/Blog", true);
        }
        catch (Exception ex)
        {
            await _alertService.Error($"خطا در ذخیره: {ex.Message}", "خطا", 6000);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task DeletePost()
    {
        if (!IsEditMode) return;
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"آیا از حذف مطلب '{post.Title}' اطمینان دارید؟");
        if (!confirmed) return;
        try
        {
            if (!string.IsNullOrEmpty(post.ImageUrl) && post.ImageUrl.StartsWith($"/{uploadFolder}/"))
            {
                var fileName = post.ImageUrl.Replace($"/{uploadFolder}/", "");
                var filePath = Path.Combine(WebHostEnvironment.WebRootPath, uploadFolder, fileName);
                if (File.Exists(filePath))
                    try { File.Delete(filePath); } catch { }
            }
            posts.RemoveAll(p => p.Id == Id);
            await _alertService.Success("مطلب با موفقیت حذف شد.", "حذف", 4000);
            NavigationManager.NavigateTo("/Admin/Blog", true);
        }
        catch (Exception ex)
        {
            await _alertService.Error($"خطا در حذف: {ex.Message}", "خطا", 6000);
        }
    }

    private void Cancel() => NavigationManager.NavigateTo("/Admin/Blog", true);

    // ============================================================
    // کلاس مدل
    // ============================================================
    public class PostItem
    {
        public string? Id { get; set; }
        public string Title { get; set; } = "";
        public string Lang { get; set; } = "fa";
        public bool IsPublished { get; set; }
        public string Excerpt { get; set; } = "";
        public string Content { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public string Date { get; set; } = "";
    }
}

<!-- ============================================================
     بخش HTML صفحه
     ============================================================ -->
<main class="dashboard">
    <div class="container">
        <div class="page-header fade-up visible">
            <div>
                <h1><i class="fas @(IsEditMode ? "fa-edit" : "fa-plus-circle")"></i> @(IsEditMode ? "ویرایش مطلب" : "مطلب جدید")</h1>
                <div class="subtitle">@(IsEditMode ? "اطلاعات مطلب را ویرایش کنید." : "مطلب جدید با محتوای کامل ایجاد کنید.")</div>
            </div>
            <div class="actions">
                <a href="/Admin/Blog" class="btn-back ripple"><i class="fas fa-arrow-right"></i> بازگشت</a>
            </div>
        </div>

        <div class="form-container fade-up visible">
            <div class="section-title">
                <i class="fas @(IsEditMode ? "fa-pen" : "fa-feather")"></i>
                @(IsEditMode ? "ویرایش مطلب" : "نوشتن مطلب جدید")
            </div>

            <div class="form-group">
                <label>عنوان مطلب <span class="required">*</span></label>
                <div class="input-wrapper">
                    <span class="input-icon"><i class="fas fa-tag"></i></span>
                    <input type="text" placeholder="عنوان مطلب را وارد کنید..." @bind="post.Title" />
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                <div class="form-group">
                    <label>زبان <span class="required">*</span></label>
                    <div class="input-wrapper">
                        <span class="input-icon"><i class="fas fa-globe"></i></span>
                        <select @bind="post.Lang">
                            <option value="fa">فارسی</option>
                            <option value="en">English</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>وضعیت انتشار</label>
                    <div class="toggle-wrapper">
                        <span class="toggle-label">پیش‌نویس</span>
                        <div class="toggle-switch @(post.IsPublished ? "active" : "")" @onclick="ToggleStatus">
                            <div class="toggle-knob"></div>
                        </div>
                        <span class="toggle-label">منتشر شده</span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>خلاصه مطلب</label>
                <div class="input-wrapper" style="align-items:stretch;">
                    <span class="input-icon" style="align-self:flex-start; padding-top:14px;"><i class="fas fa-align-left"></i></span>
                    <textarea placeholder="خلاصه‌ای از مطلب را وارد کنید..." @bind="post.Excerpt" rows="2"></textarea>
                </div>
            </div>

            <div class="form-group">
                <label>محتوای کامل <span class="required">*</span></label>
                <div style="display:flex; gap:8px; margin-bottom:8px; flex-wrap:wrap;">
                    <button class="custom-upload-btn" @onclick="TriggerImageUpload">
                        <i class="fas fa-image"></i> افزودن تصویر
                    </button>
                    <button class="custom-upload-btn" @onclick="TriggerVideoUpload">
                        <i class="fas fa-video"></i> افزودن ویدیو
                    </button>
                </div>
                <div class="ck-editor-container">
                    <div id="editorContainer"></div>
                </div>
                <InputFile id="inlineImageInput" class="hidden-input" OnChange="HandleInlineImageUpload" accept="image/*" />
                <InputFile id="videoInput" class="hidden-input" OnChange="HandleVideoUpload" accept="video/*" />
                <div style="font-size:0.7rem; color:#64748b; margin-top:6px;">
                    <i class="fas fa-info-circle"></i> برای افزودن تصویر یا ویدیو، از دکمه‌های بالای ویرایشگر استفاده کنید.
                </div>
            </div>

            <div class="form-group">
                <label>تصویر شاخص</label>
                <div class="upload-area">
                    <div class="file-input-wrapper">
                        <label for="featuredImageInput">
                            <i class="fas fa-cloud-upload-alt"></i> انتخاب تصویر شاخص
                        </label>
                        <InputFile id="featuredImageInput" OnChange="HandleFeaturedImageUpload" accept="image/*" />
                        <span style="color:#94a3b8;font-size:0.75rem;">(حداکثر ۲ مگابایت)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <div class="file-preview">
                            <img src="@post.ImageUrl" alt="تصویر شاخص" />
                            <span class="file-name">@(post.ImageUrl.Length > 30 ? post.ImageUrl.Substring(0, 30) + "..." : post.ImageUrl)</span>
                            <button class="btn-remove" @onclick="RemoveFeaturedImage"><i class="fas fa-times"></i> حذف</button>
                        </div>
                    }
                    else
                    {
                        <div style="color:#64748b;font-size:0.75rem;">هیچ تصویری انتخاب نشده است.</div>
                    }
                </div>
                <div style="font-size:0.7rem; color:#64748b; margin-top:4px;">
                    <i class="fas fa-info-circle"></i> تصویر برای نمایش در خلاصه و کارت‌های وبلاگ
                </div>
            </div>

            <div class="form-actions">
                <button class="btn-success ripple" @onclick="SavePost" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>در حال ذخیره...</span>
                    }
                    else
                    {
                        <span><i class="fas fa-save"></i> @(IsEditMode ? "ذخیره تغییرات" : "ایجاد مطلب")</span>
                    }
                </button>
                <button class="btn-outline ripple" @onclick="Cancel"><i class="fas fa-times"></i> انصراف</button>
                @if (IsEditMode)
                {
                    <button class="btn-outline ripple" @onclick="DeletePost" style="border-color:rgba(220,53,69,0.2); color:#dc3545;">
                        <i class="fas fa-trash-alt"></i> حذف مطلب
                    </button>
                }
            </div>
        </div>
    </div>
</main>
<script src="../../../../../../../GlobalAlert.js"></script>