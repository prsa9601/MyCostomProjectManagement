    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            // ۱) فقط یک بار جریان فایل را باز کن
            using var browserStream = file.OpenReadStream(MaxFileSize);
            using var memoryStream = new MemoryStream();
            await browserStream.CopyToAsync(memoryStream);
            var fileBytes = memoryStream.ToArray();  // کل بایت‌ها

            // ۲) پیش‌نمایش base64
            newMediaData = $"data:{file.ContentType};base64,{Convert.ToBase64String(fileBytes)}";

            // ۳) ساخت IFormFile از همان بایت‌ها (بدون فراخوانی دوبارهٔ OpenReadStream)
            var formFileStream = new MemoryStream(fileBytes); // stream جداگانه برای FormFile
            inputFile = new FormFile(
                baseStream: formFileStream,
                baseStreamOffset: 0,
                length: formFileStream.Length,
                name: file.Name,
                fileName: file.Name)
            {
                Headers = new HeaderDictionary(),
                ContentType = file.ContentType
            };

            //ShowToast("فایل با موفقیت انتخاب شد", "success");
            StateHasChanged();
        }
        catch (Exception ex)
