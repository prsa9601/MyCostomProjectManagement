    // ============================================================
    // FILTER & SEARCH (کلاینت ساید)
    // ============================================================

    private void ApplyFilters()
    {
        var query = allItems.AsEnumerable();

        if (!string.IsNullOrEmpty(filterCategory) && filterCategory != "all")
        {
            var categoryMap = new Dictionary<string, string>
            {
                { "website", "WebSite" },
                { "shop", "Shop" },
                { "app", "Application" },
                { "dashboard", "Dashboard" },
                { "api", "API" },
                { "other", "Others" }
            };
            if (categoryMap.TryGetValue(filterCategory, out var mapped))
                query = query.Where(i => i.Category == mapped);
            else
                query = query.Where(i => i.Category == filterCategory);
        }

        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(i =>
                i.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                i.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                i.CategoryText.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        var filteredTotal = query.Count();
        var tempTotalPages = (int)Math.Ceiling(filteredTotal / (double)pageSize);
        if (tempTotalPages == 0) tempTotalPages = 1;
        if (!string.IsNullOrEmpty(searchTerm) || filterCategory != "all")
        {
            totalPages = tempTotalPages;
            if (currentPage > totalPages) currentPage = totalPages;
        }

        filteredItems = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

