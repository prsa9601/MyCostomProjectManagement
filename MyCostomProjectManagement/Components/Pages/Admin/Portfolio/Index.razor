                Description = "API برای سیستم نظرسنجی با قابلیت ایجاد نظرسنجی‌های پویا، تحلیل داده‌ها و خروجی CSV.",
                Link = "",
                ImageUrl = "",
                Date = "۱۴۰۵/۰۳/۱۰"
            }
        };

        // Set category text for each item
        foreach (var item in allItems)
        {
            item.CategoryText = categoryTexts.GetValueOrDefault(item.Category, "سایر");
        }
    }

    // ============================================================
    // FILTER & SEARCH
    // ============================================================

    private void ApplyFilters()
    {
        var query = allItems.AsEnumerable();

        // Filter by category
        if (!string.IsNullOrEmpty(filterCategory) && filterCategory != "all")
        {
            query = query.Where(i => i.Category == filterCategory);
        }

        // Search
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(i =>
                i.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                i.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                i.CategoryText.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        // Pagination
        var total = query.Count();
        totalPages = (int)Math.Ceiling(total / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        filteredItems = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SetCategory(string category)
    {
        filterCategory = category;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // CRUD OPERATIONS
    // ============================================================

    private void AddItem()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;

        var newItem = new PortfolioItem
        {
            Id = "PF-" + (allItems.Count + 1).ToString("D3"),
            Title = newTitle.Trim(),
            Category = newCategory,
            Description = string.IsNullOrWhiteSpace(newDescription) ? "بدون توضیحات" : newDescription.Trim(),
            Link = newLink?.Trim() ?? "",
            ImageUrl = newImage?.Trim() ?? "",
            Date = DateTime.Now.ToString("۱۴۰۵/MM/dd").Replace("۱۴۰۵/", "۱۴۰۵/"),
            CategoryText = categoryTexts.GetValueOrDefault(newCategory, "سایر")
        };

        allItems.Add(newItem);
        newTitle = "";
        newDescription = "";
        newLink = "";
        newImage = "";
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleEdit(string id)
    {
        var item = allItems.FirstOrDefault(i => i.Id == id);
        if (item == null) return;

        if (editingId == id)
        {
            CancelEdit();
            return;
        }

        editingId = id;
        editTitle = item.Title;
        editCategory = item.Category;
        editDescription = item.Description;
        editLink = item.Link ?? "";
        editImage = item.ImageUrl ?? "";
        StateHasChanged();
    }

    private void SaveEdit(string id)
    {
        var item = allItems.FirstOrDefault(i => i.Id == id);
        if (item == null) return;

        if (!string.IsNullOrWhiteSpace(editTitle))
            item.Title = editTitle.Trim();
        item.Category = editCategory;
        item.Description = string.IsNullOrWhiteSpace(editDescription) ? "بدون توضیحات" : editDescription.Trim();
        item.Link = editLink?.Trim() ?? "";
        item.ImageUrl = editImage?.Trim() ?? "";
        item.CategoryText = categoryTexts.GetValueOrDefault(editCategory, "سایر");

        CancelEdit();
        ApplyFilters();
        StateHasChanged();
    }

    private void CancelEdit()
    {
        editingId = null;
        editTitle = "";
        editCategory = "website";
        editDescription = "";
        editLink = "";
        editImage = "";
        StateHasChanged();
    }

    private void DeleteItem(string id)
    {
        allItems.RemoveAll(i => i.Id == id);
        if (editingId == id) CancelEdit();
        ApplyFilters();
        StateHasChanged();
    }

    private void OpenLink(string link)
    {
        if (!string.IsNullOrEmpty(link))
        {
            NavigationManager.NavigateTo(link, true);
        }
    }

    // ============================================================
    // UI METHODS
    // ============================================================

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;
    private void GoToProfile() => NavigationManager.NavigateTo("/Profile", true);
    private void RefreshItems()
    {
        LoadItems();
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Navbar scroll
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 30);
            });

            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Fade-up observer
            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 });

            fadeEls.forEach(el => observer.observe(el));

            // Trigger visible for elements already in view
            setTimeout(() => {
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                    }
                });
            }, 300);
        ");
    }

