    private async Task LoadItems(int pageId = 1, int take = 6)
    {
        try
        {
            var param = new PortfolioFilterParam
            {
                GetPortfolioFileType = GetPortfolioType.GetAll,
                PageId = pageId,
                Take = take,
            };

            var result = await _portfolioFacade.GetFilter(param);
            if (result != null && result.Data != null)
            {
                allItems = result.Data.Select(i => new PortfolioItem
                {
                    Id = i.Id,
                    Title = i.Title,
                    IsImage = i.PortfolioFile.IsImage,
                    Category = i.Category.ToString(),
                    CategoryText = i.Category.GetDisplayName(),
                    Description = i.Description,
                    Link = i.Link,
                    ImageUrl = i.PortfolioFile?.IsImage == true
                        ? Directories.GetPortfolioImage(i.PortfolioFile.FileAddress)
                        : (i.PortfolioFile != null ? Directories.GetPortfolioVideo(i.PortfolioFile.FileAddress) : ""),
                    Date = i.CreationDate.ToPersianDateString(),
                }).ToList();
                filteredItems = allItems;
                totalItemsCount = result.EntityCount; //?? allItems.Count;
                totalPages = (int)Math.Ceiling(totalItemsCount / (double)take);
                if (totalPages == 0) totalPages = 1;
                if (currentPage > totalPages) currentPage = totalPages;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            //ShowToast("خطا در بارگذاری اطلاعات: " + ex.Message, "error");
        }
