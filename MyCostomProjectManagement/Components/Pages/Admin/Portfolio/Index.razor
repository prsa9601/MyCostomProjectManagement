@page "/Admin/Portfolio"
@layout AdminLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IPortfolioFacade _portfolioFacade
@inject FileExtensions _fileExtension
@using BackEnd.Core
@using BackEnd.Core.Portfolio.Commands.Create
@using BackEnd.Core.Portfolio.Commands.Edit
@using BackEnd.Core.Portfolio.Queries.DTOs
@using BackEnd.Data.Entities.Portfolio
@using BackEnd.Shared.Extentions.Enum
@using Microsoft.AspNetCore.Components.Forms
@using MyCostomProjectManagement.Facade.Portfolio
@using MyCostomProjectManagement.Shared.Extensions
@using MyCostomProjectManagement.Shared.Extentions

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>مدیریت نمونه کارها | پنل ادمین</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
        PORTFOLIO PAGE - با پس‌زمینه #13505b
        ============================================================ */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
        GLASS EFFECT
        ============================================================ */
    .glass {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

        .glass:hover {
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 48px rgba(0, 0, 0, 0.12);
            transform: translateY(-3px);
            border-color: rgba(255, 255, 255, 0.06);
        }

    /* ============================================================
        ANIMATIONS
        ============================================================ */
    @@keyframes float {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-10px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .float-anim {
        animation: float 4s ease-in-out infinite;
    }

    @@keyframes rotateBorder {
        0% {
            background-position: 0% 50%;
        }

        100% {
            background-position: 400% 50%;
        }
    }

    .gradient-border {
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        background-clip: padding-box;
    }

        .gradient-border::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 22px;
            background: conic-gradient(from 0deg, #e8a838, #52b788, #1a7a8a, #e8a838, #52b788);
            background-size: 400% 400%;
            animation: rotateBorder 8s linear infinite;
            opacity: 0.2;
            transition: opacity 0.4s;
        }

        .gradient-border:hover::before {
            opacity: 0.5;
        }

    /* Ripple */
    .ripple {
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* Fade Up */
    .fade-up {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.2, 0.9, 0.3, 1), transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .stagger-child {
        transition-delay: 0s;
    }

        .stagger-child:nth-child(1) {
            transition-delay: 0.05s;
        }

        .stagger-child:nth-child(2) {
            transition-delay: 0.1s;
        }

        .stagger-child:nth-child(3) {
            transition-delay: 0.15s;
        }

        .stagger-child:nth-child(4) {
            transition-delay: 0.2s;
        }

        .stagger-child:nth-child(5) {
            transition-delay: 0.25s;
        }

        .stagger-child:nth-child(6) {
            transition-delay: 0.3s;
        }

    /* Sparkle Particles */
    .sparkle {
        position: fixed;
        width: 4px;
        height: 4px;
        background: rgba(232, 168, 56, 0.2);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        animation: sparkleAnim 10s infinite alternate ease-in-out;
    }

    @@keyframes sparkleAnim {
        0% {
            transform: translate(0, 0) scale(1);
            opacity: 0.1;
        }

        50% {
            transform: translate(20px, -30px) scale(1.8);
            opacity: 0.6;
        }

        100% {
            transform: translate(-10px, 20px) scale(0.6);
            opacity: 0.05;
        }
    }

    .sparkle:nth-child(1) {
        left: 5%;
        top: 20%;
        animation-duration: 12s;
    }

    .sparkle:nth-child(2) {
        left: 85%;
        top: 60%;
        animation-duration: 14s;
        animation-delay: 2s;
        width: 6px;
        height: 6px;
    }

    .sparkle:nth-child(3) {
        left: 30%;
        top: 70%;
        animation-duration: 16s;
        animation-delay: 4s;
    }

    .sparkle:nth-child(4) {
        left: 92%;
        top: 30%;
        animation-duration: 11s;
        animation-delay: 1s;
        width: 5px;
        height: 5px;
        background: rgba(82, 183, 136, 0.15);
    }

    .sparkle:nth-child(5) {
        left: 50%;
        top: 90%;
        animation-duration: 18s;
        animation-delay: 3s;
    }

    .sparkle:nth-child(6) {
        left: 3%;
        top: 50%;
        animation-duration: 13s;
        animation-delay: 5s;
        background: rgba(232, 168, 56, 0.15);
    }

    /* ============================================================
        NAVBAR
        ============================================================ */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: all 0.4s ease;
        background: rgba(19, 80, 91, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

        .navbar.scrolled {
            background: rgba(19, 80, 91, 0.92);
            box-shadow: 0 4px 40px rgba(0, 0, 0, 0.12);
        }

        .navbar .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #e8f0f1;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .logo span {
            color: #e8a838;
        }

        .logo i {
            color: #e8a838;
            font-size: 1.3rem;
        }

    .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 500;
        align-items: center;
    }

        .nav-links a {
            color: rgba(232, 240, 241, 0.6);
            transition: all 0.35s ease;
            position: relative;
            padding: 4px 0;
        }

            .nav-links a:hover {
                color: #ffffff;
            }

            .nav-links a::after {
                content: '';
                position: absolute;
                bottom: -2px;
                right: 0;
                width: 0;
                height: 2.5px;
                background: #e8a838;
                transition: 0.35s;
                border-radius: 4px;
                box-shadow: 0 0 12px rgba(232, 168, 56, 0.15);
            }

            .nav-links a:hover::after {
                width: 100%;
            }

            .nav-links a.active {
                color: #ffffff;
            }

                .nav-links a.active::after {
                    width: 100%;
                }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 9px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.12);
    }

        .btn-primary:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(232, 168, 56, 0.2);
        }

    .btn-outline {
        background: transparent;
        border: 1.5px solid rgba(255, 255, 255, 0.1);
        color: #e8f0f1;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
    }

        .btn-outline:hover {
            border-color: #e8a838;
            background: rgba(232, 168, 56, 0.04);
            transform: translateY(-2px);
        }

    .btn-light {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-light:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: #e8a838;
            transform: translateY(-2px);
        }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        color: #fff;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.75rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(220, 53, 69, 0.15);
        }

    .avatar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(232, 168, 56, 0.2);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8f0f1;
        font-size: 1.1rem;
        transition: all 0.35s ease;
        cursor: pointer;
    }

        .avatar-btn:hover {
            background: rgba(232, 168, 56, 0.04);
            transform: scale(1.05);
            border-color: #e8a838;
        }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
    }

        .hamburger span {
            display: block;
            width: 28px;
            height: 2.5px;
            background: #e8f0f1;
            border-radius: 4px;
            transition: 0.3s;
        }

    /* ============================================================
        PAGE HEADER
        ============================================================ */
    .page-header {
        padding-top: 100px;
        padding-bottom: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .page-header h1 i {
                color: #e8a838;
            }

        .page-header .subtitle {
            color: rgba(232, 240, 241, 0.5);
            font-size: 0.9rem;
            margin-top: 4px;
        }

        .page-header .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

    /* ============================================================
        STATS ROW
        ============================================================ */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .stat-mini {
        padding: 16px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 14px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all 0.3s ease;
    }

        .stat-mini:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(232, 168, 56, 0.06);
        }

        .stat-mini i {
            font-size: 1.6rem;
            color: #e8a838;
            opacity: 0.5;
            width: 40px;
            text-align: center;
        }

        .stat-mini .info .number {
            font-size: 1.4rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.2;
        }

        .stat-mini .info .label {
            font-size: 0.75rem;
            color: rgba(232, 240, 241, 0.3);
        }

    /* ============================================================
        FILTER BAR
        ============================================================ */
    .filter-bar {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 32px;
        padding: 16px 24px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        align-items: center;
    }

        .filter-bar .search-box {
            flex: 1;
            min-width: 200px;
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 0 16px;
            transition: all 0.35s ease;
        }

            .filter-bar .search-box:focus-within {
                border-color: #e8a838;
                background: rgba(255, 255, 255, 0.04);
                box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
            }

            .filter-bar .search-box input {
                background: transparent;
                border: none;
                padding: 12px 12px;
                color: #e8f0f1;
                font-size: 0.9rem;
                width: 100%;
                outline: none;
            }

                .filter-bar .search-box input::placeholder {
                    color: rgba(232, 240, 241, 0.3);
                }

            .filter-bar .search-box i {
                color: rgba(232, 240, 241, 0.2);
                font-size: 0.9rem;
            }

        .filter-bar .filter-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .filter-bar .filter-group .filter-btn {
                padding: 8px 18px;
                border-radius: 40px;
                border: 1px solid rgba(255, 255, 255, 0.04);
                background: rgba(255, 255, 255, 0.02);
                color: rgba(232, 240, 241, 0.4);
                font-size: 0.8rem;
                font-weight: 500;
                transition: all 0.35s ease;
                cursor: pointer;
            }

                .filter-bar .filter-group .filter-btn:hover {
                    border-color: rgba(232, 168, 56, 0.1);
                    color: #e8f0f1;
                }

                .filter-bar .filter-group .filter-btn.active {
                    background: rgba(232, 168, 56, 0.08);
                    border-color: rgba(232, 168, 56, 0.1);
                    color: #e8a838;
                }

    /* ============================================================
        ADD PORTFOLIO FORM
        ============================================================ */
    .add-form {
        padding: 24px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        margin-bottom: 32px;
        transition: all 0.3s ease;
    }

        .add-form:hover {
            border-color: rgba(232, 168, 56, 0.06);
        }

        .add-form .form-title {
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .add-form .form-title i {
                color: #e8a838;
            }

        .add-form .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr auto;
            gap: 12px;
            align-items: end;
        }

        .add-form .form-group {
            margin-bottom: 0;
        }

            .add-form .form-group label {
                display: block;
                font-size: 0.75rem;
                color: rgba(232, 240, 241, 0.3);
                margin-bottom: 4px;
                font-weight: 500;
            }

            .add-form .form-group input,
            .add-form .form-group select,
            .add-form .form-group textarea {
                width: 100%;
                padding: 10px 14px;
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.04);
                border-radius: 10px;
                color: #e8f0f1;
                font-size: 0.9rem;
                transition: all 0.35s ease;
                outline: none;
                font-family: inherit;
            }

                .add-form .form-group input:focus,
                .add-form .form-group select:focus,
                .add-form .form-group textarea:focus {
                    border-color: #e8a838;
                    background: rgba(255, 255, 255, 0.04);
                    box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
                }

                .add-form .form-group input::placeholder,
                .add-form .form-group textarea::placeholder {
                    color: rgba(232, 240, 241, 0.15);
                }

                .add-form .form-group select option {
                    background: #13505b;
                    color: #e8f0f1;
                }

            .add-form .form-group textarea {
                min-height: 42px;
                resize: vertical;
            }

            .add-form .form-group .file-input-wrapper {
                position: relative;
                width: 100%;
            }

                .add-form .form-group .file-input-wrapper input[type="file"] {
                    position: absolute;
                    opacity: 0;
                    width: 100%;
                    height: 100%;
                    cursor: pointer;
                    top: 0;
                    right: 0;
                }

                .add-form .form-group .file-input-wrapper .file-label {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    padding: 10px 14px;
                    background: rgba(255, 255, 255, 0.03);
                    border: 1px dashed rgba(255, 255, 255, 0.1);
                    border-radius: 10px;
                    color: rgba(232, 240, 241, 0.3);
                    font-size: 0.85rem;
                    transition: all 0.3s ease;
                    cursor: pointer;
                    min-height: 42px;
                }

                    .add-form .form-group .file-input-wrapper .file-label:hover {
                        border-color: rgba(232, 168, 56, 0.2);
                        background: rgba(255, 255, 255, 0.05);
                    }

                    .add-form .form-group .file-input-wrapper .file-label.has-file {
                        border-color: #52b788;
                        color: #52b788;
                    }

        .add-form .btn-add {
            padding: 10px 24px;
            border-radius: 10px;
            border: none;
            background: linear-gradient(135deg, #52b788, #409f73);
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.35s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            height: 42px;
        }

            .add-form .btn-add:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 16px rgba(82, 183, 136, 0.15);
            }

    /* ============================================================
        PORTFOLIO GRID
        ============================================================ */
    .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
    }

    .portfolio-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

        .portfolio-card:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(232, 168, 56, 0.06);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }

        .portfolio-card .card-media {
            width: 100%;
            height: 180px;
            background: rgba(255, 255, 255, 0.02);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            .portfolio-card .card-media img,
            .portfolio-card .card-media video {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .portfolio-card .card-media .placeholder {
                color: rgba(232, 240, 241, 0.05);
                font-size: 4rem;
            }

            .portfolio-card .card-media .category-badge {
                position: absolute;
                top: 12px;
                right: 12px;
                padding: 4px 12px;
                border-radius: 30px;
                font-size: 0.65rem;
                font-weight: 500;
                background: rgba(19, 80, 91, 0.8);
                backdrop-filter: blur(4px);
                -webkit-backdrop-filter: blur(4px);
                color: #e8f0f1;
                border: 1px solid rgba(255, 255, 255, 0.04);
            }
            /* برای فیلم، پلی‌آیکون بزرگ روی پیش‌نمایش */
            .portfolio-card .card-media .play-overlay {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                font-size: 3rem;
                color: rgba(255, 255, 255, 0.6);
                pointer-events: none;
                text-shadow: 0 0 20px rgba(0,0,0,0.5);
            }

        .portfolio-card .card-body {
            padding: 18px 20px 16px;
        }

            .portfolio-card .card-body .title {
                font-size: 1rem;
                font-weight: 600;
                color: #ffffff;
                margin-bottom: 4px;
            }

            .portfolio-card .card-body .description {
                font-size: 0.85rem;
                color: rgba(232, 240, 241, 0.4);
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                line-height: 1.5;
                margin-bottom: 12px;
                min-height: 40px;
            }

            .portfolio-card .card-body .meta {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
                font-size: 0.7rem;
                color: rgba(232, 240, 241, 0.15);
                margin-bottom: 12px;
            }

                .portfolio-card .card-body .meta span {
                    display: flex;
                    align-items: center;
                    gap: 4px;
                }

                .portfolio-card .card-body .meta i {
                    font-size: 0.6rem;
                    color: rgba(232, 168, 56, 0.2);
                }

        .portfolio-card .card-actions {
            display: flex;
            gap: 6px;
            padding: 12px 20px 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
        }

            .portfolio-card .card-actions button {
                padding: 6px 14px;
                border-radius: 30px;
                border: 1px solid rgba(255, 255, 255, 0.04);
                background: rgba(255, 255, 255, 0.02);
                color: rgba(232, 240, 241, 0.2);
                font-size: 0.75rem;
                transition: all 0.35s ease;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }

                .portfolio-card .card-actions button:hover {
                    border-color: rgba(232, 168, 56, 0.06);
                    color: #e8f0f1;
                    background: rgba(232, 168, 56, 0.02);
                    transform: scale(1.02);
                }

                .portfolio-card .card-actions button.edit:hover {
                    border-color: rgba(82, 183, 136, 0.06);
                    color: #52b788;
                    background: rgba(82, 183, 136, 0.02);
                }

                .portfolio-card .card-actions button.delete:hover {
                    border-color: rgba(220, 53, 69, 0.06);
                    color: #dc3545;
                    background: rgba(220, 53, 69, 0.02);
                }

                .portfolio-card .card-actions button.link:hover {
                    border-color: rgba(26, 122, 138, 0.06);
                    color: #1a7a8a;
                    background: rgba(26, 122, 138, 0.02);
                }

        .portfolio-card .edit-mode {
            display: none;
            padding: 16px 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
            background: rgba(255, 255, 255, 0.02);
        }

            .portfolio-card .edit-mode.active {
                display: block;
                animation: fadeIn 0.3s ease;
            }

    @@keyframes fadeIn {
        0% {
            opacity: 0;
            transform: translateY(10px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .portfolio-card .edit-mode input,
    .portfolio-card .edit-mode select,
    .portfolio-card .edit-mode textarea {
        width: 100%;
        padding: 8px 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 8px;
        color: #e8f0f1;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        outline: none;
        font-family: inherit;
        margin-bottom: 8px;
    }

        .portfolio-card .edit-mode input:focus,
        .portfolio-card .edit-mode select:focus,
        .portfolio-card .edit-mode textarea:focus {
            border-color: #e8a838;
            background: rgba(255, 255, 255, 0.04);
        }

        .portfolio-card .edit-mode input::placeholder,
        .portfolio-card .edit-mode textarea::placeholder {
            color: rgba(232, 240, 241, 0.15);
        }

        .portfolio-card .edit-mode select option {
            background: #13505b;
            color: #e8f0f1;
        }

    .portfolio-card .edit-mode textarea {
        min-height: 60px;
        resize: vertical;
    }

    .portfolio-card .edit-mode .edit-actions {
        display: flex;
        gap: 8px;
        margin-top: 8px;
    }

        .portfolio-card .edit-mode .edit-actions button {
            flex: 1;
            padding: 6px 12px;
            border-radius: 8px;
            border: none;
            font-size: 0.75rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .portfolio-card .edit-mode .edit-actions .save-edit {
            background: linear-gradient(135deg, #52b788, #409f73);
            color: #fff;
        }

            .portfolio-card .edit-mode .edit-actions .save-edit:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(82, 183, 136, 0.15);
            }

        .portfolio-card .edit-mode .edit-actions .cancel-edit {
            background: rgba(255, 255, 255, 0.04);
            color: rgba(232, 240, 241, 0.3);
        }

            .portfolio-card .edit-mode .edit-actions .cancel-edit:hover {
                background: rgba(255, 255, 255, 0.06);
            }

    /* ============================================================
        EMPTY STATE
        ============================================================ */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.02);
    }

        .empty-state i {
            font-size: 4rem;
            color: rgba(232, 168, 56, 0.1);
            margin-bottom: 16px;
        }

        .empty-state h3 {
            font-size: 1.3rem;
            color: rgba(232, 240, 241, 0.3);
            margin-bottom: 8px;
        }

        .empty-state p {
            color: rgba(232, 240, 241, 0.15);
            font-size: 0.9rem;
        }

    /* ============================================================
        PAGINATION
        ============================================================ */
    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
        padding: 16px 0;
    }

        .pagination button {
            padding: 8px 16px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            background: rgba(255, 255, 255, 0.02);
            color: rgba(232, 240, 241, 0.3);
            font-size: 0.8rem;
            transition: all 0.35s ease;
            cursor: pointer;
        }

            .pagination button:hover {
                border-color: rgba(232, 168, 56, 0.06);
                color: #e8f0f1;
                background: rgba(232, 168, 56, 0.02);
            }

            .pagination button.active {
                background: rgba(232, 168, 56, 0.06);
                border-color: rgba(232, 168, 56, 0.06);
                color: #e8a838;
            }

    /* ============================================================
        FOOTER
        ============================================================ */
    .footer {
        position: relative;
        padding: 28px 0 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.02);
        background: rgba(19, 80, 91, 0.2);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1;
        margin-top: 20px;
    }

        .footer .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
        }

    .footer-links {
        display: flex;
        gap: 24px;
        font-size: 0.85rem;
        color: rgba(232, 240, 241, 0.2);
    }

        .footer-links a:hover {
            color: #e8a838;
        }

    .footer-copy {
        color: rgba(232, 240, 241, 0.2);
        font-size: 0.8rem;
    }

        .footer-copy i {
            color: #e8a838;
        }

    /* ============================================================
        RESPONSIVE
        ============================================================ */
    @@media (max-width: 1200px) {
        .add-form .form-row {
            grid-template-columns: 1fr 1fr 1fr;
        }

            .add-form .form-row .btn-add {
                grid-column: 1 / -1;
                justify-content: center;
            }
    }

    @@media (max-width: 992px) {
        .stats-row {
            grid-template-columns: 1fr 1fr;
        }

        .add-form .form-row {
            grid-template-columns: 1fr 1fr;
        }

            .add-form .form-row .btn-add {
                grid-column: 1 / -1;
                justify-content: center;
            }

        .portfolio-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .nav-links {
            display: none;
            flex-direction: column;
            width: 100%;
            background: rgba(19, 80, 91, 0.95);
            backdrop-filter: blur(16px);
            padding: 20px 0;
            gap: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.02);
            margin-top: 12px;
            border-radius: 20px;
            align-items: center;
        }

            .nav-links.open {
                display: flex;
            }

        .hamburger {
            display: flex;
        }

        .nav-actions .btn-outline {
            display: none;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .page-header h1 {
                font-size: 1.5rem;
            }

        .filter-bar {
            flex-direction: column;
            padding: 16px;
        }

            .filter-bar .search-box {
                width: 100%;
            }

        .page-header .actions {
            width: 100%;
        }

            .page-header .actions .btn-primary {
                flex: 1;
                justify-content: center;
            }

        .stats-row {
            grid-template-columns: 1fr 1fr;
        }

        .stat-mini .info .number {
            font-size: 1.1rem;
        }

        .stat-mini i {
            font-size: 1.2rem;
            width: 30px;
        }

        .add-form .form-row {
            grid-template-columns: 1fr;
        }

            .add-form .form-row .btn-add {
                grid-column: 1;
                justify-content: center;
            }

        .portfolio-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .stats-row {
            grid-template-columns: 1fr;
        }

        .filter-bar .filter-group {
            width: 100%;
            justify-content: center;
        }

        .add-form .form-row {
            grid-template-columns: 1fr;
        }

        .portfolio-card .card-media {
            height: 140px;
        }
    }

    /* ============================================================
        NOTIFICATION TOAST
        ============================================================ */
    .toast-container {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 400px;
        width: 100%;
        direction: rtl;
    }

    .toast {
        padding: 14px 20px;
        border-radius: 12px;
        color: #fff;
        font-size: 0.9rem;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        gap: 12px;
        animation: slideUp 0.4s ease;
        transform-origin: bottom;
    }

        .toast i {
            font-size: 1.2rem;
            opacity: 0.8;
        }

        .toast.success {
            background: rgba(82, 183, 136, 0.9);
            border-color: rgba(82, 183, 136, 0.2);
        }

        .toast.error {
            background: rgba(220, 53, 69, 0.9);
            border-color: rgba(220, 53, 69, 0.2);
        }

        .toast.info {
            background: rgba(26, 122, 138, 0.9);
            border-color: rgba(26, 122, 138, 0.2);
        }

    @@keyframes slideUp {
        0% {
            opacity: 0;
            transform: translateY(30px) scale(0.95);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

<!-- ============================================================
PAGE CONTENT
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-images"></i>
                    نمونه کارها
                    <span class="badge-admin" style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalItems</span>
                </h1>
                <div class="subtitle">مدیریت نمونه کارهای انجام شده</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshItems"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="stats-row fade-up visible">
            <div class="stat-mini">
                <i class="fas fa-images"></i>
                <div class="info">
                    <div class="number">@totalItems</div>
                    <div class="label">کل نمونه کارها</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-tag" style="color:#52b788;"></i>
                <div class="info">
                    <div class="number">@categoryCount</div>
                    <div class="label">دسته‌بندی‌ها</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-link" style="color:#e8a838;"></i>
                <div class="info">
                    <div class="number">@withLinkCount</div>
                    <div class="label">دارای لینک</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-calendar-check" style="color:#8264c8;"></i>
                <div class="info">
                    <div class="number">@thisYearCount</div>
                    <div class="label">امسال</div>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی نمونه کار..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterCategory == "all" ? "active" : "")" @onclick='() => SetCategory("all")'>همه</button>
                <button class="filter-btn @(filterCategory == "website" ? "active" : "")" @onclick='() => SetCategory("website")'>وب‌سایت</button>
                <button class="filter-btn @(filterCategory == "shop" ? "active" : "")" @onclick='() => SetCategory("shop")'>فروشگاه</button>
                <button class="filter-btn @(filterCategory == "app" ? "active" : "")" @onclick='() => SetCategory("app")'>اپلیکیشن</button>
                <button class="filter-btn @(filterCategory == "dashboard" ? "active" : "")" @onclick='() => SetCategory("dashboard")'>داشبورد</button>
                <button class="filter-btn @(filterCategory == "api" ? "active" : "")" @onclick='() => SetCategory("api")'>API</button>
                <button class="filter-btn @(filterCategory == "other" ? "active" : "")" @onclick='() => SetCategory("other")'>سایر</button>
            </div>
        </div>

        <!-- Add Form -->
        <div class="add-form fade-up visible">
            <div class="form-title">
                <i class="fas fa-plus-circle"></i>
                افزودن نمونه کار جدید
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>عنوان</label>
                    <input type="text" placeholder="مثال: فروشگاه اینترنتی" @bind="newTitle" />
                </div>
                <div class="form-group">
                    <label>دسته‌بندی</label>
                    <select @bind="newCategory">
                        <option value="WebSite">وب‌سایت</option>
                        <option value="Shop">فروشگاه</option>
                        <option value="CustomSite">وب سایت کاستوم</option>
                        <option value="Application">اپلیکیشن</option>
                        <option value="Dashboard">داشبورد</option>
                        <option value="API">API</option>
                        <option value="Others">سایر</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>لینک (اختیاری)</label>
                    <input type="text" placeholder="https://example.com" @bind="newLink" />
                </div>
                <button class="btn-add ripple" @onclick="async () => await AddItem()"><i class="fas fa-plus"></i> افزودن</button>
            </div>
            <div class="form-row" style="margin-top:10px; grid-template-columns:1fr 1fr;">
                <div class="form-group">
                    <label>توضیحات</label>
                    <textarea placeholder="توضیحات کوتاه..." @bind="newDescription" style="min-height:42px;"></textarea>
                </div>
                <div class="form-group">
                    <label>تصویر / فیلم</label>
                    <div class="file-input-wrapper">
                        <InputFile accept="image/*,video/*" OnChange="HandleFileSelected" />
                        <div class="file-label @(!string.IsNullOrEmpty(newMediaData) ? "has-file" : "")">
                            <i class="fas fa-upload"></i>
                            @(!string.IsNullOrEmpty(newMediaData) ? "فایل انتخاب شد" : "انتخاب فایل")
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(newMediaData))
                    {
                        <div style="margin-top:6px;">
                            @if (newMediaData.StartsWith("data:image/"))
                            {
                                <img src="@newMediaData" alt="پیش‌نمایش" style="max-height:80px; border-radius:8px; border:1px solid rgba(255,255,255,0.05);" />
                            }
                            else if (newMediaData.StartsWith("data:video/"))
                            {
                                <video controls style="max-height:80px; border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
                                    <source src="@newMediaData" />
                                </video>
                            }
                            <button class="btn-danger" style="padding:2px 10px; font-size:0.6rem; margin-right:6px;" @onclick="RemoveNewMedia">حذف</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Portfolio Grid -->
        @if (filteredItems.Any())
        {
            <div class="portfolio-grid">
                @foreach (var item in filteredItems)
                {
                    <div class="portfolio-card fade-up stagger-child">
                        <div class="card-media">
                            @if (!string.IsNullOrEmpty(item.ImageUrl) && item.IsImage == false)
                            {
                               @*  <video controls style="width:100%;height:100%;object-fit:cover;">
                                    <source src="@item.ImageUrl" />
                                </video>
                                <div class="play-overlay"><i class="fas fa-play-circle"></i></div> *@
                                <video controls preload="auto" playsinline
                                       style="width:100%;height:100%;object-fit:contain;background:#000;">
                                       @*onerror="this.style.display='none'; this.nextElementSibling?.style?.removeProperty('display')">*@
                                    <source src="@item.ImageUrl" type="video/mp4" />
                                    مرورگر شما از ویدیو پشتیبانی نمی‌کند.
                                </video>
                                <div class="play-overlay" style="display:none;">
                                    <i class="fas fa-play-circle"></i>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(item.ImageUrl) && item.IsImage == true)
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" />
                            }
                            @* else if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" />
                            } *@
                            else
                            {
                                @* <img src="@item.MediaData" alt="@item.Title" /> *@
                                 <div class="placeholder"><i class="fas fa-image"></i></div> 
                            }
                            <span class="category-badge">@item.CategoryText</span>
                        </div>
                        <div class="card-body">
                            <div class="title">@item.Title</div>
                            <div class="description">@item.Description</div>
                            <div class="meta">
                                <span><i class="fas fa-tag"></i> @item.CategoryText</span>
                                <span><i class="far fa-calendar-alt"></i> @item.Date</span>
                                @if (!string.IsNullOrEmpty(item.Link))
                                {
                                    <span><i class="fas fa-link"></i> دارد</span>
                                }
                            </div>
                        </div>
                        <div class="card-actions">
                            @if (!string.IsNullOrEmpty(item.Link))
                            {
                                <button class="link ripple" title="مشاهده لینک" @onclick='() => OpenLink(item.Link)'><i class="fas fa-external-link-alt"></i> لینک</button>
                            }
                            <button class="edit ripple" title="ویرایش" @onclick='() => ToggleEdit(item.Id)'><i class="fas fa-edit"></i> ویرایش</button>
                            <button class="delete ripple" title="حذف" @onclick='() => DeleteItem(item.Id)'><i class="fas fa-trash-alt"></i> حذف</button>
                        </div>

                        <!-- Edit Mode -->
                        <div class="edit-mode @(editingId == item.Id ? "active" : "")">
                            <input type="text" @bind="editTitle" placeholder="عنوان" />
                            <select @bind="editCategory">
                                <option value="WebSite">وب‌سایت</option>
                                <option value="Shop">فروشگاه</option>
                                <option value="CustomSite">وب سایت کاستوم</option>
                                <option value="Application">اپلیکیشن</option>
                                <option value="Dashboard">داشبورد</option>
                                <option value="API">API</option>
                                <option value="Others">سایر</option>
                            </select>
                            <textarea @bind="editDescription" placeholder="توضیحات"></textarea>
                            <input type="text" @bind="editLink" placeholder="لینک" />
                            <div class="file-input-wrapper" style="margin-bottom:8px;">
                                <InputFile accept="image/*,video/*" OnChange="(e) => HandleEditFileSelected(e, item.Id)" multiple />
                                <div class="file-label @(!string.IsNullOrEmpty(editMediaData) ? "has-file" : "")">
                                    <i class="fas fa-upload"></i>
                                    @(!string.IsNullOrEmpty(editMediaData) ? "فایل جدید انتخاب شد" : "تغییر فایل (اختیاری)")
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(editMediaData))
                            {
                                <div style="margin-bottom:8px;">
                                    @if (editMediaData.StartsWith("data:image/"))
                                    {
                                        <img src="@editMediaData" alt="پیش‌نمایش" style="max-height:60px; border-radius:6px; border:1px solid rgba(255,255,255,0.05);" />
                                    }
                                    else if (editMediaData.StartsWith("data:video/"))
                                    {
                                        <video controls style="max-height:60px; border-radius:6px; border:1px solid rgba(255,255,255,0.05);">
                                            <source src="@editMediaData" />
                                        </video>
                                    }
                                    <button class="btn-danger" style="padding:2px 10px; font-size:0.6rem;" @onclick="RemoveEditMedia">حذف</button>
                                </div>
                            }
                            <div class="edit-actions">
                                <button class="save-edit ripple" @onclick='async () => await SaveEdit(item.Id)'><i class="fas fa-check"></i> ذخیره</button>
                                <button class="cancel-edit ripple" @onclick='() => CancelEdit()'><i class="fas fa-times"></i> لغو</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state fade-up visible">
                <i class="fas fa-images"></i>
                <h3>هیچ نمونه کاری یافت نشد</h3>
                <p>با تغییر فیلترها یا افزودن نمونه کار جدید، نتایج را مشاهده کنید</p>
            </div>
        }

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }

    </div>
</main>

