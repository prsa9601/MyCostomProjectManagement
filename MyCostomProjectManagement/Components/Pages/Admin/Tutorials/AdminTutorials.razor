@page "/Admin/Tutorials"
@layout AdminLayout
@rendermode InteractiveServer
@inject ITutorialApiService TutorialService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using BackEnd.Data.Infrastructure.Tutorial
@using BackEnd.Data.Infrastructure.Tutorial.DTOs

<PageTitle>مدیریت آموزش‌ها | پنل ادمین</PageTitle>

<style>
    /* ============================================================
           TUTORIALS ADMIN PAGE - Full CRUD
        ============================================================ */

    .tutorials-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

        .tutorials-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .tutorials-header h1 i {
                color: #e8a838;
            }

        .tutorials-header .badge-count {
            font-size: 0.7rem;
            background: linear-gradient(135deg, #e8a838, #d4952e);
            color: #fff;
            padding: 4px 14px;
            border-radius: 40px;
            font-weight: 600;
        }

    .btn-add {
        background: linear-gradient(135deg, #52b788, #3a9a6e);
        color: #fff;
        border: none;
        padding: 11px 22px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(82, 183, 136, 0.2);
    }

        .btn-add:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(82, 183, 136, 0.3);
        }

    /* ===== FILTERS BAR ===== */
    .filters-bar {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr auto;
        gap: 12px;
        padding: 18px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 18px;
        margin-bottom: 22px;
        backdrop-filter: blur(8px);
        align-items: center;
    }

    .filter-input,
    .filter-select {
        width: 100%;
        padding: 10px 14px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        color: #e8f0f1;
        font-family: inherit;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        outline: none;
    }

        .filter-input:focus,
        .filter-select:focus {
            border-color: rgba(232, 168, 56, 0.4);
            background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 0 0 3px rgba(232, 168, 56, 0.08);
        }

        .filter-input::placeholder {
            color: rgba(232, 240, 241, 0.3);
        }

        .filter-select option {
            background: #13505b;
            color: #e8f0f1;
        }

    .btn-search {
        background: linear-gradient(135deg, #1a7a8a, #13505b);
        color: #fff;
        border: 1px solid rgba(77, 201, 221, 0.2);
        padding: 10px 20px;
        border-radius: 10px;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

        .btn-search:hover {
            background: linear-gradient(135deg, #2196a8, #1a7a8a);
            transform: translateY(-2px);
        }

    /* ===== GRID ===== */
    .tutorials-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .tutorial-card {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        padding: 22px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        backdrop-filter: blur(8px);
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

        .tutorial-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #e8a838, #52b788);
            opacity: 0.5;
            border-radius: 0 4px 4px 0;
        }

        .tutorial-card:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(232, 168, 56, 0.12);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }

    .tutorial-card-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
    }

    .tutorial-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
        background: rgba(232, 168, 56, 0.08);
        color: #e8a838;
        transition: all 0.35s ease;
    }

    .tutorial-card:hover .tutorial-icon {
        transform: scale(1.08) rotate(-5deg);
    }

    .tutorial-icon.cat-language {
        background: rgba(82, 183, 136, 0.08);
        color: #52b788;
    }

    .tutorial-icon.cat-framework {
        background: rgba(26, 122, 138, 0.12);
        color: #4dc9dd;
    }

    .tutorial-icon.cat-tool {
        background: rgba(232, 168, 56, 0.08);
        color: #e8a838;
    }

    .tutorial-icon.cat-concept {
        background: rgba(130, 100, 200, 0.1);
        color: #a88ce8;
    }

    .tutorial-card h3 {
        font-size: 1rem;
        font-weight: 600;
        color: #ffffff;
        line-height: 1.5;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tutorial-card .topic {
        font-size: 0.78rem;
        color: rgba(232, 240, 241, 0.5);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .tags-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 14px 0;
    }

    .tag {
        font-size: 0.7rem;
        padding: 3px 12px;
        border-radius: 30px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 1px solid transparent;
    }

    .tag-subject {
        background: rgba(26, 122, 138, 0.08);
        color: #4dc9dd;
        border-color: rgba(77, 201, 221, 0.12);
    }

    .tag-level-beginner {
        background: rgba(82, 183, 136, 0.08);
        color: #52b788;
        border-color: rgba(82, 183, 136, 0.12);
    }

    .tag-level-intermediate {
        background: rgba(232, 168, 56, 0.08);
        color: #e8a838;
        border-color: rgba(232, 168, 56, 0.12);
    }

    .tag-level-advanced {
        background: rgba(220, 53, 69, 0.08);
        color: #e77c88;
        border-color: rgba(220, 53, 69, 0.12);
    }

    .tag-level-all {
        background: rgba(130, 100, 200, 0.08);
        color: #a88ce8;
        border-color: rgba(130, 100, 200, 0.12);
    }

    .tag-approved {
        background: rgba(82, 183, 136, 0.08);
        color: #52b788;
        border-color: rgba(82, 183, 136, 0.12);
    }

    .tag-pending {
        background: rgba(232, 168, 56, 0.08);
        color: #e8a838;
        border-color: rgba(232, 168, 56, 0.12);
    }

    .tag-active {
        background: rgba(77, 201, 221, 0.08);
        color: #4dc9dd;
        border-color: rgba(77, 201, 221, 0.12);
    }

    .tag-inactive {
        background: rgba(150, 150, 150, 0.08);
        color: rgba(232, 240, 241, 0.5);
        border-color: rgba(150, 150, 150, 0.12);
    }

    .tutorial-stats {
        display: flex;
        gap: 16px;
        padding: 12px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.04);
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        margin-bottom: 14px;
    }

        .tutorial-stats .stat {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            color: rgba(232, 240, 241, 0.6);
        }

            .tutorial-stats .stat i {
                color: #e8a838;
                font-size: 0.85rem;
            }

    .tutorial-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        gap: 10px;
    }

    .tutorial-date {
        font-size: 0.72rem;
        color: rgba(232, 240, 241, 0.4);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .tutorial-actions {
        display: flex;
        gap: 6px;
    }

    .btn-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.03);
        color: rgba(232, 240, 241, 0.7);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

        .btn-icon:hover {
            background: rgba(232, 168, 56, 0.08);
            color: #e8a838;
            border-color: rgba(232, 168, 56, 0.2);
            transform: translateY(-2px);
        }

        .btn-icon.edit:hover {
            background: rgba(82, 183, 136, 0.08);
            color: #52b788;
            border-color: rgba(82, 183, 136, 0.2);
        }

        .btn-icon.delete:hover {
            background: rgba(220, 53, 69, 0.08);
            color: #e77c88;
            border-color: rgba(220, 53, 69, 0.2);
        }

        .btn-icon.toggle:hover {
            background: rgba(77, 201, 221, 0.08);
            color: #4dc9dd;
            border-color: rgba(77, 201, 221, 0.2);
        }

    /* ===== STATES ===== */
    .state-box {
        text-align: center;
        padding: 60px 20px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px dashed rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        color: rgba(232, 240, 241, 0.5);
    }

        .state-box i {
            font-size: 3rem;
            color: rgba(232, 168, 56, 0.3);
            margin-bottom: 14px;
            display: block;
        }

        .state-box h3 {
            font-size: 1.1rem;
            color: #e8f0f1;
            margin-bottom: 6px;
        }

    .spinner {
        width: 44px;
        height: 44px;
        border: 3px solid rgba(232, 168, 56, 0.15);
        border-top-color: #e8a838;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 16px;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ===== PAGINATION ===== */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

        .pagination button {
            min-width: 38px;
            height: 38px;
            padding: 0 12px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            background: rgba(255, 255, 255, 0.03);
            color: #e8f0f1;
            font-family: inherit;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .pagination button:hover:not(:disabled):not(.active) {
                background: rgba(232, 168, 56, 0.08);
                border-color: rgba(232, 168, 56, 0.2);
                color: #e8a838;
            }

            .pagination button.active {
                background: linear-gradient(135deg, #e8a838, #d4952e);
                border-color: transparent;
                color: #fff;
                font-weight: 600;
            }

            .pagination button:disabled {
                opacity: 0.35;
                cursor: not-allowed;
            }

    /* ===== MODAL ===== */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(6px);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: fadeIn 0.25s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideUp {
        from {
            transform: translateY(30px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-box {
        background: linear-gradient(180deg, #13505b 0%, #0f3f48 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 22px;
        width: 100%;
        max-width: 720px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        animation: slideUp 0.3s ease;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        overflow: hidden;
    }

    .modal-header {
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

        .modal-header h2 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .modal-header h2 i {
                color: #e8a838;
            }

    .modal-close {
        background: none;
        border: none;
        color: rgba(232, 240, 241, 0.5);
        font-size: 1.3rem;
        cursor: pointer;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

        .modal-close:hover {
            background: rgba(220, 53, 69, 0.1);
            color: #e77c88;
        }

    .modal-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }

    .modal-footer {
        padding: 16px 24px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(0, 0, 0, 0.1);
    }

    /* ===== FORM ===== */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-field.full {
            grid-column: 1 / -1;
        }

        .form-field label {
            font-size: 0.82rem;
            color: rgba(232, 240, 241, 0.8);
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .form-field label i {
                color: #e8a838;
                font-size: 0.8rem;
            }

            .form-field label .required {
                color: #e77c88;
            }

        .form-field input,
        .form-field select,
        .form-field textarea {
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            color: #e8f0f1;
            font-family: inherit;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            outline: none;
            width: 100%;
        }

            .form-field input:focus,
            .form-field select:focus,
            .form-field textarea:focus {
                border-color: rgba(232, 168, 56, 0.4);
                background: rgba(255, 255, 255, 0.06);
                box-shadow: 0 0 0 3px rgba(232, 168, 56, 0.08);
            }

        .form-field textarea {
            resize: vertical;
            min-height: 180px;
            font-family: 'Consolas', 'Monaco', monospace;
            line-height: 1.6;
        }

        .form-field select option {
            background: #13505b;
        }

    .checkbox-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        padding: 12px 0;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 0.85rem;
        color: rgba(232, 240, 241, 0.85);
        user-select: none;
    }

        .checkbox-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #e8a838;
            cursor: pointer;
        }

    .btn {
        padding: 10px 22px;
        border-radius: 10px;
        border: none;
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .btn-primary {
        background: linear-gradient(135deg, #52b788, #3a9a6e);
        color: #fff;
        box-shadow: 0 4px 16px rgba(82, 183, 136, 0.2);
    }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(82, 183, 136, 0.3);
        }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.05);
        color: #e8f0f1;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.08);
        }

    .btn-danger {
        background: linear-gradient(135deg, #e74c5c, #c0392b);
        color: #fff;
        box-shadow: 0 4px 16px rgba(220, 53, 69, 0.2);
    }

        .btn-danger:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(220, 53, 69, 0.3);
        }

    .validation-msg {
        font-size: 0.72rem;
        color: #e77c88;
        margin-top: 4px;
    }

    /* ===== DELETE MODAL ===== */
    .delete-modal {
        max-width: 440px;
        text-align: center;
    }

        .delete-modal .modal-body {
            padding: 32px 24px;
        }

    .delete-icon-wrap {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: rgba(220, 53, 69, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: #e77c88;
    }

    .delete-modal h3 {
        color: #fff;
        font-size: 1.1rem;
        margin-bottom: 8px;
    }

    .delete-modal p {
        color: rgba(232, 240, 241, 0.6);
        font-size: 0.85rem;
        line-height: 1.7;
    }

        .delete-modal p strong {
            color: #e8a838;
        }

    /* ===== TOAST ===== */
    .toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        padding: 14px 24px;
        border-radius: 12px;
        font-size: 0.88rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        z-index: 3000;
        animation: slideUp 0.3s ease;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .toast-success {
        background: linear-gradient(135deg, #52b788, #3a9a6e);
        color: #fff;
    }

    .toast-error {
        background: linear-gradient(135deg, #e74c5c, #c0392b);
        color: #fff;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 900px) {
        .filters-bar {
            grid-template-columns: 1fr 1fr;
        }

            .filters-bar .btn-search {
                grid-column: 1 / -1;
            }
    }

    @@media (max-width: 600px) {
        .tutorials-header h1 {
            font-size: 1.4rem;
        }

        .tutorials-grid,
        .form-grid {
            grid-template-columns: 1fr;
        }

        .filters-bar {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- ============================================================
     HEADER
============================================================ -->
<div class="tutorials-header">
    <h1>
        <i class="fas fa-graduation-cap"></i>
        مدیریت آموزش‌ها
        @if (totalCount > 0)
        {
            <span class="badge-count">@totalCount.ToString("N0") مورد</span>
        }
    </h1>
    <button class="btn-add" @onclick="OpenCreateModal">
        <i class="fas fa-plus"></i>
        آموزش جدید
    </button>
</div>

<!-- ============================================================
     FILTERS
@* ============================================================ -->
<div class="filters-bar">
    <input type="text"
           class="filter-input"
           placeholder="جستجو در عنوان..."
           @bind="searchTerm"
           @bind:event="oninput"
           @onkeydown="OnSearchKeyDown" />

    <select class="filter-select" @bind="filterLevel">
        <option value="">همه سطوح</option>
        <option value="beginner">مبتدی</option>
        <option value="intermediate">متوسط</option>
        <option value="advanced">پیشرفته</option>
        <option value="all">همه سطوح</option>
    </select>

    <select class="filter-select" @bind="filterCategory">
        <option value="">همه دسته‌ها</option>
        <option value="language">زبان</option>
        <option value="framework">فریمورک</option>
        <option value="tool">ابزار</option>
        <option value="concept">مفهوم</option>
    </select>

    <select class="filter-select" @bind="filterStatus">
        <option value="">همه وضعیت‌ها</option>
        <option value="approved">تأیید شده</option>
        <option value="pending">در انتظار</option>
        <option value="active">فعال</option>
        <option value="inactive">غیرفعال</option>
    </select>

    <button class="btn-search" @onclick="ApplyFilters">
        <i class="fas fa-search"></i>
        اعمال فیلتر
    </button>
</div>
 *@
<!-- ============================================================
     CONTENT
============================================================ -->
@if (isLoading)
{
    <div class="state-box">
        <div class="spinner"></div>
        <h3>در حال بارگذاری...</h3>
    </div>
}
else if (tutorials == null || tutorials.Count == 0)
{
    <div class="state-box">
        <i class="fas fa-inbox"></i>
        <h3>هیچ آموزشی یافت نشد</h3>
        <p>هنوز آموزشی اضافه نشده یا فیلترها نتیجه‌ای نداشتند.</p>
    </div>
}
else
{
    <div class="tutorials-grid">
        @foreach (var t in tutorials)
        {
            <div class="tutorial-card">
                <div class="tutorial-card-header">
                    <div class="tutorial-icon @GetCategoryClass(t.Category)">
                        <i class="@GetCategoryIcon(t.Category)"></i>
                    </div>
                    <div style="flex:1; min-width:0;">
                        <h3 title="@t.Title">@t.Title</h3>
                        <div class="topic">
                            <i class="fas fa-hashtag"></i>
                            @(string.IsNullOrWhiteSpace(t.Topic) ? "بدون موضوع" : t.Topic)
                        </div>
                    </div>
                </div>

                <div class="tags-row">
                    @if (!string.IsNullOrWhiteSpace(t.Subject))
                    {
                        <span class="tag tag-subject">
                            <i class="fas fa-code"></i> @t.Subject
                        </span>
                    }
                    <span class="tag @GetLevelClass(t.Level)">
                        <i class="fas fa-signal"></i> @GetLevelText(t.Level)
                    </span>
                    <span class="tag @(t.IsApproved ? "tag-approved" : "tag-pending")">
                        <i class="fas @(t.IsApproved ? "fa-check-circle" : "fa-clock")"></i>
                        @(t.IsApproved ? "تأیید شده" : "در انتظار")
                    </span>
                    <span class="tag @(t.IsActive ? "tag-active" : "tag-inactive")">
                        <i class="fas @(t.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                        @(t.IsActive ? "فعال" : "غیرفعال")
                    </span>
                </div>

                <div class="tutorial-stats">
                    <div class="stat">
                        <i class="fas fa-list-ul"></i>
                        <span>@t.SectionCount بخش</span>
                    </div>
                    <div class="stat">
                        <i class="fas fa-code"></i>
                        <span>@t.CodeBlockCount بلوک کد</span>
                    </div>
                </div>

                <div class="tutorial-footer">
                    <div class="tutorial-date">
                        <i class="far fa-calendar-alt"></i>
                        @ToPersianDate(t.CreatedAt)
                    </div>
                    <div class="tutorial-actions">
                        <button class="btn-icon" title="مشاهده"
                                @onclick="() => ViewTutorial(t.TutorialApiId)">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn-icon edit" title="ویرایش"
                                @onclick="() => OpenEditModal(t)">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button class="btn-icon toggle" title="تغییر وضعیت"
                                @onclick="() => ToggleActive(t)">
                            <i class="fas @(t.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                        </button>
                        <button class="btn-icon delete" title="حذف"
                                @onclick="() => OpenDeleteModal(t)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="pagination">
            <button @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage <= 1)">
                <i class="fas fa-chevron-right"></i>
                قبلی
            </button>

            @foreach (var p in GetPageNumbers())
            {
                var pageNum = p;
                <button class="@(pageNum == currentPage ? "active" : "")"
                        @onclick="() => GoToPage(pageNum)">
                    @pageNum
                </button>
            }

            <button @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage >= totalPages)">
                بعدی
                <i class="fas fa-chevron-left"></i>
            </button>
        </div>
    }
}

<!-- ============================================================
     CREATE / EDIT MODAL
============================================================ -->
@if (showFormModal)
{
    <div class="modal-overlay" @onclick="CloseFormModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>
                    <i class="fas @(isEditMode ? "fa-pen" : "fa-plus-circle")"></i>
                    @(isEditMode ? "ویرایش آموزش" : "آموزش جدید")
                </h2>
                <button class="modal-close" @onclick="CloseFormModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field full">
                        <label><i class="fas fa-heading"></i> عنوان <span class="required">*</span></label>
                        <input type="text" @bind="formModel.Title" maxlength="500" placeholder="عنوان آموزش..." />
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-hashtag"></i> موضوع</label>
                        <input type="text" @bind="formModel.Topic" maxlength="200" placeholder="مثلاً: async/await" />
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-code"></i> موضوع اصلی</label>
                        <input type="text" @bind="formModel.Subject" maxlength="100" placeholder="مثلاً: C#" />
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-signal"></i> سطح</label>
                        <select @bind="formModel.Level">
                            <option value="all">همه سطوح</option>
                            <option value="beginner">مبتدی</option>
                            <option value="intermediate">متوسط</option>
                            <option value="advanced">پیشرفته</option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-folder"></i> دسته‌بندی</label>
                        <select @bind="formModel.Category">
                            <option value="concept">مفهوم</option>
                            <option value="language">زبان</option>
                            <option value="framework">فریمورک</option>
                            <option value="tool">ابزار</option>
                        </select>
                    </div>

                    <div class="form-field full">
                        <label><i class="fas fa-file-alt"></i> محتوای Markdown</label>
                        <textarea @bind="formModel.Content" placeholder="# عنوان&#10;&#10;متن آموزش..."></textarea>
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-list-ul"></i> تعداد بخش‌ها</label>
                        <input type="number" @bind="formModel.SectionCount" min="0" />
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-code"></i> تعداد بلوک‌های کد</label>
                        <input type="number" @bind="formModel.CodeBlockCount" min="0" />
                    </div>

                    <div class="form-field full">
                        <div class="checkbox-row">
                            <label class="checkbox-item">
                                <input type="checkbox" @bind="formModel.IsApproved" />
                                <i class="fas fa-check-circle" style="color:#52b788"></i>
                                تأیید شده
                            </label>
                            <label class="checkbox-item">
                                <input type="checkbox" @bind="formModel.IsActive" />
                                <i class="fas fa-toggle-on" style="color:#4dc9dd"></i>
                                فعال
                            </label>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="form-field full">
                            <div class="validation-msg">
                                <i class="fas fa-exclamation-circle"></i> @formError
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseFormModal" disabled="@isSaving">
                    انصراف
                </button>
                <button class="btn btn-primary" @onclick="SaveTutorial" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>در حال ذخیره...</span>
                    }
                    else
                    {
                        <i class="fas fa-save"></i>
                        <span>ذخیره</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================================
     DELETE MODAL
============================================================ -->
@if (showDeleteModal && selectedForDelete != null)
{
    <div class="modal-overlay" @onclick="CloseDeleteModal">
        <div class="modal-box delete-modal" @onclick:stopPropagation="true">
            <div class="modal-body">
                <div class="delete-icon-wrap">
                    <i class="fas fa-trash-alt"></i>
                </div>
                <h3>حذف آموزش</h3>
                <p>
                    آیا از حذف آموزش
                    <strong>«@selectedForDelete.Title»</strong>
                    اطمینان دارید؟ این عمل قابل بازگشت نیست.
                </p>
            </div>
            <div class="modal-footer" style="justify-content:center;">
                <button class="btn btn-secondary" @onclick="CloseDeleteModal" disabled="@isDeleting">
                    انصراف
                </button>
                <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>در حال حذف...</span>
                    }
                    else
                    {
                        <i class="fas fa-trash"></i>
                        <span>حذف کن</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================================
     TOAST
============================================================ -->
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast @(toastIsError ? "toast-error" : "toast-success")">
        <i class="fas @(toastIsError ? "fa-exclamation-circle" : "fa-check-circle")"></i>
        @toastMessage
    </div>
}

@code {
    // ============================================================
    // STATE
    // ============================================================
    private const int PageSize = 12;

    private List<BackEnd.Data.Entities.Tutorial.Tutorial>? tutorials;
    private int currentPage = 1;
    private int totalCount = 0;
    private int totalPages = 0;
    private bool isLoading = true;

    // Filters
    private string searchTerm = "";
    private string filterLevel = "";
    private string filterCategory = "";
    private string filterStatus = "";

    // Form Modal
    private bool showFormModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private string formError = "";
    private int editingId = 0;
    private TutorialFormModel formModel = new();

    // Delete Modal
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private BackEnd.Data.Entities.Tutorial.Tutorial? selectedForDelete;

    // Toast
    private string toastMessage = "";
    private bool toastIsError = false;
    private System.Threading.Timer? toastTimer;

    // ============================================================
    // LIFECYCLE
    // ============================================================
    protected override async Task OnInitializedAsync()
    {
        await LoadTutorials();
    }

    // ============================================================
    // DATA LOADING
    // ============================================================
    private async Task LoadTutorials()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var filter = new TutorialFilterParam
            {
                PageId = currentPage,
                Take = PageSize,
                IsAdmin = true,
                // SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                // Level = string.IsNullOrWhiteSpace(filterLevel) ? null : filterLevel,
                // Category = string.IsNullOrWhiteSpace(filterCategory) ? null : filterCategory
            };

            // اگر سرویس فیلتر وضعیت را پشتیبانی می‌کند این خط را فعال کن
            // filter.Status = string.IsNullOrWhiteSpace(filterStatus) ? null : filterStatus;

            var result = await TutorialService.GetFilter(filter);

            tutorials = result?.Data ?? new List<BackEnd.Data.Entities.Tutorial.Tutorial>();
            totalCount = result?.EntityCount ?? tutorials.Count;
            totalPages = (int)Math.Ceiling((double)totalCount / PageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Load error: {ex.Message}");
            tutorials = new List<BackEnd.Data.Entities.Tutorial.Tutorial>();
            totalCount = 0;
            totalPages = 0;
            ShowToast("خطا در بارگذاری داده‌ها", true);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadTutorials();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplyFilters();
    }

    // ============================================================
    // PAGINATION
    // ============================================================
    private async Task GoToPage(int page)
    {
        if (page < 1 || (totalPages > 0 && page > totalPages)) return;
        currentPage = page;
        await LoadTutorials();
        await JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 0, behavior: 'smooth' })");
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int maxVisible = 5;
        var start = Math.Max(1, currentPage - maxVisible / 2);
        var end = Math.Min(totalPages, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
            start = Math.Max(1, end - maxVisible + 1);

        for (int i = start; i <= end; i++)
            yield return i;
    }

    // ============================================================
    // FORM MODAL
    // ============================================================
    private void OpenCreateModal()
    {
        isEditMode = false;
        editingId = 0;
        formModel = new TutorialFormModel
        {
            Level = "all",
            Category = "concept",
            IsApproved = false,
            IsActive = false
        };
        formError = "";
        showFormModal = true;
    }

    private void OpenEditModal(BackEnd.Data.Entities.Tutorial.Tutorial t)
    {
        isEditMode = true;
        editingId = t.TutorialApiId;
        formModel = new TutorialFormModel
        {
            Title = t.Title,
            Topic = t.Topic ?? "",
            Subject = t.Subject ?? "",
            Level = t.Level ?? "all",
            Category = t.Category ?? "concept",
            Content = t.Content ?? "",
            SectionCount = t.SectionCount,
            CodeBlockCount = t.CodeBlockCount,
            IsApproved = t.IsApproved,
            IsActive = t.IsActive
        };
        formError = "";
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        if (isSaving) return;
        showFormModal = false;
        formError = "";
    }

    private async Task SaveTutorial()
    {
        // اعتبارسنجی
        if (string.IsNullOrWhiteSpace(formModel.Title))
        {
            formError = "عنوان آموزش الزامی است.";
            return;
        }

        formError = "";
        isSaving = true;
        StateHasChanged();

        try
        {
            if (isEditMode)
            {
                // TODO: متد Update را با نام واقعی سرویس خود جایگزین کن
                // await TutorialService.Update(editingId, formModel);
                Console.WriteLine($"[Tutorials] Update id={editingId}");
            }
            else
            {
                // TODO: متد Create را با نام واقعی سرویس خود جایگزین کن
                // await TutorialService.Create(formModel);
                Console.WriteLine("[Tutorials] Create");
            }

            showFormModal = false;
            ShowToast(isEditMode ? "آموزش با موفقیت ویرایش شد" : "آموزش با موفقیت ایجاد شد");
            await LoadTutorials();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Save error: {ex.Message}");
            formError = "خطا در ذخیره‌سازی. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // DELETE
    // ============================================================
    private void OpenDeleteModal(BackEnd.Data.Entities.Tutorial.Tutorial t)
    {
        selectedForDelete = t;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (isDeleting) return;
        showDeleteModal = false;
        selectedForDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (selectedForDelete == null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            // TODO: متد Delete را با نام واقعی سرویس خود جایگزین کن
            // await TutorialService.Delete(selectedForDelete.Id);
            Console.WriteLine($"[Tutorials] Delete id={selectedForDelete.Id}");

            ShowToast("آموزش با موفقیت حذف شد");
            showDeleteModal = false;
            selectedForDelete = null;
            await LoadTutorials();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Delete error: {ex.Message}");
            ShowToast("خطا در حذف آموزش", true);
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // TOGGLE ACTIVE
    // ============================================================
    private async Task ToggleActive(BackEnd.Data.Entities.Tutorial.Tutorial t)
    {
        try
        {
            // TODO: متد ToggleActive را با نام واقعی سرویس خود جایگزین کن
            // await TutorialService.ToggleActive(t.Id);
            Console.WriteLine($"[Tutorials] ToggleActive id={t.Id}");

            ShowToast(t.IsActive ? "آموزش غیرفعال شد" : "آموزش فعال شد");
            await LoadTutorials();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Toggle error: {ex.Message}");
            ShowToast("خطا در تغییر وضعیت", true);
        }
    }

    // ============================================================
    // NAVIGATION
    // ============================================================
    private void ViewTutorial(int id)
        => Navigation.NavigateTo($"/Admin/Tutorials/Details/{id}");

    // ============================================================
    // TOAST
    // ============================================================
    private void ShowToast(string message, bool isError = false)
    {
        toastMessage = message;
        toastIsError = isError;
        StateHasChanged();

        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                toastMessage = "";
                StateHasChanged();
            });
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

    // ============================================================
    // HELPERS
    // ============================================================
    private static string GetCategoryIcon(string? category) => category?.ToLower() switch
    {
        "language" => "fas fa-code",
        "framework" => "fas fa-layer-group",
        "tool" => "fas fa-wrench",
        "concept" => "fas fa-lightbulb",
        _ => "fas fa-book"
    };

    private static string GetCategoryClass(string? category) => category?.ToLower() switch
    {
        "language" => "cat-language",
        "framework" => "cat-framework",
        "tool" => "cat-tool",
        "concept" => "cat-concept",
        _ => ""
    };

    private static string GetLevelClass(string? level) => level?.ToLower() switch
    {
        "beginner" => "tag-level-beginner",
        "intermediate" => "tag-level-intermediate",
        "advanced" => "tag-level-advanced",
        _ => "tag-level-all"
    };

    private static string GetLevelText(string? level) => level?.ToLower() switch
    {
        "beginner" => "مبتدی",
        "intermediate" => "متوسط",
        "advanced" => "پیشرفته",
        "all" => "همه سطوح",
        _ => "نامشخص"
    };

    private static string ToPersianDate(DateTime dt)
    {
        try
        {
            var pc = new System.Globalization.PersianCalendar();
            return $"{pc.GetYear(dt):0000}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00}";
        }
        catch
        {
            return dt.ToString("yyyy/MM/dd");
        }
    }

    // ============================================================
    // FORM MODEL
    // ============================================================
    public class TutorialFormModel
    {
        public string Title { get; set; } = "";
        public string Topic { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Level { get; set; } = "all";
        public string Category { get; set; } = "concept";
        public string Content { get; set; } = "";
        public int SectionCount { get; set; }
        public int CodeBlockCount { get; set; }
        public bool IsApproved { get; set; }
        public bool IsActive { get; set; }
    }
}