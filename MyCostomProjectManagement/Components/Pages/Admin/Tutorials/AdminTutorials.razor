@page "/Admin/Tutorials"
@layout AdminLayout
@rendermode InteractiveServer
@inject ITutorialApiService TutorialService
@inject NavigationManager Navigation
@inject IDbContextFactory<Context> _dbFactory
@inject IJSRuntime JSRuntime
@using BackEnd.Data.DB
@using BackEnd.Data.Entities.Tutorial
@using BackEnd.Data.Infrastructure.Tutorial
@using BackEnd.Data.Infrastructure.Tutorial.DTOs
@using Microsoft.EntityFrameworkCore

<PageTitle>مدیریت آموزش‌ها | پنل ادمین</PageTitle>

<!-- ============================================================
     HEADER
============================================================ -->
<div class="tutorials-header">
    <h1>
        <i class="fas fa-graduation-cap"></i>
        مدیریت آموزش‌ها
        @if (totalCount > 0)
        {
            <span class="badge-count">@totalCount.ToString("N0") مورد</span>
        }
    </h1>
    <button class="btn-add" @onclick="OpenCreateModal">
        <i class="fas fa-plus"></i>
        آموزش جدید
    </button>
</div>

<!-- ============================================================
     FILTERS
============================================================ -->
<div class="filters-bar">
    <input type="text"
           class="filter-input"
           placeholder="جستجو در عنوان..."
           @bind="searchTerm"
           @bind:event="oninput"
           @onkeydown="OnSearchKeyDown" />

    <select class="filter-select" @bind="filterLevel">
        <option value="">همه سطوح</option>
        <option value="beginner">مبتدی</option>
        <option value="intermediate">متوسط</option>
        <option value="advanced">پیشرفته</option>
        <option value="all">همه سطوح</option>
    </select>

    <select class="filter-select" @bind="filterCategory">
        <option value="">همه دسته‌ها</option>
        <option value="language">زبان</option>
        <option value="framework">فریمورک</option>
        <option value="tool">ابزار</option>
        <option value="concept">مفهوم</option>
    </select>

    <select class="filter-select" @bind="filterStatus">
        <option value=@TutorialStatus.None>همه وضعیت‌ها</option>
        <option value=@TutorialStatus.Approved>تأیید شده</option>
        <option value=@TutorialStatus.Pending>در انتظار تأیید</option>
        <option value=@TutorialStatus.Active>فعال</option>
        <option value=@TutorialStatus.Inactive>غیرفعال</option>
        <option value=@TutorialStatus.Deleted>حذف‌شده</option>
    </select>

    <button class="btn-search" @onclick="ApplyFilters">
        <i class="fas fa-search"></i>
        اعمال فیلتر
    </button>

    <button class="btn-search" @onclick="ResetFilters" title="پاک کردن فیلترها">
        <i class="fas fa-times"></i>
    </button>
</div>

<!-- ============================================================
     CONTENT
============================================================ -->
@if (isLoading)
{
    <div class="state-box">
        <div class="spinner"></div>
        <h3>در حال بارگذاری...</h3>
    </div>
}
else if (tutorials == null || tutorials.Count == 0)
{
    <div class="state-box">
        <i class="fas fa-inbox"></i>
        <h3>هیچ آموزشی یافت نشد</h3>
        <p>هنوز آموزشی اضافه نشده یا فیلترها نتیجه‌ای نداشتند.</p>
    </div>
}
else
{
    <div class="tutorials-grid">
        @foreach (var t in tutorials)
        {
            <div class="tutorial-card @(t.IsDelete ? "is-deleted" : "")">
                <div class="tutorial-card-header">
                    <div class="tutorial-icon @GetCategoryClass(t.Category)">
                        <i class="@GetCategoryIcon(t.Category)"></i>
                    </div>
                    <div style="flex:1; min-width:0;">
                        <h3 title="@t.Title">@t.Title</h3>
                        <div class="topic">
                            <i class="fas fa-hashtag"></i>
                            @(string.IsNullOrWhiteSpace(t.Topic) ? "بدون موضوع" : t.Topic)
                        </div>
                    </div>
                </div>

                <div class="tags-row">
                    @if (!string.IsNullOrWhiteSpace(t.Subject))
                    {
                        <span class="tag tag-subject">
                            <i class="fas fa-code"></i> @t.Subject
                        </span>
                    }
                    <span class="tag @GetLevelClass(t.Level)">
                        <i class="fas fa-signal"></i> @GetLevelText(t.Level)
                    </span>
                    <span class="tag @GetCategoryClass(t.Category)">
                        <i class="@GetCategoryIcon(t.Category)"></i> @GetCategoryText(t.Category)
                    </span>
                    <span class="tag @(t.IsApproved ? "tag-approved" : "tag-pending")">
                        <i class="fas @(t.IsApproved ? "fa-check-circle" : "fa-clock")"></i>
                        @(t.IsApproved ? "تأیید شده" : "در انتظار")
                    </span>
                    <span class="tag @(t.IsActive ? "tag-active" : "tag-inactive")">
                        <i class="fas @(t.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                        @(t.IsActive ? "فعال" : "غیرفعال")
                    </span>
                    @if (t.IsDelete)
                    {
                        <span class="tag tag-deleted">
                            <i class="fas fa-trash"></i> حذف‌شده
                        </span>
                    }
                </div>

                <div class="tutorial-stats">
                    <div class="stat">
                        <i class="fas fa-list-ul"></i>
                        <span>@t.SectionCount بخش</span>
                    </div>
                    <div class="stat">
                        <i class="fas fa-code"></i>
                        <span>@t.CodeBlockCount بلوک کد</span>
                    </div>
                    <div class="stat">
                        <i class="fas fa-fingerprint"></i>
                        <span>API: @t.TutorialApiId</span>
                    </div>
                </div>

                <div class="tutorial-footer">
                    <div class="tutorial-date">
                        <i class="far fa-calendar-alt"></i>
                        @ToPersianDate(t.CreatedAt)
                    </div>
                    <div class="tutorial-actions">
                        <button class="btn-icon" title="مشاهده"
                                @onclick="() => ViewTutorial(t.TutorialApiId)">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn-icon edit" title="ویرایش"
                                @onclick="() => OpenEditModal(t)">
                            <i class="fas fa-pen"></i>
                        </button>

                        @* ← جدید: دکمه تأیید/لغو تأیید *@
                        <button class="btn-icon approve @(t.IsApproved ? "is-on" : "")"
                                title="@(t.IsApproved ? "لغو تأیید" : "تأیید آموزش")"
                                @onclick="() => ToggleApproved(t)">
                            <i class="fas @(t.IsApproved ? "fa-check-circle" : "fa-circle-notch")"></i>
                        </button>

                        <button class="btn-icon toggle @(t.IsActive ? "is-on" : "")"
                                title="@(t.IsActive ? "غیرفعال کردن" : "فعال کردن")"
                                @onclick="() => ToggleActive(t)">
                            <i class="fas @(t.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                        </button>

                        @if (t.IsDelete)
                        {
                            <button class="btn-icon restore" title="بازگردانی"
                                    @onclick="() => RestoreTutorial(t)">
                                <i class="fas fa-undo"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn-icon delete" title="حذف"
                                    @onclick="() => OpenDeleteModal(t)">
                                <i class="fas fa-trash"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="pagination">
            <button @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage <= 1)">
                <i class="fas fa-chevron-right"></i>
                قبلی
            </button>

            @foreach (var p in GetPageNumbers())
            {
                var pageNum = p;
                <button class="@(pageNum == currentPage ? "active" : "")"
                        @onclick="() => GoToPage(pageNum)">
                    @pageNum
                </button>
            }

            <button @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage >= totalPages)">
                بعدی
                <i class="fas fa-chevron-left"></i>
            </button>
        </div>
    }
}

<!-- ============================================================
     CREATE / EDIT MODAL
============================================================ -->
@if (showFormModal)
{
    <div class="modal-overlay" @onclick="CloseFormModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>
                    <i class="fas @(isEditMode ? "fa-pen" : "fa-plus-circle")"></i>
                    @(isEditMode ? "ویرایش آموزش" : "آموزش جدید")
                </h2>
                <button class="modal-close" @onclick="CloseFormModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field full">
                        <label><i class="fas fa-heading"></i> عنوان <span class="required">*</span></label>
                        <input type="text" @bind="formModel.Title" maxlength="500" placeholder="عنوان آموزش..." />
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-hashtag"></i> موضوع</label>
                        <input type="text" @bind="formModel.Topic" maxlength="200" placeholder="مثلاً: async/await" />
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-code"></i> موضوع اصلی (Subject)</label>
                        <input type="text" @bind="formModel.Subject" maxlength="100" placeholder="مثلاً: C#" />
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-signal"></i> سطح</label>
                        <select @bind="formModel.Level">
                            <option value="all">همه سطوح</option>
                            <option value="beginner">مبتدی</option>
                            <option value="intermediate">متوسط</option>
                            <option value="advanced">پیشرفته</option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-folder"></i> دسته‌بندی</label>
                        <select @bind="formModel.Category">
                            <option value="concept">مفهوم</option>
                            <option value="language">زبان</option>
                            <option value="framework">فریمورک</option>
                            <option value="tool">ابزار</option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-fingerprint"></i> TutorialApiId</label>
                        <input type="number" @bind="formModel.TutorialApiId" min="0" />
                    </div>

                    <div class="form-field full">
                        <label><i class="fas fa-file-alt"></i> محتوای Markdown</label>
                        <textarea @bind="formModel.Content" placeholder="# عنوان&#10;&#10;متن آموزش..."></textarea>
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-list-ul"></i> تعداد بخش‌ها</label>
                        <input type="number" @bind="formModel.SectionCount" min="0" />
                    </div>

                    <div class="form-field">
                        <label><i class="fas fa-code"></i> تعداد بلوک‌های کد</label>
                        <input type="number" @bind="formModel.CodeBlockCount" min="0" />
                    </div>

                    <div class="form-field full">
                        <div class="checkbox-row">
                            <label class="checkbox-item">
                                <input type="checkbox" @bind="formModel.IsApproved" />
                                <i class="fas fa-check-circle" style="color:#52b788"></i>
                                تأیید شده
                            </label>
                            <label class="checkbox-item">
                                <input type="checkbox" @bind="formModel.IsActive" />
                                <i class="fas fa-toggle-on" style="color:#4dc9dd"></i>
                                فعال
                            </label>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="form-field full">
                            <div class="validation-msg">
                                <i class="fas fa-exclamation-circle"></i> @formError
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseFormModal" disabled="@isSaving">
                    انصراف
                </button>
                <button class="btn btn-primary" @onclick="SaveTutorial" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>در حال ذخیره...</span>
                    }
                    else
                    {
                        <i class="fas fa-save"></i>
                        <span>ذخیره</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================================
     DELETE MODAL
============================================================ -->
@if (showDeleteModal && selectedForDelete != null)
{
    <div class="modal-overlay" @onclick="CloseDeleteModal">
        <div class="modal-box delete-modal" @onclick:stopPropagation="true">
            <div class="modal-body">
                <div class="delete-icon-wrap">
                    <i class="fas fa-trash-alt"></i>
                </div>
                <h3>حذف آموزش</h3>
                <p>
                    آیا از حذف آموزش
                    <strong>«@selectedForDelete.Title»</strong>
                    اطمینان دارید؟ این عمل قابل بازگشت نیست.
                </p>
            </div>
            <div class="modal-footer" style="justify-content:center;">
                <button class="btn btn-secondary" @onclick="CloseDeleteModal" disabled="@isDeleting">
                    انصراف
                </button>
                <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>در حال حذف...</span>
                    }
                    else
                    {
                        <i class="fas fa-trash"></i>
                        <span>حذف کن</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ============================================================
     TOAST
============================================================ -->
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast @(toastIsError ? "toast-error" : "toast-success")">
        <i class="fas @(toastIsError ? "fa-exclamation-circle" : "fa-check-circle")"></i>
        @toastMessage
    </div>
}

@code {
    // ============================================================
    // STATE
    // ============================================================
    private const int PageSize = 12;

    private List<Tutorial>? tutorials;
    private int currentPage = 1;
    private int totalCount = 0;
    private int totalPages = 0;
    private bool isLoading = true;

    // Filters
    private string searchTerm = "";
    private string filterLevel = "";
    private string filterCategory = "";
    private TutorialStatus filterStatus { get; set; } = TutorialStatus.None;

    // Form Modal
    private bool showFormModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private string formError = "";
    private Guid editingId = Guid.Empty;
    private TutorialFormModel formModel = new();

    // Delete Modal
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private Tutorial? selectedForDelete;

    // Toast
    private string toastMessage = "";
    private bool toastIsError = false;
    private System.Threading.Timer? toastTimer;

    // ============================================================
    // LIFECYCLE
    // ============================================================
    protected override async Task OnInitializedAsync()
    {
        await LoadTutorials();
    }

    // ============================================================
    // DATA LOADING
    // ============================================================
    private async Task LoadTutorials()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var filter = new TutorialFilterParam
            {
                PageId = currentPage,
                Take = PageSize,
                IsAdmin = true,
                SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                Level = string.IsNullOrWhiteSpace(filterLevel) ? null : filterLevel,
                Category = string.IsNullOrWhiteSpace(filterCategory) ? null : filterCategory,
                Status = filterStatus
            };

            var result = await TutorialService.GetFilter(filter);

            tutorials = result?.Data ?? new List<Tutorial>();
            totalCount = result?.EntityCount ?? tutorials.Count;
            totalPages = (int)Math.Ceiling((double)totalCount / PageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Load error: {ex.Message}");
            tutorials = new List<Tutorial>();
            totalCount = 0;
            totalPages = 0;
            ShowToast("خطا در بارگذاری داده‌ها", true);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadTutorials();
    }

    private async Task ResetFilters()
    {
        searchTerm = "";
        filterLevel = "";
        filterCategory = "";
        filterStatus = TutorialStatus.None;
        currentPage = 1;
        await LoadTutorials();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplyFilters();
    }

    // ============================================================
    // PAGINATION
    // ============================================================
    private async Task GoToPage(int page)
    {
        if (page < 1 || (totalPages > 0 && page > totalPages)) return;
        currentPage = page;
        await LoadTutorials();
        await JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 0, behavior: 'smooth' })");
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int maxVisible = 5;
        var start = Math.Max(1, currentPage - maxVisible / 2);
        var end = Math.Min(totalPages, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
            start = Math.Max(1, end - maxVisible + 1);

        for (int i = start; i <= end; i++)
            yield return i;
    }

    // ============================================================
    // FORM MODAL
    // ============================================================
    private void OpenCreateModal()
    {
        isEditMode = false;
        editingId = Guid.Empty;
        formModel = new TutorialFormModel
        {
            Level = "all",
            Category = "concept",
            IsApproved = false,
            IsActive = false,
            TutorialApiId = 0,
            SectionCount = 0,
            CodeBlockCount = 0
        };
        formError = "";
        showFormModal = true;
    }

    private void OpenEditModal(Tutorial t)
    {
        isEditMode = true;
        editingId = t.Id;
        formModel = new TutorialFormModel
        {
            TutorialApiId = t.TutorialApiId,
            Title = t.Title,
            Topic = t.Topic ?? "",
            Subject = t.Subject ?? "",
            Level = string.IsNullOrWhiteSpace(t.Level) ? "all" : t.Level,
            Category = string.IsNullOrWhiteSpace(t.Category) ? "concept" : t.Category,
            Content = t.Content ?? "",
            SectionCount = t.SectionCount,
            CodeBlockCount = t.CodeBlockCount,
            IsApproved = t.IsApproved,
            IsActive = t.IsActive
        };
        formError = "";
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        if (isSaving) return;
        showFormModal = false;
        formError = "";
    }

    private async Task SaveTutorial()
    {
        // ============================
        // Validation
        // ============================
        if (string.IsNullOrWhiteSpace(formModel.Title))
        {
            formError = "عنوان آموزش الزامی است.";
            return;
        }
        if (formModel.Title.Length > 500)
        {
            formError = "عنوان نباید بیشتر از ۵۰۰ کاراکتر باشد.";
            return;
        }
        if ((formModel.Topic?.Length ?? 0) > 200)
        {
            formError = "موضوع نباید بیشتر از ۲۰۰ کاراکتر باشد.";
            return;
        }
        if ((formModel.Subject?.Length ?? 0) > 100)
        {
            formError = "موضوع اصلی نباید بیشتر از ۱۰۰ کاراکتر باشد.";
            return;
        }
        if ((formModel.Level?.Length ?? 0) > 20)
        {
            formError = "سطح نامعتبر است.";
            return;
        }
        if ((formModel.Category?.Length ?? 0) > 30)
        {
            formError = "دسته‌بندی نامعتبر است.";
            return;
        }

        // قاعده: آموزش فعال باید تأیید شده باشد
        if (formModel.IsActive && !formModel.IsApproved)
        {
            formError = "نمی‌توان آموزشی را فعال کرد که هنوز تأیید نشده است.";
            return;
        }

        formError = "";
        isSaving = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();

            if (isEditMode)
            {
                var entity = await db.Tutorials.FirstOrDefaultAsync(x => x.Id == editingId);
                if (entity == null)
                {
                    formError = "آموزش موردنظر یافت نشد.";
                    return;
                }

                entity.TutorialApiId = formModel.TutorialApiId;
                entity.Title = formModel.Title.Trim();
                entity.Topic = formModel.Topic?.Trim() ?? "";
                entity.Subject = formModel.Subject?.Trim() ?? "";
                entity.Level = string.IsNullOrWhiteSpace(formModel.Level) ? "all" : formModel.Level;
                entity.Category = string.IsNullOrWhiteSpace(formModel.Category) ? "concept" : formModel.Category;
                entity.Content = formModel.Content ?? "";
                entity.SectionCount = formModel.SectionCount;
                entity.CodeBlockCount = formModel.CodeBlockCount;
                entity.IsApproved = formModel.IsApproved;
                entity.IsActive = formModel.IsActive;

                await db.SaveChangesAsync();
                ShowToast("آموزش با موفقیت ویرایش شد");
            }
            else
            {
                var entity = new Tutorial
                {
                    TutorialApiId = formModel.TutorialApiId,
                    Title = formModel.Title.Trim(),
                    Topic = formModel.Topic?.Trim() ?? "",
                    Subject = formModel.Subject?.Trim() ?? "",
                    Level = string.IsNullOrWhiteSpace(formModel.Level) ? "all" : formModel.Level,
                    Category = string.IsNullOrWhiteSpace(formModel.Category) ? "concept" : formModel.Category,
                    Content = formModel.Content ?? "",
                    SectionCount = formModel.SectionCount,
                    CodeBlockCount = formModel.CodeBlockCount,
                    IsApproved = formModel.IsApproved,
                    IsActive = formModel.IsActive,
                    IsDelete = false,
                    CreatedAt = DateTime.Now
                };

                db.Tutorials.Add(entity);
                await db.SaveChangesAsync();
                ShowToast("آموزش با موفقیت ایجاد شد");
            }

            showFormModal = false;
            await LoadTutorials();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Save error: {ex.Message}");
            formError = "خطا در ذخیره‌سازی. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // DELETE (Soft Delete)
    // ============================================================
    private void OpenDeleteModal(Tutorial t)
    {
        selectedForDelete = t;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (isDeleting) return;
        showDeleteModal = false;
        selectedForDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (selectedForDelete == null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Tutorials.FirstOrDefaultAsync(x => x.Id == selectedForDelete.Id);
            if (entity != null)
            {
                entity.IsDelete = true;
                entity.IsActive = false;
                await db.SaveChangesAsync();
            }

            ShowToast("آموزش با موفقیت حذف شد");
            showDeleteModal = false;
            selectedForDelete = null;
            await LoadTutorials();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Delete error: {ex.Message}");
            ShowToast("خطا در حذف آموزش", true);
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // RESTORE
    // ============================================================
    private async Task RestoreTutorial(Tutorial t)
    {
        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Tutorials.FirstOrDefaultAsync(x => x.Id == t.Id);
            if (entity == null) return;

            entity.IsDelete = false;
            await db.SaveChangesAsync();

            ShowToast("آموزش با موفقیت بازگردانی شد");
            await LoadTutorials();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Restore error: {ex.Message}");
            ShowToast("خطا در بازگردانی آموزش", true);
        }
    }

    // ============================================================
    // TOGGLE APPROVED  ← جدید
    // ============================================================
    private async Task ToggleApproved(Tutorial t)
    {
        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Tutorials.FirstOrDefaultAsync(x => x.Id == t.Id);
            if (entity == null) return;

            entity.IsApproved = !entity.IsApproved;

            // اگر از حالت تأیید خارج شد، خودکار غیرفعال شود
            if (!entity.IsApproved && entity.IsActive)
            {
                entity.IsActive = false;
            }

            await db.SaveChangesAsync();

            ShowToast(entity.IsApproved
                ? "آموزش تأیید شد"
                : "تأیید آموزش لغو شد");
            await LoadTutorials();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] ToggleApproved error: {ex.Message}");
            ShowToast("خطا در تغییر وضعیت تأیید", true);
        }
    }

    // ============================================================
    // TOGGLE ACTIVE
    // ============================================================
    private async Task ToggleActive(Tutorial t)
    {
        try
        {
            using var db = await _dbFactory.CreateDbContextAsync();
            var entity = await db.Tutorials.FirstOrDefaultAsync(x => x.Id == t.Id);
            if (entity == null) return;

            // قاعده: برای فعال کردن باید تأیید شده باشد
            if (!entity.IsActive && !entity.IsApproved)
            {
                ShowToast("ابتدا باید آموزش را تأیید کنید", true);
                return;
            }

            entity.IsActive = !entity.IsActive;
            await db.SaveChangesAsync();

            ShowToast(entity.IsActive ? "آموزش فعال شد" : "آموزش غیرفعال شد");
            await LoadTutorials();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Toggle error: {ex.Message}");
            ShowToast("خطا در تغییر وضعیت", true);
        }
    }

