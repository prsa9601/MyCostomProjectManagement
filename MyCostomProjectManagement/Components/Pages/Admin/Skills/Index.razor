<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-code"></i>
                    مدیریت مهارت‌ها
                    <span class="badge-admin" style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalSkills</span>
                </h1>
                <div class="subtitle">مدیریت مهارت‌های فنی، دسته‌بندی و سطح پیشرفت</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshSkills"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="stats-row fade-up visible">
            <div class="stat-mini">
                <i class="fas fa-code"></i>
                <div class="info">
                    <div class="number">@totalSkills</div>
                    <div class="label">کل مهارت‌ها</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-layer-group" style="color:#52b788;"></i>
                <div class="info">
                    <div class="number">@categoryCount</div>
                    <div class="label">دسته‌بندی‌ها</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-star" style="color:#e8a838;"></i>
                <div class="info">
                    <div class="number">@highLevelCount</div>
                    <div class="label">مهارت‌های پیشرفته (۸۰%+)</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-graduation-cap" style="color:#8264c8;"></i>
                <div class="info">
                    <div class="number">@learningCount</div>
                    <div class="label">در حال یادگیری (زیر ۵۰%)</div>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی مهارت..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterCategory == "all" ? "active" : "")" @onclick='() => SetCategory("all")'>همه</button>
                <button class="filter-btn @(filterCategory == "frontend" ? "active" : "")" @onclick='() => SetCategory("frontend")'>فرانت‌اند</button>
                <button class="filter-btn @(filterCategory == "backend" ? "active" : "")" @onclick='() => SetCategory("backend")'>بک‌اند</button>
                <button class="filter-btn @(filterCategory == "database" ? "active" : "")" @onclick='() => SetCategory("database")'>دیتابیس</button>
                <button class="filter-btn @(filterCategory == "devops" ? "active" : "")" @onclick='() => SetCategory("devops")'>DevOps</button>
                <button class="filter-btn @(filterCategory == "other" ? "active" : "")" @onclick='() => SetCategory("other")'>سایر</button>
            </div>
        </div>

        <!-- Add Skill Form -->
        <div class="add-skill-form fade-up visible">
            <div class="form-title">
                <i class="fas fa-plus-circle"></i>
                افزودن مهارت جدید
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>نام مهارت</label>
                    <input type="text" placeholder="مثال: React" @bind="newSkillName" />
                </div>
                <div class="form-group">
                    <label>دسته‌بندی</label>
                    <select @bind="newSkillCategory">
                        <option value="frontend">فرانت‌اند</option>
                        <option value="backend">بک‌اند</option>
                        <option value="database">دیتابیس</option>
                        <option value="devops">DevOps</option>
                        <option value="other">سایر</option>
                    </select>
                </div>
                <button class="btn-add ripple" @onclick="AddSkill"><i class="fas fa-plus"></i> افزودن</button>
            </div>
        </div>

        <!-- Skills Grid -->
        @if (filteredSkills.Any())
        {
            <div class="skills-grid">
                @foreach (var skill in filteredSkills)
                {
                    <div class="skill-card category-@skill.Category fade-up stagger-child">
                        <span class="skill-icon"><i class="@skill.Icon"></i></span>
                        <div class="skill-name">@skill.Name</div>
                        <div class="skill-category">@skill.CategoryText</div>
                        <div class="skill-progress">
                            <div class="fill" style="width:@(skill.Progress)%;"></div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="skill-actions">
                            <button class="edit ripple" title="ویرایش" @onclick='() => ToggleEdit(skill.Id)'><i class="fas fa-edit"></i></button>
                            <button class="delete ripple" title="حذف" @onclick='() => DeleteSkill(skill.Id)'><i class="fas fa-trash-alt"></i></button>
                        </div>

                        <!-- Edit Mode -->
                        <div class="edit-mode @(editingSkillId == skill.Id ? "active" : "")">
                            <input type="text" @bind="editName" placeholder="نام مهارت" />
                            <select @bind="editCategory">
                                <option value="frontend">فرانت‌اند</option>
                                <option value="backend">بک‌اند</option>
                                <option value="database">دیتابیس</option>
                                <option value="devops">DevOps</option>
                                <option value="other">سایر</option>
                            </select>
                            <input type="number" @bind="editProgress" min="0" max="100" placeholder="سطح پیشرفت (۰-۱۰۰)" />
                            <div class="edit-actions">
                                <button class="save-edit ripple" @onclick='() => SaveEdit(skill.Id)'><i class="fas fa-check"></i> ذخیره</button>
                                <button class="cancel-edit ripple" @onclick='() => CancelEdit()'><i class="fas fa-times"></i> لغو</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state fade-up visible">
                <i class="fas fa-code"></i>
                <h3>هیچ مهارتی یافت نشد</h3>
                <p>با تغییر فیلترها یا افزودن مهارت جدید، نتایج را مشاهده کنید</p>
            </div>
        }

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }

    </div>
</main>

