@code {
    // ============================================================
    // STATE & DATA
    // ============================================================

    private bool isMenuOpen = false;
    private string searchTerm = "";
    private string filterCategory = "all";
    private int currentPage = 1;
    private int pageSize = 8;
    private int totalPages = 1;

    // New skill form
    private string newSkillName = "";
    private string newSkillCategory = "frontend";

    // Edit mode
    private string? editingSkillId = null;
    private string editName = "";
    private string editCategory = "frontend";
    private int editProgress = 50;

    private List<SkillItem> allSkills = new();
    private List<SkillItem> filteredSkills = new();

    private int totalSkills => allSkills.Count;
    private int categoryCount => allSkills.Select(s => s.Category).Distinct().Count();
    private int highLevelCount => allSkills.Count(s => s.Progress >= 80);
    private int learningCount => allSkills.Count(s => s.Progress < 50);

    // Icon mapping for categories
    private Dictionary<string, string> categoryIcons = new()
    {
        { "frontend", "fab fa-react" },
        { "backend", "fas fa-server" },
        { "database", "fas fa-database" },
        { "devops", "fas fa-cloud" },
        { "other", "fas fa-code" }
    };

    private Dictionary<string, string> categoryTexts = new()
    {
        { "frontend", "فرانت‌اند" },
        { "backend", "بک‌اند" },
        { "database", "دیتابیس" },
        { "devops", "DevOps" },
        { "other", "سایر" }
    };

    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override void OnInitialized()
    {
        LoadSkills();
        ApplyFilters();
    }

    private void LoadSkills()
    {
        allSkills = new List<SkillItem>
        {
            new SkillItem { Id = "SK-001", Name = "React", Category = "frontend", Progress = 90 },
            new SkillItem { Id = "SK-002", Name = "Vue.js", Category = "frontend", Progress = 85 },
            new SkillItem { Id = "SK-003", Name = "Node.js", Category = "backend", Progress = 80 },
            new SkillItem { Id = "SK-004", Name = "Python", Category = "backend", Progress = 75 },
            new SkillItem { Id = "SK-005", Name = "MongoDB", Category = "database", Progress = 85 },
            new SkillItem { Id = "SK-006", Name = "PostgreSQL", Category = "database", Progress = 70 },
            new SkillItem { Id = "SK-007", Name = "AWS", Category = "devops", Progress = 65 },
            new SkillItem { Id = "SK-008", Name = "Docker", Category = "devops", Progress = 60 },
            new SkillItem { Id = "SK-009", Name = "TypeScript", Category = "frontend", Progress = 88 },
            new SkillItem { Id = "SK-010", Name = "GraphQL", Category = "backend", Progress = 55 },
            new SkillItem { Id = "SK-011", Name = "Redis", Category = "database", Progress = 45 },
            new SkillItem { Id = "SK-012", Name = "Kubernetes", Category = "devops", Progress = 40 },
            new SkillItem { Id = "SK-013", Name = "Figma", Category = "other", Progress = 70 },
            new SkillItem { Id = "SK-014", Name = "Git", Category = "other", Progress = 95 }
        };

        // Set icon and category text for each skill
        foreach (var skill in allSkills)
        {
            skill.Icon = categoryIcons.GetValueOrDefault(skill.Category, "fas fa-code");
            skill.CategoryText = categoryTexts.GetValueOrDefault(skill.Category, "سایر");
        }
    }

    // ============================================================
    // FILTER & SEARCH
    // ============================================================

    private void ApplyFilters()
    {
        var query = allSkills.AsEnumerable();

        // Filter by category
        if (!string.IsNullOrEmpty(filterCategory) && filterCategory != "all")
        {
            query = query.Where(s => s.Category == filterCategory);
        }

        // Search
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(s =>
                s.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.CategoryText.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        // Pagination
        var total = query.Count();
        totalPages = (int)Math.Ceiling(total / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        filteredSkills = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SetCategory(string category)
    {
        filterCategory = category;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // CRUD OPERATIONS
    // ============================================================

    private void AddSkill()
    {
        if (string.IsNullOrWhiteSpace(newSkillName)) return;

        var newSkill = new SkillItem
        {
            Id = "SK-" + (allSkills.Count + 1).ToString("D3"),
            Name = newSkillName.Trim(),
            Category = newSkillCategory,
            Progress = 0,
            Icon = categoryIcons.GetValueOrDefault(newSkillCategory, "fas fa-code"),
            CategoryText = categoryTexts.GetValueOrDefault(newSkillCategory, "سایر")
        };

        allSkills.Add(newSkill);
        newSkillName = "";
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleEdit(string id)
    {
        var skill = allSkills.FirstOrDefault(s => s.Id == id);
        if (skill == null) return;

        if (editingSkillId == id)
        {
            CancelEdit();
            return;
        }

        editingSkillId = id;
        editName = skill.Name;
        editCategory = skill.Category;
        editProgress = skill.Progress;
        StateHasChanged();
    }

    private void SaveEdit(string id)
    {
        var skill = allSkills.FirstOrDefault(s => s.Id == id);
        if (skill == null) return;

        if (!string.IsNullOrWhiteSpace(editName))
        {
            skill.Name = editName.Trim();
        }
        skill.Category = editCategory;
        skill.Progress = Math.Clamp(editProgress, 0, 100);
        skill.Icon = categoryIcons.GetValueOrDefault(editCategory, "fas fa-code");
        skill.CategoryText = categoryTexts.GetValueOrDefault(editCategory, "سایر");

        CancelEdit();
        ApplyFilters();
        StateHasChanged();
    }

    private void CancelEdit()
    {
        editingSkillId = null;
        editName = "";
        editCategory = "frontend";
        editProgress = 50;
        StateHasChanged();
    }

    private void DeleteSkill(string id)
    {
        allSkills.RemoveAll(s => s.Id == id);
        if (editingSkillId == id) CancelEdit();
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // UI METHODS
    // ============================================================

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;
    private void GoToProfile() => NavigationManager.NavigateTo("/Profile", true);
    private void RefreshSkills()
    {
        LoadSkills();
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Navbar scroll
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 30);
            });

            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Fade-up observer
            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 });

            fadeEls.forEach(el => observer.observe(el));

            // Trigger visible for elements already in view
            setTimeout(() => {
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                    }
                });
            }, 300);
        ");
    }

    // ============================================================
    // HELPER CLASSES
    // ============================================================

    public class SkillItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public string CategoryText { get; set; } = "";
        public string Icon { get; set; } = "";
        public int Progress { get; set; }
    }
}