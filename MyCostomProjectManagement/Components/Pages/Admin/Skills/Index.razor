@page "/Admin/Skills"
@layout FrontLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>مدیریت مهارت‌ها | پنل ادمین</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ============================================================
       SKILLS PAGE - با پس‌زمینه #13505b
    ============================================================ */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #13505b;
        color: #e8f0f1;
        line-height: 1.7;
        scroll-behavior: smooth;
        overflow-x: hidden;
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 2;
    }

    /* ============================================================
       GLASS EFFECT
    ============================================================ */
    .glass {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    .glass:hover {
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 8px 48px rgba(0, 0, 0, 0.12);
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.06);
    }

    /* ============================================================
       ANIMATIONS
    ============================================================ */
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }
    .float-anim {
        animation: float 4s ease-in-out infinite;
    }

    @@keyframes rotateBorder {
        0% { background-position: 0% 50%; }
        100% { background-position: 400% 50%; }
    }
    .gradient-border {
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        background-clip: padding-box;
    }
    .gradient-border::before {
        content: '';
        position: absolute;
        inset: -2px;
        z-index: -1;
        border-radius: 22px;
        background: conic-gradient(from 0deg, #e8a838, #52b788, #1a7a8a, #e8a838, #52b788);
        background-size: 400% 400%;
        animation: rotateBorder 8s linear infinite;
        opacity: 0.2;
        transition: opacity 0.4s;
    }
    .gradient-border:hover::before {
        opacity: 0.5;
    }

    /* Ripple */
    .ripple {
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }
    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }
    @@keyframes rippleAnim {
        to { transform: scale(4); opacity: 0; }
    }

    /* Fade Up */
    .fade-up {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.2, 0.9, 0.3, 1),
                    transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    .fade-up.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .stagger-child { transition-delay: 0s; }
    .stagger-child:nth-child(1) { transition-delay: 0.05s; }
    .stagger-child:nth-child(2) { transition-delay: 0.1s; }
    .stagger-child:nth-child(3) { transition-delay: 0.15s; }
    .stagger-child:nth-child(4) { transition-delay: 0.2s; }
    .stagger-child:nth-child(5) { transition-delay: 0.25s; }
    .stagger-child:nth-child(6) { transition-delay: 0.3s; }

    /* Sparkle Particles */
    .sparkle {
        position: fixed;
        width: 4px;
        height: 4px;
        background: rgba(232, 168, 56, 0.2);
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        animation: sparkleAnim 10s infinite alternate ease-in-out;
    }
    @@keyframes sparkleAnim {
        0% { transform: translate(0, 0) scale(1); opacity: 0.1; }
        50% { transform: translate(20px, -30px) scale(1.8); opacity: 0.6; }
        100% { transform: translate(-10px, 20px) scale(0.6); opacity: 0.05; }
    }
    .sparkle:nth-child(1) { left: 5%; top: 20%; animation-duration: 12s; }
    .sparkle:nth-child(2) { left: 85%; top: 60%; animation-duration: 14s; animation-delay: 2s; width: 6px; height: 6px; }
    .sparkle:nth-child(3) { left: 30%; top: 70%; animation-duration: 16s; animation-delay: 4s; }
    .sparkle:nth-child(4) { left: 92%; top: 30%; animation-duration: 11s; animation-delay: 1s; width: 5px; height: 5px; background: rgba(82, 183, 136, 0.15); }
    .sparkle:nth-child(5) { left: 50%; top: 90%; animation-duration: 18s; animation-delay: 3s; }
    .sparkle:nth-child(6) { left: 3%; top: 50%; animation-duration: 13s; animation-delay: 5s; background: rgba(232, 168, 56, 0.15); }

    /* ============================================================
       NAVBAR
    ============================================================ */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 999;
        padding: 14px 0;
        transition: all 0.4s ease;
        background: rgba(19, 80, 91, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .navbar.scrolled {
        background: rgba(19, 80, 91, 0.92);
        box-shadow: 0 4px 40px rgba(0, 0, 0, 0.12);
    }

    .navbar .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .logo {
        font-size: 1.5rem;
        font-weight: 800;
        color: #e8f0f1;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .logo span { color: #e8a838; }
    .logo i { color: #e8a838; font-size: 1.3rem; }

    .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        font-size: 0.9rem;
        font-weight: 500;
        align-items: center;
    }
    .nav-links a {
        color: rgba(232, 240, 241, 0.6);
        transition: all 0.35s ease;
        position: relative;
        padding: 4px 0;
    }
    .nav-links a:hover { color: #ffffff; }
    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        right: 0;
        width: 0;
        height: 2.5px;
        background: #e8a838;
        transition: 0.35s;
        border-radius: 4px;
        box-shadow: 0 0 12px rgba(232, 168, 56, 0.15);
    }
    .nav-links a:hover::after { width: 100%; }
    .nav-links a.active { color: #ffffff; }
    .nav-links a.active::after { width: 100%; }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 9px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.12);
    }
    .btn-primary:hover {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 8px 32px rgba(232, 168, 56, 0.2);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid rgba(255, 255, 255, 0.1);
        color: #e8f0f1;
        padding: 8px 22px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
    }
    .btn-outline:hover {
        border-color: #e8a838;
        background: rgba(232, 168, 56, 0.04);
        transform: translateY(-2px);
    }

    .btn-light {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-light:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: #e8a838;
        transform: translateY(-2px);
    }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        color: #fff;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.75rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(220, 53, 69, 0.15);
    }

    .avatar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid rgba(232, 168, 56, 0.2);
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e8f0f1;
        font-size: 1.1rem;
        transition: all 0.35s ease;
        cursor: pointer;
    }
    .avatar-btn:hover {
        background: rgba(232, 168, 56, 0.04);
        transform: scale(1.05);
        border-color: #e8a838;
    }

    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
    }
    .hamburger span {
        display: block;
        width: 28px;
        height: 2.5px;
        background: #e8f0f1;
        border-radius: 4px;
        transition: 0.3s;
    }

    /* ============================================================
       PAGE HEADER
    ============================================================ */
    .page-header {
        padding-top: 100px;
        padding-bottom: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .page-header h1 i { color: #e8a838; }
    .page-header .subtitle {
        color: rgba(232, 240, 241, 0.5);
        font-size: 0.9rem;
        margin-top: 4px;
    }

    .page-header .actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* ============================================================
       STATS ROW
    ============================================================ */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .stat-mini {
        padding: 16px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 14px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all 0.3s ease;
    }
    .stat-mini:hover {
        transform: translateY(-3px);
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(232, 168, 56, 0.06);
    }
    .stat-mini i {
        font-size: 1.6rem;
        color: #e8a838;
        opacity: 0.5;
        width: 40px;
        text-align: center;
    }
    .stat-mini .info .number {
        font-size: 1.4rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.2;
    }
    .stat-mini .info .label {
        font-size: 0.75rem;
        color: rgba(232, 240, 241, 0.3);
    }

    /* ============================================================
       FILTER BAR
    ============================================================ */
    .filter-bar {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 32px;
        padding: 16px 24px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        align-items: center;
    }

    .filter-bar .search-box {
        flex: 1;
        min-width: 200px;
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        padding: 0 16px;
        transition: all 0.35s ease;
    }
    .filter-bar .search-box:focus-within {
        border-color: #e8a838;
        background: rgba(255, 255, 255, 0.04);
        box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
    }
    .filter-bar .search-box input {
        background: transparent;
        border: none;
        padding: 12px 12px;
        color: #e8f0f1;
        font-size: 0.9rem;
        width: 100%;
        outline: none;
    }
    .filter-bar .search-box input::placeholder {
        color: rgba(232, 240, 241, 0.3);
    }
    .filter-bar .search-box i {
        color: rgba(232, 240, 241, 0.2);
        font-size: 0.9rem;
    }

    .filter-bar .filter-group {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .filter-bar .filter-group .filter-btn {
        padding: 8px 18px;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        background: rgba(255, 255, 255, 0.02);
        color: rgba(232, 240, 241, 0.4);
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.35s ease;
        cursor: pointer;
    }
    .filter-bar .filter-group .filter-btn:hover {
        border-color: rgba(232, 168, 56, 0.1);
        color: #e8f0f1;
    }
    .filter-bar .filter-group .filter-btn.active {
        background: rgba(232, 168, 56, 0.08);
        border-color: rgba(232, 168, 56, 0.1);
        color: #e8a838;
    }

    /* ============================================================
       ADD SKILL FORM
    ============================================================ */
    .add-skill-form {
        padding: 24px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        margin-bottom: 32px;
        transition: all 0.3s ease;
    }
    .add-skill-form:hover {
        border-color: rgba(232, 168, 56, 0.06);
    }
    .add-skill-form .form-title {
        font-size: 1rem;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .add-skill-form .form-title i { color: #e8a838; }
    .add-skill-form .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 12px;
        align-items: end;
    }
    .add-skill-form .form-group {
        margin-bottom: 0;
    }
    .add-skill-form .form-group label {
        display: block;
        font-size: 0.75rem;
        color: rgba(232, 240, 241, 0.3);
        margin-bottom: 4px;
        font-weight: 500;
    }
    .add-skill-form .form-group input,
    .add-skill-form .form-group select {
        width: 100%;
        padding: 10px 14px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        color: #e8f0f1;
        font-size: 0.9rem;
        transition: all 0.35s ease;
        outline: none;
        font-family: inherit;
    }
    .add-skill-form .form-group input:focus,
    .add-skill-form .form-group select:focus {
        border-color: #e8a838;
        background: rgba(255, 255, 255, 0.04);
        box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
    }
    .add-skill-form .form-group input::placeholder {
        color: rgba(232, 240, 241, 0.15);
    }
    .add-skill-form .form-group select option {
        background: #13505b;
        color: #e8f0f1;
    }

    .add-skill-form .btn-add {
        padding: 10px 24px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #52b788, #409f73);
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        height: 42px;
    }
    .add-skill-form .btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(82, 183, 136, 0.15);
    }

    /* ============================================================
       SKILLS GRID
    ============================================================ */
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .skill-card {
        padding: 24px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .skill-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 3px;
        height: 100%;
        border-radius: 0 3px 3px 0;
        opacity: 0.4;
    }

    .skill-card.category-frontend::before { background: #52b788; }
    .skill-card.category-backend::before { background: #e8a838; }
    .skill-card.category-database::before { background: #8264c8; }
    .skill-card.category-devops::before { background: #1a7a8a; }
    .skill-card.category-other::before { background: #7f8c8d; }

    .skill-card:hover {
        transform: translateY(-6px);
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(232, 168, 56, 0.06);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    }

    .skill-card .skill-icon {
        font-size: 2.8rem;
        color: #e8a838;
        margin-bottom: 10px;
        display: block;
        opacity: 0.7;
        transition: all 0.3s ease;
    }
    .skill-card:hover .skill-icon {
        opacity: 1;
        transform: scale(1.05);
    }

    .skill-card .skill-name {
        font-size: 1rem;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 4px;
    }

    .skill-card .skill-category {
        font-size: 0.7rem;
        color: rgba(232, 240, 241, 0.2);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }

    .skill-card .skill-progress {
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 14px;
    }
    .skill-card .skill-progress .fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg, #52b788, #e8a838);
        transition: width 1s ease;
        width: 0%;
    }

    .skill-card .skill-actions {
        display: flex;
        gap: 6px;
        justify-content: center;
    }
    .skill-card .skill-actions button {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.04);
        background: rgba(255, 255, 255, 0.02);
        color: rgba(232, 240, 241, 0.15);
        transition: all 0.35s ease;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .skill-card .skill-actions button:hover {
        border-color: rgba(232, 168, 56, 0.06);
        color: #e8f0f1;
        background: rgba(232, 168, 56, 0.02);
        transform: scale(1.05);
    }
    .skill-card .skill-actions button.edit:hover {
        border-color: rgba(82, 183, 136, 0.06);
        color: #52b788;
        background: rgba(82, 183, 136, 0.02);
    }
    .skill-card .skill-actions button.delete:hover {
        border-color: rgba(220, 53, 69, 0.06);
        color: #dc3545;
        background: rgba(220, 53, 69, 0.02);
    }

    /* Edit mode inside card */
    .skill-card .edit-mode {
        display: none;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
    }
    .skill-card .edit-mode.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }
    @@keyframes fadeIn {
        0% { opacity: 0; transform: translateY(10px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    .skill-card .edit-mode input,
    .skill-card .edit-mode select {
        width: 100%;
        padding: 8px 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 8px;
        color: #e8f0f1;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        outline: none;
        font-family: inherit;
        margin-bottom: 8px;
    }
    .skill-card .edit-mode input:focus,
    .skill-card .edit-mode select:focus {
        border-color: #e8a838;
        background: rgba(255, 255, 255, 0.04);
    }
    .skill-card .edit-mode input::placeholder {
        color: rgba(232, 240, 241, 0.15);
    }
    .skill-card .edit-mode select option {
        background: #13505b;
        color: #e8f0f1;
    }
    .skill-card .edit-mode .edit-actions {
        display: flex;
        gap: 8px;
        margin-top: 8px;
    }
    .skill-card .edit-mode .edit-actions button {
        flex: 1;
        padding: 6px 12px;
        border-radius: 8px;
        border: none;
        font-size: 0.75rem;
        font-weight: 500;
        cursor: pointer;
