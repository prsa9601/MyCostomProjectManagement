                Date = "۱۴۰۵/۰۴/۱۲ - ۰۸:۳۰",
                StatusClass = "replied"
            }
        };
    }

    // ============================================================
    // FILTER & SEARCH
    // ============================================================

    private void ApplyFilters()
    {
        var query = allMessages.AsEnumerable();

        // Filter by status
        if (!string.IsNullOrEmpty(filterStatus) && filterStatus != "all")
        {
            query = query.Where(m => m.StatusClass == filterStatus);
        }

        // Search
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(m =>
                m.Sender.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Subject.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Preview.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Email.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Id.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        // Pagination
        var total = query.Count();
        totalPages = (int)Math.Ceiling(total / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        filteredMessages = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SetFilter(string status)
    {
        filterStatus = status;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // UI METHODS
    // ============================================================

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;
    private void GoToProfile() => NavigationManager.NavigateTo("/Profile", true);

    private void RefreshMessages()
    {
        LoadMessages();
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleReply(string id)
    {
        if (replyMessageId == id)
        {
            replyMessageId = null;
            replyText = "";
        }
        else
        {
            replyMessageId = id;
            replyText = "";
        }
        StateHasChanged();
    }

    private void CancelReply()
    {
        replyMessageId = null;
        replyText = "";
        StateHasChanged();
    }

    private void SendReply(string id)
    {
        if (string.IsNullOrWhiteSpace(replyText)) return;

        var msg = allMessages.FirstOrDefault(m => m.Id == id);
        if (msg != null)
        {
            msg.StatusClass = "replied";
            msg.StatusText = "پاسخ داده شده";
            // In a real app, send email via API
            Console.WriteLine($"Reply sent to {msg.Email}: {replyText}");
        }

        replyMessageId = null;
        replyText = "";
        ApplyFilters();
        StateHasChanged();
    }

    private void MarkAsRead(string id)
    {
        var msg = allMessages.FirstOrDefault(m => m.Id == id);
        if (msg != null && msg.StatusClass == "unread")
        {
            msg.StatusClass = "read";
        }
        ApplyFilters();
        StateHasChanged();
    }

    private void MarkAllAsRead()
    {
        foreach (var msg in allMessages.Where(m => m.StatusClass == "unread"))
        {
            msg.StatusClass = "read";
        }
        ApplyFilters();
        StateHasChanged();
    }

    private void DeleteMessage(string id)
    {
        allMessages.RemoveAll(m => m.Id == id);
        if (replyMessageId == id) replyMessageId = null;
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
    // JS INTEROP
    // ============================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsInterop();
        }
    }

    private async Task InitializeJsInterop()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            // Navbar scroll
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                navbar?.classList.toggle('scrolled', window.scrollY > 30);
            });

            // Ripple effect
            document.querySelectorAll('.ripple').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const ripple = document.createElement('span');
                    ripple.className = 'ripple-effect';
                    ripple.style.left = x + 'px';
                    ripple.style.top = y + 'px';
                    ripple.style.width = '40px';
                    ripple.style.height = '40px';
                    this.appendChild(ripple);
                    setTimeout(() => ripple.remove(), 600);
                });
            });

            // Fade-up observer
            const fadeEls = document.querySelectorAll('.fade-up');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 });

            fadeEls.forEach(el => observer.observe(el));

            // Trigger visible for elements already in view
            setTimeout(() => {
                fadeEls.forEach(el => {
                    if (el.getBoundingClientRect().top < window.innerHeight) {
                        el.classList.add('visible');
                    }
                });
            }, 300);
        ");
    }

