@page "/Admin/Contacts"
@layout AdminLayout
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<style>
    /* ============================================================
           STYLES SPECIFIC TO CONTACTS PAGE
        ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 32px;
        padding-top: 20px;
    }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .page-header h1 i {
                color: #e8a838;
            }

        .page-header .subtitle {
            color: rgba(232, 240, 241, 0.5);
            font-size: 0.9rem;
            margin-top: 4px;
        }

        .page-header .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

    .btn-primary {
        background: linear-gradient(135deg, #e8a838, #d4952e);
        color: #fff;
        padding: 9px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(232, 168, 56, 0.12);
    }

        .btn-primary:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 32px rgba(232, 168, 56, 0.2);
        }

    .btn-light {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: #e8f0f1;
        padding: 8px 20px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.35s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-light:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: #e8a838;
            transform: translateY(-2px);
        }

    .btn-success {
        background: linear-gradient(135deg, #52b788, #409f73);
        color: #fff;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.75rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        color: #fff;
        padding: 6px 16px;
        border-radius: 40px;
        font-weight: 500;
        font-size: 0.75rem;
        transition: all 0.35s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .stat-mini {
        padding: 16px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 14px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all 0.3s ease;
    }

        .stat-mini:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(232, 168, 56, 0.06);
        }

        .stat-mini i {
            font-size: 1.6rem;
            color: #e8a838;
            opacity: 0.5;
            width: 40px;
            text-align: center;
        }

        .stat-mini .info .number {
            font-size: 1.4rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.2;
        }

        .stat-mini .info .label {
            font-size: 0.75rem;
            color: rgba(232, 240, 241, 0.3);
        }

    .contact-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .contact-info-card {
        padding: 20px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.03);
        border-radius: 14px;
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
    }

        .contact-info-card:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(232, 168, 56, 0.06);
        }

        .contact-info-card i {
            font-size: 2rem;
            color: #e8a838;
            margin-bottom: 8px;
            display: block;
        }

        .contact-info-card .label {
            font-size: 0.7rem;
            color: rgba(232, 240, 241, 0.2);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .contact-info-card .value {
            font-size: 0.9rem;
            color: #e8f0f1;
            margin-top: 4px;
            word-break: break-word;
        }

        .contact-info-card .edit-btn {
            position: absolute;
            top: 8px;
            right: 12px;
            background: transparent;
            border: none;
            color: rgba(232, 240, 241, 0.15);
            cursor: pointer;
            font-size: 0.8rem;
            transition: color 0.3s ease;
            padding: 4px;
        }

            .contact-info-card .edit-btn:hover {
                color: #e8a838;
            }

        .contact-info-card .edit-input {
            margin-top: 8px;
            width: 100%;
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            color: #e8f0f1;
            font-size: 0.9rem;
            text-align: center;
            outline: none;
            transition: border-color 0.3s ease;
        }

            .contact-info-card .edit-input:focus {
                border-color: #e8a838;
            }

        .contact-info-card .edit-actions {
            margin-top: 12px;
            display: flex;
            gap: 8px;
            justify-content: center;
        }

            .contact-info-card .edit-actions button {
                padding: 4px 16px;
                border-radius: 30px;
                font-size: 0.75rem;
                border: none;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .contact-info-card .edit-actions .save-btn {
                background: #e8a838;
                color: #fff;
            }

                .contact-info-card .edit-actions .save-btn:hover {
                    background: #d4952e;
                }

            .contact-info-card .edit-actions .cancel-btn {
                background: rgba(255, 255, 255, 0.05);
                color: rgba(232, 240, 241, 0.5);
            }

                .contact-info-card .edit-actions .cancel-btn:hover {
                    background: rgba(255, 255, 255, 0.08);
                }

    .filter-bar {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 32px;
        padding: 16px 24px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        align-items: center;
    }

        .filter-bar .search-box {
            flex: 1;
            min-width: 200px;
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 0 16px;
            transition: all 0.35s ease;
        }

            .filter-bar .search-box:focus-within {
                border-color: #e8a838;
                background: rgba(255, 255, 255, 0.04);
                box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
            }

            .filter-bar .search-box input {
                background: transparent;
                border: none;
                padding: 12px 12px;
                color: #e8f0f1;
                font-size: 0.9rem;
                width: 100%;
                outline: none;
            }

                .filter-bar .search-box input::placeholder {
                    color: rgba(232, 240, 241, 0.3);
                }

            .filter-bar .search-box i {
                color: rgba(232, 240, 241, 0.2);
                font-size: 0.9rem;
            }

        .filter-bar .filter-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .filter-bar .filter-group .filter-btn {
                padding: 8px 18px;
                border-radius: 40px;
                border: 1px solid rgba(255, 255, 255, 0.04);
                background: rgba(255, 255, 255, 0.02);
                color: rgba(232, 240, 241, 0.4);
                font-size: 0.8rem;
                font-weight: 500;
                transition: all 0.35s ease;
                cursor: pointer;
            }

                .filter-bar .filter-group .filter-btn:hover {
                    border-color: rgba(232, 168, 56, 0.1);
                    color: #e8f0f1;
                }

                .filter-bar .filter-group .filter-btn.active {
                    background: rgba(232, 168, 56, 0.08);
                    border-color: rgba(232, 168, 56, 0.1);
                    color: #e8a838;
                }

    .messages-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
        margin-bottom: 40px;
    }

    .message-row {
        display: grid;
        grid-template-columns: auto 1fr auto auto auto;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 14px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
        cursor: pointer;
    }

        .message-row:hover {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(232, 168, 56, 0.06);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }

        .message-row .msg-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            flex-shrink: 0;
            background: rgba(232, 168, 56, 0.04);
            color: #e8a838;
        }

            .message-row .msg-icon.unread {
                background: rgba(232, 168, 56, 0.08);
                color: #e8a838;
            }

            .message-row .msg-icon.read {
                background: rgba(82, 183, 136, 0.04);
                color: #52b788;
            }

            .message-row .msg-icon.replied {
                background: rgba(26, 122, 138, 0.04);
                color: #1a7a8a;
            }

        .message-row .msg-info {
            flex: 1;
            min-width: 150px;
        }

            .message-row .msg-info .sender {
                font-size: 0.95rem;
                font-weight: 600;
                color: #ffffff;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .message-row .msg-info .sender .badge-unread {
                    font-size: 0.55rem;
                    background: #e8a838;
                    color: #fff;
                    padding: 2px 8px;
                    border-radius: 30px;
                    font-weight: 600;
                }

            .message-row .msg-info .subject {
                font-size: 0.85rem;
                color: rgba(232, 240, 241, 0.5);
                margin-top: 2px;
            }

            .message-row .msg-info .preview {
                font-size: 0.8rem;
                color: rgba(232, 240, 241, 0.25);
                margin-top: 2px;
                display: -webkit-box;
                -webkit-line-clamp: 1;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

        .message-row .msg-date {
            font-size: 0.75rem;
            color: rgba(232, 240, 241, 0.2);
            white-space: nowrap;
        }

        .message-row .msg-status {
            font-size: 0.65rem;
            padding: 3px 12px;
            border-radius: 40px;
            font-weight: 500;
            white-space: nowrap;
        }

            .message-row .msg-status.unread {
                background: rgba(232, 168, 56, 0.06);
                color: #e8a838;
                border: 1px solid rgba(232, 168, 56, 0.04);
            }

            .message-row .msg-status.read {
                background: rgba(82, 183, 136, 0.04);
                color: #52b788;
                border: 1px solid rgba(82, 183, 136, 0.02);
            }

            .message-row .msg-status.replied {
                background: rgba(26, 122, 138, 0.04);
                color: #1a7a8a;
                border: 1px solid rgba(26, 122, 138, 0.02);
            }

        .message-row .msg-actions {
            display: flex;
            gap: 4px;
            flex-shrink: 0;
        }

            .message-row .msg-actions button {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                border: 1px solid rgba(255, 255, 255, 0.04);
                background: rgba(255, 255, 255, 0.02);
                color: rgba(232, 240, 241, 0.15);
                transition: all 0.35s ease;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .message-row .msg-actions button:hover {
                    border-color: rgba(232, 168, 56, 0.06);
                    color: #e8f0f1;
                    background: rgba(232, 168, 56, 0.02);
                    transform: scale(1.05);
                }

                .message-row .msg-actions button.reply:hover {
                    border-color: rgba(82, 183, 136, 0.06);
                    color: #52b788;
                    background: rgba(82, 183, 136, 0.02);
                }

                .message-row .msg-actions button.delete:hover {
                    border-color: rgba(220, 53, 69, 0.06);
                    color: #dc3545;
                    background: rgba(220, 53, 69, 0.02);
                }

    .reply-section {
        display: none;
        margin-top: 12px;
        padding: 20px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

        .reply-section.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

    @@keyframes fadeIn {
        0% {
            opacity: 0;
            transform: translateY(10px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .reply-section textarea {
        width: 100%;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 12px;
        color: #e8f0f1;
        font-size: 0.9rem;
        resize: vertical;
        min-height: 80px;
        font-family: inherit;
        transition: all 0.35s ease;
        outline: none;
    }

        .reply-section textarea:focus {
            border-color: #e8a838;
            background: rgba(255, 255, 255, 0.04);
            box-shadow: 0 0 20px rgba(232, 168, 56, 0.02);
        }

        .reply-section textarea::placeholder {
            color: rgba(232, 240, 241, 0.15);
        }

    .reply-section .reply-actions {
        display: flex;
        gap: 10px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.02);
    }

        .empty-state i {
            font-size: 4rem;
            color: rgba(232, 168, 56, 0.1);
            margin-bottom: 16px;
        }

        .empty-state h3 {
            font-size: 1.3rem;
            color: rgba(232, 240, 241, 0.3);
            margin-bottom: 8px;
        }

        .empty-state p {
            color: rgba(232, 240, 241, 0.15);
            font-size: 0.9rem;
        }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
        padding: 16px 0;
    }

        .pagination button {
            padding: 8px 16px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            background: rgba(255, 255, 255, 0.02);
            color: rgba(232, 240, 241, 0.3);
            font-size: 0.8rem;
            transition: all 0.35s ease;
            cursor: pointer;
        }

            .pagination button:hover {
                border-color: rgba(232, 168, 56, 0.06);
                color: #e8f0f1;
                background: rgba(232, 168, 56, 0.02);
            }

            .pagination button.active {
                background: rgba(232, 168, 56, 0.06);
                border-color: rgba(232, 168, 56, 0.06);
                color: #e8a838;
            }

    .fade-up {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.2, 0.9, 0.3, 1), transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

    .stagger-child {
        transition-delay: 0s;
    }

        .stagger-child:nth-child(1) {
            transition-delay: 0.05s;
        }

        .stagger-child:nth-child(2) {
            transition-delay: 0.1s;
        }

        .stagger-child:nth-child(3) {
            transition-delay: 0.15s;
        }

        .stagger-child:nth-child(4) {
            transition-delay: 0.2s;
        }

        .stagger-child:nth-child(5) {
            transition-delay: 0.25s;
        }

        .stagger-child:nth-child(6) {
            transition-delay: 0.3s;
        }

    .ripple {
        position: relative;
        overflow: hidden;
    }

    .ripple-effect {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* ============================================================
           RESPONSIVE
        ============================================================ */
    @@media (max-width: 1200px) {
        .message-row {
            grid-template-columns: auto 1fr auto auto;
            gap: 12px;
        }

            .message-row .msg-status {
                display: none;
            }
    }

    @@media (max-width: 992px) {
        .contact-info-grid {
            grid-template-columns: 1fr 1fr;
        }

        .stats-row {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .page-header h1 {
                font-size: 1.5rem;
            }

        .filter-bar {
            flex-direction: column;
            padding: 16px;
        }

            .filter-bar .search-box {
                width: 100%;
            }

        .page-header .actions {
            width: 100%;
        }

            .page-header .actions .btn-primary {
                flex: 1;
                justify-content: center;
            }

        .message-row {
            grid-template-columns: auto 1fr;
            gap: 10px;
            padding: 14px 16px;
        }

            .message-row .msg-icon {
                grid-row: 1 / 3;
            }

            .message-row .msg-info {
                grid-column: 2;
            }

            .message-row .msg-date {
                grid-column: 2;
                justify-self: start;
                font-size: 0.65rem;
            }

            .message-row .msg-status {
                display: inline-block;
                grid-column: 2;
                justify-self: start;
                font-size: 0.6rem;
                padding: 2px 10px;
            }

            .message-row .msg-actions {
                grid-column: 1 / -1;
                justify-content: flex-end;
                padding-top: 8px;
                border-top: 1px solid rgba(255, 255, 255, 0.03);
            }

        .contact-info-grid {
            grid-template-columns: 1fr 1fr;
        }

        .stats-row {
            grid-template-columns: 1fr 1fr;
        }

        .stat-mini .info .number {
            font-size: 1.1rem;
        }

        .stat-mini i {
            font-size: 1.2rem;
            width: 30px;
        }
    }

    @@media (max-width: 480px) {
        .contact-info-grid {
            grid-template-columns: 1fr;
        }

        .stats-row {
            grid-template-columns: 1fr;
        }

        .filter-bar .filter-group {
            width: 100%;
            justify-content: center;
        }

        .message-row .msg-info .sender {
            font-size: 0.85rem;
        }

        .message-row .msg-info .subject {
            font-size: 0.75rem;
        }

        .reply-section .reply-actions {
            flex-direction: column;
        }

            .reply-section .reply-actions button {
                width: 100%;
                justify-content: center;
            }
    }
</style>

<!-- ============================================================
     PAGE CONTENT
============================================================ -->
<main class="dashboard">
    <div class="container">

        <!-- Page Header -->
        <div class="page-header fade-up visible">
            <div>
                <h1>
                    <i class="fas fa-envelope"></i>
                    پیام‌های تماس
                    <span class="badge-admin" style="font-size:0.7rem; background:linear-gradient(135deg,#e8a838,#d4952e); color:#fff; padding:4px 14px; border-radius:40px; font-weight:600;">@totalMessages</span>
                </h1>
                <div class="subtitle">مدیریت پیام‌های دریافتی از فرم تماس با ما</div>
            </div>
            <div class="actions">
                <button class="btn-light ripple" @onclick="RefreshMessages"><i class="fas fa-sync-alt"></i> بروزرسانی</button>
                <button class="btn-primary ripple" @onclick="MarkAllAsRead"><i class="fas fa-check-double"></i> خواندن همه</button>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="stats-row fade-up visible">
            <div class="stat-mini">
                <i class="fas fa-inbox"></i>
                <div class="info">
                    <div class="number">@totalMessages</div>
                    <div class="label">کل پیام‌ها</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-envelope" style="color:#e8a838;"></i>
                <div class="info">
                    <div class="number">@unreadCount</div>
                    <div class="label">خوانده نشده</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-check-circle" style="color:#52b788;"></i>
                <div class="info">
                    <div class="number">@readCount</div>
                    <div class="label">خوانده شده</div>
                </div>
            </div>
            <div class="stat-mini">
                <i class="fas fa-reply" style="color:#1a7a8a;"></i>
                <div class="info">
                    <div class="number">@repliedCount</div>
                    <div class="label">پاسخ داده شده</div>
                </div>
            </div>
        </div>

        <!-- Contact Info WITH EDIT OPTION -->
        <div class="contact-info-grid fade-up visible">
            <!-- Address -->
            <div class="contact-info-card">
                <i class="fas fa-map-marker-alt"></i>
                <div class="label">آدرس</div>
                @if (editingField == "address")
                {
                    <input class="edit-input" @bind="tempValue" />
                    <div class="edit-actions">
                        <button class="save-btn" @onclick='() => SaveEdit("address")'>ذخیره</button>
                        <button class="cancel-btn" @onclick="CancelEdit">لغو</button>
                    </div>
                }
                else
                {
                    <div class="value">@contactInfo.Address</div>
                    <button class="edit-btn" @onclick='() => StartEdit("address", contactInfo.Address)' title="ویرایش آدرس">
                        <i class="fas fa-pencil-alt"></i>
                    </button>
                }
            </div>

            <!-- Phone -->
            <div class="contact-info-card">
                <i class="fas fa-phone-alt"></i>
                <div class="label">تلفن</div>
                @if (editingField == "phone")
                {
                    <input class="edit-input" @bind="tempValue" />
                    <div class="edit-actions">
                        <button class="save-btn" @onclick='() => SaveEdit("phone")'>ذخیره</button>
                        <button class="cancel-btn" @onclick="CancelEdit">لغو</button>
                    </div>
                }
                else
                {
                    <div class="value">@contactInfo.Phone</div>
                    <button class="edit-btn" @onclick='() => StartEdit("phone", contactInfo.Phone)' title="ویرایش تلفن">
                        <i class="fas fa-pencil-alt"></i>
                    </button>
                }
            </div>

            <!-- Email -->
            <div class="contact-info-card">
                <i class="fas fa-envelope"></i>
                <div class="label">ایمیل</div>
                @if (editingField == "email")
                {
                    <input class="edit-input" @bind="tempValue" />
                    <div class="edit-actions">
                        <button class="save-btn" @onclick='() => SaveEdit("email")'>ذخیره</button>
                        <button class="cancel-btn" @onclick="CancelEdit">لغو</button>
                    </div>
                }
                else
                {
                    <div class="value">@contactInfo.Email</div>
                    <button class="edit-btn" @onclick='() => StartEdit("email", contactInfo.Email)' title="ویرایش ایمیل">
                        <i class="fas fa-pencil-alt"></i>
                    </button>
                }
            </div>

            <!-- Working Hours -->
            <div class="contact-info-card">
                <i class="fas fa-clock"></i>
                <div class="label">ساعت کاری</div>
                @if (editingField == "hours")
                {
                    <input class="edit-input" @bind="tempValue" />
                    <div class="edit-actions">
                        <button class="save-btn" @onclick='() => SaveEdit("hours")'>ذخیره</button>
                        <button class="cancel-btn" @onclick="CancelEdit">لغو</button>
                    </div>
                }
                else
                {
                    <div class="value">@contactInfo.WorkingHours</div>
                    <button class="edit-btn" @onclick='() => StartEdit("hours", contactInfo.WorkingHours)' title="ویرایش ساعت کاری">
                        <i class="fas fa-pencil-alt"></i>
                    </button>
                }
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar fade-up visible">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="جستجوی پیام..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <button class="filter-btn @(filterStatus == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>همه</button>
                <button class="filter-btn @(filterStatus == "unread" ? "active" : "")" @onclick='() => SetFilter("unread")'>خوانده نشده</button>
                <button class="filter-btn @(filterStatus == "read" ? "active" : "")" @onclick='() => SetFilter("read")'>خوانده شده</button>
                <button class="filter-btn @(filterStatus == "replied" ? "active" : "")" @onclick='() => SetFilter("replied")'>پاسخ داده شده</button>
            </div>
        </div>

        <!-- Messages Grid -->
        @if (filteredMessages.Any())
        {
            <div class="messages-grid">
                @foreach (var msg in filteredMessages)
                {
                    <div class="message-row fade-up stagger-child" @onclick='() => ToggleReply(msg.Id)'>
                        <div class="msg-icon @msg.StatusClass">
                            <i class="fas @(msg.StatusClass == "unread" ? "fa-envelope" : "fa-envelope-open")"></i>
                        </div>
                        <div class="msg-info">
                            <div class="sender">
                                @msg.Sender
                                @if (msg.StatusClass == "unread")
                                {
                                    <span class="badge-unread">جدید</span>
                                }
                            </div>
                            <div class="subject">@msg.Subject</div>
                            <div class="preview">@msg.Preview</div>
                        </div>
                        <div class="msg-date">@msg.Date</div>
                        <span class="msg-status @msg.StatusClass">
                            @(msg.StatusClass == "unread" ? "خوانده نشده" : msg.StatusClass == "read" ? "خوانده شده" : "پاسخ داده شده")
                        </span>
                        <div class="msg-actions" onclick="event.stopPropagation();">
                            <button class="ripple reply" title="پاسخ" @onclick='() => ToggleReply(msg.Id)'><i class="fas fa-reply"></i></button>
                            @if (msg.StatusClass == "unread")
                            {
                                <button class="ripple" title="خوانده شد" @onclick='() => MarkAsRead(msg.Id)'><i class="fas fa-check"></i></button>
                            }
                            <button class="ripple delete" title="حذف" @onclick='() => DeleteMessage(msg.Id)'><i class="fas fa-trash-alt"></i></button>
                        </div>

                        <!-- Reply Section (Inline) -->
                        <div class="reply-section @(replyMessageId == msg.Id ? "active" : "")" style="grid-column:1 / -1;" onclick="event.stopPropagation();">
                            <textarea placeholder="پاسخ خود را بنویسید..." @bind="replyText"></textarea>
                            <div class="reply-actions">
                                <button class="btn-primary ripple" @onclick='() => SendReply(msg.Id)'><i class="fas fa-paper-plane"></i> ارسال پاسخ</button>
                                <button class="btn-light ripple" @onclick='() => CancelReply()'><i class="fas fa-times"></i> لغو</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state fade-up visible">
                <i class="fas fa-inbox"></i>
                <h3>هیچ پیامی یافت نشد</h3>
                <p>با تغییر فیلترها یا جستجو، نتایج را مشاهده کنید</p>
            </div>
        }

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick='() => ChangePage(currentPage - 1)' disabled="@(currentPage == 1)"><i class="fas fa-chevron-right"></i></button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="@(i == currentPage ? "active" : "")" @onclick='() => ChangePage(i)'>@i</button>
                }
                <button @onclick='() => ChangePage(currentPage + 1)' disabled="@(currentPage == totalPages)"><i class="fas fa-chevron-left"></i></button>
            </div>
        }

    </div>
</main>

