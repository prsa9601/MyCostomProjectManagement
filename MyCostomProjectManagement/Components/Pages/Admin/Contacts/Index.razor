            replyText = "";
        }
        StateHasChanged();
    }

    private void CancelReply()
    {
        replyMessageId = null;
        replyText = "";
        StateHasChanged();
    }

    private void SendReply(string id)
    {
        if (string.IsNullOrWhiteSpace(replyText)) return;

        var msg = allMessages.FirstOrDefault(m => m.Id == id);
        if (msg != null)
        {
            msg.StatusClass = "replied";
            // In a real app, send email via API
            Console.WriteLine($"Reply sent to {msg.Email}: {replyText}");
        }

        replyMessageId = null;
        replyText = "";
        ApplyFilters();
        StateHasChanged();
    }

    private void MarkAsRead(string id)
    {
        var msg = allMessages.FirstOrDefault(m => m.Id == id);
        if (msg != null && msg.StatusClass == "unread")
        {
            msg.StatusClass = "read";
        }
        ApplyFilters();
        StateHasChanged();
    }

    private void MarkAllAsRead()
    {
        foreach (var msg in allMessages.Where(m => m.StatusClass == "unread"))
        {
            msg.StatusClass = "read";
        }
        ApplyFilters();
        StateHasChanged();
    }

    private void DeleteMessage(string id)
    {
        allMessages.RemoveAll(m => m.Id == id);
        if (replyMessageId == id) replyMessageId = null;
        ApplyFilters();
        StateHasChanged();
    }

    // ============================================================
