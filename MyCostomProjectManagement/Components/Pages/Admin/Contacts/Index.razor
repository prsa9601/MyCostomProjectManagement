    private void StartEdit(string field, string currentValue)
    {
        editingField = field;
        tempValue = currentValue;
    }

    private void SaveEdit(string field)
    {
        if (string.IsNullOrWhiteSpace(tempValue))
            return;

        switch (field)
        {
            case "address":
                contactInfo.Address = tempValue;
                break;
            case "phone":
                contactInfo.Phone = tempValue;
                break;
            case "email":
                contactInfo.Email = tempValue;
                break;
            case "hours":
                contactInfo.WorkingHours = tempValue;
                break;
        }

        editingField = null;
        tempValue = "";
        // در اینجا می‌توانید اطلاعات را در دیتابیس ذخیره کنید
    }

    private void CancelEdit()
    {
        editingField = null;
        tempValue = "";
    }

    // ============================================================
    // FILTER & SEARCH
    // ============================================================

    private void ApplyFilters()
    {
        var query = allMessages.AsEnumerable();

        // Filter by status
        if (!string.IsNullOrEmpty(filterStatus) && filterStatus != "all")
        {
            query = query.Where(m => m.StatusClass == filterStatus);
        }

        // Search
        if (!string.IsNullOrEmpty(searchTerm))
        {
            var term = searchTerm.Trim();
            query = query.Where(m =>
                m.Sender.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Subject.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Preview.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Email.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                m.Id.Contains(term, StringComparison.OrdinalIgnoreCase)
            );
        }

        // Pagination
        var total = query.Count();
        totalPages = (int)Math.Ceiling(total / (double)pageSize);
        if (totalPages == 0) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        filteredMessages = query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SetFilter(string status)
    {
        filterStatus = status;
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        ApplyFilters();
        StateHasChanged();
    }

