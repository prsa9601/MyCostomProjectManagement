@code {
    // ============================================================
    // STATE & DATA
    // ============================================================

    private bool isMenuOpen = false;
    private string searchTerm = "";
    private string filterStatus = "all";
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;

    private string replyText = "";
    private string? replyMessageId = null;

    private List<MessageItem> allMessages = new();
    private List<MessageItem> filteredMessages = new();

    private int totalMessages => allMessages.Count;
    private int unreadCount => allMessages.Count(m => m.StatusClass == "unread");
    private int readCount => allMessages.Count(m => m.StatusClass == "read");
    private int repliedCount => allMessages.Count(m => m.StatusClass == "replied");

    // ============================================================
    // INITIALIZATION
