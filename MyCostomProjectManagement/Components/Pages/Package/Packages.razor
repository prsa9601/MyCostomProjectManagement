    private async Task BuyPackage(string packageId)
    {
        var pkg = packages.FirstOrDefault(p => p.Id == packageId);
        if (pkg == null) return;

        // In real app: redirect to payment gateway
        Console.WriteLine($"خرید پکیج: {pkg.Name} - قیمت: {pkg.Price:N0} تومان");

        // Simulate purchase
        await Task.Delay(500);
        // After payment, could navigate to dashboard
        // NavigationManager.NavigateTo("/UserDashboard", true);
        NavigationManager.NavigateTo($"/Checkout/{packageId}", true);
    }

    private async Task ActivateFreePackage(string packageId)
    {
        var pkg = packages.FirstOrDefault(p => p.Id == packageId);
        if (pkg == null || pkg.Price > 0) return;

        Console.WriteLine($"فعال‌سازی پکیج رایگان: {pkg.Name}");

        await Task.Delay(500);
        // Update active package
        hasActivePackage = true;
        activePackage = new ActivePackage
        {
            Name = pkg.Name,
            DurationText = pkg.DurationText,
            StartDate = DateTime.Now.ToString("۱۴۰۵/MM/dd"),
            ExpiryDate = DateTime.Now.AddDays(pkg.DurationDays).ToString("۱۴۰۵/MM/dd"),
            IsExpired = false,
            RemainingDays = pkg.DurationDays,
            DurationDays = pkg.DurationDays
        };
        StateHasChanged();
    }

    private void ViewPackageDetails(string packageId)
    {
        // In real app: navigate to package detail page
        NavigationManager.NavigateTo($"/PackageDetail/{packageId}", true);
