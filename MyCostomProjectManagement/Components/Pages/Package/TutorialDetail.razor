    // ACTIONS
    // ============================================================
    private async Task CopyLink()
    {
        try
        {
            var safeUrl = Navigation.Uri.Replace("'", "\\'");
            await JSRuntime.InvokeVoidAsync("eval",
                $"navigator.clipboard.writeText('{safeUrl}')");
            ShowToast("لینک کپی شد!");
        }
        catch { ShowToast("خطا در کپی لینک"); }
    }

    private async Task CopyContent()
    {
        if (tutorial == null) return;
        try
        {
            var safeContent = tutorial.Content
                .Replace("\\", "\\\\")
                .Replace("`", "\\`")
                .Replace("$", "\\$");
            await JSRuntime.InvokeVoidAsync("eval",
                $"navigator.clipboard.writeText(`{safeContent}`)");
            ShowToast("محتوا کپی شد!");
        }
        catch { ShowToast("خطا در کپی محتوا"); }
    }

    private async Task PrintPage()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "window.print()");
        }
        catch { }
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();

        toastTimer?.Stop();
        toastTimer = new System.Timers.Timer(2500);
        toastTimer.Elapsed += (s, e) =>
        {
            toastTimer?.Stop();
            InvokeAsync(() =>
            {
                showToast = false;
                StateHasChanged();
            });
        };
        toastTimer.Start();
    }

