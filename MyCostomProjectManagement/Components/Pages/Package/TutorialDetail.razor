@page "/Tutorials/{Id:int}"
@layout FrontLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ITutorialApiService TutorialService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using System.Text.RegularExpressions
@using System.Net
@using BackEnd.Data.Infrastructure.Tutorial
@using MyCostomProjectManagement.Helpers
@using BackEnd.Data.Infrastructure.Tutorial.DTOs

<PageTitle>@(tutorial?.Title ?? "آموزش") | محمد پارسا کریمی</PageTitle>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />

<style>
    /* ============================================================
       TUTORIAL DETAIL (FRONT) - با پالت لندینگ #0a0e17
    ============================================================ */

    .td-hero {
        padding: 140px 0 40px;
        position: relative;
        z-index: 1;
    }

    .td-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.06);
        color: #b8c4d6;
        padding: 9px 20px;
        border-radius: 40px;
        font-size: 0.85rem;
        margin-bottom: 26px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .td-back:hover {
        border-color: #3b82f6;
        color: #fff;
        background: rgba(59,130,246,0.08);
        transform: translateX(-4px);
        box-shadow: 0 8px 30px rgba(59,130,246,0.1);
    }

    .td-back i { transition: transform 0.3s ease; }
    .td-back:hover i { transform: translateX(-3px); }

    .td-title {
        font-size: clamp(1.8rem, 5vw, 2.8rem);
        font-weight: 900;
        line-height: 1.3;
        margin-bottom: 18px;
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .td-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 30px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .td-tag {
        font-size: 0.75rem;
        padding: 5px 16px;
        border-radius: 40px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid transparent;
    }

    .tag-subject {
        background: rgba(26,122,138,0.1);
        color: #4dc9dd;
        border-color: rgba(77,201,221,0.2);
    }

    .tag-level-beginner     { background: rgba(52,211,153,0.1);  color: #34d399; border-color: rgba(52,211,153,0.2); }
    .tag-level-intermediate { background: rgba(251,146,60,0.1);  color: #fb923c; border-color: rgba(251,146,60,0.2); }
    .tag-level-advanced     { background: rgba(239,68,68,0.1);   color: #f87171; border-color: rgba(239,68,68,0.2); }
    .tag-level-all          { background: rgba(139,92,246,0.1);  color: #a78bfa; border-color: rgba(139,92,246,0.2); }

    .tag-topic {
        background: rgba(255,255,255,0.04);
        color: #94a3b8;
        border-color: rgba(255,255,255,0.08);
    }

    /* ===== LAYOUT ===== */
    .td-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 28px;
        align-items: start;
        padding-bottom: 90px;
        position: relative;
        z-index: 1;
    }

    .td-main {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 24px;
        padding: 36px;
        position: relative;
        overflow: hidden;
    }

    /* ===== CONTENT (Markdown) ===== */
    .td-content {
        color: #d8e3e5;
        font-size: 1rem;
        line-height: 2;
        word-wrap: break-word;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    .td-content h1 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin: 32px 0 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid transparent;
        background-image: linear-gradient(90deg, #3b82f6, #8b5cf6, transparent);
        background-repeat: no-repeat;
        background-size: 100% 2px;
        background-position: 0 100%;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .td-content h1:first-child { margin-top: 0; }

    .td-content h1::before {
        content: '\f0da';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: #3b82f6;
        font-size: 1.1rem;
    }

    .td-content h2 {
        font-size: 1.3rem;
        font-weight: 700;
        color: #60a5fa;
        margin: 28px 0 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-right: 14px;
        position: relative;
    }

    .td-content h2::before {
        content: '';
        width: 4px;
        height: 1.2rem;
        background: linear-gradient(180deg, #3b82f6, #8b5cf6);
        border-radius: 4px;
    }

    .td-content h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #a78bfa;
        margin: 22px 0 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .td-content h3::before {
        content: '\f111';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: #a78bfa;
        font-size: 0.45rem;
        opacity: 0.7;
    }

    .td-content h4 {
        font-size: 1rem;
        font-weight: 600;
        color: #4dc9dd;
        margin: 18px 0 8px;
    }

    .td-content p { margin-bottom: 16px; }

    .td-content strong {
        color: #fff;
        font-weight: 700;
        background: linear-gradient(180deg, transparent 65%, rgba(59,130,246,0.25) 65%);
        padding: 0 2px;
    }

    .td-content em {
        color: #a78bfa;
        font-style: italic;
        font-weight: 500;
    }

    .td-content a {
        color: #60a5fa;
        text-decoration: none;
        border-bottom: 1px dashed rgba(96,165,250,0.4);
        transition: all 0.25s;
        padding: 0 2px;
    }

    .td-content a:hover {
        color: #8b5cf6;
        border-bottom-color: #8b5cf6;
        border-bottom-style: solid;
        background: rgba(139,92,246,0.06);
        border-radius: 4px;
    }

    .td-content ul {
        margin: 14px 0 18px;
        padding-right: 22px;
        list-style: none;
    }

    .td-content ul li {
        position: relative;
        padding-right: 24px;
        margin-bottom: 10px;
        transition: all 0.25s;
    }

    .td-content ul li::before {
        content: '\f0da';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        right: 0;
        top: 2px;
        color: #3b82f6;
        font-size: 0.75rem;
        transition: all 0.25s;
    }

    .td-content ul li:hover::before {
        color: #8b5cf6;
        transform: translateX(-3px);
    }

    .td-content ol {
        margin: 14px 0 18px;
        padding-right: 34px;
        counter-reset: item;
        list-style: none;
    }

    .td-content ol li {
        position: relative;
        margin-bottom: 10px;
        counter-increment: item;
    }

    .td-content ol li::before {
        content: counter(item);
        position: absolute;
        right: -34px;
        top: 1px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 10px rgba(59,130,246,0.25);
    }

    .td-content code {
        background: rgba(0,0,0,0.35);
        color: #f8bb4f;
        padding: 3px 9px;
        border-radius: 6px;
        font-size: 0.85em;
        font-family: 'Fira Code', 'Consolas', 'Monaco', monospace;
        direction: ltr;
        unicode-bidi: embed;
        border: 1px solid rgba(59,130,246,0.15);
        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }

    .td-content pre {
        position: relative;
        background: #282c34 !important;
        border: 1px solid rgba(59,130,246,0.15);
        border-radius: 16px;
        padding: 24px 22px 20px;
        margin: 20px 0;
        overflow-x: auto;
        direction: ltr;
        text-align: left;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    .td-content pre::before {
        content: '● ● ●';
        position: absolute;
        top: 10px;
        left: 14px;
        color: #ff5f56;
        font-size: 0.7rem;
        letter-spacing: 4px;
        opacity: 0.9;
    }

    .td-content pre code {
        background: transparent !important;
        color: #abb2bf !important;
        padding: 0;
        border: none;
        box-shadow: none;
        font-size: 0.88rem;
        line-height: 1.7;
        font-family: 'Fira Code', 'Consolas', 'Monaco', monospace;
        display: block;
    }

    .td-content pre code.hljs {
        background: transparent !important;
        padding: 0 !important;
    }

    .td-content blockquote {
        position: relative;
        border-right: 4px solid #3b82f6;
        padding: 16px 22px;
        margin: 20px 0;
        background: linear-gradient(90deg, rgba(59,130,246,0.06), transparent);
        border-radius: 12px;
        color: rgba(232,240,241,0.9);
        font-style: italic;
        font-size: 0.95rem;
    }

    .td-content blockquote::before {
        content: '\f10d';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        top: 10px;
        right: 12px;
        color: rgba(59,130,246,0.3);
        font-size: 1.2rem;
    }

    .td-content table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 20px 0;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.06);
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

    .td-content table thead {
        background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(139,92,246,0.1));
    }

    .td-content table th {
        padding: 12px 16px;
        text-align: right;
        color: #60a5fa;
        font-weight: 700;
        font-size: 0.85rem;
        border-bottom: 2px solid rgba(59,130,246,0.2);
    }

    .td-content table td {
        padding: 11px 16px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        color: #d8e3e5;
        font-size: 0.9rem;
    }

    .td-content table tbody tr:nth-child(even) { background: rgba(255,255,255,0.02); }
    .td-content table tbody tr:hover { background: rgba(59,130,246,0.05); }
    .td-content table tbody tr:last-child td { border-bottom: none; }

    .td-content hr {
        border: none;
        height: 2px;
        background: linear-gradient(90deg, transparent, #3b82f6, #8b5cf6, transparent);
        margin: 32px 0;
        border-radius: 4px;
        opacity: 0.6;
    }

    /* ===== SIDEBAR ===== */
    .td-side {
        display: flex;
        flex-direction: column;
        gap: 18px;
        position: sticky;
        top: 100px;
    }

    .td-side-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        padding: 22px;
        transition: all 0.3s ease;
    }

    .td-side-card:hover { border-color: rgba(59,130,246,0.15); }

    .td-side-card h4 {
        font-size: 0.8rem;
        color: #3b82f6;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .td-side-stat {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: all 0.3s ease;
    }

    .td-side-stat:hover {
        background: rgba(255,255,255,0.02);
        border-radius: 10px;
        padding-right: 8px;
        padding-left: 8px;
        margin: 0 -8px;
    }

    .td-side-stat:last-child { border-bottom: none; }

    .td-side-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
        background: rgba(59,130,246,0.12);
        color: #3b82f6;
    }

    .td-side-icon.purple { background: rgba(139,92,246,0.12); color: #a78bfa; }
    .td-side-icon.green  { background: rgba(52,211,153,0.12); color: #34d399; }
    .td-side-icon.orange { background: rgba(251,146,60,0.12); color: #fb923c; }

    .td-side-info { flex: 1; min-width: 0; }

    .td-side-info .label {
        font-size: 0.72rem;
        color: #64748b;
        margin-bottom: 2px;
    }

    .td-side-info .value {
        font-size: 0.9rem;
        color: #fff;
        font-weight: 600;
    }

    /* ===== STATE ===== */
    .td-state {
        text-align: center;
        padding: 100px 20px;
        color: #94a3b8;
    }

    .td-state i {
        font-size: 3.5rem;
        color: rgba(59,130,246,0.3);
        margin-bottom: 16px;
        display: block;
    }

    .td-state h3 {
        font-size: 1.3rem;
        color: #eef2f8;
        margin-bottom: 10px;
    }

    .td-state p {
        color: #64748b;
        margin-bottom: 20px;
    }

    .td-spinner {
        width: 50px;
        height: 50px;
        border: 3px solid rgba(59,130,246,0.15);
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
        margin: 0 auto 20px;
        box-shadow: 0 0 40px rgba(59,130,246,0.15);
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ===== TOAST ===== */
    .td-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: linear-gradient(135deg, rgba(52,211,153,0.15), rgba(59,130,246,0.1));
        border: 1px solid rgba(52,211,153,0.3);
        color: #34d399;
        padding: 12px 22px;
        border-radius: 40px;
        font-size: 0.85rem;
        font-weight: 600;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        animation: toastIn 0.4s ease, toastOut 0.4s ease 2.1s forwards;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @@keyframes toastIn {
        from { transform: translateX(120%); opacity: 0; }
        to   { transform: translateX(0); opacity: 1; }
    }

    @@keyframes toastOut {
        to { transform: translateX(120%); opacity: 0; }
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 900px) {
        .td-grid { grid-template-columns: 1fr; }
        .td-side { position: static; }
        .td-main { padding: 24px; }
    }

    @@media (max-width: 500px) {
        .td-hero { padding: 120px 0 30px; }
        .td-main { padding: 20px; }
        .td-content { font-size: 0.92rem; line-height: 1.9; }
        .td-content h1 { font-size: 1.3rem; }
        .td-content h2 { font-size: 1.1rem; }
        .td-content h3 { font-size: 1rem; }
        .td-content pre { padding: 22px 16px 16px; }
        .td-content table { font-size: 0.82rem; }
        .td-content table th,
        .td-content table td { padding: 9px 12px; }
        .td-toast { bottom: 20px; right: 20px; left: 20px; justify-content: center; }
    }
</style>

@if (isLoading)
{
    <section class="td-hero">
        <div class="container">
            <div class="td-state">
                <div class="td-spinner"></div>
                <h3>در حال بارگذاری...</h3>
            </div>
        </div>
    </section>
}
else if (tutorial == null)
{
    <section class="td-hero">
        <div class="container">
            <div class="td-state">
                <i class="fas fa-exclamation-triangle"></i>
                <h3>آموزش پیدا نشد</h3>
                <p>ممکن است حذف شده باشد یا آدرس اشتباه باشد.</p>
                <a href="/Tutorials" class="td-back">
                    <i class="fas fa-arrow-right"></i>
                    بازگشت به لیست آموزش‌ها
                </a>
            </div>
        </div>
    </section>
}
else
{
    <section class="td-hero">
        <div class="container">
            <a href="/Tutorials" class="td-back">
                <i class="fas fa-arrow-right"></i>
                بازگشت به لیست آموزش‌ها
            </a>

            <h1 class="td-title">@tutorial.Title</h1>

            <div class="td-meta">
                @if (!string.IsNullOrWhiteSpace(tutorial.Subject))
                {
                    <span class="td-tag tag-subject">
                        <i class="fas fa-code"></i> @tutorial.Subject
                    </span>
                }
                <span class="td-tag @GetLevelClass(tutorial.Level)">
                    <i class="fas fa-signal"></i> @GetLevelText(tutorial.Level)
                </span>
                @if (!string.IsNullOrWhiteSpace(tutorial.Topic))
                {
                    <span class="td-tag tag-topic">
                        <i class="fas fa-hashtag"></i> @tutorial.Topic
                    </span>
                }
            </div>
        </div>
    </section>

    <section class="container">
        <div class="td-grid">
            <article class="td-main">
                <div class="td-content" id="contentArea">
                    @((MarkupString)renderedContent)
                </div>
            </article>

            <aside class="td-side">
                <div class="td-side-card">
                    <h4><i class="fas fa-info-circle"></i> اطلاعات</h4>

                    <div class="td-side-stat">
                        <div class="td-side-icon green">
                            <i class="fas fa-list-ul"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="label">تعداد بخش‌ها</div>
                            <div class="value">@tutorial.SectionCount</div>
                        </div>
                    </div>

                    <div class="td-side-stat">
                        <div class="td-side-icon">
                            <i class="fas fa-code"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="label">بلوک‌های کد</div>
                            <div class="value">@tutorial.CodeBlockCount</div>
                        </div>
                    </div>

                    <div class="td-side-stat">
                        <div class="td-side-icon purple">
                            <i class="fas fa-layer-group"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="label">دسته‌بندی</div>
                            <div class="value">@GetCategoryText(tutorial.Category)</div>
                        </div>
                    </div>

                    <div class="td-side-stat">
                        <div class="td-side-icon orange">
                            <i class="far fa-calendar-alt"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="label">تاریخ انتشار</div>
                            <div class="value">@ToPersianDate(tutorial.CreatedAt)</div>
                        </div>
                    </div>
                </div>

                <div class="td-side-card">
                    <h4><i class="fas fa-share-alt"></i> اشتراک‌گذاری</h4>

                    <div class="td-side-stat" style="cursor:pointer;" @onclick="CopyLink">
                        <div class="td-side-icon">
                            <i class="fas fa-link"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="value">کپی لینک</div>
                        </div>
                        <i class="fas fa-chevron-left" style="color:rgba(232,240,241,0.3);"></i>
                    </div>

                    <div class="td-side-stat" style="cursor:pointer;" @onclick="CopyContent">
                        <div class="td-side-icon purple">
                            <i class="fas fa-copy"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="value">کپی محتوا</div>
                        </div>
                        <i class="fas fa-chevron-left" style="color:rgba(232,240,241,0.3);"></i>
                    </div>

                    <div class="td-side-stat" style="cursor:pointer;" @onclick="PrintPage">
                        <div class="td-side-icon green">
                            <i class="fas fa-print"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="value">چاپ صفحه</div>
                        </div>
                        <i class="fas fa-chevron-left" style="color:rgba(232,240,241,0.3);"></i>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    @if (showToast)
    {
        <div class="td-toast">
            <i class="fas fa-check-circle"></i>
            @toastMessage
        </div>
    }
}

@code {
    // ============================================================
    // PARAMETERS
    // ============================================================
    [Parameter] public int Id { get; set; }

    // ============================================================
    // STATE
    // ============================================================
    private TutorialDto? tutorial;
    private bool isLoading = true;
    private string renderedContent = "";
    private bool needsHighlight = false;
    private bool showToast = false;
    private string toastMessage = "";
    private System.Timers.Timer? toastTimer;

    // ============================================================
    // LIFECYCLE
    // ============================================================
    protected override async Task OnParametersSetAsync()
    {
        // اعتبارسنجی Id
        if (Id <= 0)
        {
            tutorial = null;
            isLoading = false;
            return;
        }

        await LoadTutorial();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsHighlight)
        {
            needsHighlight = false;
            await HighlightCode();
        }
    }

    // ============================================================
    // DATA LOADING
    // ============================================================
    private async Task LoadTutorial()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            tutorial = await TutorialService.Get(Id);

            if (tutorial != null && !string.IsNullOrWhiteSpace(tutorial.Content))
            {
                // ✅ رندر Markdown با Sanitization کامل
                renderedContent = MarkdownRenderer.Render(tutorial.Content);
                needsHighlight = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TutorialDetail] Load error: {ex.Message}");
            tutorial = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // HIGHLIGHT.JS
    // ============================================================
    private async Task HighlightCode()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    if (typeof hljs === 'undefined') {
                        const script = document.createElement('script');
                        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js';
                        script.onload = () => {
                            document.querySelectorAll('#contentArea pre code').forEach(b => hljs.highlightElement(b));
                        };
                        document.head.appendChild(script);
                    } else {
                        document.querySelectorAll('#contentArea pre code').forEach(b => hljs.highlightElement(b));
                    }
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TutorialDetail] Highlight skipped: {ex.Message}");
        }
    }

