        Console.WriteLine($"خرید پکیج: {package.Name} - قیمت: {package.Price:N0} تومان");
        await Task.Delay(500);
        // In real app: redirect to payment
        // NavigationManager.NavigateTo("/Payment", true);
    }

    private async Task ActivateFreePackage()
    {
        if (package == null || package.Price > 0) return;

        Console.WriteLine($"فعال‌سازی پکیج رایگان: {package.Name}");
        await Task.Delay(500);
        isActivePackage = true;
        hasActivePackage = true;
