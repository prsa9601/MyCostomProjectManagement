                    </div>

                    <div class="td-side-stat">
                        <div class="td-side-icon purple">
                            <i class="fas fa-layer-group"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="label">دسته‌بندی</div>
                            <div class="value">@GetCategoryText(tutorial.Category)</div>
                        </div>
                    </div>

                    <div class="td-side-stat">
                        <div class="td-side-icon orange">
                            <i class="far fa-calendar-alt"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="label">تاریخ انتشار</div>
                            <div class="value">@ToPersianDate(tutorial.CreatedAt)</div>
