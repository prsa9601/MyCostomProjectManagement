@page "/Tutorials/{Id:int}"
@layout FrontLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ITutorialApiService TutorialService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using System.Text.RegularExpressions
@using System.Net
@using System.Text.Json
@using System.Text.Encodings.Web
@using BackEnd.Data.Infrastructure.Tutorial
@using MyCostomProjectManagement.Helpers
@using BackEnd.Data.Infrastructure.Tutorial.DTOs

<PageTitle>@seoTitle</PageTitle>

<HeadContent>
    <meta name="description" content="@seoDescription" />
    <meta name="keywords" content="@seoKeywords" />
    <meta name="author" content="محمد پارسا کریمی" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="@seoTitle" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="fa_IR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@seoTitle" />
    <meta name="twitter:description" content="@seoDescription" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @if (tutorial != null)
    {
        <script type="application/ld+json">@((MarkupString)BuildArticleJsonLd())</script>
        <script type="application/ld+json">@((MarkupString)BuildBreadcrumbJsonLd())</script>
    }
</HeadContent>

<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

<script>
    window.tdTutorial = window.tdTutorial || {};

    window.tdTutorial.copyToClipboard = async function(text) {
        if (!text) return false;
        try { await navigator.clipboard.writeText(text); return true; }
        catch {
            try {
                const ta = document.createElement('textarea');
                ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                document.execCommand('copy'); document.body.removeChild(ta);
                return true;
            } catch { return false; }
        }
    };

    window.tdTutorial.processContent = async function() {
        await new Promise(r => setTimeout(r, 30));

        document.querySelectorAll('#contentArea > table').forEach(function(table) {
            if (table.parentElement.classList.contains('td-table-wrap')) return;
            var wrap = document.createElement('div');
            wrap.className = 'td-table-wrap';
            table.parentNode.insertBefore(wrap, table);
            wrap.appendChild(table);
        });

        document.querySelectorAll('#contentArea a').forEach(function(a) {
            var href = (a.getAttribute('href') || '').trim();
            if (!href) return;
            if (href.startsWith('#')) {
                if (a.dataset.tdBound === '1') return;
                a.dataset.tdBound = '1';
                a.addEventListener('click', function(e) {
                    e.preventDefault();
                    var t = document.querySelector(href);
                    if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
                return;
            }
            if (/^https?:\/\//i.test(href) || href.startsWith('//')) {
                a.setAttribute('target', '_blank');
                a.setAttribute('rel', 'noopener noreferrer');
            }
        });

        document.querySelectorAll('#contentArea pre code').forEach(function(block) {
            if (block.dataset.highlighted === 'yes') return;
            try { hljs.highlightElement(block); block.dataset.highlighted = 'yes'; } catch {}
        });

        document.querySelectorAll('#contentArea pre').forEach(function(pre) {
            var code = pre.querySelector('code');
            if (!code) return;
            if (!pre.querySelector('.tg-code-copy')) {
                var btn = document.createElement('button');
                btn.className = 'tg-code-copy';
                btn.type = 'button';
                btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg><span>کپی</span>';
                btn.addEventListener('click', async function(e) {
                    e.stopPropagation();
                    var ok = await window.tdTutorial.copyToClipboard(code.textContent || code.innerText);
                    if (ok) {
                        btn.classList.add('copied');
                        var span = btn.querySelector('span');
                        var orig = span.textContent;
                        span.textContent = 'کپی شد!';
                        setTimeout(function() {
                            btn.classList.remove('copied');
                            span.textContent = orig;
                        }, 1800);
                    }
                });
                pre.appendChild(btn);
            }
        });
    };
</script>

<style>
    /* ═══════════════════════════════════════════
       HERO / HEADER
       ═══════════════════════════════════════════ */
    .td-hero { padding: 140px 0 40px; }
    .td-back {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(255,255,255,0.04); backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.06);
        color: #b8c4d6; padding: 9px 20px; border-radius: 40px;
        font-size: 0.85rem; margin-bottom: 26px;
        cursor: pointer; transition: all 0.3s ease; text-decoration: none;
    }
    .td-back:hover {
        border-color: #14b8a6; color: #fff;
        background: rgba(20,184,166,0.08); transform: translateX(-4px);
    }
    .td-title {
        font-size: clamp(1.8rem, 5vw, 2.8rem);
        font-weight: 900; line-height: 1.3; margin-bottom: 18px;
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .td-meta {
        display: flex; flex-wrap: wrap; gap: 8px;
        margin-bottom: 30px; padding-bottom: 24px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .td-tag {
        font-size: 0.75rem; padding: 5px 16px; border-radius: 40px;
        font-weight: 500; display: inline-flex; align-items: center;
        gap: 6px; border: 1px solid transparent;
    }
    .tag-subject { background: rgba(20,184,166,0.1); color: #5eead4; border-color: rgba(94,234,212,0.2); }
    .tag-level-beginner { background: rgba(52,211,153,0.1); color: #34d399; border-color: rgba(52,211,153,0.2); }
    .tag-level-intermediate { background: rgba(251,146,60,0.1); color: #fb923c; border-color: rgba(251,146,60,0.2); }
    .tag-level-advanced { background: rgba(239,68,68,0.1); color: #f87171; border-color: rgba(239,68,68,0.2); }
    .tag-level-all { background: rgba(139,92,246,0.1); color: #a78bfa; border-color: rgba(139,92,246,0.2); }
    .tag-topic { background: rgba(255,255,255,0.04); color: #94a3b8; border-color: rgba(255,255,255,0.08); }

    /* LAYOUT */
    .td-grid {
        display: grid; grid-template-columns: 1fr 300px;
        gap: 28px; align-items: start; padding-bottom: 90px;
    }
    .td-main {
        position: relative;
        background: rgba(10, 15, 13, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px; padding: 40px;
        box-shadow: 0 24px 60px -20px rgba(0,0,0,0.5);
        overflow: hidden;
    }
    .td-main::before {
        content: '';
        position: absolute; top: -180px; right: -180px;
        width: 420px; height: 420px;
        background: radial-gradient(circle, rgba(20,184,166,0.08), transparent 65%);
        pointer-events: none; z-index: 0;
    }
    .td-content { position: relative; z-index: 1; }

    /* ═══════════════════════════════════════════════════════════
       PRINT HEADER — فقط در چاپ نشون داده می‌شه
       ═══════════════════════════════════════════════════════════ */
    .td-print-header { display: none; }

    /* ═══════════════════════════════════════════════════════════
       MARKDOWN STYLES (tg-md)
       ═══════════════════════════════════════════════════════════ */
    .tg-md {
        direction: rtl;
        text-align: right;
        font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, sans-serif;
        color: #c8cbd6;
        line-height: 2;
    }

    /* HEADINGS */
    .tg-md h1 {
        font-size: 32px; font-weight: 800; line-height: 1.3;
        color: #ffffff; margin: 0 0 28px;
        letter-spacing: -0.02em;
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .tg-md h2 {
        font-size: 23px; font-weight: 700; color: #ffffff;
        margin: 42px 0 16px;
        padding-right: 16px;
        border-right: 4px solid #14b8a6;
        padding-top: 4px; padding-bottom: 4px;
    }
    .tg-md h3 {
        font-size: 18px; font-weight: 700; color: #5eead4;
        margin: 28px 0 12px;
    }
    .tg-md h4 {
        font-size: 16px; font-weight: 700; color: #e8e8ec;
        margin: 22px 0 10px;
    }

    /* TEXT */
    .tg-md p {
        margin: 0 0 18px;
        font-size: 15.5px; line-height: 2.1; color: #c8cbd6;
    }
    .tg-md strong { color: #ffffff; font-weight: 700; }
    .tg-md em { color: #5eead4; font-style: italic; }

    /* LISTS */
    .tg-md ul, .tg-md ol {
        margin: 0 0 20px;
        padding-right: 24px; padding-left: 0;
    }
    .tg-md li {
        margin-bottom: 10px;
        font-size: 15.5px; line-height: 2; color: #c8cbd6;
    }
    .tg-md ul li::marker { color: #14b8a6; }
    .tg-md ol li::marker { color: #14b8a6; font-weight: 700; }

    /* INLINE CODE */
    .tg-md code {
        background: rgba(94,234,212,0.12);
        color: #5eead4;
        padding: 3px 8px;
        border-radius: 6px;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 13px;
        direction: ltr;
        unicode-bidi: embed;
    }

    /* CODE BLOCK */
    .tg-md pre {
        background: #0d1117;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 46px 20px 18px 20px;
        margin: 20px 0;
        overflow-x: auto;
        direction: ltr;
        text-align: left;
        position: relative;
    }
    .tg-md pre::before {
        content: '';
        position: absolute; top: 0; right: 0; left: 0;
        height: 38px;
        background: rgba(13, 17, 23, 0.95);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        border-top-left-radius: 11px;
        border-top-right-radius: 11px;
        pointer-events: none;
        z-index: 1;
    }
    .tg-md pre::after {
        content: '';
        position: absolute;
        top: 14px;
        left: 14px;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: #27c93f;
        box-shadow: 18px 0 0 #ffbd2e, 36px 0 0 #ff5f56;
        pointer-events: none;
        z-index: 2;
    }
    .tg-md pre code {
        background: transparent !important;
        padding: 0 !important;
        color: #abb2bf;
        font-family: 'JetBrains Mono', ui-monospace, monospace !important;
        font-size: 13px !important;
        line-height: 1.75 !important;
        direction: ltr;
        display: block;
    }
    .tg-md pre code.hljs { background: transparent !important; padding: 0 !important; }

    /* دکمه کپی */
    .tg-md pre .tg-code-copy {
        position: absolute;
        top: 7px;
        right: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 6px;
        background: rgba(94,234,212,0.12);
        border: 1px solid rgba(94,234,212,0.25);
        color: #5eead4;
        font-family: 'Vazirmatn', sans-serif;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        direction: rtl;
        z-index: 3;
        line-height: 1;
        height: 26px;
    }
    .tg-md pre .tg-code-copy svg { width: 12px; height: 12px; }
    .tg-md pre .tg-code-copy:hover {
        background: rgba(94,234,212,0.25);
        border-color: #5eead4;
        color: #ffffff;
    }
    .tg-md pre .tg-code-copy.copied {
        background: rgba(16,185,129,0.2);
        border-color: #10b981;
        color: #6ee7b7;
    }

    /* BLOCKQUOTE */
    .tg-md blockquote {
        border-right: 3px solid #14b8a6;
        padding: 12px 18px; margin: 20px 0;
        background: rgba(20,184,166,0.06);
        border-radius: 8px;
        color: #5eead4; font-style: italic;
    }

    /* LINKS */
    .tg-md a {
        color: #5eead4;
        text-decoration: none;
        border-bottom: 1px dashed rgba(94,234,212,0.5);
        cursor: pointer;
    }
    .tg-md a:hover { border-bottom-style: solid; }

    /* HR */
    .tg-md hr {
        border: none; height: 1px;
        background: rgba(255,255,255,0.08);
        margin: 32px 0;
    }

    /* TABLE */
    .tg-md table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }
    .tg-md th, .tg-md td {
        padding: 12px 16px; text-align: right;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        font-size: 14.5px;
    }
    .tg-md th {
        color: #ffffff; font-weight: 700;
        background: rgba(20,184,166,0.06);
    }
    .tg-md tbody tr:nth-child(even) { background: rgba(255,255,255,0.02); }
    .tg-md tbody tr:hover { background: rgba(20,184,166,0.04); }

    /* ═══════════════════════════════════════════════════════════
       ⚡ SUMMARY BOX — بنفش + طلایی
       ═══════════════════════════════════════════════════════════ */
    .tg-md .summary {
        background: linear-gradient(135deg, rgba(88,28,135,0.22), rgba(88,28,135,0.06));
        border: 1.5px solid rgba(168,85,247,0.35);
        border-radius: 18px;
        padding: 28px 32px;
        margin: 24px 0 40px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 0 60px rgba(168,85,247,0.06);
    }
    .tg-md .summary::before {
        content: '';
        position: absolute; top: 0; right: 0; left: 0;
        height: 3px;
        background: linear-gradient(90deg, #a855f7, #c084fc, #a855f7);
    }
    .tg-md .summary::after {
        content: '🪄';
        position: absolute;
        top: 18px;
        left: 24px;
        font-size: 40px;
        opacity: 0.2;
        pointer-events: none;
        line-height: 1;
    }
    .tg-md .summary h1,
    .tg-md .summary h2,
    .tg-md .summary h3 {
        border-right: none !important;
        padding: 0 !important;
        color: #c084fc !important;
        font-size: 22px !important;
        font-weight: 800;
        margin: 0 0 10px !important;
        display: flex;
        align-items: center;
        gap: 8px;
        line-height: 1.4;
        text-shadow: 0 0 30px rgba(168,85,247,0.3);
    }
    .tg-md .summary > p:first-of-type {
        color: #fcd34d !important;
        font-size: 14.5px !important;
        font-weight: 500;
        margin: 0 0 22px !important;
        padding-bottom: 16px;
        border-bottom: 1px dashed rgba(250,204,21,0.25);
        line-height: 1.9;
    }
    .tg-md .summary ul {
        list-style: disc !important;
        padding-right: 24px !important;
        margin: 0 0 18px !important;
    }
    .tg-md .summary li {
        color: #e2e8f0 !important;
        font-size: 15px !important;
        line-height: 2 !important;
        margin-bottom: 10px !important;
    }
    .tg-md .summary ul li:nth-child(6n+1)::marker { color: #f472b6; }
    .tg-md .summary ul li:nth-child(6n+2)::marker { color: #facc15; }
    .tg-md .summary ul li:nth-child(6n+3)::marker { color: #2dd4bf; }
    .tg-md .summary ul li:nth-child(6n+4)::marker { color: #60a5fa; }
    .tg-md .summary ul li:nth-child(6n+5)::marker { color: #a78bfa; }
    .tg-md .summary ul li:nth-child(6n+6)::marker { color: #34d399; }
    .tg-md .summary ol {
        list-style: decimal !important;
        padding-right: 24px !important;
        margin: 0 0 18px !important;
    }
    .tg-md .summary ol li::marker {
        color: #c084fc;
        font-weight: 700;
    }
    .tg-md .summary strong {
        color: #fde047 !important;
        font-weight: 700;
    }
    .tg-md .summary > p:not(:first-of-type) {
        color: #fb923c !important;
        font-size: 14.5px;
        font-weight: 700;
        margin: 22px 0 14px !important;
        padding-top: 18px;
        border-top: 1px dashed rgba(250,204,21,0.22);
    }
    .tg-md .summary > p:not(:first-of-type) strong {
        color: #fb923c !important;
        font-weight: 700;
    }
    .tg-md .summary code {
        background: rgba(94,234,212,0.12);
        color: #5eead4;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 13px;
        direction: ltr;
        unicode-bidi: embed;
    }
    .tg-md .summary a {
        color: #fde047;
        border-bottom: 1px dashed rgba(250,204,21,0.5);
    }
    .tg-md .summary a:hover { border-bottom-style: solid; }

    /* TABLE WRAPPER */
    .td-table-wrap { width: 100%; overflow-x: auto; margin: 0; }
    .td-table-wrap::-webkit-scrollbar { height: 8px; }
    .td-table-wrap::-webkit-scrollbar-track { background: rgba(0,0,0,0.15); }
    .td-table-wrap::-webkit-scrollbar-thumb { background: rgba(94,234,212,0.3); border-radius: 4px; }

    /* SIDEBAR */
    .td-side {
        display: flex; flex-direction: column; gap: 18px;
        position: sticky; top: 100px;
    }
    .td-side-card {
        background: rgba(255,255,255,0.03); backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px; padding: 22px;
    }
    .td-side-card:hover { border-color: rgba(94,234,212,0.15); }
    .td-side-card h4 {
        font-size: 0.8rem; color: #14b8a6; font-weight: 700;
        margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    .td-side-stat {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .td-side-stat:last-child { border-bottom: none; }
    .td-side-icon {
        width: 40px; height: 40px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; flex-shrink: 0;
        background: rgba(20,184,166,0.12); color: #14b8a6;
    }
    .td-side-icon.purple { background: rgba(168,85,247,0.12); color: #c084fc; }
    .td-side-icon.green { background: rgba(52,211,153,0.12); color: #34d399; }
    .td-side-icon.orange { background: rgba(251,146,60,0.12); color: #fb923c; }
    .td-side-info { flex: 1; min-width: 0; }
    .td-side-info .label { font-size: 0.72rem; color: #64748b; margin-bottom: 2px; }
    .td-side-info .value { font-size: 0.9rem; color: #fff; font-weight: 600; }

    /* STATE / TOAST */
    .td-state { text-align: center; padding: 100px 20px; color: #94a3b8; }
    .td-spinner {
        width: 50px; height: 50px;
        border: 3px solid rgba(20,184,166,0.15);
        border-top-color: #14b8a6; border-radius: 50%;
        animation: spin 0.9s linear infinite;
        margin: 0 auto 20px;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .td-toast {
        position: fixed; bottom: 30px; right: 30px;
        background: linear-gradient(135deg, rgba(52,211,153,0.15), rgba(20,184,166,0.1));
        border: 1px solid rgba(52,211,153,0.3);
        color: #34d399; padding: 12px 22px; border-radius: 40px;
        font-size: 0.85rem; font-weight: 600;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        z-index: 9999;
        display: flex; align-items: center; gap: 8px;
    }

    /* RESPONSIVE */
    @@media (max-width: 900px) {
        .td-grid { grid-template-columns: 1fr; }
        .td-side { position: static; }
        .td-main { padding: 24px; }
    }
    @@media (max-width: 720px) {
        .tg-md .summary { padding: 20px 22px; }
        .tg-md .summary::after { font-size: 30px; top: 14px; left: 16px; }
        .tg-md .summary h2 { font-size: 18px !important; }
    }
    @@media (max-width: 500px) {
        .td-main { padding: 20px; }
        .tg-md h1 { font-size: 24px; }
        .tg-md h2 { font-size: 19px; }
        .tg-md h3 { font-size: 16px; }
        .tg-md pre { padding: 40px 14px 14px 14px; }
        .tg-md pre::after { top: 12px; left: 12px; }
        .tg-md pre .tg-code-copy span { display: none; }
    }

    /* ═══════════════════════════════════════════════════════════
       🖨️ PRINT STYLES — نسخه حرفه‌ای
       ═══════════════════════════════════════════════════════════ */
    @@media print {

        /* ─── تنظیمات صفحه A4 ─── */
        @@page {
            size: A4;
            margin: 20mm 16mm 20mm 16mm;
        }
        @@page :first {
            margin-top: 15mm;
        }

        /* ─── پاک‌سازی پایه ─── */
        html, body {
            background: #ffffff !important;
            color: #1f2937 !important;
            margin: 0 !important;
            padding: 0 !important;
            font-size: 10.5pt !important;
            line-height: 1.75 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            text-rendering: optimizeLegibility;
            font-feature-settings: "kern" 1, "liga" 1;
        }

