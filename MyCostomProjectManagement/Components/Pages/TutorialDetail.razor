                    </div>
                </div>

                <div class="td-side-card">
                    <h4><i class="fas fa-share-alt"></i> اشتراک‌گذاری</h4>

                    <div class="td-side-stat" style="cursor:pointer;" @onclick="CopyLink">
                        <div class="td-side-icon">
                            <i class="fas fa-link"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="value">کپی لینک</div>
                        </div>
                        <i class="fas fa-chevron-left" style="color:rgba(232,240,241,0.3);"></i>
                    </div>

                    <div class="td-side-stat" style="cursor:pointer;" @onclick="CopyContent">
                        <div class="td-side-icon purple">
                            <i class="fas fa-copy"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="value">کپی محتوا</div>
                        </div>
                        <i class="fas fa-chevron-left" style="color:rgba(232,240,241,0.3);"></i>
                    </div>

                    <div class="td-side-stat" style="cursor:pointer;" @onclick="PrintPage">
                        <div class="td-side-icon green">
                            <i class="fas fa-print"></i>
                        </div>
                        <div class="td-side-info">
                            <div class="value">چاپ صفحه</div>
                        </div>
                        <i class="fas fa-chevron-left" style="color:rgba(232,240,241,0.3);"></i>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    @if (showToast)
    {
        <div class="td-toast">
            <i class="fas fa-check-circle"></i>
            @toastMessage
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private TutorialDto? tutorial;
    private bool isLoading = true;
    private string renderedContent = "";
    private bool needsHighlight = false;
    private bool showToast = false;
    private string toastMessage = "";
    private System.Timers.Timer? toastTimer;

    protected override async Task OnParametersSetAsync()
    {
        if (Id <= 0)
        {
            tutorial = null;
            isLoading = false;
            return;
        }

        await LoadTutorial();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsHighlight)
        {
            needsHighlight = false;
            await HighlightCode();
        }
    }

    private async Task LoadTutorial()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            tutorial = await TutorialService.Get(Id);

            if (tutorial != null && !string.IsNullOrWhiteSpace(tutorial.Content))
            {
                renderedContent = MarkdownRenderer.Render(tutorial.Content);
                needsHighlight = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TutorialDetail] Load error: {ex.Message}");
            tutorial = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HighlightCode()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("tdTutorial.processContent");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TutorialDetail] Highlight error: {ex.Message}");
        }
    }

    private async Task CopyLink()
    {
        try
        {
            var safeUrl = Navigation.Uri.Replace("'", "\\'");
            await JSRuntime.InvokeVoidAsync("eval",
                $"navigator.clipboard.writeText('{safeUrl}')");
            ShowToast("لینک کپی شد!");
        }
        catch { ShowToast("خطا در کپی لینک"); }
    }

    private async Task CopyContent()
    {
        if (tutorial == null) return;
        try
        {
            var safeContent = tutorial.Content
                .Replace("\\", "\\\\")
                .Replace("`", "\\`")
                .Replace("$", "\\$");
            await JSRuntime.InvokeVoidAsync("eval",
                $"navigator.clipboard.writeText(`{safeContent}`)");
            ShowToast("محتوا کپی شد!");
        }
        catch { ShowToast("خطا در کپی محتوا"); }
    }

    private async Task PrintPage()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "window.print()");
        }
        catch { }
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();

        toastTimer?.Stop();
        toastTimer = new System.Timers.Timer(2500);
        toastTimer.Elapsed += (s, e) =>
        {
            toastTimer?.Stop();
            InvokeAsync(() =>
            {
                showToast = false;
                StateHasChanged();
            });
        };
        toastTimer.Start();
    }

