@if (isLoading)
{
    <section class="td-hero"><div class="container"><div class="td-state">
        <div class="td-spinner"></div><h3>در حال بارگذاری...</h3>
    </div></div></section>
}
else if (tutorial == null)
{
    <section class="td-hero"><div class="container"><div class="td-state">
        <i class="fas fa-exclamation-triangle"></i>
        <h3>آموزش پیدا نشد</h3>
        <p>ممکن است حذف شده باشد یا آدرس اشتباه باشد.</p>
        <a href="/Tutorials" class="td-back"><i class="fas fa-arrow-right"></i> بازگشت</a>
    </div></div></section>
}
else
{
    <section class="td-hero"><div class="container">
        <a href="/Tutorials" class="td-back"><i class="fas fa-arrow-right"></i> بازگشت به لیست آموزش‌ها</a>
        <h1 class="td-title">@tutorial.Title</h1>
        <div class="td-meta">
            @if (!string.IsNullOrWhiteSpace(tutorial.Subject))
            {
                <span class="td-tag tag-subject"><i class="fas fa-code"></i> @tutorial.Subject</span>
            }
            <span class="td-tag @GetLevelClass(tutorial.Level)"><i class="fas fa-signal"></i> @GetLevelText(tutorial.Level)</span>
            @if (!string.IsNullOrWhiteSpace(tutorial.Topic))
            {
                <span class="td-tag tag-topic"><i class="fas fa-hashtag"></i> @tutorial.Topic</span>
            }
        </div>
    </div></section>

    <section class="container">

        @* ⬇️ هدر اختصاصی چاپ — فقط موقع پرینت نشون داده می‌شه *@
        <div class="td-print-header">
            <div class="td-print-brand">parsakarimidev.ir</div>
            <h1 class="td-print-title">@tutorial.Title</h1>
            <div class="td-print-meta">
                @if (!string.IsNullOrWhiteSpace(tutorial.Subject))
                {
                    <span>@tutorial.Subject</span>
                }
                <span>@GetCategoryText(tutorial.Category)</span>
                <span>سطح: @GetLevelText(tutorial.Level)</span>
                <span>@ToPersianDate(tutorial.CreatedAt)</span>
            </div>
        </div>

        <div class="td-grid">
            <article class="td-main">
                <div class="td-content tg-md" id="contentArea">
                    @((MarkupString)renderedContent)
                </div>
            </article>

            <aside class="td-side">
                <div class="td-side-card">
                    <h4><i class="fas fa-info-circle"></i> اطلاعات</h4>
                    <div class="td-side-stat">
                        <div class="td-side-icon green"><i class="fas fa-list-ul"></i></div>
                        <div class="td-side-info"><div class="label">تعداد بخش‌ها</div><div class="value">@tutorial.SectionCount</div></div>
                    </div>
                    <div class="td-side-stat">
                        <div class="td-side-icon"><i class="fas fa-code"></i></div>
                        <div class="td-side-info"><div class="label">بلوک‌های کد</div><div class="value">@tutorial.CodeBlockCount</div></div>
                    </div>
                    <div class="td-side-stat">
                        <div class="td-side-icon purple"><i class="fas fa-layer-group"></i></div>
                        <div class="td-side-info"><div class="label">دسته‌بندی</div><div class="value">@GetCategoryText(tutorial.Category)</div></div>
                    </div>
                    <div class="td-side-stat">
                        <div class="td-side-icon orange"><i class="far fa-calendar-alt"></i></div>
                        <div class="td-side-info"><div class="label">تاریخ انتشار</div><div class="value">@ToPersianDate(tutorial.CreatedAt)</div></div>
                    </div>
                </div>

                <div class="td-side-card">
                    <h4><i class="fas fa-share-alt"></i> اشتراک‌گذاری</h4>
                    <div class="td-side-stat" style="cursor:pointer;" @onclick="CopyLink">
                        <div class="td-side-icon"><i class="fas fa-link"></i></div>
                        <div class="td-side-info"><div class="value">کپی لینک</div></div>
                    </div>
                    <div class="td-side-stat" style="cursor:pointer;" @onclick="CopyContent">
                        <div class="td-side-icon purple"><i class="fas fa-copy"></i></div>
                        <div class="td-side-info"><div class="value">کپی محتوا</div></div>
                    </div>
                    <div class="td-side-stat" style="cursor:pointer;" @onclick="PrintPage">
                        <div class="td-side-icon green"><i class="fas fa-print"></i></div>
                        <div class="td-side-info"><div class="value">چاپ صفحه</div></div>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    @if (showToast)
    {
        <div class="td-toast"><i class="fas fa-check-circle"></i> @toastMessage</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private TutorialDto? tutorial;
    private bool isLoading = true;
    private string renderedContent = "";
    private bool needsHighlight = false;
    private bool showToast = false;
    private string toastMessage = "";
    private System.Timers.Timer? toastTimer;

    private const string BaseUrl = "https://parsakarimidev.ir";

    private string seoTitle => tutorial == null ? "آموزش | محمد پارسا کریمی" : $"{tutorial.Title} | محمد پارسا کریمی";

    private string seoDescription
    {
        get
        {
            if (tutorial == null) return "آموزش‌های تخصصی برنامه‌نویسی";
            var raw = StripMarkdown(tutorial.Content ?? "");
            if (string.IsNullOrWhiteSpace(raw)) raw = $"آموزش کامل {tutorial.Subject}";
            raw = Regex.Replace(raw, @"\s+", " ").Trim();
            return raw.Length > 160 ? raw.Substring(0, 157).TrimEnd() + "..." : raw;
        }
    }

    private string seoKeywords => tutorial == null
        ? "برنامه‌نویسی, آموزش"
        : $"{tutorial.Subject}, آموزش {tutorial.Subject}";

    private string canonicalUrl => tutorial != null ? $"{BaseUrl}/Tutorials/{tutorial.Id}" : $"{BaseUrl}/Tutorials";
    private string ogImage => $"{BaseUrl}/images/og/tutorial-{tutorial?.Id ?? 0}.png";

    private string StripMarkdown(string md)
    {
        if (string.IsNullOrWhiteSpace(md)) return "";
        var s = md;
        s = Regex.Replace(s, @"```[\s\S]*?```", " ");
        s = Regex.Replace(s, @"`[^`]*`", " ");
        s = Regex.Replace(s, @":::\s*\w*", " ");
        s = Regex.Replace(s, @"^#{1,6}\s+", "", RegexOptions.Multiline);
        s = Regex.Replace(s, @"\*\*|__|\*|_", "");
        s = Regex.Replace(s, @"\[([^\]]+)\]\([^\)]+\)", "$1");
        return Regex.Replace(s, @"\s+", " ").Trim();
    }

    private string BuildArticleJsonLd()
    {
        if (tutorial == null) return "{}";
        var data = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "TechArticle",
            ["headline"] = tutorial.Title,
            ["description"] = seoDescription,
            ["inLanguage"] = "fa-IR",
            ["url"] = canonicalUrl,
            ["datePublished"] = tutorial.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss+03:30"),
            ["author"] = new Dictionary<string, object> { ["@type"] = "Person", ["name"] = "محمد پارسا کریمی" }
        };
        return JsonSerializer.Serialize(data, new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
    }

    private string BuildBreadcrumbJsonLd()
    {
        if (tutorial == null) return "{}";
        var data = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new List<object>
            {
                new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = BaseUrl },
                new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "آموزش‌ها", ["item"] = $"{BaseUrl}/Tutorials" },
                new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = tutorial.Title, ["item"] = canonicalUrl }
            }
        };
        return JsonSerializer.Serialize(data, new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id <= 0) { tutorial = null; isLoading = false; return; }
        await LoadTutorial();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsHighlight) { needsHighlight = false; await HighlightCode(); }
    }

    private async Task LoadTutorial()
    {
        isLoading = true; StateHasChanged();
        try
        {
            tutorial = await TutorialService.Get(Id);
            if (tutorial != null && !string.IsNullOrWhiteSpace(tutorial.Content))
            {
                renderedContent = MarkdownRenderer.Render(tutorial.Content);
                needsHighlight = true;
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); tutorial = null; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task HighlightCode()
    {
        try { await JSRuntime.InvokeVoidAsync("tdTutorial.processContent"); } catch { }
    }

    private async Task CopyLink()
    {
        try
        {
            var ok = await JSRuntime.InvokeAsync<bool>("tdTutorial.copyToClipboard", Navigation.Uri);
            ShowToast(ok ? "لینک کپی شد!" : "خطا");
        }
        catch { ShowToast("خطا"); }
    }

    private async Task CopyContent()
    {
        if (tutorial == null) return;
        try
        {
            var ok = await JSRuntime.InvokeAsync<bool>("tdTutorial.copyToClipboard", tutorial.Content ?? "");
            ShowToast(ok ? "محتوا کپی شد!" : "خطا");
        }
        catch { ShowToast("خطا"); }
    }

    private async Task PrintPage()
    {
        try { await JSRuntime.InvokeVoidAsync("eval", "window.print()"); } catch { }
    }

    private void ShowToast(string message)
    {
        toastMessage = message; showToast = true; StateHasChanged();
        toastTimer?.Stop();
        toastTimer = new System.Timers.Timer(2500);
        toastTimer.Elapsed += (s, e) =>
        {
            toastTimer?.Stop();
            InvokeAsync(() => { showToast = false; StateHasChanged(); });
        };
        toastTimer.Start();
    }

