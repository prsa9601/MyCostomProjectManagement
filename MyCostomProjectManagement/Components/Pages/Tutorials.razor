@page "/Tutorials"
@layout FrontLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ITutorialApiService TutorialService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using BackEnd.Data.Infrastructure.Tutorial
@using BackEnd.Data.Infrastructure.Tutorial.DTOs

<PageTitle>آموزش‌ها | محمد پارسا کریمی</PageTitle>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />
<style>
    /* ============================================================
       TUTORIAL DETAIL (FRONT) - Full Style Sheet
    ============================================================ */

    /* ===== HERO ===== */
    .td-hero {
        padding: 140px 0 40px;
        position: relative;
        z-index: 1;
    }

    .td-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.06);
        color: #b8c4d6;
        padding: 9px 20px;
        border-radius: 40px;
        font-size: 0.85rem;
        margin-bottom: 26px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .td-back:hover {
        border-color: #3b82f6;
        color: #fff;
        background: rgba(59,130,246,0.08);
        transform: translateX(-4px);
        box-shadow: 0 8px 30px rgba(59,130,246,0.1);
    }

    .td-back i {
        transition: transform 0.3s ease;
    }

    .td-back:hover i {
        transform: translateX(-3px);
    }

    .td-title {
        font-size: clamp(1.8rem, 5vw, 2.8rem);
        font-weight: 900;
        line-height: 1.3;
        margin-bottom: 18px;
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .td-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 30px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .td-tag {
        font-size: 0.75rem;
        padding: 5px 16px;
        border-radius: 40px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid transparent;
    }

    .tag-subject {
        background: rgba(26,122,138,0.1);
        color: #4dc9dd;
        border-color: rgba(77,201,221,0.2);
    }

    .tag-level-beginner     { background: rgba(52,211,153,0.1);  color: #34d399; border-color: rgba(52,211,153,0.2); }
    .tag-level-intermediate { background: rgba(251,146,60,0.1);  color: #fb923c; border-color: rgba(251,146,60,0.2); }
    .tag-level-advanced     { background: rgba(239,68,68,0.1);   color: #f87171; border-color: rgba(239,68,68,0.2); }
    .tag-level-all          { background: rgba(139,92,246,0.1);  color: #a78bfa; border-color: rgba(139,92,246,0.2); }

    .tag-topic {
        background: rgba(255,255,255,0.04);
        color: #94a3b8;
        border-color: rgba(255,255,255,0.08);
    }

    /* ===== LAYOUT ===== */
    .td-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 28px;
        align-items: start;
        padding-bottom: 90px;
        position: relative;
        z-index: 1;
    }

    .td-main {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 24px;
        padding: 36px;
        position: relative;
    }

    /* ===== CONTENT (Markdown) ===== */
    .td-content {
        color: #d8e3e5;
        font-size: 1rem;
        line-height: 2;
        word-wrap: break-word;
    }

    /* Headers */
    .td-content h1 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin: 32px 0 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid transparent;
        background-image: linear-gradient(90deg, #3b82f6, #8b5cf6, transparent);
        background-repeat: no-repeat;
        background-size: 100% 2px;
        background-position: 0 100%;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .td-content h1:first-child {
        margin-top: 0;
    }

    .td-content h1::before {
        content: '\f0da';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: #3b82f6;
        font-size: 1.1rem;
    }

    .td-content h2 {
        font-size: 1.3rem;
        font-weight: 700;
        color: #60a5fa;
        margin: 28px 0 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-right: 14px;
        position: relative;
    }

    .td-content h2::before {
        content: '';
        width: 4px;
        height: 1.2rem;
        background: linear-gradient(180deg, #3b82f6, #8b5cf6);
        border-radius: 4px;
    }

    .td-content h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #a78bfa;
        margin: 22px 0 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .td-content h3::before {
        content: '\f111';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: #a78bfa;
        font-size: 0.45rem;
        opacity: 0.7;
    }

    .td-content h4 {
        font-size: 1rem;
        font-weight: 600;
        color: #4dc9dd;
        margin: 18px 0 8px;
    }

    /* Paragraphs */
    .td-content p {
        margin-bottom: 16px;
    }

    .td-content strong {
        color: #fff;
        font-weight: 700;
        background: linear-gradient(180deg, transparent 65%, rgba(59,130,246,0.25) 65%);
        padding: 0 2px;
    }

    .td-content em {
        color: #a78bfa;
        font-style: italic;
        font-weight: 500;
    }

    /* Links */
    .td-content a {
        color: #60a5fa;
        text-decoration: none;
        border-bottom: 1px dashed rgba(96,165,250,0.4);
        transition: all 0.25s;
        padding: 0 2px;
    }

    .td-content a:hover {
        color: #8b5cf6;
        border-bottom-color: #8b5cf6;
        border-bottom-style: solid;
        background: rgba(139,92,246,0.06);
        border-radius: 4px;
    }

    /* Lists - unordered */
    .td-content ul {
        margin: 14px 0 18px;
        padding-right: 22px;
        list-style: none;
    }

    .td-content ul li {
        position: relative;
        padding-right: 24px;
        margin-bottom: 10px;
        transition: all 0.25s;
    }

    .td-content ul li::before {
        content: '\f0da';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        right: 0;
        top: 2px;
        color: #3b82f6;
        font-size: 0.75rem;
        transition: all 0.25s;
    }

    .td-content ul li:hover::before {
        color: #8b5cf6;
        transform: translateX(-3px);
    }

    /* Lists - ordered */
    .td-content ol {
        margin: 14px 0 18px;
        padding-right: 34px;
        counter-reset: item;
        list-style: none;
    }

    .td-content ol li {
        position: relative;
        margin-bottom: 10px;
        counter-increment: item;
    }

    .td-content ol li::before {
        content: counter(item);
        position: absolute;
        right: -34px;
        top: 1px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 10px rgba(59,130,246,0.25);
    }

    /* Inline code */
    .td-content code {
        background: rgba(0,0,0,0.35);
        color: #f8bb4f;
        padding: 3px 9px;
        border-radius: 6px;
        font-size: 0.85em;
        font-family: 'Fira Code', 'Consolas', 'Monaco', monospace;
        direction: ltr;
        unicode-bidi: embed;
        border: 1px solid rgba(59,130,246,0.15);
        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }

    /* Code blocks */
    .td-content pre {
        position: relative;
        background: #282c34 !important;
        border: 1px solid rgba(59,130,246,0.15);
        border-radius: 16px;
        padding: 24px 22px 20px;
        margin: 20px 0;
        overflow-x: auto;
        direction: ltr;
        text-align: left;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    .td-content pre::before {
        content: '● ● ●';
        position: absolute;
        top: 10px;
        left: 14px;
        color: #ff5f56;
        font-size: 0.7rem;
        letter-spacing: 4px;
        opacity: 0.9;
    }

    .td-content pre code {
        background: transparent !important;
        color: #abb2bf !important;
        padding: 0;
        border: none;
        box-shadow: none;
        font-size: 0.88rem;
        line-height: 1.7;
        font-family: 'Fira Code', 'Consolas', 'Monaco', monospace;
        display: block;
    }

    .td-content pre code.hljs {
        background: transparent !important;
        padding: 0 !important;
    }

    /* Blockquote */
    .td-content blockquote {
        position: relative;
        border-right: 4px solid #3b82f6;
        padding: 16px 22px;
        margin: 20px 0;
        background: linear-gradient(90deg, rgba(59,130,246,0.06), transparent);
        border-radius: 12px;
        color: rgba(232,240,241,0.9);
        font-style: italic;
        font-size: 0.95rem;
    }

    .td-content blockquote::before {
        content: '\f10d';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        top: 10px;
        right: 12px;
        color: rgba(59,130,246,0.3);
        font-size: 1.2rem;
    }

    /* Tables */
    .td-content table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 20px 0;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.06);
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

    .td-content table thead {
        background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(139,92,246,0.1));
    }

    .td-content table th {
        padding: 12px 16px;
        text-align: right;
        color: #60a5fa;
        font-weight: 700;
        font-size: 0.85rem;
        border-bottom: 2px solid rgba(59,130,246,0.2);
    }

    .td-content table td {
        padding: 11px 16px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        color: #d8e3e5;
        font-size: 0.9rem;
    }

    .td-content table tbody tr:nth-child(even) {
        background: rgba(255,255,255,0.02);
    }

    .td-content table tbody tr:hover {
        background: rgba(59,130,246,0.05);
    }

    .td-content table tbody tr:last-child td {
        border-bottom: none;
    }

    /* HR */
    .td-content hr {
        border: none;
        height: 2px;
        background: linear-gradient(90deg, transparent, #3b82f6, #8b5cf6, transparent);
        margin: 32px 0;
        border-radius: 4px;
        opacity: 0.6;
    }

    /* ===== SIDEBAR ===== */
    .td-side {
        display: flex;
        flex-direction: column;
        gap: 18px;
        position: sticky;
        top: 100px;
    }

    .td-side-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        padding: 22px;
        transition: all 0.3s ease;
    }

    .td-side-card:hover {
        border-color: rgba(59,130,246,0.15);
    }

    .td-side-card h4 {
        font-size: 0.8rem;
        color: #3b82f6;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .td-side-stat {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: all 0.3s ease;
    }

    .td-side-stat:hover {
        background: rgba(255,255,255,0.02);
        border-radius: 10px;
        padding-right: 8px;
        padding-left: 8px;
        margin: 0 -8px;
    }

    .td-side-stat:last-child {
        border-bottom: none;
    }

    .td-side-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
        background: rgba(59,130,246,0.12);
        color: #3b82f6;
    }

    .td-side-icon.purple { background: rgba(139,92,246,0.12); color: #a78bfa; }
    .td-side-icon.green  { background: rgba(52,211,153,0.12); color: #34d399; }
    .td-side-icon.orange { background: rgba(251,146,60,0.12); color: #fb923c; }

    .td-side-info {
        flex: 1;
        min-width: 0;
    }

    .td-side-info .label {
        font-size: 0.72rem;
        color: #64748b;
        margin-bottom: 2px;
    }

    .td-side-info .value {
        font-size: 0.9rem;
        color: #fff;
        font-weight: 600;
    }

    /* ===== STATE ===== */
    .td-state {
        text-align: center;
        padding: 100px 20px;
        color: #94a3b8;
    }

    .td-state i {
        font-size: 3.5rem;
        color: rgba(59,130,246,0.3);
        margin-bottom: 16px;
        display: block;
    }

    .td-state h3 {
        font-size: 1.3rem;
        color: #eef2f8;
        margin-bottom: 10px;
    }

    .td-state p {
        color: #64748b;
        margin-bottom: 20px;
    }

    .td-spinner {
        width: 50px;
        height: 50px;
        border: 3px solid rgba(59,130,246,0.15);
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
        margin: 0 auto 20px;
        box-shadow: 0 0 40px rgba(59,130,246,0.15);
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 900px) {
        .td-grid {
            grid-template-columns: 1fr;
        }
        .td-side {
            position: static;
        }
        .td-main {
            padding: 24px;
        }
    }

    @@media (max-width: 500px) {
        .td-hero {
            padding: 120px 0 30px;
        }
        .td-main {
            padding: 20px;
        }
        .td-content {
            font-size: 0.92rem;
            line-height: 1.9;
        }
        .td-content h1 { font-size: 1.3rem; }
        .td-content h2 { font-size: 1.1rem; }
        .td-content h3 { font-size: 1rem; }
        .td-content pre {
            padding: 22px 16px 16px;
            font-size: 0.82rem;
        }
        .td-content table {
            font-size: 0.82rem;
        }
        .td-content table th,
        .td-content table td {
            padding: 9px 12px;
        }
    }
</style><style>
    /* ============================================================
       TUTORIALS (FRONT) - Full Style Sheet
       Palette: #0a0e17 (bg), #3b82f6 (blue), #8b5cf6 (purple)
    ============================================================ */

    /* ===== HERO ===== */
    .tut-hero {
        padding: 140px 0 40px;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .tut-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(59,130,246,0.12);
        padding: 7px 22px;
        border-radius: 40px;
        font-size: 0.82rem;
        color: #3b82f6;
        border: 1px solid rgba(59,130,246,0.2);
        margin-bottom: 22px;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        animation: badgePulse 3s ease-in-out infinite;
    }

    @@keyframes badgePulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(59,130,246,0.15); }
        50%      { box-shadow: 0 0 0 12px rgba(59,130,246,0); }
    }

    .tut-hero h1 {
        font-size: clamp(2rem, 6vw, 3.5rem);
        font-weight: 900;
        line-height: 1.2;
        margin-bottom: 16px;
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .tut-hero h1 span {
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 30px rgba(59,130,246,0.25));
    }

    .tut-hero p {
        font-size: 1.1rem;
        max-width: 640px;
        margin: 0 auto;
        color: #b8c4d6;
        line-height: 1.8;
    }

    /* ===== SECTION ===== */
    .tut-section {
        padding: 40px 0 90px;
        position: relative;
        z-index: 1;
    }

    /* ===== SEARCH BAR ===== */
    .search-wrapper {
        max-width: 620px;
        margin: 0 auto 40px;
        position: relative;
    }

    .search-input {
        width: 100%;
        padding: 16px 56px 16px 20px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 50px;
        color: #eef2f8;
        font-size: 1rem;
        font-family: inherit;
        transition: all 0.3s ease;
        outline: none;
    }

    .search-input::placeholder {
        color: #64748b;
    }

    .search-input:focus {
        border-color: #3b82f6;
        background: rgba(59,130,246,0.05);
        box-shadow: 0 0 40px rgba(59,130,246,0.12);
    }

    .search-icon {
        position: absolute;
        right: 22px;
        top: 50%;
        transform: translateY(-50%);
        color: #3b82f6;
        font-size: 1.05rem;
        pointer-events: none;
        transition: all 0.3s ease;
    }

    .search-input:focus + .search-icon {
        color: #8b5cf6;
        transform: translateY(-50%) scale(1.1);
    }

    /* ===== FILTER PILLS ===== */
    .filter-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
        margin-bottom: 40px;
    }

    .filter-pill {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.06);
        color: #b8c4d6;
        padding: 9px 20px;
        border-radius: 40px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.2,0.9,0.3,1);
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .filter-pill:hover {
        border-color: rgba(59,130,246,0.4);
        color: #fff;
        transform: translateY(-2px);
        background: rgba(59,130,246,0.06);
    }

    .filter-pill.active {
        background: linear-gradient(135deg, rgba(59,130,246,0.25), rgba(139,92,246,0.2));
        border-color: #3b82f6;
        color: #fff;
        box-shadow: 0 8px 30px rgba(59,130,246,0.2);
        font-weight: 600;
    }

    .filter-pill.active i {
        color: #60a5fa;
    }

    /* ===== TUTORIAL CARDS GRID ===== */
    .tut-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
    }

    .tut-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 24px;
        padding: 26px;
        transition: all 0.4s cubic-bezier(0.2,0.9,0.3,1);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

    .tut-card::before {
        content: '';
        position: absolute;
        inset: -2px;
        z-index: -1;
        border-radius: 26px;
        background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
        background-size: 300% 300%;
        animation: rotateBorder 10s linear infinite;
        opacity: 0;
        transition: opacity 0.4s;
    }

    .tut-card:hover::before {
        opacity: 0.5;
    }

    .tut-card:hover {
        transform: translateY(-8px);
        border-color: transparent;
        box-shadow: 0 20px 60px rgba(59,130,246,0.12);
    }

    @@keyframes rotateBorder {
        0%   { background-position: 0% 50%; }
        100% { background-position: 400% 50%; }
    }

    /* ===== CARD HEADER ===== */
    .tut-head {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 16px;
    }

    .tut-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
        background: rgba(59,130,246,0.12);
        color: #3b82f6;
        transition: all 0.35s ease;
    }

