                            <span class="tut-open">
                                مطالعه
                                <i class="fas fa-arrow-left"></i>
                            </span>
                        </div>
                    </a>
                }
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="tut-pagination">
                    <button @onclick="() => GoToPage(currentPage - 1)"
                            disabled="@(currentPage <= 1)">
                        <i class="fas fa-chevron-right"></i>
                        قبلی
                    </button>

                    @foreach (var p in GetPageNumbers())
                    {
                        var pageNum = p;
                        <button class="@(pageNum == currentPage ? "active" : "")"
                                @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }

                    <button @onclick="() => GoToPage(currentPage + 1)"
                            disabled="@(currentPage >= totalPages)">
                        بعدی
                        <i class="fas fa-chevron-left"></i>
                    </button>
                </div>
            }
        }

    </div>
</section>

@code {
    // ============================================================
    // STATE
    // ============================================================
    private const int PageSize = 9;

    private List<TutorialDto>? tutorials;
    private int currentPage = 1;
    private int totalCount = 0;
    private int totalPages = 0;
    private bool isLoading = true;
    private bool _fadeUpInitialized = false;

    private string searchTerm = "";
    private string? selectedCategory = null;

    // ============================================================
    // LIFECYCLE
    // ============================================================
    protected override async Task OnInitializedAsync()
    {
        await LoadTutorials();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JS Interop فقط در OnAfterRenderAsync مجاز است
        if (!_fadeUpInitialized && tutorials != null)
        {
            _fadeUpInitialized = true;
            await InitializeFadeUp();
        }
    }

    // ============================================================
    // DATA LOADING
    // ============================================================
    private async Task LoadTutorials()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var filter = new TutorialFilterParam
            {
                PageId = currentPage,
                Take = PageSize
            };

            var result = await TutorialService.GetFilter(filter);

            // ⚠️ نام پراپرتی‌های BaseFilter را با نام واقعی جایگزین کنید
            tutorials  = result?.Data ?? new List<TutorialDto>();
            totalCount = result?.EntityCount ?? tutorials.Count;

            // فیلترهای سمت کلاینت (چون API از search/category پشتیبانی نمی‌کند)
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.ToLower();
                tutorials = tutorials
                    .Where(t => t.Title.ToLower().Contains(term) ||
                                t.Topic.ToLower().Contains(term) ||
                                t.Subject.ToLower().Contains(term))
                    .ToList();
            }

            if (!string.IsNullOrWhiteSpace(selectedCategory))
            {
                tutorials = tutorials
                    .Where(t => string.Equals(t.Category, selectedCategory, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            totalPages = (int)Math.Ceiling((double)totalCount / PageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Load error: {ex.Message}");
            tutorials = new List<TutorialDto>();
            totalCount = 0;
            totalPages = 0;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ============================================================
    // FILTER ACTIONS
    // ============================================================
    private async Task FilterByCategory(string? category)
    {
        selectedCategory = category;
        currentPage = 1;
        _fadeUpInitialized = false;
        await LoadTutorials();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            _fadeUpInitialized = false;
            await LoadTutorials();
        }
    }

    // ============================================================
    // PAGINATION
    // ============================================================
    private async Task GoToPage(int page)
    {
        if (page < 1 || (totalPages > 0 && page > totalPages)) return;
        currentPage = page;
        _fadeUpInitialized = false;
        await LoadTutorials();

        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 0, behavior: 'smooth' })");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] Scroll error: {ex.Message}");
        }
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int maxVisible = 5;
        var start = Math.Max(1, currentPage - maxVisible / 2);
        var end = Math.Min(totalPages, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
            start = Math.Max(1, end - maxVisible + 1);

        for (int i = start; i <= end; i++)
            yield return i;
    }

    // ============================================================
    // JS INTEROP
    // ============================================================
    private async Task InitializeFadeUp()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    const elements = document.querySelectorAll('.fade-up');
                    if (!elements.length) return;

                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('visible');
                            }
                        });
                    }, { threshold: 0.1, rootMargin: '0px 0px -20px 0px' });

                    elements.forEach(el => observer.observe(el));

                    setTimeout(() => {
                        elements.forEach(el => {
                            if (el.getBoundingClientRect().top < window.innerHeight) {
                                el.classList.add('visible');
                            }
                        });
                    }, 200);
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Tutorials] JS Interop skipped: {ex.Message}");
        }
    }

    // ============================================================
    // HELPERS
    // ============================================================
    private static string GetCategoryIcon(string? category) => category?.ToLower() switch
    {
        "language"  => "fas fa-code",
        "framework" => "fas fa-layer-group",
        "tool"      => "fas fa-wrench",
        "concept"   => "fas fa-lightbulb",
        _           => "fas fa-book"
    };

    private static string GetCategoryClass(string? category) => category?.ToLower() switch
    {
        "language"  => "cat-language",
        "framework" => "cat-framework",
        "tool"      => "cat-tool",
        "concept"   => "cat-concept",
        _           => ""
    };

    private static string GetLevelClass(string? level) => level?.ToLower() switch
    {
        "beginner"     => "tag-level-beginner",
        "intermediate" => "tag-level-intermediate",
        "advanced"     => "tag-level-advanced",
        _              => "tag-level-all"
    };

    private static string GetLevelText(string? level) => level?.ToLower() switch
    {
        "beginner"     => "مبتدی",
        "intermediate" => "متوسط",
        "advanced"     => "پیشرفته",
        "all"          => "همه سطوح",
        _              => "نامشخص"
    };

    private static string ToPersianDate(DateTime dt)
    {
        try
        {
            var pc = new System.Globalization.PersianCalendar();
            return $"{pc.GetYear(dt):0000}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00}";
        }
        catch
        {
            return dt.ToString("yyyy/MM/dd");
        }
    }
}