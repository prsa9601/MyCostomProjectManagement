    private async Task ResendOtp()
    {
        if (otpTimer > 0) return;

        phoneError = "";
        phoneSuccess = "";

        await Task.Delay(800);
        StartOtpTimer();
        phoneSuccess = "کد جدید به شماره شما ارسال شد.";
        StateHasChanged();
    }

    private void StartOtpTimer()
    {
        otpTimer = 120;
        otpTimerRef?.Dispose();
        otpTimerRef = new System.Timers.Timer(1000);
        otpTimerRef.Elapsed += (sender, e) =>
        {
            if (otpTimer > 0)
            {
                otpTimer--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                otpTimerRef?.Stop();
            }
        };
        otpTimerRef.Start();
    }

    // ============================================================
    // EMAIL LOGIN
    // ============================================================

    private async Task HandleEmailLogin()
    {
        if (string.IsNullOrWhiteSpace(emailLogin) || string.IsNullOrWhiteSpace(emailPassword))
        {
            emailError = "لطفاً ایمیل و رمز عبور را وارد کنید.";
            return;
        }

        isLoading = true;
        emailError = "";
        emailSuccess = "";

        await Task.Delay(1500);

        if (emailLogin.Contains("@") && emailPassword.Length >= 6)
        {
            emailSuccess = "ورود موفق! در حال انتقال به داشبورد...";
            await Task.Delay(500);
            NavigationManager.NavigateTo("/Dashboard", true);
        }
        else
        {
            emailError = "ایمیل یا رمز عبور اشتباه است.";
        }

        isLoading = false;
        StateHasChanged();
    }

