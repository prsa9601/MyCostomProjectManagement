@page "/Register"
@using MyCostomProjectManagement.Facade.User
@layout MyCostomProjectManagement.Components.Layout.FrontLayout
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IUserFacade _userFacade

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ثبت‌نام | محمد رضایی</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ===== استایل مشابه صفحه Auth (برای هماهنگی) ===== */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #0a0e17;
        color: #eef2f8;
        line-height: 1.7;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

        .bg-particles span {
            position: absolute;
            display: block;
            width: 6px;
            height: 6px;
            background: rgba(59, 130, 246, 0.2);
            border-radius: 50%;
            animation: floatParticle 12s infinite alternate ease-in-out;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.05);
        }

            .bg-particles span:nth-child(1) {
                top: 10%;
                left: 20%;
                animation-duration: 14s;
                width: 8px;
                height: 8px;
            }

            .bg-particles span:nth-child(2) {
                top: 60%;
                left: 80%;
                animation-duration: 16s;
                animation-delay: 2s;
            }

            .bg-particles span:nth-child(3) {
                top: 30%;
                left: 70%;
                animation-duration: 18s;
                animation-delay: 4s;
                width: 10px;
                height: 10px;
            }

            .bg-particles span:nth-child(4) {
                top: 80%;
                left: 10%;
                animation-duration: 15s;
                animation-delay: 1s;
            }

            .bg-particles span:nth-child(5) {
                top: 50%;
                left: 40%;
                animation-duration: 20s;
                animation-delay: 3s;
                width: 12px;
                height: 12px;
                background: rgba(59, 130, 246, 0.12);
            }

            .bg-particles span:nth-child(6) {
                top: 15%;
                left: 90%;
                animation-duration: 13s;
                animation-delay: 5s;
            }

            .bg-particles span:nth-child(7) {
                top: 70%;
                left: 50%;
                animation-duration: 17s;
                animation-delay: 2s;
                width: 7px;
                height: 7px;
            }

            .bg-particles span:nth-child(8) {
                top: 40%;
                left: 5%;
                animation-duration: 19s;
                animation-delay: 3s;
            }

    @@keyframes floatParticle {
        0% {
            transform: translate(0, 0) scale(1);
            opacity: 0.2;
        }

        50% {
            transform: translate(30px, -60px) scale(1.6);
            opacity: 0.7;
        }

        100% {
            transform: translate(-20px, 40px) scale(0.8);
            opacity: 0.1;
        }
    }

    .register-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 440px;
        margin: 40px auto;
        padding: 0 16px;
    }

    .register-box {
        background: rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 8px 48px rgba(0, 0, 0, 0.4);
        border-radius: 28px;
        padding: 40px 32px;
        transition: all 0.3s ease;
    }

        .register-box:hover {
            border-color: rgba(59, 130, 246, 0.08);
            box-shadow: 0 8px 64px rgba(0, 0, 0, 0.5);
        }

    .register-logo {
        text-align: center;
        margin-bottom: 28px;
    }

        .register-logo .icon {
            font-size: 2.8rem;
            color: #3b82f6;
            display: block;
            margin-bottom: 6px;
            text-shadow: 0 0 40px rgba(59, 130, 246, 0.1);
        }

        .register-logo h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.5px;
        }

            .register-logo h1 span {
                color: #3b82f6;
                text-shadow: 0 0 30px rgba(59, 130, 246, 0.15);
            }

        .register-logo p {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-top: 2px;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #94a3b8;
            margin-bottom: 4px;
        }

        .form-group .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            transition: all 0.3s ease;
        }

            .form-group .input-wrapper:focus-within {
                border-color: #3b82f6;
                background: rgba(255, 255, 255, 0.04);
                box-shadow: 0 0 24px rgba(59, 130, 246, 0.02);
            }

            .form-group .input-wrapper .input-icon {
                padding: 0 0 0 14px;
                color: #64748b;
                font-size: 0.9rem;
                opacity: 0.4;
                transition: 0.3s;
            }

            .form-group .input-wrapper:focus-within .input-icon {
                opacity: 0.8;
                color: #3b82f6;
            }

            .form-group .input-wrapper input {
                width: 100%;
                padding: 12px 14px;
                background: transparent;
                border: none;
                color: #eef2f8;
                font-size: 0.95rem;
                outline: none;
                font-family: inherit;
            }

                .form-group .input-wrapper input::placeholder {
                    color: #64748b;
                }

                .form-group .input-wrapper input:read-only {
                    opacity: 0.7;
                    cursor: default;
                }

    .btn-submit {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.35s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(59, 130, 246, 0.12);
        font-family: inherit;
        margin-top: 10px;
    }

        .btn-submit:hover {
            transform: translateY(-2px) scale(1.01);
            box-shadow: 0 8px 32px rgba(59, 130, 246, 0.2);
        }

        .btn-submit:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

    .btn-submit-secondary {
        width: 100%;
        padding: 12px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
        color: #94a3b8;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: inherit;
        margin-top: 10px;
    }

        .btn-submit-secondary:hover {
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.08);
            color: #eef2f8;
        }

        .btn-submit-secondary i {
            color: #3b82f6;
            opacity: 0.4;
        }

    .alert {
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.85rem;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .alert i {
            font-size: 1rem;
        }

    .alert-error {
        background: rgba(239, 68, 68, 0.04);
        border: 1px solid rgba(239, 68, 68, 0.06);
        color: #ef4444;
    }

    .alert-success {
        background: rgba(52, 211, 153, 0.04);
        border: 1px solid rgba(52, 211, 153, 0.06);
        color: #34d399;
    }

    @@media (max-width: 480px) {
        .register-box {
            padding: 28px 20px;
            border-radius: 20px;
        }

        .register-logo h1 {
            font-size: 1.3rem;
        }
    }
</style>

<!-- ===== BACKGROUND PARTICLES ===== -->
<div class="bg-particles">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
</div>

<div class="register-container">
    <div class="register-box">

        <!-- Logo -->
        <div class="register-logo">
            <span class="icon"><i class="fas fa-user-plus"></i></span>
            <h1>Mohammad<span>Dev</span></h1>
            <p>ایجاد حساب کاربری جدید</p>
        </div>

        <!-- پیام‌ها -->
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                @error
            </div>
        }

        @if (!string.IsNullOrEmpty(success))
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                @success
            </div>
        }

        <!-- فرم ثبت‌نام -->
        <div class="form-group">
            <label>شماره تلفن</label>
            <div class="input-wrapper">
                <span class="input-icon"><i class="fas fa-phone"></i></span>
                <input type="tel" @bind="Phone" readonly />
            </div>
            <div style="font-size:0.75rem; color:#64748b; margin-top:4px;">
                این شماره قبلاً تأیید شده است
            </div>
        </div>

        <div class="form-group">
            <label>نام کامل</label>
            <div class="input-wrapper">
                <span class="input-icon"><i class="fas fa-user"></i></span>
                <input type="text" placeholder="مثال: محمد رضایی" @bind="FullName" />
            </div>
        </div>

        <div class="form-group">
            <label>ایمیل (اختیاری)</label>
            <div class="input-wrapper">
                <span class="input-icon"><i class="fas fa-envelope"></i></span>
                <input type="email" placeholder="example@email.com" @bind="Email" />
            </div>
        </div>

        <div class="form-group">
            <label>رمز عبور</label>
            <div class="input-wrapper">
                <span class="input-icon"><i class="fas fa-lock"></i></span>
                <input type="password" placeholder="••••••••" @bind="Password" />
            </div>
        </div>

        <button class="btn-submit" @onclick="RegisterUser" disabled="@isLoading">
            @if (isLoading)
            {
                <span><i class="fas fa-spinner fa-spin"></i> در حال ثبت‌نام...</span>
            }
            else
            {
                <span><i class="fas fa-user-plus"></i> ثبت‌نام</span>
            }
        </button>

        <button class="btn-submit-secondary" @onclick="GoToLogin">
            <i class="fas fa-arrow-right"></i> بازگشت به صفحه ورود
        </button>

    </div>
</div>

@code {
    // ============================================================
    // دریافت پارامتر از کوئری استرینگ ✅
    // ============================================================

    //[Parameter]
    [SupplyParameterFromQuery]
    public string? phone { get; set; }

    // ============================================================
    // STATE
    // ============================================================

    private string Phone = "";
    private string FullName = "";
    private string Email = "";
    private string Password = "";
    private string error = "";
    private string success = "";
    private bool isLoading = false;

    // ============================================================
    // LIFECYCLE
    // ============================================================

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(phone))
        {
            Phone = phone;
        }
        else
        {
            // اگر پارامتر وجود نداشت، به Auth برگردان
            NavigationManager.NavigateTo("/Auth");
        }
    }

    // ============================================================
    // REGISTER LOGIC
    // ============================================================

    private async Task RegisterUser()
    {
        // اعتبارسنجی ساده
        if (string.IsNullOrWhiteSpace(FullName))
        {
            error = "لطفاً نام کامل خود را وارد کنید.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Password) || Password.Length < 6)
        {
            error = "رمز عبور باید حداقل ۶ کاراکتر باشد.";
            return;
        }

        isLoading = true;
        error = "";
        success = "";

        // شبیه‌سازی درخواست به سرور
        // await Task.Delay(1500);
        var registerResult = await _userFacade.Register(new BackEnd.Core.User.Commands.Register.RegisterUserCommand
        {
            FullName = FullName,
            Email = Email,
            Password = Password,
            PhoneNumber = phone,
        });
        if (registerResult.Status != BackEnd.Shared.CoreShared.OperationResultStatus.Success)
        {
            error = registerResult.Message;
            return;
        }

        NavigationManager.NavigateTo($"/Auth/Login?phoneNumber={phone}", true);

        success = "حساب کاربری شما با موفقیت ایجاد شد!";
        // await Task.Delay(500);
        NavigationManager.NavigateTo("/Dashboard", true);

        isLoading = false;
        StateHasChanged();
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/Auth");
    }
}