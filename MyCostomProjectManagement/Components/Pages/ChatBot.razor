@page "/Chat"
@layout FrontLayout
@rendermode InteractiveServer
@using BackEnd.Data.Infrastructure.ChatBot
@using MyCostomProjectManagement.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@inject IChatBotService _chatBot
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>گفتگو با دستیار پارسا | مشاوره فنی</PageTitle>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />

<style>
    /* ============================================================
           RESET & BASE
        ============================================================ */
    .chat-page * {
        box-sizing: border-box;
    }

    .chat-page {
        padding-top: 90px;
        padding-bottom: 30px;
        min-height: 100vh;
        position: relative;
        z-index: 1;
    }

    /* ============================================================
           HEADER
        ============================================================ */
    .chat-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .chat-header-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(59, 130, 246, 0.12);
        padding: 6px 18px;
        border-radius: 40px;
        font-size: 0.8rem;
        color: #3b82f6;
        border: 1px solid rgba(59, 130, 246, 0.15);
        margin-bottom: 14px;
        backdrop-filter: blur(4px);
    }

    .chat-header h1 {
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        font-weight: 800;
        margin-bottom: 8px;
        background: linear-gradient(to left, #f0f4ff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .chat-header p {
        color: #94a3b8;
        font-size: 0.95rem;
        max-width: 620px;
        margin: 0 auto;
    }

    /* ============================================================
           CHAT CONTAINER
        ============================================================ */
    .chat-shell {
        max-width: 980px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 24px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        position: relative;
    }

        .chat-shell::before {
            content: '';
            position: absolute;
            inset: -2px;
            z-index: -1;
            border-radius: 26px;
            background: conic-gradient(from 0deg, #3b82f6, #8b5cf6, #3b82f6);
            background-size: 300% 300%;
            animation: chatBorderRotate 10s linear infinite;
            opacity: 0.15;
        }

    @@keyframes chatBorderRotate {
        0% {
            background-position: 0% 50%;
        }

        100% {
            background-position: 300% 50%;
        }
    }

    /* ============================================================
           CHAT MESSAGES AREA
        ============================================================ */
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 26px 22px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-height: 480px;
        max-height: 62vh;
        scroll-behavior: smooth;
        overscroll-behavior: contain;
    }

    /* ============================================================
           MESSAGE BUBBLE
        ============================================================ */
    .msg-row {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        animation: chatMsgIn 0.35s ease;
        max-width: 100%;
    }

    @@keyframes chatMsgIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .msg-row.user {
        flex-direction: row-reverse;
    }

    .msg-avatar {
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
    }

    .msg-row.bot .msg-avatar {
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    }

    .msg-row.user .msg-avatar {
        background: linear-gradient(135deg, #10b981, #059669);
    }

    .msg-bubble {
        padding: 14px 18px;
        border-radius: 18px;
        max-width: min(720px, 78%);
        font-size: 0.95rem;
        line-height: 1.85;
        color: #e8edf5;
        word-wrap: break-word;
        word-break: break-word;
        position: relative;
        overflow-wrap: anywhere;
    }

    .msg-row.bot .msg-bubble {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-top-right-radius: 6px;
    }

    .msg-row.user .msg-bubble {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.22), rgba(139, 92, 246, 0.18));
        border: 1px solid rgba(59, 130, 246, 0.25);
        border-top-left-radius: 6px;
        color: #eaf2ff;
    }

    /* Attachments inside bubble */
    .msg-attachments {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
    }

        .msg-attachments img {
            max-width: 220px;
            max-height: 220px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            display: block;
            cursor: zoom-in;
            transition: transform .25s ease, box-shadow .25s ease;
        }

            .msg-attachments img:hover {
                transform: scale(1.02);
                box-shadow: 0 8px 30px rgba(59, 130, 246, 0.35);
            }

        .msg-attachments .file-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 20px;
            font-size: 0.78rem;
            color: #93c5fd;
        }

            .msg-attachments .file-chip.audio {
                background: rgba(139, 92, 246, 0.12);
                border-color: rgba(139, 92, 246, 0.2);
                color: #c4b5fd;
            }

            .msg-attachments .file-chip.video {
                background: rgba(236, 72, 153, 0.12);
                border-color: rgba(236, 72, 153, 0.2);
                color: #f9a8d4;
            }

    /* Streaming cursor */
    .streaming-cursor {
        display: inline-block;
        width: 8px;
        height: 1em;
        background: #3b82f6;
        margin-inline-start: 3px;
        vertical-align: text-bottom;
        animation: cursorBlink 0.85s step-end infinite;
        box-shadow: 0 0 10px #3b82f6;
        border-radius: 1px;
    }

    @@keyframes cursorBlink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }

    /* ============================================================
           MARKDOWN INSIDE BUBBLE
        ============================================================ */
    .msg-bubble .md-content > *:first-child {
        margin-top: 0;
    }

    .msg-bubble .md-content > *:last-child {
        margin-bottom: 0;
    }

    .msg-bubble .md-content p {
        margin: 0 0 .75em;
    }

    .msg-bubble .md-content h1,
    .msg-bubble .md-content h2,
    .msg-bubble .md-content h3,
    .msg-bubble .md-content h4,
    .msg-bubble .md-content h5,
    .msg-bubble .md-content h6 {
        margin: 1.1em 0 .5em;
        font-weight: 700;
        line-height: 1.5;
    }

    .msg-bubble .md-content h1 {
        font-size: 1.25rem;
        color: #fff;
    }

    .msg-bubble .md-content h2 {
        font-size: 1.15rem;
        color: #93c5fd;
    }

    .msg-bubble .md-content h3 {
        font-size: 1.05rem;
        color: #a78bfa;
    }

    .msg-bubble .md-content ul,
    .msg-bubble .md-content ol {
        padding-inline-start: 1.5em;
        margin: 0 0 .75em;
    }

    .msg-bubble .md-content li {
        margin-bottom: .35em;
    }

    .msg-bubble .md-content ul li::marker {
        color: #3b82f6;
    }

    .msg-bubble .md-content ol li::marker {
        color: #8b5cf6;
        font-weight: 600;
    }

    .msg-bubble .md-content a {
        color: #60a5fa;
        text-decoration: none;
        border-bottom: 1px dashed rgba(96, 165, 250, 0.5);
        transition: .2s;
    }

        .msg-bubble .md-content a:hover {
            color: #93c5fd;
            border-bottom-style: solid;
        }

    .msg-bubble .md-content strong {
        color: #fff;
        font-weight: 700;
    }

    .msg-bubble .md-content em {
        color: #c4b5fd;
        font-style: italic;
    }

    .msg-bubble .md-content blockquote {
        border-inline-start: 3px solid #3b82f6;
        background: rgba(59, 130, 246, 0.06);
        padding: .6rem .9rem;
        border-radius: 0 10px 10px 0;
        margin: 0 0 1em;
        color: #cbd5e1;
        font-style: italic;
    }

        .msg-bubble .md-content blockquote > *:last-child {
            margin-bottom: 0;
        }

    /* Inline code */
    .msg-bubble .md-content code {
        direction: ltr;
        unicode-bidi: embed;
        background: rgba(139, 92, 246, 0.12);
        color: #c4b5fd;
        padding: .15em .5em;
        border-radius: 6px;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: .88em;
        border: 1px solid rgba(139, 92, 246, 0.2);
        text-align: left;
        font-weight: 500;
    }

    /* Code block */
    .msg-bubble .md-content pre {
        position: relative;
        direction: ltr !important;
        text-align: left !important;
        unicode-bidi: embed;
        background: #0d0d13;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        padding: 2.6rem 1rem .9rem 1rem;
        margin: 0 0 1em;
        overflow-x: auto;
        line-height: 1.65;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: .84rem;
    }

        .msg-bubble .md-content pre code {
            background: transparent !important;
            color: #e0e0e8;
            padding: 0 !important;
            border: none !important;
            font-size: inherit;
            display: block;
            white-space: pre;
            font-family: inherit;
            border-radius: 0;
            tab-size: 4;
            text-align: left !important;
        }

            .msg-bubble .md-content pre code.hljs {
                background: transparent !important;
                padding: 0 !important;
            }

    /* Copy button */
    .msg-bubble .md-content .chat-copy-btn {
        position: absolute;
        top: .5rem;
        right: .5rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .3rem .65rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #cbd5e1;
        border-radius: 6px;
        font-size: .7rem;
        cursor: pointer;
        transition: all .2s;
        z-index: 3;
        font-family: inherit;
    }

        .msg-bubble .md-content .chat-copy-btn:hover {
            background: rgba(59, 130, 246, 0.15);
            color: #93c5fd;
            border-color: rgba(59, 130, 246, 0.4);
        }

        .msg-bubble .md-content .chat-copy-btn.copied {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border-color: rgba(16, 185, 129, 0.4);
        }

    /* Language badge */
    .msg-bubble .md-content .chat-lang-badge {
        position: absolute;
        top: .5rem;
        left: .5rem;
        padding: .22rem .55rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #94a3b8;
        border-radius: 6px;
        font-size: .62rem;
        font-family: 'Consolas', monospace;
        text-transform: uppercase;
        letter-spacing: .5px;
        z-index: 3;
        font-weight: 700;
    }

    /* ============================================================
           TYPING INDICATOR
        ============================================================ */
    .typing-indicator {
        display: inline-flex;
        gap: 5px;
        padding: 4px 0;
        align-items: center;
    }

        .typing-indicator span {
            width: 8px;
            height: 8px;
            background: #3b82f6;
            border-radius: 50%;
            animation: typingBounce 1.2s infinite;
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.4);
        }

            .typing-indicator span:nth-child(2) {
                animation-delay: .15s;
                background: #8b5cf6;
            }

            .typing-indicator span:nth-child(3) {
                animation-delay: .3s;
                background: #a78bfa;
            }

    @@keyframes typingBounce {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: .5;
        }

        30% {
            transform: translateY(-6px);
            opacity: 1;
        }
    }

    /* ============================================================
           WELCOME / EMPTY STATE
        ============================================================ */
    .chat-welcome {
        text-align: center;
        padding: 30px 20px;
        color: #94a3b8;
    }

        .chat-welcome i {
            font-size: 3rem;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 14px;
        }

        .chat-welcome h3 {
            color: #e8edf5;
            font-size: 1.15rem;
            margin-bottom: 8px;
        }

        .chat-welcome p {
            font-size: 0.9rem;
            max-width: 460px;
            margin: 0 auto 20px;
            line-height: 1.8;
        }

    .chat-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        max-width: 620px;
        margin: 0 auto;
    }

    .chat-suggestion {
        background: rgba(59, 130, 246, 0.08);
        border: 1px solid rgba(59, 130, 246, 0.2);
        color: #93c5fd;
        padding: 8px 16px;
        border-radius: 40px;
        font-size: 0.82rem;
        cursor: pointer;
        transition: .25s;
        font-family: inherit;
    }

        .chat-suggestion:hover {
            background: rgba(59, 130, 246, 0.16);
            border-color: rgba(59, 130, 246, 0.5);
            color: #fff;
            transform: translateY(-2px);
        }

    /* ============================================================
           ATTACHMENT PREVIEW (before send)
        ============================================================ */
    .chat-attachments-preview {
        padding: 12px 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        background: rgba(0, 0, 0, 0.15);
    }

    .attach-preview-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px 6px 8px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 10px;
        font-size: 0.78rem;
        color: #cbd5e1;
    }

        .attach-preview-item img {
            width: 32px;
            height: 32px;
            object-fit: cover;
            border-radius: 6px;
            cursor: zoom-in;
            transition: transform .25s ease;
        }

            .attach-preview-item img:hover {
                transform: scale(1.08);
            }

        .attach-preview-item .attach-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139, 92, 246, 0.12);
            color: #c4b5fd;
            border-radius: 6px;
            font-size: 0.85rem;
        }

        .attach-preview-item .remove-btn {
            background: rgba(239, 68, 68, 0.12);
            border: none;
            color: #f87171;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: .2s;
            font-family: inherit;
        }

            .attach-preview-item .remove-btn:hover {
                background: rgba(239, 68, 68, 0.25);
                color: #fff;
            }

    /* ============================================================
           INPUT AREA
        ============================================================ */
    .chat-input-area {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding: 16px 20px;
        background: rgba(0, 0, 0, 0.12);
    }

    .chat-input-row {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }

    .chat-textarea {
        flex: 1;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 16px;
        color: #eef2f8;
        font-size: 0.95rem;
        padding-block: 12px;
        padding-inline: 16px;
        resize: none;
        font-family: inherit;
        min-height: 50px;
        max-height: 180px;
        line-height: 1.7;
        transition: border-color .25s ease, background .25s ease, box-shadow .25s ease;
        outline: none;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(59, 130, 246, 0.35) transparent;
    }

        .chat-textarea:focus {
            border-color: rgba(59, 130, 246, 0.5);
            background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.08);
        }

        .chat-textarea::placeholder {
            color: #64748b;
        }

        .chat-textarea:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .chat-tools {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .chat-tool-btn {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.07);
        color: #94a3b8;
        cursor: pointer;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .25s;
        position: relative;
        font-family: inherit;
    }

        .chat-tool-btn:hover {
            background: rgba(59, 130, 246, 0.1);
            border-color: rgba(59, 130, 246, 0.35);
            color: #93c5fd;
            transform: translateY(-1px);
        }

        .chat-tool-btn.loading {
            opacity: 0.5;
            pointer-events: none;
        }

    .hidden-input {
        display: none;
    }

    .chat-send-btn {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border: none;
        color: #fff;
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .25s;
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.2);
        font-family: inherit;
        flex-shrink: 0;
    }

        .chat-send-btn:hover:not(:disabled) {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 12px 35px rgba(59, 130, 246, 0.35);
        }

        .chat-send-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .chat-send-btn.stop {
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.25);
        }

            .chat-send-btn.stop:hover {
                box-shadow: 0 12px 35px rgba(239, 68, 68, 0.4);
            }

    .chat-hint {
        font-size: 0.72rem;
        color: #64748b;
        margin-top: 8px;
        text-align: center;
    }

    /* ============================================================
           SCROLL-DOWN BUTTON
        ============================================================ */
    .chat-scroll-down-btn {
        position: absolute;
        bottom: 130px;
        left: 50%;
        transform: translateX(-50%) translateY(15px);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        border: 2px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.5);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
        z-index: 20;
        font-family: inherit;
    }

        .chat-scroll-down-btn.visible {
            opacity: 1;
            pointer-events: auto;
            transform: translateX(-50%) translateY(0);
        }

        .chat-scroll-down-btn:hover {
            transform: translateX(-50%) translateY(-3px) scale(1.08);
            box-shadow: 0 12px 35px rgba(59, 130, 246, 0.65);
        }

        .chat-scroll-down-btn:active {
            transform: translateX(-50%) translateY(0) scale(0.95);
        }

        .chat-scroll-down-btn i {
            animation: scrollBtnBounce 1.8s infinite;
        }

    @@keyframes scrollBtnBounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(3px);
        }
    }

    /* ============================================================
           IMAGE LIGHTBOX / ZOOM MODAL
        ============================================================ */
    .chat-lightbox {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.88);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 24px;
        animation: lightboxFadeIn 0.25s ease;
        cursor: zoom-out;
    }

    @@keyframes lightboxFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .chat-lightbox-img-wrap {
        position: relative;
        max-width: 100%;
        max-height: 100%;
        animation: lightboxZoomIn 0.35s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    @@keyframes lightboxZoomIn {
        from {
            transform: scale(0.85);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .chat-lightbox img {
        display: block;
        max-width: 90vw;
        max-height: 85vh;
        border-radius: 12px;
        box-shadow: 0 20px 80px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.06);
        object-fit: contain;
        background: #0d0d13;
        user-select: none;
    }

    .chat-lightbox-close {
        position: absolute;
        top: -50px;
        right: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
