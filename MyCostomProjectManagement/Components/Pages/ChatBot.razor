<div class="chat-page">
    <div class="container">

        <!-- HEADER -->
        <div class="chat-header">
            <div class="chat-header-badge">
                <i class="fas fa-robot"></i>
                دستیار هوش مصنوعی پارسا
            </div>
            <h1>گفتگو با <span style="color:#3b82f6;">دستیار محمد پارسا کریمی</span></h1>
            <p>
                درباره پروژه، مهارت‌ها، نمونه‌کارها یا هر سوال فنی دیگه‌ای بپرسید.
                من به نمایندگی از محمد پارسا اینجام تا کمکتون کنم.
            </p>
        </div>

        <!-- CHAT SHELL -->
        <div class="chat-shell" id="chatShell">

            <!-- MESSAGES -->
            <div class="chat-messages" id="chatMessages">

                @if (!_messages.Any())
                {
                    <div class="chat-welcome">
                        <i class="fas fa-comments"></i>
                        <h3>سلام! 👋</h3>
                        <p>
                            من دستیار هوش مصنوعی محمد پارسا کریمی هستم.
                            می‌تونید هر سوالی درباره تجربه‌ها، پروژه‌ها یا مهارت‌هاش بپرسید.
                        </p>
                        <div class="chat-suggestions">
                            @foreach (var sug in Suggestions)
                            {
                                <button class="chat-suggestion"
                                        @onclick="() => SendSuggestion(sug)"
                                        disabled="@_isStreaming">
                                    @sug
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var msg in _messages)
                    {
                        var isUser = msg.IsUser;
                        var isStreamingThis = !isUser && _isStreaming && msg.Id == _streamingMessageId;

                        <div class="msg-row @(isUser ? "user" : "bot")" @key="msg.Id">

                            <div class="msg-avatar">
                                @if (isUser)
                                {
                                    <i class="fas fa-user"></i>
                                }
                                else
                                {
                                    <i class="fas fa-robot"></i>
                                }
                            </div>

                            <div class="msg-bubble">

                                <!-- Attachments -->
                                @if (isUser && (msg.Images.Any() || msg.Audios.Any() || msg.Videos.Any() || msg.Files.Any()))
                                {
                                    <div class="msg-attachments">
                                        @foreach (var img in msg.Images)
                                        {
                                            <img src="@img"
                                                 alt="تصویر ارسالی"
                                                 @onclick="() => OpenLightbox(img, null)" />
                                        }
                                        @foreach (var audio in msg.Audios)
                                        {
                                            <span class="file-chip audio">
                                                <i class="fas fa-microphone"></i>
                                                پیام صوتی
                                            </span>
                                        }
                                        @foreach (var vid in msg.Videos)
                                        {
                                            <span class="file-chip video">
                                                <i class="fas fa-video"></i>
                                                @vid
                                            </span>
                                        }
                                        @foreach (var file in msg.Files)
                                        {
                                            <span class="file-chip">
                                                <i class="fas fa-paperclip"></i>
                                                @file
                                            </span>
                                        }
                                    </div>
                                }

                                <!-- Content -->
                                @if (isUser)
                                {
                                    <div style="white-space:pre-wrap;">@msg.Content</div>
                                }
                                else if (!string.IsNullOrEmpty(msg.Content))
                                {
                                    <div class="md-content">
                                        @((MarkupString)RenderMarkdown(msg.Content))
                                        @if (isStreamingThis)
                                        {
                                            <span class="streaming-cursor"></span>
                                        }
                                    </div>
                                }
                                else if (isStreamingThis)
                                {
                                    <div class="typing-indicator">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </div>
                                }

                            </div>

                        </div>
                    }
                }

            </div>

            <!-- SCROLL DOWN BUTTON -->
            <button type="button"
                    id="chatScrollDownBtn"
                    class="chat-scroll-down-btn"
                    @onclick="ScrollToBottom"
                    title="رفتن به آخرین پیام">
                <i class="fas fa-arrow-down"></i>
            </button>

            <!-- ATTACHMENTS PREVIEW -->
            @if (_pendingImages.Any() || _pendingAudios.Any() || _pendingFiles.Any() || _isProcessingAttachment)
            {
                <div class="chat-attachments-preview">
                    @if (_isProcessingAttachment)
                    {
                        <div class="attach-preview-item">
                            <span class="attach-icon">
                                <i class="fas fa-spinner fa-spin"></i>
                            </span>
                            <span>در حال پردازش...</span>
                        </div>
                    }

                    @foreach (var (img, idx) in _pendingImages.Select((v, i) => (v, i)))
                    {
                        <div class="attach-preview-item" @key="img.DataUrl.GetHashCode()">
                            <img src="@img.DataUrl"
                                 alt="پیش‌نمایش"
                                 @onclick='() => OpenLightbox(img.DataUrl, $" پیش‌نمایش تصویر {idx + 1}")' />
                            <span>تصویر @(idx + 1)</span>
                            <button class="remove-btn"
                                    @onclick="() => RemoveImage(idx)"
                                    @onclick:stopPropagation="true"
                                    title="حذف">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                    @foreach (var (aud, idx) in _pendingAudios.Select((v, i) => (v, i)))
                    {
                        <div class="attach-preview-item" @key="aud.DataUrl.GetHashCode()">
                            <span class="attach-icon">
                                <i class="fas fa-microphone"></i>
                            </span>
                            <span>صدا @(idx + 1)</span>
                            <button class="remove-btn"
                                    @onclick="() => RemoveAudio(idx)"
                                    title="حذف">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                    @foreach (var (f, idx) in _pendingFiles.Select((v, i) => (v, i)))
                    {
                        <div class="attach-preview-item" @key="f.Name + idx">
                            <span class="attach-icon">
                                <i class="fas fa-file"></i>
                            </span>
                            <span>@f.Name</span>
                            <button class="remove-btn"
                                    @onclick="() => RemoveFile(idx)"
                                    title="حذف">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                </div>
            }

            <!-- INPUT AREA -->
            <div class="chat-input-area">
                <div class="chat-input-row">

                    <div class="chat-tools">

                        <!-- Image -->
                        <InputFile OnChange="OnImageSelected"
                                   accept="image/*"
                                   multiple
                                   class="hidden-input"
                                   id="chatImgInput" />
                        <label for="chatImgInput"
                               class="chat-tool-btn @(_isProcessingAttachment ? "loading" : "")"
                               title="ارسال تصویر">
                            <i class="fas fa-image"></i>
                        </label>

                        <!-- Audio -->
                        <InputFile OnChange="OnAudioSelected"
                                   accept="audio/*"
                                   class="hidden-input"
                                   id="chatAudInput" />
                        <label for="chatAudInput"
                               class="chat-tool-btn @(_isProcessingAttachment ? "loading" : "")"
                               title="ارسال صدا">
                            <i class="fas fa-microphone"></i>
                        </label>

                        <!-- File -->
                        <InputFile OnChange="OnFileSelected"
                                   class="hidden-input"
                                   id="chatFileInput" />
                        <label for="chatFileInput"
                               class="chat-tool-btn"
                               title="ارسال فایل">
                            <i class="fas fa-paperclip"></i>
                        </label>

                    </div>

                    <textarea class="chat-textarea"
                              id="chatTextarea"
                              placeholder="سوالت رو بنویس..."
                              rows="1"
                              @bind="_userInput"
                              @bind:event="oninput"
                              @onkeydown="OnTextareaKeyDown"
                              disabled="@_isStreaming"></textarea>

                    @if (_isStreaming)
                    {
                        <button class="chat-send-btn stop"
                                @onclick="StopStreaming"
                                title="توقف">
                            <i class="fas fa-stop"></i>
                        </button>
                    }
                    else
                    {
                        <button class="chat-send-btn"
                                @onclick="SendMessage"
                                disabled="@(!CanSend())"
                                title="ارسال">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    }

                </div>

                <div class="chat-hint">
                    <i class="fas fa-info-circle"></i>
                    Enter برای ارسال · Shift + Enter برای خط جدید
                </div>
            </div>

        </div>

    </div>
</div>


<!-- ============================================================
     IMAGE LIGHTBOX
============================================================ -->
@if (_lightboxOpen && !string.IsNullOrEmpty(_lightboxImageSrc))
{
    <div class="chat-lightbox"
         @onclick="CloseLightbox"
         @onkeydown="OnLightboxKeyDown"
         tabindex="0">

        <div class="chat-lightbox-img-wrap" @onclick:stopPropagation="true">

            <button type="button"
                    class="chat-lightbox-close"
                    @onclick="CloseLightbox"
                    title="بستن (Esc)">
                <i class="fas fa-times"></i>
            </button>

            <img src="@_lightboxImageSrc"
                 alt="@(_lightboxCaption ?? "نمایش تصویر")"
                 @onclick="CloseLightbox" />

            @if (!string.IsNullOrEmpty(_lightboxCaption))
            {
                <div class="chat-lightbox-caption">@_lightboxCaption</div>
            }

        </div>

    </div>
}


@code {

    // ============================================================
    // STATE
    // ============================================================
    private List<UiChatMessage> _messages = new();
    private string _userInput = "";
    private bool _isStreaming = false;
    private Guid? _streamingMessageId = null;
    private CancellationTokenSource? _cts;

    private readonly List<PendingAttachment> _pendingImages = new();
    private readonly List<PendingAttachment> _pendingAudios = new();
    private readonly List<PendingFile> _pendingFiles = new();

    private bool _jsReady = false;
    private bool _needsCodeEnhance = false;
    private bool _isProcessingAttachment = false;

    // Lightbox
    private bool _lightboxOpen = false;
    private string? _lightboxImageSrc;
    private string? _lightboxCaption;

    private readonly object _sendLock = new();

    // حداکثر حجم‌های مجاز
    private const long MaxImageSize = 15 * 1024 * 1024;
    private const long MaxAudioSize = 10 * 1024 * 1024;
    private const int MaxImageDim = 1024;
    private const double ImageQuality = 0.82;

    private static readonly string[] Suggestions = new[]
    {
        "چند سال سابقه داره؟",
        "با چه تکنولوژی‌هایی کار می‌کنه؟",
        "یه نمونه‌کار خوب معرفی کن",
        "تجربه‌ش در میکروسرویس چیه؟"
    };

    // ============================================================
    // MODELS
    // ============================================================

    private class UiChatMessage
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Content { get; set; } = "";
        public bool IsUser { get; set; }
        public List<string> Images { get; set; } = new();
        public List<string> Audios { get; set; } = new();
        public List<string> Videos { get; set; } = new();
        public List<string> Files { get; set; } = new();

        public ChatMessageDto ToDto() => new()
        {
            Content = Content,
            IsUser = IsUser,
            Images = new List<string>(Images),
            Audios = new List<string>(Audios),
            Videos = new List<string>(Videos),
            Files = new List<string>(Files)
        };
    }

    private class PendingAttachment
    {
        public string DataUrl { get; set; } = "";
        public string Name { get; set; } = "";
        public string ContentType { get; set; } = "";
    }

    private class PendingFile
    {
        public string Name { get; set; } = "";
        public string ContentType { get; set; } = "";
    }

    // ============================================================
    // LIFECYCLE
    // ============================================================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jsReady)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", ChatInteropJs);
                _jsReady = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Chat] JS init error: {ex.Message}");
                return;
            }
        }

        if (_needsCodeEnhance)
        {
            _needsCodeEnhance = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("__chatEnhanceCodeBlocks");
            }
            catch { /* ignore */ }
        }

        // فوکوس روی lightbox برای پشتیبانی از Esc
        if (_lightboxOpen && firstRender == false)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval",
                    "setTimeout(() => { var el = document.querySelector('.chat-lightbox'); if (el) el.focus(); }, 50);");
            }
            catch { /* ignore */ }
        }
    }

    // ============================================================
    // LIGHTBOX
    // ============================================================
    private void OpenLightbox(string src, string? caption)
    {
        if (string.IsNullOrEmpty(src)) return;
        _lightboxImageSrc = src;
        _lightboxCaption = caption;
        _lightboxOpen = true;
    }

    private void CloseLightbox()
    {
        _lightboxOpen = false;
        _lightboxImageSrc = null;
        _lightboxCaption = null;
    }

    private async Task OnLightboxKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseLightbox();
        }
    }

    // ============================================================
    // HELPERS
    // ============================================================
    private bool CanSend()
    {
        if (_isStreaming) return false;
        if (_isProcessingAttachment) return false;
        if (!string.IsNullOrWhiteSpace(_userInput)) return true;
        if (_pendingImages.Any() || _pendingAudios.Any() || _pendingFiles.Any()) return true;
        return false;
    }

    private void RemoveImage(int idx)
    {
        if (idx >= 0 && idx < _pendingImages.Count)
            _pendingImages.RemoveAt(idx);
    }

    private void RemoveAudio(int idx)
    {
        if (idx >= 0 && idx < _pendingAudios.Count)
            _pendingAudios.RemoveAt(idx);
    }

    private void RemoveFile(int idx)
    {
        if (idx >= 0 && idx < _pendingFiles.Count)
            _pendingFiles.RemoveAt(idx);
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("__chatScrollToBottomForce");
        }
        catch { /* ignore */ }
    }

    // ============================================================
    // FILE UPLOADS
    // ============================================================
    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        _isProcessingAttachment = true;
        StateHasChanged();

        try
        {
            foreach (var file in e.GetMultipleFiles(5))
            {
                if (file.Size > MaxImageSize) continue;

                try
                {
                    using var ms = new MemoryStream();
                    await file.OpenReadStream(MaxImageSize).CopyToAsync(ms);
                    var bytes = ms.ToArray();
                    var base64 = Convert.ToBase64String(bytes);
                    var originalDataUrl = $"data:{file.ContentType};base64,{base64}";

                    var resized = await JSRuntime.InvokeAsync<string>(
                        "eval",
                        $"window.__chatResizeImageFromDataUrl('{EscapeJs(originalDataUrl)}')");

                    var finalUrl = string.IsNullOrEmpty(resized) ? originalDataUrl : resized;

                    _pendingImages.Add(new PendingAttachment
                    {
                        DataUrl = finalUrl,
                        Name = file.Name,
                        ContentType = "image/jpeg"
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Chat] Image processing error: {ex.Message}");
                }
            }
        }
        finally
        {
            _isProcessingAttachment = false;
            StateHasChanged();
        }
    }

    private async Task OnAudioSelected(InputFileChangeEventArgs e)
    {
        _isProcessingAttachment = true;
        StateHasChanged();

        try
        {
            var file = e.File;
            if (file.Size > MaxAudioSize) return;

            try
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(MaxAudioSize).CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());

                _pendingAudios.Add(new PendingAttachment
                {
                    DataUrl = $"data:{file.ContentType};base64,{base64}",
                    Name = file.Name,
                    ContentType = file.ContentType
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Chat] Audio processing error: {ex.Message}");
            }
        }
        finally
        {
            _isProcessingAttachment = false;
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(5))
        {
            _pendingFiles.Add(new PendingFile
            {
                Name = file.Name,
                ContentType = file.ContentType
            });
        }
        await Task.CompletedTask;
        StateHasChanged();
    }

    // ============================================================
    // SEND + STREAMING
    // ============================================================
    private async Task SendSuggestion(string text)
    {
        if (_isStreaming) return;
        _userInput = text;
        await SendMessage();
    }

    private async Task OnTextareaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (CanSend() && !_isStreaming)
            {
                await SendMessage();
            }
        }
    }

    private async Task SendMessage()
    {
        if (_isStreaming) return;
        if (_isProcessingAttachment) return;

        var text = (_userInput ?? "").Trim();
        var hasAttachment = _pendingImages.Any() || _pendingAudios.Any() || _pendingFiles.Any();
        if (string.IsNullOrEmpty(text) && !hasAttachment) return;

        lock (_sendLock)
        {
            if (_isStreaming) return;
            _isStreaming = true;
        }

        var userImages = _pendingImages.Select(i => i.DataUrl).ToList();
        var userAudios = _pendingAudios.Select(a => a.DataUrl).ToList();
        var userFiles = _pendingFiles.Select(f => f.Name).ToList();

        _userInput = "";
        _pendingImages.Clear();
        _pendingAudios.Clear();
        _pendingFiles.Clear();

        bool isFirstUserMessage = !_messages.Any(m => m.IsUser);

        if (isFirstUserMessage)
        {
            _messages.Add(new UiChatMessage
            {
                IsUser = false,
                Content = "سلام! 👋 من **دستیار هوش مصنوعی محمد پارسا کریمی** هستم. "
                        + "به نمایندگی از ایشون درباره‌ی تجربه‌ها، پروژه‌ها و مهارت‌هاش با شما صحبت می‌کنم. "
                        + "بفرمایید چطور می‌تونم کمکتون کنم؟"
            });
        }

        var userMsg = new UiChatMessage
        {
            Content = text,
            IsUser = true,
            Images = userImages,
            Audios = userAudios,
            Files = userFiles
        };
        _messages.Add(userMsg);

        var botMsg = new UiChatMessage
        {
            Content = "",
            IsUser = false
        };
        _messages.Add(botMsg);
        _streamingMessageId = botMsg.Id;

        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        StateHasChanged();

        try
        {
            var toSend = _messages
                .Take(_messages.Count - 1)
                .Select(m => m.ToDto())
                .ToList();

            var lastUserIdx = toSend.FindLastIndex(m => m.IsUser);
            for (int i = 0; i < toSend.Count; i++)
            {
                if (i != lastUserIdx && toSend[i].IsUser)
                {
                    toSend[i].Images.Clear();
                    toSend[i].Audios.Clear();
                    toSend[i].Files.Clear();
                }
            }

            var sb = new StringBuilder();

            await foreach (var chunk in _chatBot.AskStreamingAsync(toSend, token)
                                              .WithCancellation(token))
            {
                if (token.IsCancellationRequested) break;
                if (string.IsNullOrEmpty(chunk)) continue;

                sb.Append(chunk);
                botMsg.Content = sb.ToString();

                if (sb.Length % 3 == 0 || chunk.Contains('\n'))
                {
                    await InvokeAsync(StateHasChanged);
                }
            }

            if (string.IsNullOrEmpty(botMsg.Content))
            {
                botMsg.Content = token.IsCancellationRequested
                    ? "_(پاسخ متوقف شد)_"
                    : "متأسفم، پاسخی دریافت نشد. لطفاً دوباره تلاش کنید.";
            }
        }
        catch (OperationCanceledException)
        {
            if (string.IsNullOrEmpty(botMsg.Content))
                botMsg.Content = "_(پاسخ متوقف شد)_";
            else
                botMsg.Content += "\n\n_(پاسخ متوقف شد)_";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Chat] Stream error: {ex}");
            if (string.IsNullOrEmpty(botMsg.Content))
                botMsg.Content = "❌ متأسفانه خطایی رخ داد. لطفاً دوباره تلاش کنید.";
            else
                botMsg.Content += "\n\n❌ _(خطا در ادامه‌ی استریم)_";
        }
        finally
        {
            _streamingMessageId = null;
            _isStreaming = false;

            try { _cts?.Dispose(); } catch { }
            _cts = null;

            _needsCodeEnhance = true;

            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopStreaming()
    {
        try
        {
            _cts?.Cancel();
        }
        catch (ObjectDisposedException) { }
    }

    // ============================================================
    // MARKDOWN RENDER
    // ============================================================
    private static string RenderMarkdown(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        try
        {
            return MarkdownRenderer.Render(content);
        }
        catch
        {
            return $"<pre>{System.Net.WebUtility.HtmlEncode(content)}</pre>";
        }
    }

    // ============================================================
    // JS ESCAPE HELPER
    // ============================================================
    private static string EscapeJs(string s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        return s
            .Replace("\\", "\\\\")
            .Replace("'", "\\'")
            .Replace("\r", "\\r")
            .Replace("\n", "\\n")
            .Replace("</", "<\\/");
    }

    // ============================================================
    // JS INTEROP
    // ============================================================
    private const string ChatInteropJs = """
        (function () {

            // ---- بارگذاری highlight.js فقط یک بار ----
            if (!window.__chatHljsLoaded) {
                window.__chatHljsLoaded = true;
                var s1 = document.createElement('script');
                s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js';
                s1.onload = function () {
                    var langs = ['csharp','javascript','typescript','python','sql','xml','json','bash','css'];
                    langs.forEach(function (l) {
                        var s = document.createElement('script');
                        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/' + l + '.min.js';
                        document.head.appendChild(s);
                    });
                };
                document.head.appendChild(s1);
            }

            // ============================================================
            // Resize Image
            // ============================================================
            window.__chatResizeImageFromDataUrl = function (dataUrl) {
                return new Promise(function (resolve) {
                    if (!dataUrl) { resolve(dataUrl); return; }

                    var img = new Image();
                    img.onload = function () {
                        try {
                            var MAX = 1024;
                            var w = img.width, h = img.height;

                            if (w > MAX || h > MAX) {
                                if (w > h) {
                                    h = Math.round(h * MAX / w);
                                    w = MAX;
                                } else {
                                    w = Math.round(w * MAX / h);
                                    h = MAX;
                                }
                            }

                            var canvas = document.createElement('canvas');
                            canvas.width = w;
                            canvas.height = h;
                            var ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, w, h);

                            var out = canvas.toDataURL('image/jpeg', 0.82);
                            resolve(out);
                        } catch (e) {
                            resolve(dataUrl);
                        }
                    };
                    img.onerror = function () { resolve(dataUrl); };
                    img.src = dataUrl;
                });
            };

            // ============================================================
            // مدیریت اسکرول هوشمند
            // ============================================================
            const SCROLL_THRESHOLD = 120;

            window.__chatState = {
                isPinnedToBottom: true,
                isProgrammaticScroll: false
            };

            window.__chatIsNearBottom = function () {
                var el = document.getElementById('chatMessages');
                if (!el) return true;
                var distance = el.scrollHeight - el.scrollTop - el.clientHeight;
                return distance <= SCROLL_THRESHOLD;
            };

            window.__chatScrollToBottomNow = function (smooth) {
                var el = document.getElementById('chatMessages');
                if (!el) return;
                window.__chatState.isProgrammaticScroll = true;
                try {
                    el.scrollTo({
                        top: el.scrollHeight,
                        behavior: smooth ? 'smooth' : 'auto'
                    });
                } catch (e) {
                    el.scrollTop = el.scrollHeight;
                }
                setTimeout(function () {
                    window.__chatState.isProgrammaticScroll = false;
                }, 300);
            };

            window.__chatAutoScroll = function () {
                if (window.__chatState.isPinnedToBottom) {
                    window.__chatScrollToBottomNow(false);
                }
            };

            window.__chatScrollToBottomForce = function () {
                window.__chatState.isPinnedToBottom = true;
                window.__chatScrollToBottomNow(true);
                window.__chatUpdateScrollBtn();
            };

            window.__chatUpdateScrollBtn = function () {
                var btn = document.getElementById('chatScrollDownBtn');
                if (!btn) return;
                if (window.__chatState.isPinnedToBottom) {
                    btn.classList.remove('visible');
                } else {
                    btn.classList.add('visible');
                }
            };

            window.__chatBindScroll = function () {
                var el = document.getElementById('chatMessages');
                if (!el || el.__scrollBound) return;
                el.__scrollBound = true;

                el.addEventListener('scroll', function () {
                    if (window.__chatState.isProgrammaticScroll) return;
                    var isNearBottom = window.__chatIsNearBottom();
                    window.__chatState.isPinnedToBottom = isNearBottom;
                    window.__chatUpdateScrollBtn();
                }, { passive: true });
            };

            // ============================================================
            // MutationObserver
            // ============================================================
            if (!window.__chatDomObserver) {
                window.__chatDomObserver = true;

                var obs = new MutationObserver(function () {
                    window.__chatBindScroll();
                    window.__chatBindTextarea();
                    window.__chatBindLightbox();

                    if (window.__chatState.isPinnedToBottom) {
                        requestAnimationFrame(function () {
                            window.__chatAutoScroll();
                        });
                    }
                });

                obs.observe(document.body, { childList: true, subtree: true });
            }

            // ============================================================
            // textarea
            // ============================================================
            window.__chatBindTextarea = function () {
                var ta = document.getElementById('chatTextarea');
                if (!ta || ta.__chatBound) return;
                ta.__chatBound = true;

                ta.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                    }
                });

                var autoResize = function () {
                    ta.style.height = 'auto';
                    var maxH = 180;
                    var newH = Math.min(ta.scrollHeight + 2, maxH);
                    ta.style.height = newH + 'px';
                    ta.style.overflowY = ta.scrollHeight > maxH ? 'auto' : 'hidden';
                };

                ta.addEventListener('input', autoResize);
                autoResize();
            };

            // ============================================================
            // Lightbox: Esc key + wheel zoom
            // ============================================================
            window.__chatBindLightbox = function () {
                // Esc key global
                if (!window.__chatEscBound) {
                    window.__chatEscBound = true;
                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape') {
                            var lb = document.querySelector('.chat-lightbox');
                            if (lb) {
                                // Blazor هندل می‌کنه — اینجا فقط به عنوان fallback
                                var closeBtn = lb.querySelector('.chat-lightbox-close');
                                if (closeBtn) closeBtn.click();
                            }
                        }
                    });
                }

                // wheel zoom (اختیاری)
                var lb = document.querySelector('.chat-lightbox');
                if (!lb || lb.__wheelBound) return;
                lb.__wheelBound = true;

                var scale = 1;
                var imgEl = lb.querySelector('img');

                lb.addEventListener('wheel', function (e) {
                    if (!imgEl) return;
                    e.preventDefault();
                    scale += e.deltaY > 0 ? -0.1 : 0.1;
                    scale = Math.max(0.5, Math.min(3, scale));
                    imgEl.style.transform = 'scale(' + scale + ')';
                    imgEl.style.transition = 'transform 0.15s ease';
                }, { passive: false });
            };

            // صدا زدن اولیه
            setTimeout(function () {
                window.__chatBindScroll();
                window.__chatBindTextarea();
                window.__chatBindLightbox();
            }, 100);

            // ============================================================
            // تزئین کد بلاک‌ها
            // ============================================================
            window.__chatEnhanceCodeBlocks = function () {
                var pres = document.querySelectorAll('.msg-bubble .md-content pre');
                pres.forEach(function (pre) {
                    if (pre.getAttribute('data-enhanced') === '1') return;
                    pre.setAttribute('data-enhanced', '1');

                    var code = pre.querySelector('code');
                    var lang = '';
                    if (code && code.className) {
                        var m = code.className.match(/language-([A-Za-z0-9_+-]+)/);
                        if (m) lang = m[1].toLowerCase();
                    }

                    if (lang) {
                        var badge = document.createElement('span');
                        badge.className = 'chat-lang-badge';
                        badge.textContent = lang === 'csharp' ? 'C#' : lang;
                        pre.appendChild(badge);
                    }

                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'chat-copy-btn';
                    btn.setAttribute('aria-label', 'کپی کد');
                    btn.innerHTML = '<i class="fas fa-copy"></i><span>کپی</span>';

                    btn.addEventListener('click', function () {
                        var codeEl = pre.querySelector('code');
                        var text = codeEl ? codeEl.textContent : pre.textContent;

                        var finish = function (ok) {
                            if (ok) {
                                btn.classList.add('copied');
                                btn.innerHTML = '<i class="fas fa-check"></i><span>کپی شد!</span>';
                            } else {
                                btn.innerHTML = '<i class="fas fa-times"></i><span>خطا</span>';
                            }
                            setTimeout(function () {
                                btn.classList.remove('copied');
                                btn.innerHTML = '<i class="fas fa-copy"></i><span>کپی</span>';
                            }, 2000);
                        };

                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(text)
                                .then(function () { finish(true); })
                                .catch(function () { finish(false); });
                        } else {
                            try {
                                var ta2 = document.createElement('textarea');
                                ta2.value = text;
                                ta2.style.position = 'fixed';
                                ta2.style.top = '-9999px';
                                document.body.appendChild(ta2);
                                ta2.focus(); ta2.select();
                                document.execCommand('copy');
                                document.body.removeChild(ta2);
                                finish(true);
                            } catch (e) { finish(false); }
                        }
                    });

                    pre.appendChild(btn);
                });

                var applyHl = function () {
                    if (typeof hljs === 'undefined') return;
                    document.querySelectorAll('.msg-bubble .md-content pre code').forEach(function (el) {
                        if (el.getAttribute('data-highlighted') === '1') return;
                        try {
                            hljs.highlightElement(el);
                            el.setAttribute('data-highlighted', '1');
                        } catch (e) {}
                    });
                };

                if (typeof hljs !== 'undefined') {
                    applyHl();
                } else {
                    var tries = 0;
                    var iv = setInterval(function () {
                        tries++;
                        if (typeof hljs !== 'undefined' || tries > 40) {
                            clearInterval(iv);
                            applyHl();
                        }
                    }, 100);
                }
            };
        })();
        """;
}